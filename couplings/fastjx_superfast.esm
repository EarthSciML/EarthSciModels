{
  "esm": "0.8.0",
  "metadata": {
    "name": "FastJXSuperFastCoupling",
    "description": "Coupling library (esm-spec §10.9) wiring Fast-JX photolysis rates into the SuperFast gas-phase mechanism's six photolysis parameters. Roles: Photolysis (a Fast-JX model exposing j_<X> observed rates, 1/s) and Chem (SuperFast, whose jNO2/jO32OH/jH2COa/jH2COb/jH2O2/jCH3OOH parameters are replaced by the time-varying FastJX rates via param_to_var). Import with coupling_import + bind {Photolysis, Chem}. The j_o32OH mapping is the effective rate for O3 + hv -> 2 OH (including the O(1D) + H2O step), computed in Fast-JX as j_o32OH = j_O31D * j_O31D_adj. Rewritten from the previous concrete-name form (which carried a FastJX model stub and could not be coupling_import'd) into a role-based, importable library. Provenance: GasChem.jl@8c12c048 src/fastjx_couplings.jl:86-109 (esm-75da).",
    "tags": ["photolysis", "coupling-library", "gaschem", "fastjx", "superfast", "param_to_var"],
    "references": [
      { "citation": "Wild, O., Zhu, X., & Prather, M. J. (2000). Fast-J: Accurate simulation of in- and below-cloud photolysis in tropospheric chemical models. Journal of Atmospheric Chemistry, 37(3), 245-282." },
      { "citation": "Seinfeld, J. H., & Pandis, S. N. (2016). Atmospheric Chemistry and Physics: From Air Pollution to Climate Change (3rd ed.). Wiley." }
    ]
  },
  "coupling_roles": {
    "Photolysis": { "description": "Fast-JX photolysis component; provides j_<X> [1/s] observed rates." },
    "Chem":       { "description": "SuperFast gas-phase chemistry; its six j-parameters are driven by Photolysis." }
  },
  "coupling": [
    { "type": "variable_map", "from": "Photolysis.j_H2O2",   "to": "Chem.jH2O2",   "transform": "param_to_var",
      "description": "H2O2 + hv -> 2 OH." },
    { "type": "variable_map", "from": "Photolysis.j_H2COa",  "to": "Chem.jH2COa",  "transform": "param_to_var",
      "description": "CH2O + hv -> CO + HO2 + H (radical channel)." },
    { "type": "variable_map", "from": "Photolysis.j_H2COb",  "to": "Chem.jH2COb",  "transform": "param_to_var",
      "description": "CH2O + hv -> CO + H2 (molecular channel)." },
    { "type": "variable_map", "from": "Photolysis.j_CH3OOH", "to": "Chem.jCH3OOH", "transform": "param_to_var",
      "description": "CH3OOH + hv -> CH3O + OH." },
    { "type": "variable_map", "from": "Photolysis.j_NO2",    "to": "Chem.jNO2",    "transform": "param_to_var",
      "description": "NO2 + hv -> NO + O (drives the NOx-O3 photostationary state)." },
    { "type": "variable_map", "from": "Photolysis.j_o32OH",  "to": "Chem.jO32OH",  "transform": "param_to_var",
      "description": "Effective O3 + hv -> 2 OH (O(1D) yield x H2O reaction)." }
  ]
}
