CLAUDE.md
.beads/
.claude/
.runtime/
Manifest.toml
/_EarthSciAST/

# Auto-generated docs output (tools/esm_to_docs.py + hugo + pagefind)
docs/content/components/*/
docs/data/components-index.json
docs/public/
docs/resources/
.hugo_build.lock

# Auto-generated example plot artifacts (tools/render_example_plots.py)
components/**/*.plots/
docs/static/plots/

# Python cruft
__pycache__/
*.pyc
.pytest_cache/

# Runtime Dolt database state (created by embedded dolt server)
embeddeddolt/

# Deployment-chosen data location (esm-spec §8.2.1). Components name their
# local mirrors as paths relative to their own file, e.g.
# components/earthsci_data/nei2016_monthly.esm -> ../../data/..., and this
# symlink points `data/` at the machine's EarthSciIO data directory (what
# $EARTHSCIDATADIR used to name, before §8.2.1 refused env vars in a URL):
#   ln -s "$EARTHSCIDATADIR" data
/data
