{
  "esm": "1.0.0",
  "metadata": {
    "name": "wrf_air_properties",
    "description": "Transport properties of moist air as pure expression templates, transcribed from the statement functions WRF's WSM microphysics schemes share (phys/physics_mmm/mp_wsm6.F90: diffus, viscos, xka). Every template is a closed algebraic function of its parameters; the empirical coefficients are passed in explicitly (the WSM6 values live in components/atmospheric_dynamics/wsm6/wsm6_parameters.esm) so the same template serves any scheme that carries its own fit. T is absolute temperature (K), p pressure (Pa), rho air density (kg/m^3).",
    "license": "MIT",
    "tags": ["wrf", "microphysics", "transport-properties", "expression-templates"],
    "references": [
      { "citation": "Hong, S.-Y., and J.-O. J. Lim (2006). The WRF single-moment 6-class microphysics scheme (WSM6). J. Korean Meteor. Soc. 42, 129-151." },
      { "citation": "Pruppacher, H. R., and J. D. Klett (1997). Microphysics of Clouds and Precipitation, 2nd ed. Kluwer. Chapter 13 (diffusivity of water vapor and viscosity of air)." }
    ]
  },
  "expression_templates": {
    "kinematic_viscosity_of_air": {
      "params": ["T", "rho", "coef", "T_sutherland"],
      "description": "Kinematic viscosity of air from Sutherland's law, nu = coef T^(3/2) / (T + T_sutherland) / rho (WSM: viscos(t, den) = 1.496e-6 t^1.5 / (t + 120) / den; coef in kg/(m s K^(1/2))).",
      "body": {
        "op": "/",
        "args": [
          { "op": "*", "args": ["coef", { "op": "^", "args": ["T", { "op": "/", "args": [3, 2] }] }] },
          { "op": "*", "args": [{ "op": "+", "args": ["T", "T_sutherland"] }, "rho"] }
        ]
      }
    },
    "diffusivity_of_water_vapor": {
      "params": ["T", "p", "coef", "expn"],
      "description": "Molecular diffusivity of water vapor in air, Dv = coef T^expn / p (WSM: diffus(t, p) = 8.794e-5 t^1.81 / p).",
      "body": { "op": "/", "args": [{ "op": "*", "args": ["coef", { "op": "^", "args": ["T", "expn"] }] }, "p"] }
    },
    "thermal_conductivity_of_air": {
      "params": ["nu", "rho", "coef"],
      "description": "Thermal conductivity of air proportional to the dynamic viscosity, ka = coef nu rho (WSM: xka(t, den) = 1.414e3 viscos(t, den) den; coef in J/(kg K)).",
      "body": { "op": "*", "args": ["coef", "nu", "rho"] }
    }
  }
}
