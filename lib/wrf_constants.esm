{
  "esm": "1.0.0",
  "metadata": {
    "name": "WRFConstants",
    "description": "Physical and model constants of the WRF model, transcribed from share/module_model_constants.F (WRF v4.8.0, commit 06d4240). Every EqWeFiC component takes its constants from this file by mounting it as a subsystem (esm-spec 4.7) and referencing e.g. `<Model>.wrf.cp`, so that no physical constant is ever written inline in a component and every scheme agrees with the Fortran to the digit. Base constants are parameters carrying WRF's exact literal values (single-precision literals in the Fortran, written here as the same decimal strings). Constants that WRF defines as expressions of other constants (cp = 7 r_d / 2, ep_1 = r_v/r_d - 1, ...) are observed unknowns defined by the same expressions, so the derivation is not repeated. Only constants used by more than one scheme are here; scheme-private constants live with their scheme. The inline tests pin the derived values against the Fortran expressions evaluated in double precision.",
    "tags": [
      "wrf",
      "constants",
      "eqwefic",
      "library"
    ],
    "created": "2026-09-04T00:00:00Z",
    "authors": [
      "EqWeFiC"
    ],
    "references": [
      {
        "citation": "WRF v4.8.0, share/module_model_constants.F (commit 06d4240, 2026-06-08).",
        "url": "https://github.com/wrf-model/WRF/blob/release-v4.8.0/share/module_model_constants.F"
      },
      {
        "citation": "Skamarock, W. C., et al. (2021). A Description of the Advanced Research WRF Model Version 4.3. NCAR Tech. Note NCAR/TN-556+STR.",
        "url": "https://doi.org/10.5065/1dfh-6p97"
      }
    ]
  },
  "models": {
    "WRFConstants": {
      "variables": {
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.81,
          "description": "Acceleration due to gravity."
        },
        "r_d": {
          "type": "parameter",
          "units": "J/(kg*K)",
          "default": 287.0,
          "description": "Gas constant of dry air."
        },
        "r_v": {
          "type": "parameter",
          "units": "J/(kg*K)",
          "default": 461.6,
          "description": "Gas constant of water vapor."
        },
        "cliq": {
          "type": "parameter",
          "units": "J/(kg*K)",
          "default": 4190.0,
          "description": "Specific heat of liquid water at 0 degC."
        },
        "cice": {
          "type": "parameter",
          "units": "J/(kg*K)",
          "default": 2106.0,
          "description": "Specific heat of ice at 0 degC."
        },
        "psat": {
          "type": "parameter",
          "units": "Pa",
          "default": 610.78,
          "description": "Saturation vapor pressure at 0 degC."
        },
        "mwdry": {
          "type": "parameter",
          "units": "g/mol",
          "default": 28.966,
          "description": "Molecular weight of dry air."
        },
        "p1000mb": {
          "type": "parameter",
          "units": "Pa",
          "default": 100000.0,
          "description": "Reference pressure, 1000 hPa."
        },
        "t0": {
          "type": "parameter",
          "units": "K",
          "default": 300.0,
          "description": "Base-state temperature."
        },
        "r_earth": {
          "type": "parameter",
          "units": "m",
          "default": 6370000.0,
          "description": "Earth radius (WRF stores its reciprocal, `reradius`)."
        },
        "xlv0": {
          "type": "parameter",
          "units": "J/kg",
          "default": 3150000.0,
          "description": "Latent heat of vaporization, linear fit intercept: L_v(T) = xlv0 - xlv1 T."
        },
        "xlv1": {
          "type": "parameter",
          "units": "J/(kg*K)",
          "default": 2370.0,
          "description": "Latent heat of vaporization, linear fit slope."
        },
        "xls0": {
          "type": "parameter",
          "units": "J/kg",
          "default": 2905000.0,
          "description": "Latent heat of sublimation, linear fit intercept: L_s(T) = xls0 - xls1 T."
        },
        "xls1": {
          "type": "parameter",
          "units": "J/(kg*K)",
          "default": 259.532,
          "description": "Latent heat of sublimation, linear fit slope."
        },
        "xls": {
          "type": "parameter",
          "units": "J/kg",
          "default": 2850000.0,
          "description": "Latent heat of sublimation of water at 0 degC."
        },
        "xlv": {
          "type": "parameter",
          "units": "J/kg",
          "default": 2500000.0,
          "description": "Latent heat of vaporization of water at 0 degC."
        },
        "xlf": {
          "type": "parameter",
          "units": "J/kg",
          "default": 350000.0,
          "description": "Latent heat of fusion of water at 0 degC."
        },
        "rhowater": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1000.0,
          "description": "Density of liquid water at 0 degC."
        },
        "rhosnow": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 100.0,
          "description": "Density of snow."
        },
        "rhoair0": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1.28,
          "description": "Density of dry air at 0 degC and 1000 hPa."
        },
        "piconst": {
          "type": "parameter",
          "units": "1",
          "default": 3.141592653589793,
          "description": "Pi, as WRF spells it."
        },
        "svp1": {
          "type": "parameter",
          "units": "kPa",
          "default": 0.6112,
          "description": "Saturation vapor pressure (Bolton 1980) prefactor: e_s = svp1 exp(svp2 (T - svpt0)/(T - svp3)), giving e_s in kPa."
        },
        "svp2": {
          "type": "parameter",
          "units": "1",
          "default": 17.67,
          "description": "Saturation vapor pressure (Bolton 1980) exponent coefficient."
        },
        "svp3": {
          "type": "parameter",
          "units": "K",
          "default": 29.65,
          "description": "Saturation vapor pressure (Bolton 1980) denominator offset."
        },
        "svpt0": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "Triple-point reference temperature used by the Bolton saturation formula."
        },
        "karman": {
          "type": "parameter",
          "units": "1",
          "default": 0.4,
          "description": "von Karman constant."
        },
        "eomeg": {
          "type": "parameter",
          "units": "rad/s",
          "default": 7.2921e-05,
          "description": "Angular velocity of Earth's rotation."
        },
        "stbolt": {
          "type": "parameter",
          "units": "W/(m^2*K^4)",
          "default": 5.67051e-08,
          "description": "Stefan-Boltzmann constant."
        },
        "pq0": {
          "type": "parameter",
          "units": "Pa",
          "default": 379.90516,
          "description": "Prefactor of the Magnus-form saturation specific humidity q_s = pq0/p exp(a2 (T - a3)/(T - a4)) used by several schemes."
        },
        "a2": {
          "type": "parameter",
          "units": "1",
          "default": 17.2693882,
          "description": "Magnus-form saturation exponent coefficient (see pq0)."
        },
        "a3": {
          "type": "parameter",
          "units": "K",
          "default": 273.16,
          "description": "Magnus-form saturation reference temperature (see pq0)."
        },
        "a4": {
          "type": "parameter",
          "units": "K",
          "default": 35.86,
          "description": "Magnus-form saturation denominator offset (see pq0)."
        },
        "cp": {
          "type": "unknown",
          "units": "J/(kg*K)",
          "description": "Specific heat of dry air at constant pressure, cp = 7 r_d / 2."
        },
        "cv": {
          "type": "unknown",
          "units": "J/(kg*K)",
          "description": "Specific heat of dry air at constant volume, cv = cp - r_d."
        },
        "cpv": {
          "type": "unknown",
          "units": "J/(kg*K)",
          "description": "Specific heat of water vapor at constant pressure, cpv = 4 r_v."
        },
        "cvv": {
          "type": "unknown",
          "units": "J/(kg*K)",
          "description": "Specific heat of water vapor at constant volume, cvv = cpv - r_v."
        },
        "cvpm": {
          "type": "unknown",
          "units": "1",
          "description": "-cv/cp."
        },
        "rcv": {
          "type": "unknown",
          "units": "1",
          "description": "r_d/cv."
        },
        "rcp": {
          "type": "unknown",
          "units": "1",
          "description": "r_d/cp (the Poisson exponent kappa)."
        },
        "rovg": {
          "type": "unknown",
          "units": "m/K",
          "description": "r_d/g (the scale-height factor)."
        },
        "c2": {
          "type": "unknown",
          "units": "J/(kg*K)",
          "description": "cp rcv."
        },
        "cpovcv": {
          "type": "unknown",
          "units": "1",
          "description": "cp/cv (gamma)."
        },
        "cvovcp": {
          "type": "unknown",
          "units": "1",
          "description": "cv/cp (1/gamma)."
        },
        "rvovrd": {
          "type": "unknown",
          "units": "1",
          "description": "r_v/r_d."
        },
        "ep_1": {
          "type": "unknown",
          "units": "1",
          "description": "r_v/r_d - 1, the virtual-temperature factor (WRF also names this p608)."
        },
        "ep_2": {
          "type": "unknown",
          "units": "1",
          "description": "r_d/r_v, the ratio of molecular weights (0.622)."
        },
        "reradius": {
          "type": "unknown",
          "units": "1/m",
          "description": "Reciprocal of Earth radius."
        },
        "degrad": {
          "type": "unknown",
          "units": "1",
          "description": "Radians per degree, pi/180."
        }
      },
      "equations": [
        {
          "lhs": "cp",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  7,
                  "r_d"
                ]
              },
              2
            ]
          }
        },
        {
          "lhs": "cv",
          "rhs": {
            "op": "-",
            "args": [
              "cp",
              "r_d"
            ]
          }
        },
        {
          "lhs": "cpv",
          "rhs": {
            "op": "*",
            "args": [
              4,
              "r_v"
            ]
          }
        },
        {
          "lhs": "cvv",
          "rhs": {
            "op": "-",
            "args": [
              "cpv",
              "r_v"
            ]
          }
        },
        {
          "lhs": "cvpm",
