            "op": "-",
            "args": [
              {
                "op": "/",
                "args": [
                  "cv",
                  "cp"
                ]
              }
            ]
          }
        },
        {
          "lhs": "rcv",
          "rhs": {
            "op": "/",
            "args": [
              "r_d",
              "cv"
            ]
          }
        },
        {
          "lhs": "rcp",
          "rhs": {
            "op": "/",
            "args": [
              "r_d",
              "cp"
            ]
          }
        },
        {
          "lhs": "rovg",
          "rhs": {
            "op": "/",
            "args": [
              "r_d",
              "g"
            ]
          }
        },
        {
          "lhs": "c2",
          "rhs": {
            "op": "*",
            "args": [
              "cp",
              "rcv"
            ]
          }
        },
        {
          "lhs": "cpovcv",
          "rhs": {
            "op": "/",
            "args": [
              "cp",
              "cv"
            ]
          }
        },
        {
          "lhs": "cvovcp",
          "rhs": {
            "op": "/",
            "args": [
              1,
              "cpovcv"
            ]
          }
        },
        {
          "lhs": "rvovrd",
          "rhs": {
            "op": "/",
            "args": [
              "r_v",
              "r_d"
            ]
          }
        },
        {
          "lhs": "ep_1",
          "rhs": {
            "op": "-",
            "args": [
              "rvovrd",
              1
            ]
          }
        },
        {
          "lhs": "ep_2",
          "rhs": {
            "op": "/",
            "args": [
              "r_d",
              "r_v"
            ]
          }
        },
        {
          "lhs": "reradius",
          "rhs": {
            "op": "/",
            "args": [
              1,
              "r_earth"
            ]
          }
        },
        {
          "lhs": "degrad",
          "rhs": {
            "op": "/",
            "args": [
              "piconst",
              180
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "derived_constants_match_fortran",
          "description": "Derived constants evaluated from the WRF Fortran expressions in double precision (r_d = 287, r_v = 461.6, g = 9.81) by tools/ (python, binary64). Values are exact to binary64 rounding; tolerance 1e-12 relative.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "tolerance": {
            "rel": 1e-12
          },
          "assertions": [
            {
              "variable": "cp",
              "time": 0.0,
              "expected": 1004.5
            },
            {
              "variable": "cv",
              "time": 0.0,
              "expected": 717.5
            },
            {
              "variable": "cpv",
              "time": 0.0,
              "expected": 1846.4
            },
            {
              "variable": "cvv",
              "time": 0.0,
              "expected": 1384.8000000000002
            },
            {
              "variable": "rcp",
              "time": 0.0,
              "expected": 0.2857142857142857
            },
            {
              "variable": "rcv",
              "time": 0.0,
              "expected": 0.4
            },
            {
              "variable": "rovg",
              "time": 0.0,
              "expected": 29.25586136595311
            },
            {
              "variable": "cpovcv",
              "time": 0.0,
              "expected": 1.4
            },
            {
              "variable": "ep_1",
              "time": 0.0,
              "expected": 0.6083623693379792
            },
            {
              "variable": "ep_2",
              "time": 0.0,
              "expected": 0.6217504332755632
            },
            {
              "variable": "reradius",
              "time": 0.0,
              "expected": 1.5698587127158556e-07
            },
            {
              "variable": "degrad",
              "time": 0.0,
              "expected": 0.017453292519943295
            }
          ]
        }
      ]
    }
  }
}
