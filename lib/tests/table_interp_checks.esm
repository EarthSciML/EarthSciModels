       3.0,
       -1.0,
       2.0,
       2.5,
       10.0
      ],
      [
       1.0,
       4.0,
       -2.0,
       0.5,
       6.0
      ]
     ],
     "description": "Run-time per-row table table[row, k]: a 2 x 5 shaped parameter."
    },
    "axis_o": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "ax"
     ],
     "default": 0.0,
     "description": "Observed 1-D axis computed from a parameter: 0.5 axis_dbl_p (exact in binary64, equal to axis_p)."
    },
    "table_o": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "ax"
     ],
     "default": 0.0,
     "description": "Observed 1-D table computed from a parameter: 2 table_half_p (exact, equal to table_p's default)."
    },
    "table2_o": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "ax",
      "ay"
     ],
     "default": 0.0,
     "description": "Observed 5 x 3 table computed from a parameter: 2 table2_half_p (exact)."
    },
    "f_closed": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "std linear (esm:std/interp.esm) on the const 1-D table: the reference."
    },
    "g_closed": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "std bilinear on the const 5 x 3 table: the reference."
    },
    "h_closed": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "std linear on the const row 2 of the per-row table and axis: the reference for h_row."
    },
    "i_row": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "bracket_index_in_row on row 2 of a 2 x 5 const axis table, whose rows differ: the number of that row's entries at or below x, held to [1, 4]."
    },
    "i_p": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "bracket_index on the shaped-parameter axis axis_p: one bracket, shared by f_par and f_shared."
    },
    "f_par": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "interp_linear_bracketed on the shaped parameters table_p, axis_p with the shared bracket i_p."
    },
    "f_shared": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "interp_linear_bracketed on a second table (the observed table_o) over the same axis and the same bracket i_p: the bracket computed once, used for two tables."
    },
    "i_o": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "bracket_index on the observed axis axis_o."
    },
    "j_p": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "bracket_index on the shaped-parameter y axis axis_y_p."
    },
    "f_obs": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "interp_linear_bracketed on the observeds table_o, axis_o with bracket i_o."
    },
    "g_obs": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "interp_bilinear_bracketed on the observed table2_o over the observed x axis axis_o and the parameter y axis axis_y_p, with brackets i_o, j_p."
    },
    "i_row_p": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "bracket_index_in_row on row 2 of the shaped-parameter axis axis_rows_p."
    },
    "h_row": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "description": "interp_linear_bracketed_in_row on row 2 of the shaped parameters table_rows_p, axis_rows_p with bracket i_row_p."
    }
