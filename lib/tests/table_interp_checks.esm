{
 "esm": "2.0.0",
 "metadata": {
  "name": "TableInterpChecks",
  "description": "Checks for lib/table_interp.esm. A template library cannot carry inline tests, so this 0-D component applies the library's templates to RUN-TIME tables and axes -- shaped parameters with array defaults (axis_p, table_p, axis_y_p, axis_rows_p, table_rows_p) and observeds computed from parameters (axis_o, table_o, table2_o, exact binary64 rescalings of parameters) -- and evaluates the standard-library templates `linear` and `bilinear` of esm:std/interp.esm on equal literal const tables beside them as the reference: a 5-point axis with unequal spacing, a 5 x 3 table, and a 2 x 5 per-row axis and table whose rows differ. Covered: bracket_index computed once as an observed and shared by two tables (f_par, f_shared), interp_linear_bracketed and interp_bilinear_bracketed on parameters and on observeds, and the per-row forms bracket_index_in_row and interp_linear_bracketed_in_row (through it, bracket_weight_in_row). The ten query points cover both clamps on each axis (below the first and above the last entry), knots, both axis ends exactly, and interior points; a further test overrides the run-time table between runs. Expected values are std's formulas evaluated in binary64 (bracket, weight, then lo + w (hi - lo)); the tolerance is EXACT (abs 0, rel 0), because the library's purpose is bit-identity with std for the lookups std's single-lookup templates do not cover.",
  "license": "MIT",
  "tags": [
   "interpolation",
   "test"
  ]
 },
 "index_sets": {
  "ax": {
   "kind": "interval",
   "size": 5
  },
  "ay": {
   "kind": "interval",
   "size": 3
  },
  "rows": {
   "kind": "interval",
   "size": 2
  }
 },
 "models": {
  "TableInterpChecks": {
   "expression_template_imports": [
    {
     "ref": "../table_interp.esm"
    },
    {
     "ref": "esm:std/interp.esm",
     "only": [
      "linear",
      "bilinear"
     ]
    }
   ],
   "variables": {
    "x": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Query point on the first axis."
    },
    "y": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Query point on axis_y."
    },
    "axis_p": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "ax"
     ],
     "default": [
      0.0,
      1.0,
      2.5,
      4.0,
      7.0
     ],
     "description": "Run-time 1-D axis: a shaped parameter (unequal spacing), equal to the const axis the std references use."
    },
    "table_p": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "ax"
     ],
     "default": [
      3.0,
      -1.0,
      2.0,
      2.5,
      10.0
     ],
     "description": "Run-time 1-D table: a shaped parameter, equal to the const table the std reference f_closed uses (overridden in test runtime_table_override)."
    },
    "axis_y_p": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "ay"
     ],
     "default": [
      0.0,
      2.0,
      5.0
     ],
     "description": "Run-time y axis of the 2-D table: a shaped parameter."
    },
    "axis_dbl_p": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "ax"
     ],
     "default": [
      0.0,
      2.0,
      5.0,
      8.0,
      14.0
     ],
     "description": "Twice the 1-D axis; axis_o halves it."
    },
    "table_half_p": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "ax"
     ],
     "default": [
      1.5,
      -0.5,
      1.0,
      1.25,
      5.0
     ],
     "description": "Half the 1-D table; table_o doubles it."
    },
    "table2_half_p": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "ax",
      "ay"
     ],
     "default": [
      [
       0.5,
       1.0,
       2.0
      ],
      [
       0.25,
       1.5,
       -1.0
      ],
      [
       1.0,
       1.0,
       3.0
      ],
      [
       0.5,
       0.0,
       0.5
      ],
      [
       3.5,
       -1.5,
       2.5
      ]
     ],
     "description": "Half the 5 x 3 table; table2_o doubles it."
    },
    "axis_rows_p": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "rows",
      "ax"
     ],
     "default": [
