{
 "esm": "1.2.0",
 "metadata": {
  "name": "TableInterpChecks",
  "description": "Checks for lib/table_interp.esm. A template library cannot carry inline tests, so this 0-D component applies interp_linear_table and interp_bilinear_table to literal const tables -- a 5-point axis with unequal spacing and a 5 x 3 table -- and evaluates the closed functions interp.linear and interp.bilinear (esm-spec section 9.2) on the same tables beside them. The ten query points cover both clamps on each axis (below the first and above the last entry), knots, both axis ends exactly, and interior points. Expected values are the section 9.2 formulas evaluated in binary64 (bracket, weight, then lo + w (hi - lo)); the tolerance is EXACT (abs 0, rel 0), because the library's purpose is bit-identity with the closed functions for tables they cannot take.",
  "license": "MIT",
  "tags": ["interpolation", "test"]
 },
 "models": {
  "TableInterpChecks": {
   "expression_template_imports": [{"ref": "../table_interp.esm"}],
   "variables": {
    "x": {"type": "parameter", "units": "1", "default": 0.0, "description": "Query point on axis_x."},
    "y": {"type": "parameter", "units": "1", "default": 0.0, "description": "Query point on axis_y."},
    "f_table": {"type": "unknown", "units": "1", "description": "interp_linear_table of lib/table_interp.esm."},
    "f_closed": {"type": "unknown", "units": "1", "description": "The closed function interp.linear on the same const table."},
    "g_table": {"type": "unknown", "units": "1", "description": "interp_bilinear_table of lib/table_interp.esm."},
    "g_closed": {"type": "unknown", "units": "1", "description": "The closed function interp.bilinear on the same const table."}
   },
   "equations": [
    {
     "lhs": "f_table",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "interp_linear_table",
      "bindings": {
       "table": {"op": "const", "args": [], "value": [3.0, -1.0, 2.0, 2.5, 10.0]},
       "axis": {"op": "const", "args": [], "value": [0.0, 1.0, 2.5, 4.0, 7.0]},
       "x": "x",
       "n": 5
      }
     }
    },
    {
     "lhs": "f_closed",
     "rhs": {
      "op": "fn",
      "name": "interp.linear",
      "args": [{"op": "const", "args": [], "value": [3.0, -1.0, 2.0, 2.5, 10.0]}, {"op": "const", "args": [], "value": [0.0, 1.0, 2.5, 4.0, 7.0]}, "x"]
     }
    },
    {
     "lhs": "g_table",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "interp_bilinear_table",
      "bindings": {
       "table": {"op": "const", "args": [], "value": [[1.0, 2.0, 4.0], [0.5, 3.0, -2.0], [2.0, 2.0, 6.0], [1.0, 0.0, 1.0], [7.0, -3.0, 5.0]]},
       "axis_x": {"op": "const", "args": [], "value": [0.0, 1.0, 2.5, 4.0, 7.0]},
       "axis_y": {"op": "const", "args": [], "value": [0.0, 2.0, 5.0]},
       "x": "x",
       "y": "y",
       "nx": 5,
       "ny": 3
      }
     }
    },
    {
     "lhs": "g_closed",
     "rhs": {
      "op": "fn",
      "name": "interp.bilinear",
      "args": [
       {"op": "const", "args": [], "value": [[1.0, 2.0, 4.0], [0.5, 3.0, -2.0], [2.0, 2.0, 6.0], [1.0, 0.0, 1.0], [7.0, -3.0, 5.0]]},
       {"op": "const", "args": [], "value": [0.0, 1.0, 2.5, 4.0, 7.0]},
       {"op": "const", "args": [], "value": [0.0, 2.0, 5.0]},
       "x",
       "y"
      ]
     }
    }
   ],
   "tests": [
    {
     "id": "query_0",
     "description": "x = -1.0, y = -1.0.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": -1.0, "y": -1.0},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 3.0},
      {"variable": "f_closed", "time": 0.0, "expected": 3.0},
      {"variable": "g_table", "time": 0.0, "expected": 1.0},
      {"variable": "g_closed", "time": 0.0, "expected": 1.0}
     ]
    },
    {
     "id": "query_1",
     "description": "x = 0.0, y = 0.0.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 0.0, "y": 0.0},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 3.0},
      {"variable": "f_closed", "time": 0.0, "expected": 3.0},
      {"variable": "g_table", "time": 0.0, "expected": 1.0},
      {"variable": "g_closed", "time": 0.0, "expected": 1.0}
     ]
    },
    {
     "id": "query_2",
     "description": "x = 0.4, y = 1.0.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 0.4, "y": 1.0},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 1.4},
      {"variable": "f_closed", "time": 0.0, "expected": 1.4},
      {"variable": "g_table", "time": 0.0, "expected": 1.6},
      {"variable": "g_closed", "time": 0.0, "expected": 1.6}
     ]
    },
    {
     "id": "query_3",
     "description": "x = 1.0, y = 2.0.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 1.0, "y": 2.0},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": -1.0},
      {"variable": "f_closed", "time": 0.0, "expected": -1.0},
      {"variable": "g_table", "time": 0.0, "expected": 3.0},
      {"variable": "g_closed", "time": 0.0, "expected": 3.0}
     ]
    },
    {
     "id": "query_4",
     "description": "x = 2.5, y = 3.3.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 2.5, "y": 3.3},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 2.0},
      {"variable": "f_closed", "time": 0.0, "expected": 2.0},
      {"variable": "g_table", "time": 0.0, "expected": 3.7333333333333334},
      {"variable": "g_closed", "time": 0.0, "expected": 3.7333333333333334}
     ]
    },
    {
     "id": "query_5",
     "description": "x = 3.1, y = 5.0.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 3.1, "y": 5.0},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 2.2},
      {"variable": "f_closed", "time": 0.0, "expected": 2.2},
      {"variable": "g_table", "time": 0.0, "expected": 3.9999999999999996},
      {"variable": "g_closed", "time": 0.0, "expected": 3.9999999999999996}
     ]
    },
    {
     "id": "query_6",
     "description": "x = 4.0, y = 6.0.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 4.0, "y": 6.0},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 2.5},
      {"variable": "f_closed", "time": 0.0, "expected": 2.5},
      {"variable": "g_table", "time": 0.0, "expected": 1.0},
      {"variable": "g_closed", "time": 0.0, "expected": 1.0}
     ]
    },
    {
     "id": "query_7",
     "description": "x = 5.5, y = 4.9.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 5.5, "y": 4.9},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 6.25},
      {"variable": "f_closed", "time": 0.0, "expected": 6.25},
      {"variable": "g_table", "time": 0.0, "expected": 2.8500000000000005},
      {"variable": "g_closed", "time": 0.0, "expected": 2.8500000000000005}
     ]
    },
    {
     "id": "query_8",
     "description": "x = 7.0, y = 0.5.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 7.0, "y": 0.5},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 10.0},
      {"variable": "f_closed", "time": 0.0, "expected": 10.0},
      {"variable": "g_table", "time": 0.0, "expected": 4.5},
      {"variable": "g_closed", "time": 0.0, "expected": 4.5}
     ]
    },
    {
     "id": "query_9",
     "description": "x = 9.0, y = 2.0.",
     "time_span": {"start": 0.0, "end": 0.0},
     "tolerance": {"rel": 0.0, "abs": 0.0},
     "parameter_overrides": {"x": 9.0, "y": 2.0},
     "assertions": [
      {"variable": "f_table", "time": 0.0, "expected": 10.0},
      {"variable": "f_closed", "time": 0.0, "expected": 10.0},
      {"variable": "g_table", "time": 0.0, "expected": -3.0},
      {"variable": "g_closed", "time": 0.0, "expected": -3.0}
     ]
    }
   ]
  }
 }
}
