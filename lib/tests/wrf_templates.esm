{
  "esm": "1.0.0",
  "metadata": {
    "name": "WRFTemplateChecks",
    "description": "Checks for the expression templates of lib/wrf_thermo.esm and lib/wrf_air_properties.esm. A template-library file cannot carry inline tests, so this 0-D component mounts lib/wrf_constants.esm, imports both libraries and applies every template once to fixed inputs (T = 283 K, p = 850 hPa, qv = 8 g/kg, ...), binding the constants the way the WRF schemes do. The expected values are the WRF Fortran expressions (WSM6 fpvs, xlcal, cpmcal, viscos, diffus, xka; YSU thlix and rvls; calc_p_rho_phi; Bolton e_s) written out independently in Python and evaluated in binary64, plus the identities that anchor each fit: fpvs(ttp) = psat, L(T_ref) = xlv and theta -> T -> theta. Tolerance 1e-10 relative, to allow libm differences in exp, log and pow.",
    "tags": [
      "wrf",
      "thermodynamics",
      "expression-templates",
      "tests"
    ],
    "created": "2026-10-15T00:00:00Z",
    "authors": [
      "EqWeFiC"
    ]
  },
  "models": {
    "WRFTemplateChecks": {
      "expression_template_imports": [
        {
          "ref": "../wrf_thermo.esm"
        },
        {
          "ref": "../wrf_air_properties.esm"
        }
      ],
      "subsystems": {
        "wrf": {
          "ref": "../wrf_constants.esm"
        }
      },
      "variables": {
        "T": {
          "type": "parameter",
          "units": "K",
          "default": 283.0,
          "description": "Test input T."
        },
        "p": {
          "type": "parameter",
          "units": "Pa",
          "default": 85000.0,
          "description": "Test input p."
        },
        "qv": {
          "type": "parameter",
          "units": "kg/kg",
          "default": 0.008,
          "description": "Test input qv."
        },
        "qc": {
          "type": "parameter",
          "units": "kg/kg",
          "default": 0.0002,
          "description": "Test input qc."
        },
        "qi": {
          "type": "parameter",
          "units": "kg/kg",
          "default": 5e-05,
          "description": "Test input qi."
        },
        "theta": {
          "type": "parameter",
          "units": "K",
          "default": 295.0,
          "description": "Test input theta."
        },
        "ttp": {
          "type": "parameter",
          "units": "K",
          "default": 273.16,
          "description": "Test input ttp."
        },
        "theta_m": {
          "type": "parameter",
          "units": "K",
          "default": 303.0,
          "description": "Test input theta_m."
        },
        "alpha_d": {
          "type": "parameter",
          "units": "m^3/kg",
          "default": 0.95,
          "description": "Test input alpha_d."
        },
        "rho": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1.1,
          "description": "Test input rho."
        },
        "exner": {
          "type": "unknown",
          "units": "1",
          "description": "exner_function at p with p0 = p1000mb, kappa = rcp."
        },
        "T_from_theta": {
          "type": "unknown",
          "units": "K",
          "description": "temperature_from_theta: theta pi."
        },
        "theta_roundtrip": {
          "type": "unknown",
          "units": "K",
          "description": "theta_from_temperature(temperature_from_theta(theta)) recovers theta."
        },
        "theta_of_T": {
          "type": "unknown",
          "units": "K",
          "description": "theta_from_temperature: T / pi."
        },
        "theta_v": {
          "type": "unknown",
          "units": "K",
          "description": "virtual_potential_temperature."
        },
        "theta_li": {
          "type": "unknown",
          "units": "K",
          "description": "liquid_ice_potential_temperature, against YSU's (tx - xlv qc/cp - xls qi/cp)/pi."
        },
        "rho_moist": {
          "type": "unknown",
          "units": "kg/m^3",
          "description": "moist_air_density."
        },
        "xa": {
          "type": "unknown",
          "units": "1",
          "description": "fpvs_exponent_a over water: -(cpv - cliq)/r_v."
        },
        "xb": {
          "type": "unknown",
          "units": "1",
          "description": "fpvs_exponent_b over water: xa + xlv/(r_v ttp)."
        },
        "es_fpvs": {
          "type": "unknown",
          "units": "Pa",
          "description": "saturation_vapor_pressure_fpvs over water at T, against WSM6's psat exp(log(tr) xa) exp(xb (1 - tr)), tr = ttp/T."
        },
        "es_fpvs_at_ttp": {
          "type": "unknown",
          "units": "Pa",
          "description": "saturation_vapor_pressure_fpvs at T = ttp equals psat, the anchor of the fit."
        },
        "qsat_fpvs": {
          "type": "unknown",
          "units": "kg/kg",
          "description": "saturation_mixing_ratio from es_fpvs."
        },
        "xl": {
          "type": "unknown",
          "units": "J/kg",
          "description": "latent_heat_of_vaporization with WSM6's bindings (T_ref = svpt0)."
        },
        "xl_at_ref": {
          "type": "unknown",
          "units": "J/kg",
          "description": "latent_heat_of_vaporization at T = T_ref equals xlv."
        },
        "cpm": {
          "type": "unknown",
          "units": "J/(kg*K)",
          "description": "moist_heat_capacity (WSM6 cpmcal)."
        },
        "es_bolton": {
          "type": "unknown",
          "units": "Pa",
          "description": "bolton_saturation_vapor_pressure with svp1_pa, so in Pa."
        },
        "qsat_bolton": {
          "type": "unknown",
          "units": "kg/kg",
          "description": "saturation_mixing_ratio from es_bolton with p in Pa (sfclayrev's form, with pressures in Pa rather than kPa)."
        },
        "rvls": {
          "type": "unknown",
          "units": "kg/kg",
          "description": "bolton_saturation_mixing_ratio against bl_ysu.F90's rvls with T0 = 273.16 and es0 = 611.2 Pa."
        },
        "rho_dry": {
          "type": "unknown",
          "units": "kg/m^3",
          "description": "dry_air_density."
        },
        "theta_dry": {
          "type": "unknown",
          "units": "K",
          "description": "moist_theta_to_dry_theta."
        },
        "p_eos": {
          "type": "unknown",
          "units": "Pa",
          "description": "wrf_equation_of_state against calc_p_rho_phi."
        },
        "rho_total": {
          "type": "unknown",
          "units": "kg/m^3",
          "description": "moist_density_from_inverse_dry_density."
        },
        "nu": {
          "type": "unknown",
          "units": "m^2/s",
          "description": "kinematic_viscosity_of_air against WSM6 viscos(t, den) = 1.496e-6 t**1.5/(t + 120)/den."
        },
        "Dv": {
          "type": "unknown",
          "units": "m^2/s",
          "description": "diffusivity_of_water_vapor against WSM6 diffus(t, p) = 8.794e-5 t**1.81/p."
        },
        "ka": {
          "type": "unknown",
          "units": "J/(m*s*K)",
          "description": "thermal_conductivity_of_air against WSM6 xka(t, den) = 1.414e3 viscos(t, den) den."
        }
      },
      "equations": [
        {
          "lhs": "exner",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "exner_function",
            "bindings": {
              "p": "p",
              "p0": "wrf.p1000mb",
              "kappa": "wrf.rcp"
            }
          }
        },
        {
          "lhs": "T_from_theta",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "temperature_from_theta",
            "bindings": {
              "theta": "theta",
              "exner": "exner"
            }
          }
        },
        {
          "lhs": "theta_roundtrip",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "theta_from_temperature",
            "bindings": {
              "T": "T_from_theta",
              "exner": "exner"
            }
          }
        },
        {
          "lhs": "theta_of_T",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "theta_from_temperature",
            "bindings": {
              "T": "T",
              "exner": "exner"
            }
          }
        },
        {
          "lhs": "theta_v",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "virtual_potential_temperature",
            "bindings": {
              "theta": "theta",
              "qv": "qv",
              "ep_1": "wrf.ep_1"
            }
          }
        },
        {
          "lhs": "theta_li",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "liquid_ice_potential_temperature",
            "bindings": {
              "theta": "theta",
              "qc": "qc",
              "qi": "qi",
              "exner": "exner",
              "xlv": "wrf.xlv",
              "xls": "wrf.xls",
              "cp": "wrf.cp"
            }
          }
        },
        {
          "lhs": "rho_moist",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "moist_air_density",
            "bindings": {
              "p": "p",
              "T": "T",
              "qv": "qv",
              "r_d": "wrf.r_d",
              "ep_1": "wrf.ep_1"
            }
          }
        },
        {
          "lhs": "xa",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "fpvs_exponent_a",
            "bindings": {
              "c_vapor": "wrf.cpv",
              "c_condensate": "wrf.cliq",
              "r_v": "wrf.r_v"
            }
          }
        },
        {
          "lhs": "xb",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "fpvs_exponent_b",
            "bindings": {
              "xa": "xa",
              "L": "wrf.xlv",
              "r_v": "wrf.r_v",
              "ttp": "ttp"
            }
          }
        },
        {
          "lhs": "es_fpvs",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "saturation_vapor_pressure_fpvs",
            "bindings": {
              "T": "T",
              "psat": "wrf.psat",
              "ttp": "ttp",
              "xa": "xa",
              "xb": "xb"
            }
          }
        },
        {
          "lhs": "es_fpvs_at_ttp",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "saturation_vapor_pressure_fpvs",
            "bindings": {
              "T": "ttp",
              "psat": "wrf.psat",
              "ttp": "ttp",
              "xa": "xa",
              "xb": "xb"
            }
          }
        },
        {
          "lhs": "qsat_fpvs",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "saturation_mixing_ratio",
            "bindings": {
              "es": "es_fpvs",
              "p": "p",
              "ep_2": "wrf.ep_2"
            }
          }
        },
        {
          "lhs": "xl",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "latent_heat_of_vaporization",
            "bindings": {
              "T": "T",
              "xlv": "wrf.xlv",
              "cliq": "wrf.cliq",
              "cpv": "wrf.cpv",
              "T_ref": "wrf.svpt0"
            }
          }
        },
        {
          "lhs": "xl_at_ref",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "latent_heat_of_vaporization",
            "bindings": {
              "T": "wrf.svpt0",
              "xlv": "wrf.xlv",
              "cliq": "wrf.cliq",
              "cpv": "wrf.cpv",
              "T_ref": "wrf.svpt0"
            }
          }
        },
        {
          "lhs": "cpm",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "moist_heat_capacity",
            "bindings": {
              "qv": "qv",
              "cp": "wrf.cp",
              "cpv": "wrf.cpv"
            }
          }
        },
        {
          "lhs": "es_bolton",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "bolton_saturation_vapor_pressure",
            "bindings": {
              "T": "T",
              "svp1": "wrf.svp1_pa",
              "svp2": "wrf.svp2",
              "svp3": "wrf.svp3",
              "svpt0": "wrf.svpt0"
            }
          }
        },
        {
          "lhs": "qsat_bolton",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "saturation_mixing_ratio",
            "bindings": {
              "es": "es_bolton",
              "p": "p",
              "ep_2": "wrf.ep_2"
            }
          }
        },
        {
          "lhs": "rvls",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "bolton_saturation_mixing_ratio",
            "bindings": {
              "T": "T",
              "T0": 273.16,
              "p": "p",
              "es0": 611.2,
              "a": 17.67,
              "b": 29.65,
              "ep_2": "wrf.ep_2"
            }
          }
        },
        {
          "lhs": "rho_dry",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "dry_air_density",
            "bindings": {
              "p": "p",
              "T": "T",
              "r_d": "wrf.r_d"
            }
          }
        },
        {
          "lhs": "theta_dry",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "moist_theta_to_dry_theta",
            "bindings": {
              "theta_m": "theta_m",
              "qv": "qv",
              "rvovrd": "wrf.rvovrd"
            }
          }
        },
        {
          "lhs": "p_eos",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "wrf_equation_of_state",
            "bindings": {
              "theta_m": "theta_m",
              "alpha_d": "alpha_d",
              "p0": "wrf.p1000mb",
              "r_d": "wrf.r_d",
              "cpovcv": "wrf.cpovcv"
            }
          }
        },
        {
          "lhs": "rho_total",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "moist_density_from_inverse_dry_density",
            "bindings": {
              "qv": "qv",
              "alpha_d": "alpha_d"
            }
          }
        },
        {
          "lhs": "nu",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "kinematic_viscosity_of_air",
            "bindings": {
              "T": "T",
              "rho": "rho",
              "coef": 1.496e-06,
              "T_sutherland": 120.0
            }
          }
        },
        {
          "lhs": "Dv",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "diffusivity_of_water_vapor",
            "bindings": {
              "T": "T",
              "p": "p",
              "coef": 8.794e-05,
              "expn": 1.81
            }
          }
        },
        {
          "lhs": "ka",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "thermal_conductivity_of_air",
            "bindings": {
              "nu": "nu",
              "rho": "rho",
              "coef": 1414.0
            }
          }
        }
      ],
      "tests": [
        {
          "id": "templates_match_fortran",
          "description": "Every template against its WRF Fortran expression evaluated in binary64 (generator: lib/tests/gen_wrf_templates.py).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
