{
 "esm": "1.2.0",
 "metadata": {
  "name": "WRFDegradAngles",
  "description": "Checks that wrf.degrad (lib/wrf_constants.esm) converts degrees to radians exactly once when its product with an angle declared in degrees is handed to a trigonometric function. Since EarthSciAST #413 the transcendentals apply the declared scale of their argument, so the product angle_deg * degrad must carry units rad: degrad must be declared rad/deg. Declared dimensionless (\"1\"), the product is still typed deg and is converted a second time, so cos(60 deg * degrad) evaluates cos(0.01828 rad) = 0.99983 instead of 0.5. WRF's own module_model_constants.F carries no units, which is how the dimensionless declaration arose. Expected values are exact trigonometric identities.",
  "license": "MIT",
  "tags": ["wrf", "constants", "units", "test"]
 },
 "models": {
  "WRFDegradAngles": {
   "subsystems": {
    "wrf": {"ref": "../wrf_constants.esm"}
   },
   "variables": {
    "angle_deg": {"type": "parameter", "units": "deg", "default": 60.0, "description": "An angle in degrees, the way WRF carries latitudes, declinations and zenith angles."},
    "cos_angle": {"type": "unknown", "units": "1", "description": "cos(angle_deg * degrad), the form WRF writes (e.g. COS(XLAT*DEGRAD))."},
    "sin_angle": {"type": "unknown", "units": "1", "description": "sin(angle_deg * degrad)."}
   },
   "equations": [
    {"lhs": "cos_angle", "rhs": {"op": "cos", "args": [{"op": "*", "args": ["angle_deg", "wrf.degrad"]}]}},
    {"lhs": "sin_angle", "rhs": {"op": "sin", "args": [{"op": "*", "args": ["angle_deg", "wrf.degrad"]}]}}
   ],
   "tests": [
    {"id": "sixty_degrees", "description": "cos 60 deg = 1/2, sin 60 deg = sqrt(3)/2.", "time_span": {"start": 0.0, "end": 0.0}, "tolerance": {"rel": 1e-12},
     "parameter_overrides": {"angle_deg": 60.0},
     "assertions": [
      {"variable": "cos_angle", "time": 0.0, "expected": 0.5},
      {"variable": "sin_angle", "time": 0.0, "expected": 0.8660254037844386}
     ]},
    {"id": "ninety_degrees", "description": "sin 90 deg = 1; cos 90 deg = 0, checked absolutely.", "time_span": {"start": 0.0, "end": 0.0}, "tolerance": {"rel": 1e-12},
     "parameter_overrides": {"angle_deg": 90.0},
     "assertions": [
      {"variable": "sin_angle", "time": 0.0, "expected": 1.0},
      {"variable": "cos_angle", "time": 0.0, "expected": 0.0, "tolerance": {"abs": 1e-15}}
     ]}
   ]
  }
 }
}
