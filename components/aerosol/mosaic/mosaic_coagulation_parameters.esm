{
  "esm": "1.2.0",
  "metadata": {
    "name": "MosaicCoagulationParameters",
    "description": "The fixed numbers coagsolv carries for the Brownian kernel (chem/module_mosaic_coag.F, WRF v4.8.0). They are the routine's own CGS literals -- its Boltzmann constant is 1.38054e-16 erg/K and its Avogadro number 6.02252e23, both slightly different from the modern values and from lib/wrf_constants.esm, and reproducing coagsolv means using its.",
    "authors": [
      "EqWeFiC"
    ],
    "created": "2026-09-23T00:00:00Z",
    "tags": [
      "mosaic",
      "aerosol",
      "coagulation",
      "wrf-chem"
    ],
    "references": [
      {
        "citation": "Jacobson, M. Z. (2005). Fundamentals of Atmospheric Modeling, 2nd ed."
      }
    ]
  },
  "models": {
    "MosaicCoagulationParameters": {
      "variables": {
        "pi": {
          "type": "parameter",
          "units": "1",
          "default": 3.14159265358979,
          "description": "Pi as coagsolv spells it (`onepi`)."
        },
        "boltg": {
          "type": "parameter",
          "units": "erg/K",
          "default": 1.38054e-16,
          "description": "Boltzmann constant in CGS, coagsolv's own value."
        },
        "avogadro": {
          "type": "parameter",
          "units": "1/mol",
          "default": 6.02252e+23,
          "description": "Avogadro number, coagsolv's own value."
        },
        "mw_air": {
          "type": "parameter",
          "units": "g/mol",
          "default": 28.966,
          "description": "Molecular weight of dry air (`wtair`)."
        },
        "rgas_atm": {
          "type": "parameter",
          "units": "atm*L/(mol*K)",
          "default": 0.08206,
          "description": "Gas constant in atm-litre units (`rgas2`)."
        },
        "g_per_kg": {
          "type": "parameter",
          "units": "1",
          "default": 0.001,
          "description": "The 0.001 in `rho3 = patm*wtair*0.001/(rgas2*tk)`, which turns the litre-based gas constant and g/mol into g/cm^3."
        },
        "consmu": {
          "type": "parameter",
          "units": "g/(cm*s)*K",
          "default": 0.07626132000000001,
          "description": "The Sutherland numerator coagsolv precomputes, 1.8325e-4*(296.16 + 120)."
        },
        "sutherland_offset": {
          "type": "parameter",
          "units": "K",
          "default": 120.0,
          "description": "Sutherland offset."
        },
        "sutherland_tref": {
          "type": "parameter",
          "units": "K",
          "default": 296.16,
          "description": "Sutherland reference temperature."
        }
      },
      "equations": []
    }
  }
}