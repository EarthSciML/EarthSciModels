{
  "esm": "1.1.0",
  "metadata": {
    "name": "MosaicCoagulationTemplates",
    "description": "The per-particle quantities MOSAIC's Brownian coagulation kernel needs for ONE size bin, factored out because coagsolv evaluates them for both partners of every pair (chem/module_mosaic_coag.F, SUBROUTINE coagsolv, loop 145 of WRF v4.8.0). Each template takes the bin's wet radius and wet density plus the air state, so the pair-level file applies them twice rather than repeating the algebra.",
    "authors": [
      "EqWeFiC"
    ],
    "created": "2026-09-23T00:00:00Z",
    "tags": [
      "mosaic",
      "aerosol",
      "coagulation",
      "wrf-chem"
    ],
    "references": [
      {
        "citation": "Fuchs, N. A. (1964). The Mechanics of Aerosols. Pergamon Press (the transition-regime coagulation kernel and the particle mean free path)."
      },
      {
        "citation": "Jacobson, M. Z. (2005). Fundamentals of Atmospheric Modeling, 2nd ed. (the coagsolv solver this kernel was taken from)."
      }
    ]
  },
  "expression_templates": {
    "particle_diffusivity": {
      "params": [
        "radwet",
        "gmfp",
        "tk",
        "amu",
        "boltg",
        "onepi"
      ],
      "description": "Brownian diffusivity of a particle of wet radius radwet, Stokes-Einstein with the Cunningham slip correction bpm = 1 + Kn*(1.257 + 0.42*exp(-1.1/Kn)) (coagsolv loop 145).",
      "body": {
        "op": "/",
        "args": [
          {
            "op": "*",
            "args": [
              "boltg",
              "tk",
              {
                "op": "+",
                "args": [
                  1.0,
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          "gmfp",
                          "radwet"
                        ]
                      },
                      {
                        "op": "+",
                        "args": [
                          1.257,
                          {
                            "op": "*",
                            "args": [
                              0.42,
                              {
                                "op": "exp",
                                "args": [
                                  {
                                    "op": "/",
                                    "args": [
                                      -1.1,
                                      {
                                        "op": "/",
                                        "args": [
                                          "gmfp",
                                          "radwet"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              6.0,
              "onepi",
              "radwet",
              "amu"
            ]
          }
        ]
      }
    },
    "particle_thermal_speed": {
      "params": [
        "radwet",
        "denav",
        "volwet",
        "tk",
        "boltg",
        "onepi"
      ],
      "description": "Thermal speed of a particle, sqrt(8 k T / (pi * rho_wet * V_wet)) (coagsolv loop 145).",
      "body": {
        "op": "^",
        "args": [
          {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  8.0,
                  "boltg",
                  "tk"
                ]
              },
              {
                "op": "*",
                "args": [
                  "onepi",
                  "denav",
                  "volwet"
                ]
              }
            ]
          },
          0.5
        ]
      }
    },
    "particle_delta": {
      "params": [
        "radwet",
        "difcof",
        "vthermp",
        "onepi"
      ],
      "description": "Fuchs's transition-regime length delta, squared: with the particle mean free path pmfp = 8 D / (pi c), delta = (1/(6 r pmfp))*((2r + pmfp)^3 - (4r^2 + pmfp^2)^(3/2)) - 2r. coagsolv writes the 1/6 as the truncated literal 0.166667, which is kept here because it is visible at single precision.",
      "body": {
        "op": "^",
        "args": [
          {
            "op": "-",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      0.166667,
                      {
                        "op": "*",
                        "args": [
                          "radwet",
                          {
                            "op": "/",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  8.0,
                                  "difcof"
                                ]
                              },
                              {
                                "op": "*",
                                "args": [
                                  "onepi",
                                  "vthermp"
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "^",
                        "args": [
                          {
                            "op": "+",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  2.0,
                                  "radwet"
                                ]
                              },
                              {
                                "op": "/",
                                "args": [
                                  {
                                    "op": "*",
                                    "args": [
                                      8.0,
                                      "difcof"
                                    ]
                                  },
                                  {
                                    "op": "*",
                                    "args": [
                                      "onepi",
                                      "vthermp"
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          3.0
                        ]
                      },
                      {
                        "op": "^",
                        "args": [
                          {
                            "op": "+",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  4.0,
                                  "radwet",
                                  "radwet"
                                ]
                              },
                              {
                                "op": "*",
                                "args": [
                                  {
                                    "op": "/",
                                    "args": [
                                      {
                                        "op": "*",
                                        "args": [
                                          8.0,
                                          "difcof"
                                        ]
                                      },
                                      {
                                        "op": "*",
                                        "args": [
                                          "onepi",
                                          "vthermp"
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "op": "/",
                                    "args": [
                                      {
                                        "op": "*",
                                        "args": [
                                          8.0,
                                          "difcof"
                                        ]
                                      },
                                      {
                                        "op": "*",
                                        "args": [
                                          "onepi",
                                          "vthermp"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          1.5
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  2.0,
                  "radwet"
                ]
              }
            ]
          },
          2.0
        ]
      }
    }
  }
}