{
  "esm": "1.1.0",
  "metadata": {
    "name": "MosaicAerosolDryDeposition",
    "description": "MOSAIC's aerosol dry-deposition velocity for ONE size bin, as WRF-Chem computes it at `aer_drydep_opt = 1`: the wet-size and density preamble of mosaic_drydep_1clm and the Binkowski-Shankar kernel aerosol_depvel_2, both in chem/module_mosaic_drydep.F of WRF v4.8.0. The bins are independent of one another, so a consumer maps this component over its size bins rather than the component owning a bin index.\n\nWhat it takes and what it leaves to the consumer. The two composition sums MOSAIC performs first -- drymass = sum over components of rsub*mw_aer and dryvol = the same over dens_aer -- are a mapping across MOSAIC's species pointers rather than physics, so they are inputs here; everything from the wet size and density onwards is transcribed. The aerodynamic resistance and friction velocity come from the surface layer, and MOSAIC uses only the k = 1 (surface) level, so this is a surface-layer component.\n\nWhat cannot be pinned by the reference. WRF stores none of the intermediate quantities: the dump carries the per-bin deposition velocity and nothing between the inputs and it. So the tests assert `vdep`, and the twenty-odd intermediates (wet diameter, Schmidt and Stokes numbers, the two resistances) are transcribed but unasserted. Two branches are likewise unexercised by any WRF-Chem run: MOSAIC always passes alnsg = log(1) = 0, which collapses the moment-0 and moment-3 forms onto the monodisperse case and makes vsettl_0 = vsettl_3, and `depresist_unstabpblfact` is always 1.0. The moment-0 quantities are computed but never used by WRF for the deposition velocity.",
    "authors": [
      "EqWeFiC"
    ],
    "created": "2026-09-22T00:00:00Z",
    "tags": [
      "mosaic",
      "aerosol",
      "dry-deposition",
      "wrf-chem",
      "chem_opt-170"
    ],
    "references": [
      {
        "citation": "Binkowski, F. S. and Shankar, U. (1995). The Regional Particulate Matter Model 1. Model description and preliminary results. J. Geophys. Res. 100(D12), 26191-26209 (Eq. A33, the resistance sum this kernel uses)."
      },
      {
        "citation": "Zaveri, R. A., Easter, R. C., Fast, J. D. and Peters, L. K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). J. Geophys. Res. 113, D13204."
      }
    ]
  },
  "models": {
    "MosaicAerosolDryDeposition": {
      "subsystems": {
        "par": {
          "ref": "./mosaic_drydep_parameters.esm"
        }
      },
      "variables": {
        "temp": {
          "type": "parameter",
          "units": "K",
          "default": 305.6,
          "description": "Air temperature, MOSAIC's `rsub(ktemp,1,1)` at the surface level."
        },
        "cair": {
          "type": "parameter",
          "units": "mol/cm^3",
          "default": 3.9e-05,
          "description": "Air molar density at the surface level, `cairclm(1)`."
        },
        "ustar_in": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.026,
          "description": "Friction velocity from the surface layer, WRF's `ust`."
        },
        "aer_res_in": {
          "type": "parameter",
          "units": "s/m",
          "default": 18.2,
          "description": "Aerodynamic resistance from the dry-deposition driver, WRF's `aer_res`."
        },
        "drymass": {
          "type": "parameter",
          "units": "g/mol",
          "default": 1.2e-10,
          "description": "Dry aerosol mass of this bin per mole of air, MOSAIC's `drymass` = sum over components of rsub*mw_aer. The sum itself is a mapping over MOSAIC's species pointers, not physics, so it is the consumer's; see the model description."
        },
        "dryvol": {
          "type": "parameter",
          "units": "cm^3/mol",
          "default": 8.18e-11,
          "description": "Dry aerosol volume of this bin per mole of air, `dryvol` = sum of rsub*mw_aer/dens_aer."
        },
        "q_water": {
          "type": "parameter",
          "units": "mol/mol",
          "default": 1.78e-12,
          "description": "Aerosol water of this bin, `rsub(waterptr_aer)`."
        },
        "q_num": {
          "type": "parameter",
          "units": "1/mol",
          "default": 915000.0,
          "description": "Number concentration of this bin, `rsub(numptr_aer)`, particles per mole of air."
        },
        "d_cen": {
          "type": "parameter",
          "units": "cm",
          "default": 5.5e-06,
          "description": "Bin centre diameter, `dcen_sect`."
        },
        "d_lo": {
          "type": "parameter",
          "units": "cm",
          "default": 3.9e-06,
          "description": "Bin lower diameter bound, `dlo_sect`."
        },
        "d_hi": {
          "type": "parameter",
          "units": "cm",
          "default": 7.8e-06,
          "description": "Bin upper diameter bound, `dhi_sect`."
        },
        "volum_lo": {
          "type": "parameter",
          "units": "cm^3",
          "default": 3.12e-17,
          "description": "Single-particle volume at the bin's lower bound, `volumlo_sect`."
        },
        "volum_hi": {
          "type": "parameter",
          "units": "cm^3",
          "default": 2.5e-16,
          "description": "Single-particle volume at the bin's upper bound, `volumhi_sect`."
        },
        "mw_water": {
          "type": "parameter",
          "units": "g/mol",
          "default": 18.0,
          "description": "Molecular weight of aerosol water, MOSAIC's `mw_water_aer`."
        },
        "dens_water": {
          "type": "parameter",
          "units": "g/cm^3",
          "default": 1.0,
          "description": "Density of aerosol water, `dens_water_aer`."
        },
        "alnsg": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "ln of the geometric standard deviation the deposition kernel is asked for. MOSAIC passes log(1.0) = 0 at every call, which collapses the moment-0 and moment-3 forms onto the monodisperse one; the general form is transcribed but is never exercised by WRF-Chem."
        },
        "unstable_pbl_fact": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "MOSAIC's `depresist_unstabpblfact`, which the routine sets to 1.0 unconditionally."
        },
        "airdens": {
          "type": "unknown",
          "units": "g/cm^3",
          "description": "Air mass density, cairclm*28.966 (module_mosaic_drydep.F:288)."
        },
        "airkinvisc": {
          "type": "unknown",
          "units": "cm^2/s",
          "description": "Air kinematic viscosity, Sutherland's law over the air density (:292)."
        },
        "freepath": {
          "type": "unknown",
          "units": "cm",
          "description": "Air molecular mean free path (:296)."
        },
        "ustar": {
          "type": "unknown",
          "units": "cm/s",
          "description": "Friction velocity in CGS."
        },
        "aer_res": {
          "type": "unknown",
          "units": "s/cm",
          "description": "Aerodynamic resistance in CGS."
        },
        "water_mass": {
          "type": "unknown",
          "units": "g/mol",
          "description": "Aerosol water mass of this bin, q_water*mw_water."
        },
        "wetmass_raw": {
          "type": "unknown",
          "units": "g/mol",
          "description": "drymass + water_mass, before the small-mass overrides."
        },
        "wetvol_raw": {
          "type": "unknown",
          "units": "cm^3/mol",
          "description": "dryvol + water_mass/dens_water, before the small-mass overrides."
        },
        "tiny_mass": {
          "type": "unknown",
          "units": "1",
          "description": "1 where drymass <= 1e-30 g/mol, the branch that falls back to the bin centre and a default density (:318)."
        },
        "small_mass": {
          "type": "unknown",
          "units": "1",
          "description": "1 where drymass <= 1e-20 g/mol, the branch that drops the aerosol water (:327)."
        },
        "wetmass": {
          "type": "unknown",
          "units": "g/mol",
          "description": "Wet mass after those overrides."
        },
        "wetvol": {
          "type": "unknown",
          "units": "cm^3/mol",
          "description": "Wet volume after those overrides."
        },
        "drydens_calc": {
          "type": "unknown",
          "units": "g/cm^3",
          "description": "drymass/dryvol."
        },
        "wetdens_calc": {
          "type": "unknown",
          "units": "g/cm^3",
          "description": "wetmass/wetvol."
        },
        "drydp_calc": {
          "type": "unknown",
          "units": "cm",
          "description": "Dry diameter from the bin's own volume and number, clamped to the bin bounds by the number test at :336-342."
        },
        "dumfact": {
          "type": "unknown",
          "units": "1",
          "description": "Wet-to-dry diameter ratio, (wetvol/dryvol)^(1/3), clamped to [1,10]; the 10 is also taken directly when wetvol exceeds 1000*dryvol (:345-352)."
        },
        "drydp": {
          "type": "unknown",
          "units": "cm",
          "description": "Dry diameter actually used."
        },
        "wetdp": {
          "type": "unknown",
          "units": "cm",
          "description": "Wet diameter actually used."
        },
        "wetdens": {
          "type": "unknown",
          "units": "g/cm^3",
          "description": "Wet density actually used."
        },
        "dgnum": {
          "type": "unknown",
          "units": "cm",
          "description": "The diameter handed to the deposition kernel, wetdp*exp(-1.5*alnsg^2) (:361)."
        },
        "alnsg2": {
          "type": "unknown",
          "units": "1",
          "description": "alnsg squared."
        },
        "xknudsenfact": {
          "type": "unknown",
          "units": "1",
          "description": "1.246 times the Knudsen number 2*freepath/dgnum."
        },
        "vsettl_dgnum": {
          "type": "unknown",
          "units": "cm/s",
          "description": "Stokes settling velocity at dgnum (module_mosaic_drydep.F, aerosol_depvel_2)."
        },
        "vsettl_0": {
          "type": "unknown",
          "units": "cm/s",
          "description": "Number-weighted (moment 0) settling velocity."
        },
        "vsettl_3": {
          "type": "unknown",
          "units": "cm/s",
          "description": "Mass-weighted (moment 3) settling velocity, the one the deposition velocity uses."
        },
        "aerodiffus_dgnum": {
          "type": "unknown",
          "units": "cm^2/s",
          "description": "Brownian diffusivity at dgnum (Stokes-Einstein with the slip correction)."
        },
        "aerodiffus_0": {
          "type": "unknown",
          "units": "cm^2/s",
          "description": "Moment-0 Brownian diffusivity."
        },
        "aerodiffus_3": {
          "type": "unknown",
          "units": "cm^2/s",
          "description": "Moment-3 Brownian diffusivity."
        },
        "schmidt_0": {
          "type": "unknown",
          "units": "1",
          "description": "Moment-0 Schmidt number."
        },
        "schmidt_3": {
          "type": "unknown",
          "units": "1",
          "description": "Moment-3 Schmidt number."
        },
        "stokes_0": {
          "type": "unknown",
          "units": "1",
          "description": "Moment-0 Stokes number."
        },
        "stokes_3": {
          "type": "unknown",
          "units": "1",
          "description": "Moment-3 Stokes number."
        },
        "fac_d0": {
          "type": "unknown",
          "units": "1",
          "description": "Moment-0 surface-collection factor, Sc^(-2/3) + 10^(-3/max(0.03,St))."
        },
        "fac_d3": {
          "type": "unknown",
          "units": "1",
          "description": "Moment-3 surface-collection factor."
        },
        "depresist_d0": {
          "type": "unknown",
          "units": "s/cm",
          "description": "Moment-0 quasi-laminar (surface) resistance."
        },
        "depresist_d3": {
          "type": "unknown",
          "units": "s/cm",
          "description": "Moment-3 quasi-laminar resistance."
        },
        "depvel_a3": {
          "type": "unknown",
          "units": "cm/s",
          "description": "Mass-weighted deposition velocity, the Binkowski-Shankar resistance sum (:372-378)."
        },
        "vdep": {
          "type": "unknown",
          "units": "m/s",
          "description": "Deposition velocity of this bin as MOSAIC hands it to the vertical-mixing driver, depvel_a3*0.01."
        }
      },
