{
  "esm": "1.1.0",
  "metadata": {
    "name": "MosaicMassTransferParameters",
    "description": "The per-gas and fixed numbers of MOSAIC's gas-particle mass-transfer coefficient: SUBROUTINE aerosolmtc and the functions gas_diffusivity, mean_molecular_speed and fuchs_sutugin of chem/module_mosaic_therm.F (WRF v4.8.0). The molecular weights, Fuller molar volumes and accommodation coefficients are the routine's own table; MOSAIC gives every condensing gas the same accommodation coefficient, 0.1.",
    "authors": [
      "EqWeFiC"
    ],
    "created": "2026-09-23T00:00:00Z",
    "tags": [
      "mosaic",
      "aerosol",
      "condensation",
      "wrf-chem"
    ],
    "references": [
      {
        "citation": "Fuchs, N. A. and Sutugin, A. G. (1971). High-dispersed aerosols. In Topics in Current Aerosol Research, Pergamon (the transition-regime correction this kernel uses)."
      },
      {
        "citation": "Zaveri, R. A., Easter, R. C., Fast, J. D. and Peters, L. K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). J. Geophys. Res. 113, D13204."
      }
    ]
  },
  "models": {
    "MosaicMassTransferParameters": {
      "variables": {
        "speed_c0": {
          "type": "parameter",
          "units": "cm/s*(g/mol/K)^(1/2)",
          "default": 14550.0,
          "description": "Coefficient of the mean molecular speed, 1.455e4*sqrt(T/mw) (function mean_molecular_speed)."
        },
        "dg_c0": {
          "type": "parameter",
          "units": "cm^2/s*atm/K^(7/4)",
          "default": 0.001,
          "description": "Leading coefficient of the Fuller gas-diffusivity fit (function gas_diffusivity)."
        },
        "dg_texp": {
          "type": "parameter",
          "units": "1",
          "default": 1.75,
          "description": "Temperature exponent of that fit."
        },
        "dg_mw_add": {
          "type": "parameter",
          "units": "mol/g",
          "default": 0.035,
          "description": "The 0.035 added to 1/mw under the square root; it stands for the reciprocal molecular weight of air."
        },
        "dg_vm_exp": {
          "type": "parameter",
          "units": "1",
          "default": 0.333333,
          "description": "Exponent applied to the molar volume. It is the routine's truncated 1/3 and reproducing it matters at single precision."
        },
        "dg_vm_add": {
          "type": "parameter",
          "units": "(cm^3/mol)^(1/3)",
          "default": 2.7189,
          "description": "The air term added to the gas molar volume before squaring."
        },
        "freepath_c0": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "freepath = 3*dg/speed."
        },
        "two_pi": {
          "type": "parameter",
          "units": "1",
          "default": 6.283185,
          "description": "2*pi as aerosolmtc spells it in `cdum = 6.283185*dp_avg*num_a`."
        },
        "fs_c0": {
          "type": "parameter",
          "units": "1",
          "default": 0.75,
          "description": "Numerator and denominator coefficient of the Fuchs-Sutugin correction, 0.75*a*(1+Kn) over Kn^2 + Kn + 0.283*Kn*a + 0.75*a."
        },
        "fs_c1": {
          "type": "parameter",
          "units": "1",
          "default": 0.283,
          "description": "The 0.283 in that denominator."
        },
        "mw_h2so4": {
          "type": "parameter",
          "units": "g/mol",
          "default": 98.0,
          "description": "Molecular weight of H2SO4 in the mass-transfer table."
        },
        "vm_h2so4": {
          "type": "parameter",
          "units": "cm^3/mol",
          "default": 42.88,
          "description": "Fuller molar volume of H2SO4."
        },
        "mw_msa": {
          "type": "parameter",
          "units": "g/mol",
          "default": 96.0,
          "description": "Molecular weight of MSA."
        },
        "vm_msa": {
          "type": "parameter",
          "units": "cm^3/mol",
          "default": 58.0,
          "description": "Fuller molar volume of MSA."
        },
        "mw_hno3": {
          "type": "parameter",
          "units": "g/mol",
          "default": 63.0,
          "description": "Molecular weight of HNO3."
        },
        "vm_hno3": {
          "type": "parameter",
          "units": "cm^3/mol",
          "default": 24.11,
          "description": "Fuller molar volume of HNO3."
        },
        "mw_hcl": {
          "type": "parameter",
          "units": "g/mol",
          "default": 36.5,
          "description": "Molecular weight of HCl."
        },
        "vm_hcl": {
          "type": "parameter",
          "units": "cm^3/mol",
          "default": 21.48,
          "description": "Fuller molar volume of HCl."
        },
        "mw_nh3": {
          "type": "parameter",
          "units": "g/mol",
          "default": 17.0,
          "description": "Molecular weight of NH3."
        },
        "vm_nh3": {
          "type": "parameter",
          "units": "cm^3/mol",
          "default": 14.9,
          "description": "Fuller molar volume of NH3."
        },
        "accom": {
          "type": "parameter",
          "units": "1",
          "default": 0.1,
          "description": "Accommodation coefficient. MOSAIC gives every condensing gas the same value."
        }
      },
      "equations": []
    }
  }
}