      },
      "temporal": {
        "start": "1948-01-01T00:00:00Z",
        "file_period": "P1Y",
        "frequency": "PT6H",
        "records_per_file": 1460,
        "time_variable": "time"
      },
      "grid": {
        "family": "cartesian",
        "crs": {
          "projection": "longlat",
          "datum": "WGS84"
        },
        "description": "Native NCEP/NCAR Reanalysis 1 grid: regular global 2.5°×2.5° longitude/latitude lattice on 17 standard pressure levels (1000, 925, 850, 700, 600, 500, 400, 300, 250, 200, 150, 100, 70, 50, 30, 20, 10 hPa — non-uniform vertical spacing). Geographic (unprojected) longlat/WGS84 crs — the regridding model applies the longlat IDENTITY reprojection (ESD reprojection/longlat.esm, esd-47z.1). Migrated from the loader's former DataLoaderSpatial block (RFC pure-io-data-loaders §4.1). Dimension cell counts resolve from the source dataset at load time; documented native geometry: lon ∈ [-180°,180°] (144 cells, 2.5°), lat ∈ [-90°,90°] (72 cells, 2.5°), level = 17 pressure surfaces.",
        "dimensions": [
