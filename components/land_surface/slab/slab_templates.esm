{
 "esm": "1.0.0",
 "metadata": {
  "name": "slab_templates",
  "description": "Expression templates of the surface energy balance as WRF's slab land-surface scheme writes it (phys/module_sf_slab.F, SLAB1D): bulk surface fluxes from an exchange coefficient, black-body emission and net radiation. The Bolton (1980) saturation vapor pressure and the Exner function live in lib/wrf_thermo.esm (bolton_saturation_vapor_pressure, exner_function), shared with the surface-layer scheme.",
  "license": "MIT",
  "tags": ["wrf", "land-surface", "surface-energy-balance", "templates"],
  "references": [
   {"citation": "Bolton, D. (1980). The computation of equivalent potential temperature. Mon. Wea. Rev. 108, 1046-1053."},
   {"citation": "wrf-model/WRF v4.8.0 phys/module_sf_slab.F SLAB1D lines 441-453."}
  ]
 },
 "expression_templates": {
  "bulk_surface_flux": {
   "params": ["coefficient", "surface_value", "air_value"],
   "description": "Bulk-aerodynamic surface flux, coefficient (surface_value - air_value), upward positive; WRF hands the slab scheme the exchange coefficients already multiplied by density and wind speed (FLHC in W m^-2 K^-1, FLQC in kg m^-2 s^-1), so HFX = FLHC (THG - THX) and QFX = FLQC (QSG - QX).",
   "body": {"op": "*", "args": ["coefficient", {"op": "-", "args": ["surface_value", "air_value"]}]}
  },
  "blackbody_emission": {
   "params": ["sigma", "T"],
   "description": "Black-body emission sigma T^4 (SLAB1D: UPFLUX = STBOLT*TG0**4; the emissivity multiplies the net longwave, not the emission, in this scheme).",
   "body": {"op": "*", "args": ["sigma", {"op": "^", "args": ["T", 4]}]}
  },
  "net_radiation": {
   "params": ["gsw", "glw", "emiss", "upflux"],
   "description": "Net radiation absorbed by the surface, gsw + emiss (glw - upflux): the downward shortwave already includes the albedo, and the emissivity scales the net longwave (SLAB1D: XINET = EMISS*(GLW-UPFLUX); RNET = GSW + XINET).",
   "body": {"op": "+", "args": ["gsw", {"op": "*", "args": ["emiss", {"op": "-", "args": ["glw", "upflux"]}]}]}
  }
 }
}
