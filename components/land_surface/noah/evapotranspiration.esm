{
 "esm": "1.1.0",
 "metadata": {
  "name": "NoahEvapotranspiration",
  "description": "Partition of Noah's potential evaporation into its three actual components -- direct soil evaporation, canopy transpiration and evaporation of intercepted canopy water -- SUBROUTINES EVAPO, DEVAP and TRANSP of phys/module_sf_noahlsm.F (WRF 4.8, sf_surface_physics = 2), as called by NOPAC for snow-free ground. Direct soil evaporation edir = fx (1 - shdfac) etp, with the bare-soil efficiency fx = clamp(((smc[1] - smcdry)/(smcmax - smcdry))^fxexp, 0, 1) evaluated on TOTAL top-layer soil moisture. Canopy evaporation ec = shdfac (cmc/cmcmax)^cfactr etp drains intercepted water at the potential rate weighted by the canopy wetness fraction. Transpiration takes what is left of the canopy's share, etp1a = shdfac pc etp (1 - (cmc/cmcmax)^cfactr), and distributes it over the root zone by the Noah root-weighting rule: each root layer's share is gx max(rtdis + gx - sgx, 0), normalised to sum to one, where gx is the layer's moisture stress on UNFROZEN water, rtdis = dz/z_root its thickness fraction of the root zone and sgx the UNWEIGHTED ARITHMETIC MEAN of gx over the root layers. That mean is a per-layer count, not a depth average, and it is what makes the rule redistribute water towards layers that are wetter than the root-zone average; it is written here as the column integral of gx/dz over the masked root zone divided by nroot, which is identically the Fortran's sum over layers 1..nroot. Two quantities are evaluated on DIFFERENT moisture variables and the difference is deliberate in WRF: DEVAP reads total soil moisture smc, TRANSP reads unfrozen soil water sh2o. The canopy-drain limiter ec <= cmc/dt_canopy is a finite-sub-step clip on an otherwise continuous rate, so dt_canopy is A PARAMETER OF THE TENDENCY and not the integrator's step; it is inactive at every state of the reference set (cmc/dt is 2e4 W/m^2 against an ec of at most 121 W/m^2 there), so the tests pin the unclipped branch only and the clipped branch is untested. When etp <= 0 the whole routine is skipped and WRF reports dew instead: eta = etp, beta = 1 for etp < 0 and beta = 0 for etp = 0, which this component reproduces so that the dew branch is not a silent hole. Consumer-supplied column fields (ze, smc, sh2o) are rewrite-target ops `input_<name>` lowered by the consumer, in the inline tests through per-test expression_template_imports libraries generated by tools/fill_tests.py.",
  "license": "MIT",
  "tags": [
   "wrf",
   "land-surface",
   "noah",
   "evaporation",
   "transpiration",
   "column"
  ],
  "references": [
   {
    "citation": "Betts, A. K., et al. (1997). Assessment of the land surface and boundary layer models in two operational versions of the NCEP Eta model using FIFE data. Mon. Wea. Rev., 125, 2896-2916."
   },
   {
    "citation": "Chen, F., and J. Dudhia (2001). Coupling an advanced land surface-hydrology model with the Penn State-NCAR MM5 modeling system. Part I. Mon. Wea. Rev., 129, 569-585."
   },
   {
    "citation": "wrf-model/WRF v4.8.0 phys/module_sf_noahlsm.F SUBROUTINE EVAPO lines 1323-1421, DEVAP lines 1189-1228, TRANSP lines 4355-4458 (instrumented in ctessum-claude/WRF branch earthsciml-instrumented-chem170, commit ac6d4cc)."
   }
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 4,
   "description": "Number of soil layers, WRF num_soil_layers (4 for the Noah default). Bound into the column grid at the import edge."
  }
 },
 "models": {
  "NoahEvapotranspiration": {
   "expression_template_imports": [
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/grid.esm",
     "bindings": {
      "NLEV": "NLEV"
     }
    },
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/rules/integral_lev_whole.esm",
     "bindings": {
      "NLEV": "NLEV"
     }
    }
   ],
   "subsystems": {
    "par": {
     "ref": "./noah_parameters.esm"
    }
   },
   "variables": {
    "ze": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "description": "Soil layer interface DEPTHS below the surface, positive downward, ze[1] = 0; the negative of WRF's ZSOIL prefixed by zero."
    },
    "zc": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev"
     ],
     "description": "Soil layer centre depths, from the grid's column_cell_center template."
    },
    "dz": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev"
     ],
     "description": "Soil layer thicknesses, from the grid's column_cell_thickness template. Equals WRF's SLDPTH."
    },
    "smc": {
     "type": "unknown",
     "units": "m^3/m^3",
     "shape": [
      "lev"
     ],
     "description": "TOTAL volumetric soil moisture of each layer, WRF's SMC. Only the top layer is read, by the bare-soil evaporation efficiency."
    },
    "sh2o": {
     "type": "unknown",
     "units": "m^3/m^3",
     "shape": [
      "lev"
     ],
     "description": "UNFROZEN volumetric soil water of each layer, WRF's SH2O, which is what TRANSP receives as its SMC argument."
    },
    "etp": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 100.0,
     "description": "Potential evaporation in energy units as SFLX reports it, the etp_energy of the Penman component. Negative means dew."
    },
    "shdfac": {
     "type": "parameter",
     "units": "1",
     "default": 0.5,
     "description": "Green vegetation fraction, WRF's SHDFAC. Splits the surface between the bare-soil and the canopy pathway."
    },
    "pc": {
     "type": "parameter",
     "units": "1",
     "default": 0.9,
     "description": "Plant coefficient from the canopy-resistance component, which converts potential to Penman-Monteith transpiration."
    },
    "cmc": {
     "type": "parameter",
     "units": "m",
     "default": 0.0005,
     "description": "Canopy-intercepted water content, WRF's CMC."
    },
    "dt_canopy": {
     "type": "parameter",
     "units": "s",
     "default": 60.0,
     "description": "Sub-step over which the canopy reservoir may be drained, which caps ec at cmc/dt_canopy. A parameter of the tendency, not the integrator's step: prescribe it in the mounting document and couple it into every stage that needs it. Inactive throughout the reference set."
    },
    "z_root": {
     "type": "parameter",
     "units": "m",
     "default": 1.0,
     "description": "Depth of the bottom of the root zone, |ZSOIL(NROOT)|."
    },
    "nroot": {
     "type": "parameter",
     "units": "1",
     "default": 3.0,
     "description": "Number of soil layers in the root zone, VEGPARM.TBL NROTBL, carried as a real count because it divides the UNWEIGHTED mean sgx."
    },
    "smcmax": {
     "type": "parameter",
     "units": "m^3/m^3",
     "default": 0.476,
     "description": "Soil porosity (saturation moisture) of the soil type, SOILPARM.TBL MAXSMC."
    },
    "smcdry": {
     "type": "parameter",
     "units": "m^3/m^3",
     "default": 0.084,
     "description": "Air-dry soil moisture of the soil type, SOILPARM.TBL DRYSMC, at which direct soil evaporation ceases."
    },
    "smcwlt": {
     "type": "parameter",
     "units": "m^3/m^3",
     "default": 0.084,
     "description": "Soil wilting point, SOILPARM.TBL WLTSMC."
    },
    "smcref": {
     "type": "parameter",
     "units": "m^3/m^3",
     "default": 0.36,
     "description": "Soil reference moisture (field capacity), SOILPARM.TBL REFSMC."
    },
    "etp_kinematic": {
     "type": "unknown",
     "units": "kg/(m^2*s)",
     "description": "Potential evaporation as a mass flux, etp/lvh2o; WRF's ETP before SFLX's energy conversion."
    },
    "canopy_wet": {
     "type": "unknown",
     "units": "1",
     "description": "Canopy wetness fraction raised to its exponent, (cmc/cmcmax)^cfactr, zero when the canopy is dry."
    },
    "sratio": {
     "type": "unknown",
     "units": "1",
     "description": "Normalised top-layer soil wetness above the air-dry value, (smc[1] - smcdry)/(smcmax - smcdry)."
    },
    "fx": {
     "type": "unknown",
     "units": "1",
     "description": "Bare-soil evaporation efficiency, clamp(sratio^fxexp, 0, 1), and zero where sratio is not positive."
    },
    "edir": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Direct evaporation from the bare-soil fraction, fx (1 - shdfac) etp. Zero when etp <= 0."
    },
    "ec_raw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Canopy-water evaporation before the drain limiter, shdfac canopy_wet etp."
    },
    "ec": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Canopy-water evaporation, min(ec_raw, cmc lvh2o/dt_canopy). Zero when etp <= 0 or the canopy is dry."
    },
    "etp1a": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "The share of the potential flux left for transpiration, shdfac pc etp (1 - canopy_wet)."
    },
    "gx": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Per-layer moisture stress on UNFROZEN water, clamp((sh2o - smcwlt)/(smcref - smcwlt), 0, 1)."
    },
    "gx_root": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "gx masked to the root zone (zero where the layer centre lies below z_root)."
    },
    "sgx": {
     "type": "unknown",
     "units": "1",
     "description": "UNWEIGHTED arithmetic mean of gx over the nroot root layers. Written as the column integral of gx_root/dz -- which is the plain sum over the root layers -- divided by nroot."
    },
    "rtdis": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Root distribution, each root layer's thickness fraction of the root zone, dz/z_root."
    },
    "rtx": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Root-weighting increment rtdis + gx - sgx, which is positive where the layer is wetter than the root-zone mean or holds a large share of the roots."
    },
    "gxs": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Unnormalised root-zone uptake weight, gx_root max(rtx, 0)."
    },
    "denom_raw": {
     "type": "unknown",
     "units": "1",
     "description": "Sum of gxs over the root zone, the column integral of gxs/dz."
    },
    "denom": {
     "type": "unknown",
     "units": "1",
     "description": "denom_raw, replaced by 1 where it is not positive (WRF's guard against a wholly stressed root zone, which then transpires nothing because every gxs is zero)."
    },
    "et": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "lev"
     ],
     "description": "Transpiration withdrawn from each soil layer, etp1a gxs/denom. Zero outside the root zone and zero when etp <= 0."
    },
    "ett": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Total transpiration, the column integral of et/dz, i.e. the plain sum of the layer withdrawals."
    },
    "eta": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Total actual evapotranspiration, edir + ec + ett where etp > 0, and etp itself (dew) where etp <= 0."
    },
    "beta": {
     "type": "unknown",
     "units": "1",
     "description": "Ratio of actual to potential evaporation, eta/etp; WRF forces beta = 1 for etp < 0 (dew is unlimited) and beta = 0 for etp = 0."
    },
    "eta_kinematic": {
     "type": "unknown",
     "units": "kg/(m^2*s)",
     "description": "Total evapotranspiration as a mass flux, eta/lvh2o; the surface moisture flux the atmosphere receives."
    },
    "gx_root_density": {
     "type": "unknown",
     "units": "1/m",
     "shape": [
      "lev"
     ],
     "description": "gx_root divided by the layer thickness, so that the column integral of it is the PLAIN SUM of gx over the root layers -- the per-layer count the Fortran's SGX takes the mean of. The division is what turns a depth integral into a layer sum; it is not a physical density."
    },
    "gxs_density": {
     "type": "unknown",
     "units": "1/m",
     "shape": [
      "lev"
     ],
     "description": "gxs divided by the layer thickness, so that its column integral is the plain sum of the uptake weights (the Fortran's DENOM)."
    },
    "et_density": {
     "type": "unknown",
     "units": "W/m^3",
     "shape": [
      "lev"
     ],
     "description": "et divided by the layer thickness, so that its column integral is the plain sum of the layer withdrawals (the Fortran's ETT)."
    },
    "z_sfc": {
     "type": "unknown",
     "units": "m",
     "description": "Lower boundary of the column, ze[1]: the free name the EarthSciDiscretizations column_nonuniform_1d integral rules match as the lower bound of a bottom-anchored integral (ESD #39)."
    },
    "z_top": {
     "type": "unknown",
     "units": "m",
     "description": "Upper boundary of the column, ze[NLEV+1]: the free name the EarthSciDiscretizations column_nonuniform_1d integral rules match as the upper bound of a top-anchored integral (ESD #39)."
    }
   },
   "equations": [
    {
     "lhs": "ze",
     "rhs": {
      "op": "input_ze",
      "args": []
     }
    },
    {
     "lhs": "zc",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "column_cell_center",
      "bindings": {
       "ze": "ze"
      }
     }
    },
    {
     "lhs": "dz",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "column_cell_thickness",
      "bindings": {
       "ze": "ze"
      }
     }
    },
    {
     "lhs": "smc",
     "rhs": {
      "op": "input_smc",
      "args": []
     }
    },
    {
     "lhs": "sh2o",
     "rhs": {
      "op": "input_sh2o",
      "args": []
     }
    },
    {
     "lhs": "etp_kinematic",
     "rhs": {
      "op": "/",
      "args": [
       "etp",
       "par.lvh2o"
      ]
     }
    },
    {
     "lhs": "canopy_wet",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": ">",
        "args": [
         "cmc",
         0.0
        ]
       },
       {
        "op": "^",
        "args": [
         {
          "op": "/",
          "args": [
           "cmc",
           "par.cmcmax"
          ]
         },
         "par.cfactr"
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": "sratio",
     "rhs": {
      "op": "/",
      "args": [
       {
        "op": "-",
        "args": [
         {
          "op": "index",
          "args": [
           "smc",
           1
          ]
         },
         "smcdry"
        ]
       },
       {
        "op": "-",
        "args": [
         "smcmax",
         "smcdry"
        ]
       }
      ]
     }
    },
    {
     "lhs": "fx",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": ">",
        "args": [
         "sratio",
         0.0
        ]
       },
       {
        "op": "max",
        "args": [
         {
          "op": "min",
          "args": [
           {
            "op": "^",
            "args": [
             "sratio",
             "par.fxexp"
            ]
           },
           1.0
          ]
         },
         0.0
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": "edir",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": ">",
        "args": [
         "etp",
         0.0
        ]
       },
       {
        "op": "*",
        "args": [
         {
          "op": "*",
          "args": [
           "fx",
           {
            "op": "-",
            "args": [
             1.0,
             "shdfac"
            ]
           }
          ]
         },
         "etp"
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": "ec_raw",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "and",
        "args": [
         {
          "op": ">",
          "args": [
           "etp",
           0.0
          ]
         },
         {
          "op": ">",
          "args": [
           "shdfac",
           0.0
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         {
          "op": "*",
          "args": [
           "shdfac",
           "canopy_wet"
          ]
         },
         "etp"
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": "ec",
     "rhs": {
      "op": "min",
      "args": [
       "ec_raw",
       {
        "op": "/",
        "args": [
         {
          "op": "*",
          "args": [
           "cmc",
           "par.lvh2o"
          ]
         },
         "dt_canopy"
        ]
       }
      ]
     }
    },
    {
     "lhs": "etp1a",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "and",
        "args": [
         {
          "op": ">",
          "args": [
           "etp",
           0.0
          ]
         },
         {
          "op": ">",
          "args": [
           "shdfac",
           0.0
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         {
          "op": "*",
          "args": [
           {
            "op": "*",
            "args": [
             "shdfac",
             "pc"
            ]
           },
           "etp"
          ]
         },
         {
          "op": "-",
          "args": [
           1.0,
           "canopy_wet"
          ]
         }
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": "gx",
     "rhs": {
      "op": "max",
      "args": [
       {
        "op": "min",
        "args": [
         {
          "op": "/",
          "args": [
           {
            "op": "-",
            "args": [
             "sh2o",
             "smcwlt"
            ]
           },
           {
            "op": "-",
            "args": [
             "smcref",
             "smcwlt"
            ]
           }
          ]
         },
         1.0
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": "gx_root",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "<",
        "args": [
         "zc",
         "z_root"
        ]
       },
       "gx",
       0.0
      ]
     }
    },
    {
     "lhs": "gx_root_density",
     "rhs": {
      "op": "/",
      "args": [
       "gx_root",
       "dz"
      ]
     }
    },
    {
     "lhs": "sgx",
     "rhs": {
      "op": "/",
      "args": [
       {
        "op": "integral",
        "args": [
         "gx_root_density"
        ],
        "var": "lev",
        "lower": "z_sfc",
        "upper": "z_top"
       },
       "nroot"
      ]
     }
    },
    {
     "lhs": "rtdis",
     "rhs": {
      "op": "/",
      "args": [
       "dz",
       "z_root"
      ]
     }
    },
    {
     "lhs": "rtx",
     "rhs": {
      "op": "-",
      "args": [
       {
        "op": "+",
        "args": [
         "rtdis",
         "gx"
        ]
       },
       "sgx"
      ]
     }
    },
    {
     "lhs": "gxs",
     "rhs": {
      "op": "*",
      "args": [
       "gx_root",
       {
        "op": "max",
        "args": [
         "rtx",
         0.0
        ]
       }
      ]
     }
    },
    {
     "lhs": "gxs_density",
     "rhs": {
      "op": "/",
      "args": [
       "gxs",
       "dz"
      ]
     }
    },
    {
     "lhs": "denom_raw",
     "rhs": {
      "op": "integral",
      "args": [
       "gxs_density"
      ],
      "var": "lev",
      "lower": "z_sfc",
      "upper": "z_top"
     }
    },
    {
     "lhs": "denom",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": ">",
        "args": [
         "denom_raw",
         0.0
        ]
       },
       "denom_raw",
       1.0
      ]
     }
    },
    {
     "lhs": "et",
     "rhs": {
      "op": "/",
      "args": [
       {
        "op": "*",
        "args": [
         "etp1a",
         "gxs"
        ]
       },
       "denom"
      ]
     }
    },
    {
     "lhs": "et_density",
     "rhs": {
      "op": "/",
      "args": [
       "et",
       "dz"
      ]
     }
    },
    {
     "lhs": "ett",
     "rhs": {
      "op": "integral",
      "args": [
       "et_density"
      ],
      "var": "lev",
      "lower": "z_sfc",
      "upper": "z_top"
     }
    },
    {
     "lhs": "eta",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": ">",
        "args": [
         "etp",
         0.0
        ]
       },
       {
        "op": "+",
        "args": [
         {
          "op": "+",
          "args": [
           "edir",
           "ec"
          ]
         },
         "ett"
        ]
       },
       "etp"
      ]
     }
    },
    {
     "lhs": "beta",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "==",
        "args": [
         "etp",
         0.0
        ]
       },
       0.0,
       {
        "op": "ifelse",
        "args": [
         {
          "op": "<",
          "args": [
           "etp",
           0.0
          ]
         },
         1.0,
         {
          "op": "/",
          "args": [
           "eta",
           "etp"
          ]
         }
        ]
       }
      ]
     }
    },
    {
     "lhs": "eta_kinematic",
