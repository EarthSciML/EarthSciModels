   "tests": [
     {
       "id": "chem170_scm_step1_surface",
       "description": "Reference: WRF 4.8 em_scm_xy single-column run at chem_opt = 170 with Noah (sf_surface_physics = 2, num_soil_layers = 4, silt loam, dryland cropland), data/eqwefic/chem170_scm, dumped by ctessum-claude/WRF branch earthsciml-instrumented-chem170 (commit ac6d4cc) and replayed through the real64 (-fdefault-real-8) kernels/noah_driver. Inputs are the dumped SFLX arguments (real32 values widened). df1, yy, zz1 and the pre-step ground heat flux are not Registry variables; they are published by the kernels/noah_esm_*.inc splices into a BUILD-TIME COPY of module_sf_noahlsm.F (the WRF source is untouched). The column is above freezing and snow-free throughout, so the SNKSRC phase-change sink and the SNOPAC branch are inactive here and therefore UNTESTED, not merely unused. SURFACE CLOSURE at pre-dawn, soil warming from below. SFLX recomputes the surface conductivity df1 from the soil moisture that SMFLX has already advanced, so yy, zz1, t1, ssoil and sheat all carry an O(dt) dependence on the replay step; the reference is therefore taken at ESM_DT = 1e-6 s, where that truncation is below 1e-10 relative. At ESM_DT = 0.01 s the same quantities are already off the dt -> 0 limit by up to 5.7e-7 relative, and WRF's own dt = 60 s values by up to 3e-3.",
       "parameter_overrides": {
         "quartz": 0.25,
         "smcmax": 0.47600001096725464,
         "shdfac": 0.5,
         "sfctmp": 299.7296142578125,
         "sfcprs": 99642.484375,
         "th2": 300.0362854003906,
         "q2": 0.013806705363094807,
         "ch": 2.107988257193938e-05,
         "fdown": 464.0659408569336,
         "emissi": 0.9850000143051147,
         "rch": 0.024321563028787355,
         "rr": 246.25458052495014,
         "epsca": 48.4970804600707,
         "beta": 0.6509801410881244,
         "tbot": 300.0,
         "z_deep": 8.0
       },
       "expression_template_imports": [
         {
           "ref": "./tests/heat_surf_step1_inputs.esm"
         }
       ],
       "time_span": {
         "start": 0.0,
         "end": 1.0
       },
       "assertions": [
         {
           "variable": "yy",
           "time": 0.0,
           "expected": 301.82556840097305,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "zz1",
           "time": 0.0,
           "expected": 2.335787526654383,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "t1",
           "time": 0.0,
           "expected": 299.63780667435327,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "ssoil",
           "time": 0.0,
           "expected": -13.103153217511641,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "sheat",
           "time": 0.0,
           "expected": -0.009690660726137421,
           "tolerance": {
             "rel": 1e-09
           }
         }
       ]
     },
     {
       "id": "chem170_scm_step1_tendency",
       "description": "Reference: WRF 4.8 em_scm_xy single-column run at chem_opt = 170 with Noah (sf_surface_physics = 2, num_soil_layers = 4, silt loam, dryland cropland), data/eqwefic/chem170_scm, dumped by ctessum-claude/WRF branch earthsciml-instrumented-chem170 (commit ac6d4cc) and replayed through the real64 (-fdefault-real-8) kernels/noah_driver. Inputs are the dumped SFLX arguments (real32 values widened). df1, yy, zz1 and the pre-step ground heat flux are not Registry variables; they are published by the kernels/noah_esm_*.inc splices into a BUILD-TIME COPY of module_sf_noahlsm.F (the WRF source is untouched). The column is above freezing and snow-free throughout, so the SNKSRC phase-change sink and the SNOPAC branch are inactive here and therefore UNTESTED, not merely unused. SOIL TEMPERATURE TENDENCY at pre-dawn, soil warming from below. SFLX advances the soil column IN PLACE with an implicit tridiagonal solve (HSTEP), so its dt = 60 s increment is NOT the instantaneous tendency: across this reference set WRF's (STC_out - STC_in)/60 differs from the dt -> 0 limit by up to 2.7e-7 K/s, which is the implicit solve and not the physics. The reference here is the replay increment at ESM_DT = 0.01 s, whose own remaining truncation is at most 5e-11 K/s (measured against a Richardson extrapolation from 0.02 and 0.01 s) and therefore an order below the assertion tolerance. A smaller step cannot be used for an INCREMENT: at ESM_DT = 1e-6 s the difference of two ~300 K temperatures loses the tendency to cancellation. The per-level assertions therefore carry an ABSOLUTE bound rather than a tight relative one: the reference's own implicit-solve truncation is up to 1.1e-10 K/s, which is a few times 1e-5 of the QUIETEST deep layer's tendency, so those layers cannot be pinned relatively at this step size while the surface layer is pinned to 1e-6 of its own amplitude. The Linf assertion above is the bound that matters.",
       "parameter_overrides": {
         "quartz": 0.25,
         "smcmax": 0.47600001096725464,
         "shdfac": 0.5,
         "sfctmp": 299.7296142578125,
         "sfcprs": 99642.484375,
         "th2": 300.0362854003906,
         "q2": 0.013806705363094807,
         "ch": 2.107988257193938e-05,
         "fdown": 464.0659408569336,
         "emissi": 0.9850000143051147,
         "rch": 0.024321563028787355,
         "rr": 246.25458052495014,
         "epsca": 48.4970804600707,
         "beta": 0.6509801410881244,
         "tbot": 300.0,
         "z_deep": 8.0
       },
       "expression_template_imports": [
         {
           "ref": "./tests/heat_tend_step1_inputs.esm"
         }
       ],
       "time_span": {
         "start": 0.0,
         "end": 1.0
       },
       "assertions": [
         {
           "variable": "dstc_dt",
           "time": 0.0,
           "reduce": "Linf_error",
           "expected": 0.0,
           "reference": {
             "op": "faq",
             "output_idx": [
               "k"
             ],
             "args": [],
             "ranges": {
               "k": {
                 "from": "lev"
               }
             },
             "expr": {
               "op": "index",
               "args": [
                 {
                   "op": "const",
                   "args": [],
                   "value": [3.9437782106688246e-05, -1.2023122053506086e-06, 2.5081476451305207e-06, 1.0962025953631382e-06]
                 },
                 "k"
               ]
             }
           },
           "tolerance": {
             "abs": 1e-09,
             "rel": 0.0
           }
         },
         {
           "variable": "dstc_dt",
           "time": 0.0,
           "coords": {
             "lev": 1
           },
           "expected": 3.9437782106688246e-05,
           "tolerance": {
             "rel": 0.001,
             "abs": 5e-10
           }
         },
         {
           "variable": "dstc_dt",
           "time": 0.0,
           "coords": {
             "lev": 2
           },
           "expected": -1.2023122053506086e-06,
           "tolerance": {
             "rel": 0.001,
             "abs": 5e-10
           }
         },
         {
           "variable": "dstc_dt",
           "time": 0.0,
           "coords": {
             "lev": 3
           },
           "expected": 2.5081476451305207e-06,
           "tolerance": {
             "rel": 0.001,
             "abs": 5e-10
           }
         },
         {
           "variable": "dstc_dt",
           "time": 0.0,
           "coords": {
             "lev": 4
           },
           "expected": 1.0962025953631382e-06,
           "tolerance": {
             "rel": 0.001,
             "abs": 5e-10
           }
         }
       ]
     },
