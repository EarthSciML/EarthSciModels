   "tests": [
    {
     "id": "chem170_scm_step1_infiltration",
     "description": "Reference: WRF 4.8 em_scm_xy single-column run at chem_opt = 170 with Noah (sf_surface_physics = 2, num_soil_layers = 4, silt loam, dryland cropland, slopetyp 1), data/eqwefic/chem170_scm, dumped by ctessum-claude/WRF branch earthsciml-instrumented-chem170 and replayed through the real64 (-fdefault-real-8) kernels/noah_driver. Inputs are the dumped SFLX arguments (real32 values widened). The column is unfrozen and unsaturated at every dumped step, so the frozen-ground infiltration reduction fcr and SSTEP's supersaturation redistribution are UNTESTED, not merely unused, and so is every path that reads sice. INFILTRATION AND RUNOFF at pre-dawn, no rain: drainage and root uptake only. Reference at ESM_DT = 1e-4 s, which is NOT the smallest available and is chosen deliberately. WRF's infiltration limiter contains val = 1 - exp(-kdt dt/86400); as dt falls the argument underflows into the cancellation of 1 - exp(-x), and as dt rises val departs from its linear limit, so the replay's own accuracy is a V in dt. Measured on the step-601 column, the replay differs from this component by 5.8e-7 at dt = 1e-6, 1.1e-8 at dt = 1e-4 and 2.2e-5 at dt = 1, with a clean minimum at 1e-4; the runoff1 tolerance below is set from that floor and bounds the REFERENCE, not the component. runoff2 contains no dt-dependent quantity at all and is pinned at 1e-9.",
     "parameter_overrides": {
      "edir": 0.1790657287391653,
      "ec": 0.0,
      "etp": 1.1795247991217812,
      "prcp": 0.0,
      "shdfac": 0.5,
      "cmc": 0.0,
      "smcmax": 0.47600001096725464,
      "smcwlt": 0.08399999886751175,
      "bexp": 5.329999923706055,
      "dksat": 2.8100000690756133e-06,
      "dwsat": 2.390000008745119e-05,
      "kdt": 4.215000114255272,
      "frzx": 0.17460114362402857,
      "slope": 0.10000000149011612
     },
     "expression_template_imports": [
      {
       "ref": "./tests/moist_inf_step1_inputs.esm"
      }
     ],
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "runoff1",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 5e-08,
        "abs": 1e-18
       }
      },
      {
       "variable": "runoff2",
       "time": 0.0,
       "expected": 5.129462179181446e-10,
       "tolerance": {
        "rel": 1e-09
       }
      },
      {
       "variable": "supersaturation_active",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "abs": 0.0,
        "rel": 0.0
       }
      }
     ]
    },
    {
     "id": "chem170_scm_step1_tendency",
     "description": "Reference: WRF 4.8 em_scm_xy single-column run at chem_opt = 170 with Noah (sf_surface_physics = 2, num_soil_layers = 4, silt loam, dryland cropland, slopetyp 1), data/eqwefic/chem170_scm, dumped by ctessum-claude/WRF branch earthsciml-instrumented-chem170 and replayed through the real64 (-fdefault-real-8) kernels/noah_driver. Inputs are the dumped SFLX arguments (real32 values widened). The column is unfrozen and unsaturated at every dumped step, so the frozen-ground infiltration reduction fcr and SSTEP's supersaturation redistribution are UNTESTED, not merely unused, and so is every path that reads sice. SOIL WATER AND CANOPY TENDENCIES at pre-dawn, no rain: drainage and root uptake only. SSTEP advances the soil column IN PLACE with an implicit tridiagonal solve, so WRF's dt = 60 s increment is not the instantaneous tendency; the reference is the replay increment at ESM_DT = 0.01 s. drip and dcmc_dt are referenced at the SAME step and not at a smaller one, because WRF forms drip as (cmc + dt rhsct) - cmcmax: the increment is nine orders below cmc at dt = 1e-6 and is destroyed by cancellation, while at 1e-2 it is recovered to 1e-11. The per-level assertions carry an ABSOLUTE bound: the reference's own implicit-solve truncation is about 1e-11 (1/s), which is a few times 1e-5 of the DEEPEST layer's tendency, so the quiet layers cannot be pinned relatively at this step size while the top layer is pinned to 1e-7 of its own amplitude.",
     "parameter_overrides": {
      "edir": 0.1790657287391653,
      "ec": 0.0,
      "etp": 1.1795247991217812,
      "prcp": 0.0,
      "shdfac": 0.5,
      "cmc": 0.0,
      "smcmax": 0.47600001096725464,
      "smcwlt": 0.08399999886751175,
      "bexp": 5.329999923706055,
      "dksat": 2.8100000690756133e-06,
      "dwsat": 2.390000008745119e-05,
      "kdt": 4.215000114255272,
      "frzx": 0.17460114362402857,
      "slope": 0.10000000149011612
     },
     "expression_template_imports": [
      {
       "ref": "./tests/moist_tend_step1_inputs.esm"
      }
     ],
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "drip",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-09,
        "abs": 1e-18
       }
      },
      {
       "variable": "dcmc_dt",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-06,
        "abs": 1e-16
       }
      },
      {
       "variable": "dsh2o_dt",
       "time": 0.0,
       "reduce": "Linf_error",
       "expected": 0.0,
       "reference": {
        "op": "faq",
        "output_idx": [
         "k"
        ],
        "args": [],
        "ranges": {
         "k": {
          "from": "lev"
         }
        },
        "expr": {
         "op": "index",
         "args": [
          {
           "op": "const",
           "args": [],
           "value": [
            -5.224599641806549e-08,
            -2.3542279237176444e-10,
            -2.354172412566413e-10,
            4.61651827876608e-09
           ]
          },
          "k"
         ]
        }
       },
       "tolerance": {
        "abs": 1e-10,
        "rel": 0.0
       }
      },
      {
       "variable": "dsh2o_dt",
       "time": 0.0,
       "coords": {
        "lev": 1
       },
       "expected": -5.224599641806549e-08,
       "tolerance": {
        "rel": 0.001,
        "abs": 5e-11
       }
      },
      {
       "variable": "dsh2o_dt",
       "time": 0.0,
       "coords": {
        "lev": 2
       },
       "expected": -2.3542279237176444e-10,
       "tolerance": {
        "rel": 0.001,
        "abs": 5e-11
       }
      },
      {
       "variable": "dsh2o_dt",
       "time": 0.0,
       "coords": {
        "lev": 3
       },
       "expected": -2.354172412566413e-10,
       "tolerance": {
        "rel": 0.001,
        "abs": 5e-11
       }
