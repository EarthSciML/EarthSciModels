{
 "esm": "1.1.0",
 "metadata": {
  "name": "NoahSnowEnergy",
  "description": "The snow-pack surface energy balance of WRF's unified Noah land-surface model, SUBROUTINE SNOPAC of phys/module_sf_noahlsm.F (WRF 4.8, sf_surface_physics = 2): the linearised snow-surface temperature t12, the branch it selects, the skin temperature and ground heat flux that follow, and the melt rate. THE CLOSURE. SNOPAC solves the surface balance over a slab of thickness dtot = snowh + half the top soil layer, treating the snow and that half-layer as one conductive path of conductivity df1. Writing the balance about the air temperature gives t12 = (sfctmp + t12a + t12b)/denom, where t12a carries the radiative and turbulent forcing per unit rch and per unit rr, t12b the conduction from the top soil layer, and denom = 1 + df1/(dtot rr rch) the strength of that conduction relative to the atmospheric coupling. t12 is the temperature the snow surface WOULD reach with no melting. THE BRANCH. If t12 is at or below freezing the pack simply cools: the skin temperature is t12 itself, nothing melts, and the pack loses only what sublimates. If t12 is above freezing the surface is pinned near freezing instead -- t1 is a cover-weighted blend of the freezing point and t12, with the weight max(0.01, sncovr^2), so a thin pack lets the surface run warm while a full one holds it at 273.15 K -- and the energy the balance cannot dispose of becomes melt. THE MELT RATE IS REFERENCED BEFORE ITS LIMITER, not after, and that distinction is the same one FORTRAN_BUGS N97 forced for the frozen-soil sink. flx3 is the residual of the balance evaluated at the blended skin temperature, floored at zero, and the melt rate is ex = flx3/(rho_w lsubf). That rate is a rate: it needs no differencing and has no dt dependence. WRF then applies TWO projections on top of it, both explicitly finite-dt, and this component reports each as an indicator rather than folding it into the rate. `pack_exhausted` is WRF's `esd - esnow2 <= esdmin` test, which zeroes the whole melt block when a step's sublimation would finish the pack; esnow2 is a sublimation AMOUNT, esnow1 dt, so the test is dt-dependent and in the dt -> 0 limit reduces to esd <= esdmin. `melt_limited` is WRF's `esd - snomlt < esdmin` test, which rewrites ex as esd/dt when a step's melt would overshoot the remaining pack -- a rate manufactured from an amount, and the clearest finite-dt artefact in the routine. A consumer integrating ex must apply both as projections of the state after its step, exactly as it would the supersaturation redistribution in soil_moisture.esm; neither belongs in a tendency. NOT TRANSCRIBED: the whole UA_PHYS branch (flx4, etpn and the canopy-shading adjustment to the melt energy), which is off in every reference run; SNOWPACK's compaction of the pack, which is a separate routine and a separate component; and the evaporation split itself -- etns, the non-snow-covered evaporation energy, is a consumer-supplied input here because it comes from EVAPO with the (1 - sncovr) weighting SNOPAC applies around it. Consumer-supplied column fields are rewrite-target ops `input_<name>` lowered by the consumer, in the inline tests through per-test expression_template_imports libraries generated by tools/fill_tests.py.",
  "license": "MIT",
  "tags": [
   "wrf",
   "land-surface",
   "noah",
   "snow",
   "surface-energy-balance",
   "snowmelt"
  ],
  "references": [
   {
    "citation": "Koren, V., et al. (1999). A parameterization of snowpack and frozen ground intended for NCEP weather and climate models. J. Geophys. Res., 104(D16), 19569-19585."
   },
   {
    "citation": "Ek, M. B., et al. (2003). Implementation of Noah land surface model advances in the NCEP operational mesoscale Eta model. J. Geophys. Res., 108(D22), 8851."
   },
   {
    "citation": "Livneh, B., et al. (2010). Noah LSM snow model diagnostics and enhancements. J. Hydrometeor., 11, 721-738."
   },
   {
    "citation": "wrf-model/WRF v4.8.0 phys/module_sf_noahlsm.F SUBROUTINE SNOPAC lines 3070-3400 (cold-season reference run instrumented in ctessum-claude/WRF branch earthsciml-instrumented-noahcold, commit 4695cee3)."
   }
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 4,
   "description": "Number of soil layers, WRF num_soil_layers. Bound into the column grid at the import edge."
  }
 },
 "models": {
  "NoahSnowEnergy": {
   "expression_template_imports": [
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/grid.esm",
     "bindings": {
      "NLEV": "NLEV"
     }
    }
   ],
   "subsystems": {
    "par": {
     "ref": "./noah_parameters.esm"
    }
   },
   "variables": {
    "ze": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "description": "Soil layer interface DEPTHS below the surface, positive downward, ze[1] = 0."
    },
    "stc": {
     "type": "unknown",
     "units": "K",
     "shape": [
      "lev"
     ],
     "description": "Soil temperature of each layer, WRF's STC. Only the top layer is read, through the conduction term."
    },
    "sfctmp": {
     "type": "parameter",
     "units": "K",
     "default": 265.0,
     "description": "Air temperature at the lowest model level."
    },
    "th2": {
     "type": "parameter",
     "units": "K",
     "default": 265.0,
     "description": "Potential temperature at the lowest model level referenced to the surface pressure."
    },
    "t1_in": {
     "type": "parameter",
     "units": "K",
     "default": 265.0,
     "description": "Skin temperature carried in from the previous step. Read ONLY by flx1, the sensible-heat content of falling precipitation, which WRF evaluates before the new skin temperature exists."
    },
    "rch": {
     "type": "parameter",
     "units": "W/(m^2*K)",
     "default": 10.0,
     "description": "Bulk heat-transfer coefficient in energy units, from the Penman component."
    },
    "rr": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "Resistance ratio, from the Penman component."
    },
    "t24": {
     "type": "parameter",
     "units": "K^4",
     "default": 4900000000.0,
     "description": "Fourth power of the AIR temperature, from the Penman component: the linearisation point of the surface emission in t12a."
    },
    "fdown": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 300.0,
     "description": "Total absorbed downward radiation at the surface, solnet + lwdn."
    },
    "flx2": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Latent heat released by freezing rain on impact, from the Penman component."
    },
    "emissi": {
     "type": "parameter",
     "units": "1",
     "default": 0.95,
     "description": "Surface emissivity, from the snow-cover component."
    },
    "df1": {
     "type": "parameter",
     "units": "W/(m*K)",
     "default": 0.2,
     "description": "Conductivity of the combined snow-and-soil path, WRF's DF1 after SFLX has blended the snow conductivity into the soil value by snow-cover fraction."
    },
    "snowh": {
     "type": "parameter",
     "units": "m",
     "default": 0.3,
     "description": "Physical depth of the pack."
    },
    "sncovr": {
     "type": "parameter",
     "units": "1",
     "default": 0.98,
     "description": "Snow-cover fraction, from the snow-cover component."
    },
    "prcp": {
     "type": "parameter",
     "units": "kg/(m^2*s)",
     "default": 0.0,
     "description": "Precipitation rate reaching the surface."
    },
    "snowing": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Indicator (1/0) for WRF's SNOWNG, which selects the ice rather than the liquid heat capacity for falling precipitation."
    },
    "esd": {
     "type": "parameter",
     "units": "m",
     "default": 0.06,
     "description": "Snow water equivalent of the pack entering the step, WRF's ESD. Read only by the two finite-dt projections."
    },
    "dt_pack": {
     "type": "parameter",
     "units": "s",
     "default": 60.0,
     "description": "Sub-step over which the two pack projections are evaluated. A parameter of the projections, not the integrator's step, and it does NOT enter the melt rate: prescribe it in the mounting document."
    },
    "dsoil": {
     "type": "unknown",
     "units": "m",
     "description": "Half the top soil layer, 0.5 ze[2], the soil part of the conductive path."
    },
    "dtot": {
     "type": "unknown",
     "units": "m",
     "description": "Total conductive path, snowh + dsoil: the pack plus the upper half of the top soil layer, treated as one slab."
    },
    "denom": {
     "type": "unknown",
     "units": "1",
     "description": "1 + df1/(dtot rr rch): how strongly the soil below holds the snow surface, relative to the atmosphere above. It tends to 1 for a deep pack, where the surface decouples from the soil."
    },
    "flx1": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Sensible heat carried by falling precipitation, cpice prcp (t1_in - sfctmp) when it is snowing and cph2o prcp (t1_in - sfctmp) for rain, zero with no precipitation. Evaluated at the INCOMING skin temperature."
    },
    "etanrg": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Total latent-heat flux the balance must dispose of, WRF's ETANRG = esnow lsubs + etns lvh2o: sublimation from the pack at the latent heat of SUBLIMATION plus evaporation from the bare fraction at the latent heat of vaporisation. Consumer-supplied, because the split between the two comes from EVAPO with the (1 - sncovr) weighting SNOPAC applies around it."
    },
    "t12a": {
     "type": "unknown",
     "units": "K",
     "description": "The forcing term of the closure: net radiation at the linearisation temperature, less the precipitation and freezing-rain heat and the latent flux, expressed as a temperature through rch and rr, plus the air's potential-temperature offset."
    },
    "t12b": {
     "type": "unknown",
     "units": "K",
     "description": "The conduction term, df1 stc[1]/(dtot rr rch): the top soil layer pulling the snow surface towards itself."
    },
    "t12": {
     "type": "unknown",
     "units": "K",
     "description": "Snow-surface temperature with NO melting, (sfctmp + t12a + t12b)/denom. Its position relative to the freezing point is what selects the branch."
    },
    "melting": {
     "type": "unknown",
     "units": "1",
     "description": "Indicator, 1 where t12 exceeds the freezing point and SNOPAC takes its melt block. 29 of the 84 cold-season reference steps; 38 take the sub-freezing block."
    },
    "cover_weight": {
     "type": "unknown",
     "units": "1",
     "description": "max(0.01, sncovr^2), the weight with which the melting surface is pinned to the freezing point. The floor of 0.01 keeps a vanishing pack from decoupling entirely."
    },
    "t1": {
     "type": "unknown",
     "units": "K",
     "description": "Skin temperature: t12 itself on the sub-freezing branch, and on the melt branch the cover-weighted blend of the freezing point and t12, so a full pack holds the surface at 273.15 K while a thin one lets it run warm."
    },
    "ssoil": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Ground heat flux through the combined path, df1 (t1 - stc[1])/dtot, positive downward into the soil. Note this is WRF's pre-flip sign convention inside SNOPAC; SFLX negates it before reporting."
    },
    "seh": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Sensible heat flux at the melting surface, rch (t1 - th2). Assigned only inside the melt block in WRF, and meaningful only there."
    },
    "t14": {
     "type": "unknown",
     "units": "K^4",
     "description": "Fourth power of the SKIN temperature, used for the emission in the melt residual -- unlike t24 in t12a, which uses the air temperature."
    },
    "flx3_raw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Residual of the energy balance at the melting surface, fdown - flx1 - flx2 - emissi sigma t14 - ssoil - seh - etanrg, before it is floored."
    },
    "flx3": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "The melt energy, max(flx3_raw, 0) on the melt branch and exactly zero on the sub-freezing branch."
    },
    "ex": {
     "type": "unknown",
     "units": "m/s",
     "description": "Melt rate as a water velocity, flx3/(rho_water lsubf). This is a RATE and is what a consumer integrates; it carries no dt dependence and needs no differencing, which is why it is referenced directly rather than through the snow amount."
    },
    "pack_exhausted": {
     "type": "unknown",
     "units": "1",
     "description": "Indicator for WRF's esd - esnow1 dt_pack <= esdmin test, which zeroes the entire melt block when a step's sublimation would finish the pack. A PROJECTION of the state, dt-dependent by construction, reported rather than applied; in the dt -> 0 limit it reduces to esd <= esdmin."
    },
    "melt_limited": {
     "type": "unknown",
     "units": "1",
     "description": "Indicator for WRF's esd - ex dt_pack < esdmin test, which rewrites the melt rate as esd/dt_pack when a step's melt would overshoot the remaining pack. A rate manufactured from an amount, and the clearest finite-dt artefact in the routine: a PROJECTION, reported rather than applied. UNTESTED against the reference set's melt branch, which never reaches it at the replay step size."
    },
    "esnow_rate": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "Sublimation from the snow-covered fraction as a water velocity, WRF's ESNOW1. Read ONLY by the pack-exhaustion projection. Negative means deposition."
    }
   },
   "equations": [
    {
     "lhs": "ze",
