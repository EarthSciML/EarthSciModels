   "tests": [
     {
       "id": "usgs_siltloam_cropland",
       "description": "Reference: the VEGPARM/SOILPARM/GENPARM tables WRF loaded for the chem_opt = 170 idealized-column run (USGS land use, STAS soils), carried verbatim in the tbl_* fields of data/eqwefic/dumps/chem170_wrf/esm_dump_noah_601.json, for soiltyp = 4 (silt loam), vegtyp = 2 (dryland cropland and pasture) and slopetyp = 1. The four assertions that REDPRM itself produces -- smcmax, smcref, smcwlt, smcdry, plus nroot, rsmin and xlai -- are end-to-end: they compare against what SFLX returned, not against the table this component was built from. The remaining soil assertions are TRANSCRIPTION CHECKS against the same table, so they catch an off-by-one in the category index or a corrupted row but cannot catch a table that was wrong to begin with; the seven single-soil-type tests below are the independent check. shdmin = shdmax = 0 here, so the greenness selection takes the shdfac >= shdmax branch and xlai = laimax.",
       "parameter_overrides": {
         "soiltyp": 4.0,
         "vegtyp": 2.0,
         "slopetyp": 1.0,
         "shdfac": 0.5,
         "shdmin": 0.0,
         "shdmax": 0.0
       },
       "time_span": {
         "start": 0.0,
         "end": 1.0
       },
       "assertions": [
         {
           "variable": "bexp",
           "time": 0.0,
           "expected": 5.329999923706055,
           "tolerance": {
             "rel": 1e-12
           }
         },
         {
           "variable": "dksat",
           "time": 0.0,
           "expected": 2.8100000690756133e-06,
           "tolerance": {
             "rel": 1e-12
           }
         },
         {
