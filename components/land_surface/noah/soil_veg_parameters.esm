{
 "esm": "1.1.0",
 "metadata": {
  "name": "NoahSoilVegParameters",
  "description": "SUBROUTINE REDPRM of phys/module_sf_noahlsm.F (WRF 4.8, sf_surface_physics = 2): the per-soil-type, per-vegetation-type and per-slope-type parameters Noah copies out of SOILPARM.TBL, VEGPARM.TBL and GENPARM.TBL for the grid cell it is about to run, plus the four quantities REDPRM derives from them (kdt, frzfact, frzx) and the four it selects by greenness (xlai, embrd, z0brd, alb). Each lookup is interp.linear on a constant table with a constant integer axis, the pattern anderson13_fuel_table.esm already uses: the category index lands exactly on an axis knot, so the interpolation returns the table entry unchanged, and a category outside the table clamps at the end rather than reading past it. TWO THINGS A CONSUMER MUST CHECK. (1) The vegetation table is the USGS 27-category one. WRF also ships a 20-category MODIS table (isurban = 13 instead of 1) with different rows, and the real-terrain reference run in data/eqwefic/gwdo_real uses THAT one, so this component must not be mounted for a MODIS run; the SOILPARM table is the same in both, which is why the soil half of this component is tested against seven soil types drawn from the real-terrain dumps and the vegetation half only against the idealized column. (2) The table values are the REAL32-WIDENED numbers WRF actually held, not the decimal text of the .TBL files: those tables are read into real32 arrays, so a real64 reference replay uses the widened single, and writing the decimal instead puts up to 2.3e-8 relative error into smcmax -- six times the 1e-9 tolerance these tests run at. The urban override REDPRM applies when vegtyp == isurban (smcmax 0.45, smcref 0.42, smcwlt 0.40, smcdry 0.40) is NOT transcribed, and neither is the fatal-error path for an out-of-range category; a consumer must not mount this on an urban cell.",
  "license": "MIT",
  "tags": [
   "wrf",
   "land-surface",
   "noah",
   "lookup-table",
   "soil-parameters",
   "vegetation-parameters"
  ],
  "references": [
   {
    "citation": "Cosby, B. J., et al. (1984). A statistical exploration of the relationships of soil moisture characteristics to the physical properties of soils. Water Resour. Res., 20, 682-690."
   },
   {
    "citation": "Chen, F., and J. Dudhia (2001). Coupling an advanced land surface-hydrology model with the Penn State-NCAR MM5 modeling system. Part I. Mon. Wea. Rev., 129, 569-585."
   },
   {
    "citation": "wrf-model/WRF v4.8.0 phys/module_sf_noahlsm.F SUBROUTINE REDPRM lines 2315-2535, and the SOILPARM.TBL (STAS, 19 categories), VEGPARM.TBL (USGS, 27 categories) and GENPARM.TBL that run/ ships; values as WRF loaded them, carried in the tbl_* fields of the `noah` dump."
   }
  ]
 },
 "models": {
  "NoahSoilVegParameters": {
   "subsystems": {
    "par": {
     "ref": "./noah_parameters.esm"
    }
   },
   "variables": {
    "soiltyp": {
     "type": "parameter",
     "units": "1",
     "default": 4.0,
     "description": "Soil category index into SOILPARM.TBL, 1..19 for the shipped STAS table (4 = silt loam). An out-of-range value gathers off the end of the table; WRF's REDPRM would stop the run instead."
    },
    "vegtyp": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "Vegetation category index into VEGPARM.TBL, 1..27 for USGS (2 = dryland cropland and pasture). The MODIS table is a DIFFERENT table with a different length and different rows; this component carries the USGS one, so a MODIS run must not mount it."
    },
    "slopetyp": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "Slope category index into GENPARM.TBL SLOPE_DATA, 1..9."
    },
    "bexp": {
     "type": "unknown",
     "units": "1",
     "description": "Clapp-Hornberger pore-size distribution index b, SOILPARM.TBL BB. Sets the steepness of both the retention curve and the conductivity curve."
    },
    "dksat": {
     "type": "unknown",
     "units": "m/s",
     "description": "Saturated hydraulic conductivity, SOILPARM.TBL SATDK."
    },
    "dwsat": {
     "type": "unknown",
     "units": "m^2/s",
     "description": "Saturated soil water diffusivity, SOILPARM.TBL SATDW."
    },
    "f1": {
     "type": "unknown",
     "units": "1",
     "description": "SOILPARM.TBL F11, a soil-type coefficient of the (unused in WRF 4.8) alternative thermal-conductivity form. Carried because REDPRM sets it and SHFLX passes it on."
    },
    "psisat": {
     "type": "unknown",
     "units": "m",
     "description": "Saturated soil matric potential, SOILPARM.TBL SATPSI."
    },
    "quartz": {
     "type": "unknown",
     "units": "1",
     "description": "Quartz volume fraction, SOILPARM.TBL QTZ, which sets the solid-phase thermal conductivity in TDFCND."
    },
    "smcdry": {
     "type": "unknown",
     "units": "m^3/m^3",
     "description": "Air-dry soil moisture, SOILPARM.TBL DRYSMC, at which direct soil evaporation ceases. Identical to smcwlt in the shipped STAS table for every soil type."
    },
    "smcmax": {
     "type": "unknown",
     "units": "m^3/m^3",
     "description": "Soil porosity (saturation moisture), SOILPARM.TBL MAXSMC."
    },
    "smcref": {
     "type": "unknown",
     "units": "m^3/m^3",
     "description": "Soil reference moisture (field capacity), SOILPARM.TBL REFSMC, above which transpiration is unstressed."
    },
    "smcwlt": {
     "type": "unknown",
     "units": "m^3/m^3",
     "description": "Soil wilting point, SOILPARM.TBL WLTSMC."
    },
    "slope": {
     "type": "unknown",
     "units": "1",
     "description": "Bottom drainage-slope factor, GENPARM.TBL SLOPE_DATA, which multiplies the free-drainage flux out of the deepest soil layer."
    },
    "nroot": {
     "type": "unknown",
     "units": "1",
     "description": "Number of soil layers in the root zone, VEGPARM.TBL NROTBL. Carried as a real count because TRANSP divides an UNWEIGHTED sum by it."
    },
    "rsmin": {
     "type": "unknown",
     "units": "s/m",
     "description": "Minimum (unstressed) stomatal resistance, VEGPARM.TBL RSTBL."
    },
    "rgl": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Solar-radiation threshold of the rcs stress function, VEGPARM.TBL RGLTBL."
    },
    "hs": {
     "type": "unknown",
     "units": "kg/kg",
     "description": "Vapour-pressure-deficit coefficient of the rcq stress function, VEGPARM.TBL HSTBL."
    },
    "snup": {
     "type": "unknown",
     "units": "m",
     "description": "Snow depth at which the snow-cover fraction reaches one, VEGPARM.TBL SNUPTBL. Carried for the snow branch, which is not yet written."
    },
    "laimin": {
     "type": "unknown",
     "units": "1",
     "description": "Leaf area index at minimum greenness, VEGPARM.TBL LAIMINTBL."
    },
    "laimax": {
     "type": "unknown",
     "units": "1",
     "description": "Leaf area index at maximum greenness, VEGPARM.TBL LAIMAXTBL."
    },
    "emissmin": {
     "type": "unknown",
     "units": "1",
     "description": "Surface emissivity at minimum greenness, VEGPARM.TBL EMISSMINTBL."
    },
    "emissmax": {
     "type": "unknown",
     "units": "1",
     "description": "Surface emissivity at maximum greenness, VEGPARM.TBL EMISSMAXTBL."
    },
    "z0min": {
     "type": "unknown",
     "units": "m",
     "description": "Roughness length at minimum greenness, VEGPARM.TBL Z0MINTBL."
    },
    "z0max": {
     "type": "unknown",
     "units": "m",
     "description": "Roughness length at maximum greenness, VEGPARM.TBL Z0MAXTBL."
    },
    "albedomin": {
     "type": "unknown",
     "units": "1",
     "description": "Background albedo at MAXIMUM greenness, VEGPARM.TBL ALBEDOMINTBL. The name is WRF's and it is the wrong way round: REDPRM assigns ALBEDOMIN when shdfac >= shdmax."
    },
    "albedomax": {
     "type": "unknown",
     "units": "1",
     "description": "Background albedo at MINIMUM greenness, VEGPARM.TBL ALBEDOMAXTBL. See albedomin: the two are used in the opposite sense to their names."
    },
    "kdt": {
     "type": "unknown",
     "units": "1",
     "description": "Infiltration parameter, refkdt dksat/refdk: the reference infiltration parameter rescaled by how conductive this soil is relative to the reference soil."
    },
    "frzfact": {
     "type": "unknown",
     "units": "1",
     "description": "Frozen-ground scaling factor, (smcmax/smcref)(0.412/0.468), where the two literals are the reference soil's porosity and field capacity."
    },
    "frzx": {
     "type": "unknown",
     "units": "1",
     "description": "Per-soil-type frozen-ground parameter, frzk frzfact, which sets how strongly soil ice throttles infiltration. Used only by the frozen branch of SRT, which this reference set never exercises."
    },
    "interp_fraction": {
     "type": "unknown",
     "units": "1",
     "description": "Greenness interpolation weight, clamp((shdfac - shdmin)/(shdmax - shdmin), 0, 1); 0.5 where shdmax equals shdmin."
    },
    "shdfac": {
     "type": "parameter",
     "units": "1",
     "default": 0.5,
     "description": "Green vegetation fraction of this time step, WRF's SHDFAC."
    },
    "shdmin": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Annual MINIMUM green vegetation fraction, WRF's SHDMIN."
    },
    "shdmax": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Annual MAXIMUM green vegetation fraction, WRF's SHDMAX. In the idealized reference run shdmin = shdmax = 0, so every point takes the shdfac >= shdmax branch and xlai = laimax."
    },
    "xlai": {
     "type": "unknown",
     "units": "1",
     "description": "Leaf area index selected by greenness between laimin and laimax (the .NOT. RDLAI2D branch; a run that reads LAI from the input file bypasses this)."
    },
    "embrd": {
     "type": "unknown",
     "units": "1",
     "description": "Background surface emissivity selected by greenness between emissmin and emissmax."
    },
    "z0brd": {
     "type": "unknown",
     "units": "m",
     "description": "Background roughness length selected by greenness between z0min and z0max."
    },
    "alb": {
     "type": "unknown",
     "units": "1",
     "description": "Background albedo selected by greenness. NOTE THE ORDER: WRF takes ALBEDOMIN at MAXIMUM greenness and ALBEDOMAX at minimum, the opposite of the other three, because a green canopy is darker than bare ground. The .NOT. USEMONALB branch."
    }
   },
