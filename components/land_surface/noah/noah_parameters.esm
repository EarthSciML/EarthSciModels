{
 "esm": "1.2.0",
 "metadata": {
  "name": "NoahParameters",
  "description": "Scheme constants of WRF's unified Noah land-surface model, transcribed from the module- and subroutine-level PARAMETER statements and the GENPARM.TBL scalars of phys/module_sf_noahlsm.F (WRF 4.8, sf_surface_physics = 2). Mounted by every Noah component as subsystem `par` so that no tuning constant is written inline in the physics. Two groups: (a) the thermodynamic constants Noah redefines for itself, which do NOT agree with lib/wrf_constants.esm and must not be taken from there -- Noah's rd = 287.04 against the dynamics' 287.0, Noah's sigma = 5.67e-8 against the dynamics' 5.67051e-8, and, inside SUBROUTINE PENMAN alone, cp = 1004.6 against the cp = 1004.5 that module_model_constants supplies to the rest of the module (FORTRAN_BUGS N88); and (b) the GENPARM.TBL scalars that REDPRM copies into the scheme, whose values are those WRF loaded for the reference runs and are carried in the `*_data` fields of the `noah` dump. Volumetric heat capacities (cair_vol, cice_vol, ch2o_vol) are the SUBROUTINE HRT literals, not the mass-specific cph2o/cpice of the module header; both appear in the scheme and they are different quantities. Group (a) carries the nominal decimal values of the Fortran PARAMETER statements: a real64 kernel build evaluates those literals in double precision, so the nominal value is what a reference replay uses. Group (b) is DIFFERENT -- those numbers reach the scheme through a real32 table array, so the value the scheme uses, and that a real64 replay reproduces, is the SINGLE-PRECISION representation of the table's decimal text. Five of them are not exactly representable and their defaults are therefore the widened singles (cmcmax, salp, refdk, frzk, czil); using the decimal instead puts a 4.7e-8 relative error into cmcmax, which a canopy-wetness ratio near one amplifies into a 1.5e-5 error in the transpiration.",
  "license": "MIT",
  "tags": [
   "wrf",
   "land-surface",
   "noah",
   "scheme-constants"
  ],
  "references": [
   {
    "citation": "Chen, F., and J. Dudhia (2001). Coupling an advanced land surface-hydrology model with the Penn State-NCAR MM5 modeling system. Part I: Model implementation and sensitivity. Mon. Wea. Rev., 129, 569-585."
   },
   {
    "citation": "Ek, M. B., et al. (2003). Implementation of Noah land surface model advances in the NCEP operational mesoscale Eta model. J. Geophys. Res., 108(D22), 8851."
   },
   {
    "citation": "wrf-model/WRF v4.8.0 phys/module_sf_noahlsm.F lines 24-27 (module PARAMETERs), 375-377 (SFLX), 2221-2222 (PENMAN), 1616-1617 (HRT), and the GENPARM.TBL scalars copied by SUBROUTINE REDPRM lines 2440-2535."
   }
  ]
 },
 "models": {
  "NoahParameters": {
   "variables": {
    "rd": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 287.04,
     "description": "Gas constant for dry air as Noah defines it (module PARAMETER RD, and the SFLX-local R). Deliberately NOT wrf.r_d = 287.0: the two differ by 1.4e-4 relative and both appear in the same WRF executable (FORTRAN_BUGS N88)."
    },
    "sigma": {
     "type": "parameter",
     "units": "W/(m^2*K^4)",
     "default": 5.67e-08,
     "description": "Stefan-Boltzmann constant as Noah defines it (module PARAMETER SIGMA). Deliberately NOT wrf.stbolt = 5.67051e-8; the two differ by 9e-5 relative (FORTRAN_BUGS N88)."
    },
    "cp_penman": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 1004.6,
     "description": "Specific heat of dry air at constant pressure as SUBROUTINE PENMAN alone defines it (its local PARAMETER CP = 1004.6). Every other routine in the module uses the cp = 1004.5 imported from module_model_constants, so a single Noah call evaluates two different cp (FORTRAN_BUGS N88). Only the Penman component reads this one."
    },
    "cph2o": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 4218.0,
     "description": "Specific heat of liquid water, module PARAMETER CPH2O, used for the sensible-heat content of falling rain in PENMAN and for FLX1."
    },
    "cpice": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 2106.0,
     "description": "Specific heat of ice, module PARAMETER CPICE, used for the sensible-heat content of falling snow in PENMAN."
    },
    "lsubf": {
     "type": "parameter",
     "units": "J/kg",
     "default": 333500.0,
     "description": "Latent heat of fusion, module PARAMETER LSUBF, used for FLX2 when freezing rain reaches the ground."
    },
    "lvh2o": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2501000.0,
     "description": "Latent heat of vaporisation, SFLX PARAMETER LVH2O; converts the kinematic evaporation terms to W/m^2 at the end of SFLX."
    },
    "lsubs": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2830000.0,
     "description": "Latent heat of sublimation, SFLX PARAMETER LSUBS; weights the snow-covered fraction of the potential-evaporation conversion."
    },
    "elcp": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2488.8,
     "description": "PENMAN's PARAMETER ELCP = 2.4888e3, the latent heat of vaporisation divided by the specific heat of air (L/cp), used to express the vapour-pressure deficit as a temperature. It is a ratio expressed in K per unit specific humidity, hence J/kg as a (L/cp) group in the Penman numerator; carried with PENMAN's own value rather than rebuilt from lvh2o/cp_penman, which would give 2489.5."
    },
    "t0": {
     "type": "parameter",
     "units": "K",
     "default": 273.15,
     "description": "Freezing point used by the soil thermal routines (HRT/SNKSRC PARAMETER T0). Note it is 273.15, while the module's phase-change routine FRH2O uses the same value but WRF's microphysics uses 273.16."
    },
    "cair_vol": {
     "type": "parameter",
     "units": "J/(m^3*K)",
     "default": 1004.0,
     "description": "Volumetric heat capacity of the soil air fraction, HRT PARAMETER CAIR."
    },
    "cice_vol": {
     "type": "parameter",
     "units": "J/(m^3*K)",
     "default": 2106000.0,
     "description": "Volumetric heat capacity of soil ice, HRT PARAMETER CICE = 2.106e6."
    },
    "ch2o_vol": {
     "type": "parameter",
     "units": "J/(m^3*K)",
     "default": 4200000.0,
     "description": "Volumetric heat capacity of soil water, HRT PARAMETER CH2O = 4.2e6. Not 4.218e6: the mass-specific cph2o of the module header and this volumetric literal disagree by 0.4 % about the same substance."
    },
    "topt": {
     "type": "parameter",
     "units": "K",
     "default": 298.0,
     "description": "GENPARM.TBL TOPT_DATA, the optimum transpiration air temperature of the Jarvis temperature stress function."
    },
    "cmcmax": {
     "type": "parameter",
     "units": "m",
     "default": 0.0005000000237487257,
     "description": "GENPARM.TBL CMCMAX_DATA, the maximum canopy water capacity. TABLE VALUE: WRF reads GENPARM.TBL into a real32 array, so the number the scheme actually uses is the single-precision representation of the table's decimal text; the default here is that widened single, not the decimal, because it is what a real64 replay of WRF reproduces. The table text reads 5.E-4."
    },
    "cfactr": {
     "type": "parameter",
     "units": "1",
     "default": 0.5,
     "description": "GENPARM.TBL CFACTR_DATA, the exponent of the canopy-wetness fraction in the canopy-evaporation and transpiration partition."
    },
    "rsmax": {
     "type": "parameter",
     "units": "s/m",
     "default": 5000.0,
     "description": "GENPARM.TBL RSMAX_DATA, the maximum stomatal resistance, which sets the dark-limit floor rsmin/rsmax of the solar stress factor."
    },
    "sbeta": {
     "type": "parameter",
     "units": "1",
     "default": -2.0,
     "description": "GENPARM.TBL SBETA_DATA, the exponent that reduces the surface soil thermal conductivity under a canopy, df1 = df1 exp(sbeta shdfac)."
    },
    "fxexp": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "GENPARM.TBL FXEXP_DATA, the exponent of the bare-soil evaporation efficiency."
    },
    "csoil": {
     "type": "parameter",
     "units": "J/(m^3*K)",
     "default": 2000000.0,
     "description": "GENPARM.TBL CSOIL_DATA, the volumetric heat capacity of the soil mineral fraction."
    },
    "salp": {
     "type": "parameter",
     "units": "1",
     "default": 2.5999999046325684,
     "description": "GENPARM.TBL SALP_DATA, the shape parameter of the snow-cover fraction curve. Carried for completeness; the snow-free components do not read it. TABLE VALUE: WRF reads GENPARM.TBL into a real32 array, so the number the scheme actually uses is the single-precision representation of the table's decimal text; the default here is that widened single, not the decimal, because it is what a real64 replay of WRF reproduces. The table text reads 2.6."
    },
    "zbot": {
     "type": "parameter",
     "units": "m",
     "default": -8.0,
     "description": "GENPARM.TBL ZBOT_DATA, the depth at which the deep-soil temperature tbot is prescribed, in WRF's sign convention (negative downward)."
    },
    "refdk": {
     "type": "parameter",
     "units": "m/s",
     "default": 1.9999999949504854e-06,
     "description": "GENPARM.TBL REFDK_DATA, the reference saturated hydraulic conductivity of the infiltration parameter kdt = refkdt dksat / refdk. TABLE VALUE: WRF reads GENPARM.TBL into a real32 array, so the number the scheme actually uses is the single-precision representation of the table's decimal text; the default here is that widened single, not the decimal, because it is what a real64 replay of WRF reproduces. The table text reads 2.0E-6."
    },
    "refkdt": {
     "type": "parameter",
     "units": "1",
     "default": 3.0,
     "description": "GENPARM.TBL REFKDT_DATA, the reference infiltration parameter."
    },
    "frzk": {
     "type": "parameter",
     "units": "1",
     "default": 0.15000000596046448,
     "description": "GENPARM.TBL FRZK_DATA, the reference frozen-ground parameter, scaled per soil type into frzx. TABLE VALUE: WRF reads GENPARM.TBL into a real32 array, so the number the scheme actually uses is the single-precision representation of the table's decimal text; the default here is that widened single, not the decimal, because it is what a real64 replay of WRF reproduces. The table text reads 0.15."
    },
    "czil": {
     "type": "parameter",
     "units": "1",
     "default": 0.10000000149011612,
     "description": "GENPARM.TBL CZIL_DATA, the Zilitinkevich coefficient of the thermal roughness length. Read by the surface-exchange routine SFCDIF, which WRF bypasses when a separate surface-layer scheme supplies ch; carried for completeness. TABLE VALUE: WRF reads GENPARM.TBL into a real32 array, so the number the scheme actually uses is the single-precision representation of the table's decimal text; the default here is that widened single, not the decimal, because it is what a real64 replay of WRF reproduces. The table text reads 0.1."
    },
    "lvcoef": {
     "type": "parameter",
     "units": "1",
     "default": 0.5,
     "description": "GENPARM.TBL LVCOEF_DATA, the snow-albedo decay coefficient. Carried for completeness; the snow-free components do not read it."
    },
    "rho_water": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 1000.0,
     "description": "Density of liquid water as the frozen-soil routines define it (SNKSRC's PARAMETER DH2O = 1.0000E3, FRH2O's DH2O = 1000.0). Numerically equal to wrf.rhowater, written separately because the Fortran declares it separately."
    },
    "hlice": {
     "type": "parameter",
     "units": "J/kg",
     "default": 333500.0,
     "description": "Latent heat of fusion as the frozen-soil routines define it (SNKSRC's and FRH2O's PARAMETER HLICE = 3.3350E5). Numerically equal to par.lsubf; the module declares the same constant twice under two names."
    },
    "snow_c1": {
     "type": "parameter",
     "units": "1/(cm*h)",
     "default": 0.01,
     "description": "SNOWPACK's C1, the fractional increase in snow density per centimetre of overlying water equivalent per hour, in Koren's approximate solution of E. Anderson's compaction equation (3.29), NOAA Technical Report NWS 19. WRF: SUBROUTINE SNOWPACK, PARAMETER C1 = 0.01. The routine works in its own 'simulation units' of centimetres and hours, and this constant carries them."
    },
    "snow_c2": {
     "type": "parameter",
     "units": "1",
     "default": 21.0,
     "description": "SNOWPACK's C2, Kojima's density coefficient in the compaction exponent exp(0.08 tavgc - c2 sndens). WRF: PARAMETER C2 = 21.0, and its comment calls it 'a constant (cm3/g) Kojima estimated as 21 cms/g'. Declared dimensionless here because the density it multiplies is carried as the dimensionless fraction of the density of water (WRF's own comment on SNDENS: 'G/CM3=DIMENSIONLESS FRACTION OF H2O DENSITY'), which is numerically the density in g/cm^3; the product is dimensionless either way."
    },
    "snow_ctemp": {
     "type": "parameter",
     "units": "1/K",
     "default": 0.08,
     "description": "The temperature coefficient of the compaction exponent, WRF's in-line 0.08 in EXP(0.08*TAVGC - C2*SNDENS). TAVGC is a Celsius temperature, i.e. a temperature measured from the freezing point, and a difference of one degree Celsius is a difference of one kelvin, so the coefficient is per kelvin."
    },
    "snow_dwrate": {
     "type": "parameter",
     "units": "1/d",
     "default": 0.13,
     "description": "SNOWPACK's melt-water retention rate: 13 % of the liquid water can be stored in the pack per DAY during snowmelt, until the density reaches 0.40. WRF's in-line 0.13 in DW = 0.13*DTHR/24."
    },
    "snow_dens_max": {
     "type": "parameter",
     "units": "1",
     "default": 0.4,
     "description": "Upper limit SNOWPACK imposes on the snow density, as a fraction of the density of water. WRF applies it twice: to the compacted density DSX, and again to the density after melt-water retention."
    },
    "snow_dens_min": {
     "type": "parameter",
     "units": "1",
     "default": 0.05,
     "description": "Lower limit SNOWPACK imposes on the compacted snow density, as a fraction of the density of water. WRF: IF (DSX < 0.05) DSX = 0.05."
    },
    "snow_esdc_min": {
     "type": "parameter",
     "units": "cm",
     "default": 0.01,
     "description": "Floor SNOWPACK puts under the water equivalent BEFORE forming the compaction argument, WRF's ESDCX: IF (ESDC > 1.E-2) THEN ESDCX = ESDC ELSE ESDCX = 1.E-2. It bounds the overburden a vanishing pack can feel, and it does NOT apply to the depth diagnostic at the end, which uses the unfloored ESDC."
    },
    "snow_new_dens": {
     "type": "parameter",
     "units": "1",
     "default": 0.05,
     "description": "Density of freshly fallen snow at or below snow_new_tcold, as a fraction of the density of water. WRF: SUBROUTINE SNOW_NEW's in-line 0.05, the constant term of Gottlib's (1980) fresh-snow density fit. Numerically equal to snow_dens_min, the floor SNOWPACK puts under the COMPACTED density, but a different quantity: this one is where new snow starts, that one is where compaction may not take it."
    },
    "snow_new_coef": {
     "type": "parameter",
     "units": "1/K^1.5",
     "default": 0.0017,
     "description": "Coefficient of Gottlib's (1980) fresh-snow density fit, dsnew = snow_new_dens + snow_new_coef (tempc - snow_new_tcold)^1.5: warmer snow falls denser. WRF's in-line 0.0017. Its units are fixed by the exponent, since the temperature excess it multiplies is raised to the 3/2 power and the result is a density fraction."
    },
    "snow_new_tcold": {
     "type": "parameter",
     "units": "K",
     "default": -15.0,
     "description": "Temperature below which Gottlib's fit is cut off and fresh snow takes its minimum density, measured from the freezing point (WRF's -15. against TEMPC = TEMP - 273.15). Below it the fit's 3/2 power would take the density below its floor and, for a negative argument, out of the reals."
    },
    "snow_new_hmin": {
     "type": "parameter",
     "units": "cm",
     "default": 0.001,
     "description": "Depth below which SNOW_NEW abandons the depth-weighted density average and takes max(dsnew, sndens) instead, WRF's 1.0E-3 in IF (SNOWHC + HNEWC .LT. 1.0E-3). It guards the average against a vanishing denominator when both the old pack and the new snowfall are negligible."
    },
    "snow_z0": {
     "type": "parameter",
     "units": "m",
     "default": 0.001,
     "description": "Aerodynamic roughness length of a snow surface, WRF's PARAMETER Z0S in SUBROUTINE SNOWZ0. It is the roughness the snow-covered fraction contributes once the vegetation beneath is fully buried."
    },
    "snow_z0_burial_factor": {
     "type": "parameter",
     "units": "1",
     "default": 7.0,
     "description": "How many roughness lengths of snow it takes to bury the vegetation, WRF's 7.0 in BURIAL = 7.0 Z0BRD - SNOWH. Roughness elements are treated as 7 z0brd tall, so the snow-covered roughness falls linearly from z0brd towards the snow value as the pack approaches that height."
    },
    "snow_z0_burial_min": {
     "type": "parameter",
     "units": "m",
     "default": 0.0007,
     "description": "Remaining exposed height below which SNOWZ0 stops interpolating and takes the bare snow roughness, WRF's 0.0007 in IF (BURIAL.LE.0.0007). Divided by snow_z0_burial_factor it is 1e-4 m, a tenth of snow_z0, so the linear branch is abandoned well before it would undercut the snow surface's own roughness."
    }
   },
   "equations": [],
   "tests": []
  }
 }
}
