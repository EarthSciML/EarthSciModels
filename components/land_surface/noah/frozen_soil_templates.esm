{
 "esm": "1.1.0",
 "metadata": {
  "name": "frozen_soil_templates",
  "description": "Expression templates of Noah's frozen-soil physics, transcribed from phys/module_sf_noahlsm.F (WRF 4.8): TMPAVG's freezing-clipped layer average and the two halves of FRH2O's Newton step. They are templates rather than equations because each is applied per soil layer inside a faq over `lev`, and FRH2O's pair is applied TWICE per layer -- the iteration is unrolled rather than written as a recurrence, which is exact here because the loop never runs past two iterations (FORTRAN_BUGS N95).",
  "license": "MIT",
  "tags": [
   "wrf",
   "land-surface",
   "noah",
   "frozen-soil",
   "templates"
  ],
  "references": [
   {
    "citation": "Koren, V., et al. (1999). J. Geophys. Res., 104(D16), 19569-19585."
   },
   {
    "citation": "wrf-model/WRF v4.8.0 phys/module_sf_noahlsm.F SUBROUTINE TMPAVG lines 4250-4352 and SUBROUTINE FRH2O lines 1447-1585."
   }
  ]
 },
 "expression_templates": {
  "tmpavg_clipped": {
   "params": [
    "tu",
    "tm",
    "td",
    "dzl",
