  "frh2o_residual": {
   "params": [
    "swl",
    "tavg",
    "smc",
    "smcmax",
    "bx",
    "psisat",
    "t0"
   ],
   "description": "FRH2O's Newton residual: log[(psisat g/hlice)(1 + ck swl)^2 (smcmax/(smc - swl))^bx] - log[-(tavg - t0)/tavg], the freezing-point depression relation in log form, zero at the equilibrium frozen water. ck = 8, g = 9.81 and hlice = 3.335e5 are FRH2O's own local PARAMETERs and are written here as it writes them.",
   "body": {
    "op": "-",
    "args": [
     {
      "op": "log",
      "args": [
       {
        "op": "*",
        "args": [
         {
          "op": "*",
          "args": [
           {
            "op": "/",
            "args": [
             {
              "op": "*",
              "args": [
               "psisat",
               9.81
              ]
             },
             333500.0
            ]
           },
           {
            "op": "^",
            "args": [
             {
              "op": "+",
              "args": [
               1.0,
               {
                "op": "*",
                "args": [
                 8.0,
                 "swl"
                ]
               }
              ]
             },
             2.0
            ]
           }
          ]
         },
         {
          "op": "^",
          "args": [
           {
            "op": "/",
            "args": [
             "smcmax",
             {
              "op": "-",
              "args": [
               "smc",
               "swl"
              ]
             }
            ]
           },
           "bx"
          ]
         }
        ]
       }
      ]
     },
     {
      "op": "log",
      "args": [
       {
        "op": "/",
        "args": [
         {
          "op": "-",
          "args": [
           0.0,
           {
            "op": "-",
            "args": [
             "tavg",
             "t0"
            ]
           }
          ]
         },
         "tavg"
        ]
       }
      ]
     }
    ]
   }
  },
  "frh2o_slope": {
   "params": [
    "swl",
    "smc",
    "bx"
   ],
   "description": "Derivative of frh2o_residual with respect to swl, 2 ck/(1 + ck swl) + bx/(smc - swl), which is FRH2O's DENOM.",
   "body": {
    "op": "+",
    "args": [
     {
      "op": "/",
      "args": [
       {
        "op": "*",
        "args": [
         2.0,
         8.0
        ]
       },
       {
        "op": "+",
        "args": [
         1.0,
         {
          "op": "*",
          "args": [
           8.0,
           "swl"
          ]
         }
        ]
       }
      ]
     },
     {
      "op": "/",
      "args": [
       "bx",
       {
        "op": "-",
        "args": [
         "smc",
         "swl"
        ]
       }
      ]
     }
    ]
   }
  }
 }
