{
 "esm": "1.3.0",
 "metadata": {
  "name": "clm_bareground_step",
  "description": "One-step update of the CLM bare-ground stability iteration (stage 2 of the EqESM project): a single pass of the do-while of BareGroundFluxes in stage1/cesm/components/clm/src/biogeophys/BareGroundFluxesMod.F90:342-388 (the FrictionVelocity call of :343-347 followed by the z0hg update, the stability-parameter update and the Obukhov-length update of :357-384), transcribed exactly and mounted three times by reference in clm_bareground.esm (top-level models.step1..step3, esm-spec section 4.7) so the 17-equation update law is authored once and the unrolled iteration is composed. Inputs are the update-invariant pointwise fields (the wind and temperature measurement heights forc_hgt_u/forc_hgt_t, the momentum roughness z0m = z0mg_patch which is constant across the iteration, the wind speed ur = max(wind_min, |forc_u,forc_v|), the temperature/humidity differences dth/dqh, the forcing specific/potential temperatures forc_q/forc_th, the virtual potential temperature thv, the convective velocity-scale inputs zii/beta, the zetamaxstable stability clamp and the physical constants vkc/grav/zetam/zetat/meier_param3/nu_param/beta_param) and the previous update's state (z0h_prev/obu_prev/um_prev). The iteration height is the step's own momentum profile height zldis_u = forc_hgt_u + z0m, which equals the parent's zldis = forc_hgt_u + z0mg (the redundant coupling is dropped), and the Fortran's stale wc local is computed unconditionally (only read by the unstable um branch; the dead wc threading is dropped). Outputs are the 17 update states (zldis_u = forc_hgt_u + z0m, zldis_t = forc_hgt_t + z0h_prev and zldis_2m = 2 + z0h_prev, the three profile heights of FrictionVelocityMod.F90:850-853, 946-949, 1022-1025; ustar from the four-branch momentum profile F90:857-871; temp1 from the four-branch scalar profile F90:956-970; temp2 = temp1 and temp22m = temp12m by the equality branch F90:997-998 and F90:1051-1052, which holds in the traced run because forc_hgt_q_patch == forc_hgt_t_patch and z0qg == z0hg; temp12m from the 2-m scalar profile F90:1022-1038; tstar = temp1*dth and qstar = temp2*dqh F90:358-359; z0h from the Meier2022 update F90:365; thvstar F90:367 (the virtual_potential_scale law shared with the parent's dthv); zeta_raw F90:368; the sign-preserving stability clamp zeta F90:369-375 (the clamp_zeta law shared with the MoninObukIni initialization); wc F90:371-374; obu = zldis/zeta F90:375). The wc update keeps the previous value on the stable branch exactly as the Fortran leaves its stale local: wc_prev is threaded through the mounts and seeded with the MoninObukIni value 0.5 m/s. The expression templates of ./clm_templates.esm are imported by reference.",
  "tags": [
   "land_surface",
   "clm",
   "bare-ground",
   "monin-obukhov",
   "stability-iteration",
   "cesm"
  ],
  "created": "2026-11-08T00:00:00Z",
  "authors": [
   "EqESM project contributors"
  ],
  "references": [
   {
    "citation": "Lawrence, D. M., Fisher, R. A., Koven, C. D., Oleson, K. W., Swenson, S. C., Bonan, G., et al. (2019). The Community Land Model Version 5: Description of New Features, Benchmarking, and Impact of Forcing Uncertainty. Journal of Advances in Modeling Earth Systems, 11(12), 4245-4287.",
    "doi": "10.1029/2018MS001583"
   },
   {
    "citation": "Meier, R., Davin, E. L., Bonan, G. B., Lawrence, D. M., Hu, X., Duveiller, G., Prigent, C., and Seneviratne, S. I. (2022). Impacts of a revised surface roughness parameterization in the Community Land Model 5.1. Geoscientific Model Development, 15(6), 2365-2393.",
    "doi": "10.5194/gmd-15-2365-2022"
   },
   {
    "citation": "CTSM (Community Terrestrial Systems Model), ESCOMP/CTSM, ctsm5.4.063 (cesm3.0-alphabranch): the CLM land-surface source - BareGroundFluxesMod.F90, FrictionVelocityMod.F90, clm_varcon.F90 (constants) - the reference implementation these components are transcribed from.",
    "url": "https://github.com/ESCOMP/CTSM"
   },
   {
    "citation": "EarthSciModels - the authoritative .esm corpus this component lives in.",
    "url": "https://github.com/EarthSciML/EarthSciModels"
   }
  ]
 },
 "index_sets": {
  "patch": {
   "kind": "interval",
   "size": "N_PATCH"
  }
 },
 "metaparameters": {
  "N_PATCH": {
   "type": "integer",
   "default": 1
  }
 },
 "models": {
  "BareGroundStep": {
   "expression_template_imports": [
    { "ref": "./clm_templates.esm" }
   ],
   "variables": {
    "forc_hgt_u": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m",
     "default": 30.0,
     "description": "observational height of wind at patch level (BareGroundFluxesMod.F90:343-347, forc_hgt_u_patch = forc_hgt_u + z0mg + displa with displa = 0), [m]"
    },
    "forc_hgt_t": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m",
     "default": 30.0,
     "description": "observational height of temperature at patch level (forc_hgt_t_patch = forc_hgt_t + z0hg + displa), [m]"
    },
    "z0m": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m",
     "default": 8.13402050576016129e-05,
     "description": "momentum roughness length over ground z0mg_patch, constant across the stability iteration, [m]"
    },
    "z0h_prev": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m",
     "default": 8.13402050576016129e-05,
     "description": "previous update's scalar roughness z0hg_patch (seeded with z0mg, the initial set of SetRoughnessLengthsAndForcHeightsNonLake FrictionVelocityMod.F90:637), [m]"
    },
    "obu_prev": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m",
     "default": 15.758842,
     "description": "previous update's Obukhov length obu (seeded by MoninObukIni), [m]"
    },
    "um_prev": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m/s",
     "default": 1.0,
     "description": "previous update's wind speed um (seeded by MoninObukIni), [m/s]"
    },
    "ur": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m/s",
     "default": 1.0,
     "description": "wind speed at the forcing height ur = max(wind_min, sqrt(forc_u^2 + forc_v^2)) with wind_min = 1.0 m/s (param file), [m/s]"
    },
    "dth": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "K",
     "default": 1.0,
     "description": "temperature difference dth = thm - t_grnd (BareGroundFluxesMod.F90:326), [K]"
    },
    "dqh": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "kg/kg",
     "default": 1.0e-3,
     "description": "humidity difference dqh = forc_q - qg (BareGroundFluxesMod.F90:327), [kg/kg]"
    },
    "forc_q": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "kg/kg",
     "default": 3.0e-3,
     "description": "atmospheric specific humidity at the forcing height, [kg/kg]"
    },
    "forc_th": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "K",
     "default": 290.0,
     "description": "atmospheric potential temperature at the forcing height forc_th = thv/(1 + 0.61*forc_q) (the traced dump does not carry forc_th; it is recovered from the dumped virtual potential temperature thv), [K]"
    },
    "thv": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "K",
     "default": 295.31,
     "description": "virtual potential temperature at the forcing height (BiogeophysPreFluxCalcsMod, dumped in clm_run_imports preflux), [K]"
    },
    "zii": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m",
     "default": 1000.0,
     "description": "convective boundary layer height (BiogeophysPreFluxCalcsMod.F90:363, zii = 1000 m in the traced run), [m]"
    },
    "beta": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "1",
     "default": 1.0,
     "description": "coefficient for convective velocity (BiogeophysPreFluxCalcsMod.F90:362, beta = 1 in the traced run), [-]"
    },
    "zetamaxstable": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "1",
     "default": 2.0,
     "description": "maximum zeta in the stable boundary layer (namelist zetamaxstable = 2.0 of the traced run, FrictionVelocityMod.F90:1201), [-]"
    },
    "vkc": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "1",
     "default": 0.4,
     "description": "von Karman constant (clm_varcon.F90:53), [-]"
    },
    "grav": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m/s^2",
     "default": 9.80616,
     "description": "gravitational acceleration (clm_varcon.F90:51), [m/s^2]"
    },
    "zetam": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "1",
     "default": 1.574,
     "description": "transition point of the flux-gradient relation, wind profile (FrictionVelocityMod.F90:795), [-]"
    },
    "zetat": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "1",
     "default": 0.465,
     "description": "transition point of the flux-gradient relation, temperature profile (FrictionVelocityMod.F90:796), [-]"
    },
    "meier_param3": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "1",
     "default": 70.0,
     "description": "Meier et al. (2022) empirical constant (clm_varcon.F90:171), [-]"
    },
    "nu_param": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "m^2/s",
     "default": 1.5e-5,
     "description": "kinematic viscosity of air (clm_varcon.F90:165), [m^2/s]"
    },
    "beta_param": {
     "type": "parameter",
     "shape": ["patch"],
     "units": "s^0.5/m^0.5/K^0.25",
     "default": 7.2,
     "description": "Meier et al. (2022) empirical constant (clm_varcon.F90:164), [(s/m)^0.5/K^0.25]"
    },
    "zldis_u": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "m",
     "description": "momentum profile height zldis = forc_hgt_u_patch - displa with displa = 0 (FrictionVelocityMod.F90:850-853), equal to the pre-iteration zldis = forc_hgt_u + z0mg of BareGroundFluxesMod.F90:329 (z0m = z0mg_patch is constant across the iteration), so it serves as the iteration height in zeta_raw and obu and the redundant parent zldis coupling is dropped, [m]"
    },
    "zldis_t": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "m",
     "description": "scalar profile height zldis = forc_hgt_t_patch - displa (FrictionVelocityMod.F90:946-949), [m]"
    },
    "zldis_2m": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "m",
     "description": "2-m profile height zldis = 2.0 + z0h (FrictionVelocityMod.F90:1022-1025), [m]"
    },
    "ustar": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "m/s",
     "description": "friction velocity (FrictionVelocityMod.F90:857-871), [m/s]"
    },
    "temp1": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "1",
     "description": "inverse integrated temperature profile at the measurement height (FrictionVelocityMod.F90:956-970), [-]"
    },
    "temp2": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "1",
     "description": "inverse integrated humidity profile at the measurement height, equal to temp1 by the equality branch (FrictionVelocityMod.F90:997-998, forc_hgt_q == forc_hgt_t and z0q == z0h in the traced run), [-]"
    },
    "temp12m": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "1",
     "description": "inverse integrated temperature profile at 2 m (FrictionVelocityMod.F90:1022-1038), [-]"
    },
    "temp22m": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "1",
     "description": "inverse integrated humidity profile at 2 m, equal to temp12m by the equality branch (FrictionVelocityMod.F90:1051-1052, z0q == z0h in the traced run), [-]"
    },
    "tstar": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "K",
     "description": "temperature scale tstar = temp1*dth (BareGroundFluxesMod.F90:358), [K]"
    },
    "qstar": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "kg/kg",
     "description": "humidity scale qstar = temp2*dqh (BareGroundFluxesMod.F90:359), [kg/kg]"
    },
    "z0h": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "m",
     "description": "updated scalar roughness over ground z0hg_patch, Meier2022 branch (BareGroundFluxesMod.F90:365), [m]"
    },
    "thvstar": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "K",
     "description": "virtual potential temperature scale thvstar = tstar*(1 + 0.61*forc_q) + 0.61*forc_th*qstar (BareGroundFluxesMod.F90:367), [K]"
    },
    "zeta_raw": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "1",
     "description": "unclamped stability parameter zeta = zldis_u*vkc*grav*thvstar/(ustar^2*thv) (BareGroundFluxesMod.F90:368, with zldis_u the iteration height), [-]"
    },
    "zeta": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "1",
     "description": "clamped stability parameter: the sign-preserving clamp of clamp_zeta applied to zeta_raw (BareGroundFluxesMod.F90:369-374; the same clamp as the MoninObukIni initialization, FrictionVelocityMod.F90:1200-1204), [-]"
    },
    "wc": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "m/s",
     "description": "convective velocity wc = beta*(-grav*ustar*thvstar*zii/thv)^0.333 (BareGroundFluxesMod.F90:372, the Fortran's 0.333_r8 exponent), written with the base nondimensionalized by 1 m^3/s^3 so the unit algebra closes (the unit checker only reduces exact rational exponents on dimensional bases). Documented divergence: the Fortran local wc is only read by the unstable um branch and otherwise keeps its MoninObukIni seed 0.5 m/s stale (F90:371), so computing it unconditionally is observationally identical and the dead wc threading is dropped, [m/s]"
    },
    "um": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "m/s",
     "description": "updated wind speed: stable branch (zeta_raw >= 0) um = max(ur, 0.1 m/s), unstable branch um = sqrt(ur^2 + wc^2) (BareGroundFluxesMod.F90:370,373) - the monin_obukhov_initial_wind law applied to the iteration branch test, [m/s]"
    },
    "obu": {
     "type": "unknown",
     "shape": ["patch"],
     "units": "m",
     "description": "updated Obukhov length obu = zldis/zeta (BareGroundFluxesMod.F90:375), [m]"
    }
   },
   "equations": [
    {
     "lhs": "zldis_u",
     "rhs": {"op": "+", "args": ["forc_hgt_u", "z0m"]}
    },
    {
     "lhs": "zldis_t",
     "rhs": {"op": "+", "args": ["forc_hgt_t", "z0h_prev"]}
    },
    {
     "lhs": "zldis_2m",
     "rhs": {"op": "+", "args": [{"op": "const", "args": [], "value": 2.0, "units": "m"}, "z0h_prev"]}
    },
    {
     "lhs": "ustar",
     "rhs": {"op": "apply_expression_template", "args": [], "name": "friction_velocity_momentum", "bindings": {
      "vkc": "vkc", "um": "um_prev", "zldis": "zldis_u", "z0m": "z0m", "obu": "obu_prev", "zetam": "zetam",
      "zeta": {"op": "/", "args": ["zldis_u", "obu_prev"]}
     }}
    },
    {
     "lhs": "temp1",
     "rhs": {"op": "apply_expression_template", "args": [], "name": "friction_velocity_scalar", "bindings": {
      "vkc": "vkc", "zldis": "zldis_t", "z0": "z0h_prev", "obu": "obu_prev", "zetat": "zetat",
      "zeta": {"op": "/", "args": ["zldis_t", "obu_prev"]}
     }}
    },
    {
     "lhs": "temp2",
     "rhs": "temp1"
    },
    {
     "lhs": "temp12m",
     "rhs": {"op": "apply_expression_template", "args": [], "name": "friction_velocity_scalar", "bindings": {
      "vkc": "vkc", "zldis": "zldis_2m", "z0": "z0h_prev", "obu": "obu_prev", "zetat": "zetat",
      "zeta": {"op": "/", "args": ["zldis_2m", "obu_prev"]}
     }}
    },
    {
     "lhs": "temp22m",
     "rhs": "temp12m"
    },
    {
     "lhs": "tstar",
     "rhs": {"op": "*", "args": ["temp1", "dth"]}
    },
    {
     "lhs": "qstar",
     "rhs": {"op": "*", "args": ["temp2", "dqh"]}
    },
    {
     "lhs": "z0h",
     "rhs": {"op": "apply_expression_template", "args": [], "name": "z0hg_meier2022", "bindings": {
      "meier_param3": "meier_param3", "nu_param": "nu_param", "ustar": "ustar", "beta_param": "beta_param", "tstar": "tstar"
     }}
    },
    {
     "lhs": "thvstar",
     "rhs": {"op": "apply_expression_template", "args": [], "name": "virtual_potential_scale", "bindings": {
      "x": "tstar", "forc_q": "forc_q", "forc_th": "forc_th", "y": "qstar"
     }}
    },
    {
     "lhs": "zeta_raw",
     "rhs": {"op": "/", "args": [
      {"op": "*", "args": ["zldis_u", "vkc", "grav", "thvstar"]},
      {"op": "*", "args": [{"op": "^", "args": ["ustar", 2]}, "thv"]}
     ]}
    },
    {
     "lhs": "zeta",
     "rhs": {"op": "apply_expression_template", "args": [], "name": "clamp_zeta", "bindings": {
      "zeta": "zeta_raw", "zetamaxstable": "zetamaxstable"
     }}
    },
    {
     "lhs": "wc",
     "rhs": {"op": "*", "args": [
      "beta",
      {"op": "const", "args": [], "value": 1.0, "units": "m/s"},
      {"op": "^", "args": [{"op": "/", "args": [
       {"op": "*", "args": [{"op": "-", "args": ["grav"]}, "ustar", "thvstar", "zii"]},
       {"op": "*", "args": ["thv", {"op": "const", "args": [], "value": 1.0, "units": "m^3/s^3"}]}
      ]}, 0.333]}
     ]}
    },
    {
     "lhs": "um",
     "rhs": {"op": "apply_expression_template", "args": [], "name": "monin_obukhov_initial_wind", "bindings": {
      "dthv": "zeta_raw", "ur": "ur", "wc": "wc"
     }}
    },
    {
     "lhs": "obu",
     "rhs": {"op": "/", "args": ["zldis_u", "zeta"]}
    }
   ]
  }
 }
}
