{
 "esm": "2.0.0",
 "metadata": {
  "name": "clm_bareground_steps_coupling",
  "description": "Coupling library (esm-spec §10.9) wiring the three BareGroundStep mounts (the unrolled Monin-Obukhov stability iteration of BareGroundFluxesMod.F90:342-388, see ./clm_bareground_step.esm and ./clm_bareground.esm) to the parent bare-ground flux model: the 19 iteration-invariant pointwise fields (forc_hgt_u/forc_hgt_t, the Meier2022 z0mg as z0m, ur, dth, dqh, forc_q, forc_th, thv, zii, beta, zetamaxstable and the constants vkc/grav/zetam/zetat/meier_param3/nu_param/beta_param) feed every step, and the iteration state chains step1 -> step2 -> step3 (um, obu, z0h). Import with coupling_import + bind {Parent: BareGroundFluxes, Step1: step1, Step2: step2, Step3: step3}; imported by ./clm_bareground.esm. Roles: Parent (the BareGroundFluxes model exposing the raw inputs and the MononObukIni seeds um_ini/obu_ini and the Meier2022 z0mg), and Step1/Step2/Step3 (the three BareGroundStep mounts).",
  "tags": [
   "land_surface",
   "clm",
   "coupling",
   "bare-ground",
   "monin-obukhov",
   "cesm"
  ],
  "created": "2026-11-15T00:00:00Z",
  "authors": [
   "EqESM project contributors"
  ],
  "references": [
   {
    "citation": "Lawrence, D. M., Fisher, R. A., Koven, C. D., Oleson, K. W., Swenson, S. C., Bonan, G., et al. (2019). The Community Land Model Version 5: Description of New Features, Benchmarking, and Impact of Forcing Uncertainty. Journal of Advances in Modeling Earth Systems, 11(12), 4245-4287.",
    "url": "https://doi.org/10.1029/2018MS001583"
   },
   {
    "citation": "EarthSciModels - the authoritative .esm corpus this component lives in.",
    "url": "https://github.com/EarthSciML/EarthSciModels"
   }
  ]
 },
 "coupling_roles": {
  "Parent": {
   "description": "the parent bare-ground flux model (BareGroundFluxes); supplies the pointwise fields, the constants, and the MoninObukIni seeds um_ini/obu_ini and the Meier2022 z0mg"
  },
  "Step1": {
   "description": "first pass of the unrolled stability iteration (BareGroundStep mount step1)"
  },
  "Step2": {
   "description": "second pass of the unrolled stability iteration (BareGroundStep mount step2)"
  },
  "Step3": {
   "description": "third pass of the unrolled stability iteration (BareGroundStep mount step3); its exit state is the parent's ustar/temp1/temp2/temp12m/temp22m/z0h/um"
  }
 },
 "coupling": [
  {
   "type": "variable_map",
   "from": "Parent.forc_hgt_u",
   "to": "Step1.forc_hgt_u",
   "transform": "param_to_var"
  },
  {
   "type": "variable_map",
   "from": "Parent.forc_hgt_u",
   "to": "Step2.forc_hgt_u",
   "transform": "param_to_var"
  },
  {
   "type": "variable_map",
   "from": "Parent.forc_hgt_u",
   "to": "Step3.forc_hgt_u",
   "transform": "param_to_var"
  },
  {
