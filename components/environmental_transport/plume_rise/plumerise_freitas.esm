        "Q𝒻": {
          "type": "parameter",
          "units": "kW/m^2",
          "default": 2.56,
          "description": "Fire heat release per unit surface area before multiplication by the convective fraction η."
        },
        "A𝒻": {
          "type": "parameter",
          "units": "m^2",
          "default": 7500000.0,
          "description": "Burning area defining the circular source radius sqrt(A𝒻/π₀)."
        },
        "α": {
          "type": "parameter",
          "units": "1",
          "default": 0.05,
          "description": "Entrainment coefficient controlling radial growth and exchange with ambient air."
        },
        "m𝒻": {
          "type": "parameter",
          "units": "1",
          "default": 10.0,
          "description": "Fuel moisture expressed as a numerical percentage; its integer part enters the surface moisture factor."
        },
        "τμ": {
          "type": "unknown",
          "units": "s",
          "description": "Interior microphysical transfer interval, τμ = τₛ/3. Lower-boundary microphysics uses 3τμ = τₛ. Interior microphysical tendencies are net changes divided by τμ and scaled by χμ."
        },
        "τₐ": {
          "type": "parameter",
          "units": "s",
          "description": "Time interval used in the transport reconstruction and outgoing-flux limiter.",
          "default": 0.1
        },
        "χ𝑤": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "Ambient-wind switch: 1 includes the prescribed wind, 0 suppresses its contribution."
        },
        "χμ": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "Multiplier of the microphysical phase-change tendencies; zero disables phase-change forcing."
        },
        "χᵥ": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "Multiplier of the prescribed eddy diffusivity profile."
        },
        "χΩ": {
          "type": "parameter",
          "units": "1",
          "description": "Domain switch: positive values set kₐ = 199; otherwise kₐ follows the instantaneous velocity threshold with a 20-level buffer.",
          "default": 0
        },
        "kₐ": {
          "type": "unknown",
          "units": "1",
          "description": "Upper limit of the active column; prognostic tendencies apply at 2 ≤ k < kₐ, with kₐ at most 199."
        },
        "𝒲ᶜ": {
          "type": "unknown",
          "units": "m/s",
          "description": "Maximum absolute carried velocity over all 200 levels."
        },
        "τᴅ": {
          "type": "unknown",
          "units": "s",
          "description": "Rayleigh relaxation timescale min(tₘ,3τₛ)."
        },
        "r₀": {
          "type": "unknown",
          "units": "m",
          "description": "Radius of the circular burning area, sqrt(A𝒻/π₀)."
        },
        "ℋ₀": {
          "type": "unknown",
          "units": "W/m^2",
          "description": "Convective surface heat flux evaluated at the end of the current update, t + τₙ, as in the reference finite-step scheme: initial floor before 60 s, one-minute ramp to 240 s, plateau through 3180 s, then the post-fire floor."
        },
        "f₀": {
          "type": "unknown",
          "units": "m^4/s^3",
          "description": "Buoyancy flux of the circular source, calculated from convective heating and the near-surface atmospheric state."
        },
        "w₀": {
          "type": "unknown",
          "units": "m/s",
          "description": "Upward velocity prescribed by the lower-boundary buoyant-source similarity solution."
        },
        "T₀⁽⁰⁾": {
          "type": "unknown",
          "units": "K",
          "description": "Lower-boundary temperature before microphysical phase changes."
        },
        "qᵥ₀⁽⁰⁾": {
          "type": "unknown",
          "units": "1",
          "description": "Lower-boundary water-vapor mixing ratio before microphysical phase changes."
        },
        "qₗ₀⁽⁰⁾": {
          "type": "unknown",
          "units": "1",
          "description": "Lower-boundary cloud-water mixing ratio before microphysical phase changes."
        },
        "w̄₀": {
          "type": "parameter",
          "units": "m/s",
          "description": "Prescribed lower-boundary mean velocity entering the cloud evaporation capacity.",
          "default": 0
        },
        "G₀": {
          "type": "parameter",
          "units": "1/m",
          "description": "Prescribed lower-boundary vertical gradient of the saturation mixing ratio.",
          "default": 0
        },
        "qₗᶜ₀": {
          "type": "unknown",
          "units": "1",
          "description": "Lower-boundary cloud-water mixing ratio retained above the threshold qε; smaller values are set to zero."
        },
        "qᵣᶜ₀": {
          "type": "unknown",
          "units": "1",
          "description": "Rainwater mixing ratio from level 2 used in lower-boundary microphysics; nonnegative values above qε are retained and smaller values are set to zero."
        },
        "qᵢᶜ₀": {
          "type": "unknown",
          "units": "1",
          "description": "Ice mixing ratio from level 2 used in lower-boundary microphysics; nonnegative values above qε are retained and smaller values are set to zero."
        },
        "δq⁽⁰⁾₀": {
          "type": "unknown",
          "units": "1",
          "description": "Lower-boundary saturation mixing ratio minus water-vapor mixing ratio before phase changes; positive values indicate a vapor deficit."
        },
        "Eₘ₀": {
          "type": "unknown",
          "units": "1",
          "description": "Lower-boundary transport-related capacity for cloud condensation or evaporation over 3τμ, based on vertical motion and the saturation-mixing-ratio gradient."
        },
        "Eₗ₀": {
          "type": "unknown",
          "units": "1",
          "description": "Lower-boundary cloud-water evaporation capacity, limited by the transport-related capacity and available cloud water."
        },
        "qᵥ⁽¹⁾₀": {
          "type": "unknown",
          "units": "1",
          "description": "At the lower boundary: water-vapor mixing ratio after stage 1: condensation of excess vapor to cloud water, or evaporation of cloud water into unsaturated air."
        },
        "qₗ⁽¹⁾₀": {
          "type": "unknown",
          "units": "1",
          "description": "At the lower boundary: cloud-water mixing ratio after stage 1 (condensation or evaporation). Cloud water loads the plume, reducing buoyancy, and is the source of rain."
        },
