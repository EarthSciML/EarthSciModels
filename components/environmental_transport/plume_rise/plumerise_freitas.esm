      ],
      "analyses": [
        {
          "id": "short_plume",
          "description": "Time evolution during the first 300 s of surface forcing, showing plume-top height and maximum vertical speed.",
          "time_span": {
            "start": 0,
            "end": 300
          },
          "plots": [
            {
              "id": "plume_height",
              "type": "line",
              "x": {
                "variable": "t",
                "label": "Time (s)"
              },
              "y": {
                "variable": "hₚ",
                "label": "Plume top (m)"
              }
            },
            {
              "id": "maximum_speed",
              "type": "line",
              "x": {
                "variable": "t"
              },
              "y": {
                "variable": "𝒲"
              }
            }
          ]
        }
      ],
      "tests": [
        {
          "id": "Fortran comparison at 300.000000000 s",
          "description": "Independent numerical comparison with the Freitas-derived Fortran implementation, including Mallia/Wilmot modifications. The model evolves from its prescribed initial conditions over 0–300 s using the supplied OTX atmospheric profile and fire forcing, with no overrides. At 300 s, 57 assertions compare temperature, vertical velocity, water vapor, scalar-level buoyancy, passive tracer, plume-top height and maximum vertical speed against Fortran reference values using the established absolute and relative tolerances. With minute-indexed forcing evaluated at the end of the current update (t + τₙ), all 57 comparisons satisfy the established tolerances; the closest is velocity_state[7], which uses about 85% of its allowed deviation. Version 0.10.9, which evaluated this forcing at the start of the update, gave 53 passes and 4 failures (velocity_state[6], velocity_state[7], tracer_state[9] and tracer_state[10]). This suite assesses early-time behavior only and does not validate significant precipitation, glaciation or full-duration agreement. The complete extended scientific validation report is supplied separately.",
          "time_span": {
            "start": 0,
            "end": 300.0
          },
          "assertions": [
            {
              "variable": "hₚ",
              "time": 300.0,
              "expected": 900.0,
              "tolerance": {
                "abs": 100.0,
                "rel": 0.05
              }
            },
            {
              "variable": "𝒲",
              "time": 300.0,
              "expected": 9.371197700500488,
              "tolerance": {
                "abs": 0.5,
                "rel": 0.1
              }
            },
            {
              "variable": "temperature_state[2]",
              "time": 300.0,
              "expected": 306.8099365234375,
              "tolerance": {
                "abs": 1.0,
                "rel": 0
              }
            },
            {
              "variable": "velocity_state[2]",
              "time": 300.0,
              "expected": 9.30801773071289,
              "tolerance": {
                "abs": 0.5,
                "rel": 0.1
              }
            },
            {
              "variable": "vapor_state[2]",
              "time": 300.0,
              "expected": 0.007682247553020716,
              "tolerance": {
                "abs": 0.0001,
                "rel": 0.05
              }
            },
            {
              "variable": "tracer_state[2]",
              "time": 300.0,
              "expected": 984.0889282226562,
              "tolerance": {
                "abs": 1.0,
                "rel": 0.1
              }
            },
            {
              "variable": "ℬₜ_2",
              "time": 300.0,
              "expected": 0.009016021154820919,
              "tolerance": {
