          "_comment": "Lower-boundary rainwater mixing ratio after phase changes and warm-rain conversion by autoconversion and accretion."
        },
        {
          "lhs": "uₐ",
          "rhs": {
            "op": "*",
            "args": [
              "χ𝑤",
              "uₑ"
            ]
          },
          "_comment": "Ambient horizontal wind acting on the plume: prescribed wind uₑ times the wind switch χ𝑤."
        },
        {
          "lhs": "r₀",
          "rhs": {
            "op": "sqrt",
            "args": [
              {
                "op": "/",
                "args": [
                  "A𝒻",
                  "π₀"
                ]
              }
            ]
          },
          "_comment": "Radius of the circular burning area, sqrt(A𝒻/π₀)."
        },
        {
          "lhs": "ℋ₀",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "ℋ𝒻",
            "bindings": {
              "s": {
                "op": "+",
                "args": [
                  "t",
                  "τₙ"
                ]
              }
            }
          },
          "_comment": "Convective surface heat flux evaluated at the end of the current update, t + τₙ, as in the reference finite-step scheme: initial floor before 60 s, one-minute ramp to 240 s, plateau through 3180 s, then the post-fire floor."
        },
        {
          "lhs": "ρ₀",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
