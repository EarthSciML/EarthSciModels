          },
          "_comment": "Lower-boundary cloud-water mixing ratio after phase changes and warm-rain conversion by autoconversion and accretion."
        },
        {
          "lhs": "qᵣμ₀",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": ">",
                    "args": [
