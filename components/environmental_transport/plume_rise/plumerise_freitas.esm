          "type": "unknown",
          "units": "K/s",
          "description": "Maximum absolute temperature-equivalent phase enthalpy residual over levels 2–198."
        },
        "τₛ": {
          "type": "unknown",
          "units": "s",
          "description": "Transport timescale based on the maximum absolute carried velocity, bounded above by τₘₐₓ; also the lower-boundary microphysical interval. The interior microphysical interval is τₛ/3."
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.80796,
          "description": "Gravitational acceleration in the lower-boundary buoyancy flux f₀ and thermal factor β₀ (the reference code's 9.80796 m/s²). Interior buoyancy uses gᵦ and adiabatic cooling uses Γᴅ."
        },
        "Rᴅ": {
          "type": "parameter",
          "units": "J/kg/K",
          "default": 287.04,
          "description": "Specific gas constant of dry air, used in the lower-boundary buoyancy flux f₀."
        },
        "cₚᴅ": {
          "type": "parameter",
          "units": "J/kg/K",
          "default": 1004.6,
          "description": "Specific heat of dry air at constant pressure, used in the lower-boundary buoyancy flux f₀."
        },
        "κρ": {
          "type": "parameter",
          "units": "g*K/m^3/kPa",
          "default": 3483.8,
          "description": "Air-density coefficient 1/Rᴅ expressed for pressure in kPa and density in g/m³, so that ρ = κρ p/T."
        },
        "e₀": {
          "type": "parameter",
          "units": "kPa",
          "default": 0.61078,
          "description": "Saturation vapor pressure at Tᵣ in the Tetens formula eₛ = e₀ exp[aₑₛ(T − Tᵣ)/(T − Tₑₛ)]."
        },
        "Tᵣ": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "Reference temperature (0 °C) in the Tetens formula eₛ = e₀ exp[aₑₛ(T − Tᵣ)/(T − Tₑₛ)]."
        },
        "Tₑₛ": {
          "type": "parameter",
          "units": "K",
          "default": 35.85,
          "description": "Temperature offset in the denominator of the Tetens formula eₛ = e₀ exp[aₑₛ(T − Tᵣ)/(T − Tₑₛ)]."
        },
        "κW": {
          "type": "parameter",
          "units": "W/kW",
          "default": 1000,
          "description": "Unit conversion from kW to W for the surface heat flux."
        },
        "κp": {
          "type": "parameter",
          "units": "Pa/kPa",
          "default": 1000,
          "description": "Unit conversion from kPa to Pa in the lower-boundary buoyancy flux."
        },
        "κg": {
          "type": "parameter",
          "units": "g/kg",
          "default": 1000,
          "description": "Unit conversion from kg to g in the fire water-vapor increment δq₀."
        },
        "κkg": {
          "type": "parameter",
          "units": "kg/g",
          "default": 0.001,
          "description": "Unit conversion from g to kg; converts air density from g/m³ to kg/m³ in the mass fluxes."
        },
        "h𝒻": {
          "type": "parameter",
          "units": "J/kg",
          "default": 19300000.0,
          "description": "Heat of combustion of the fuel. The surface heat flux divided by η h𝒻 is the fuel burning rate, which sets the fire's water-vapor source δq₀."
        },
        "tₘ": {
          "type": "parameter",
          "units": "s",
          "default": 60,
          "description": "One-minute forcing interval: the heat-flux ramp steps every tₘ, the velocity-filter weight ε changes at tₘ, and the Rayleigh timescale τᴅ is capped at tₘ."
        },
        "tᵣ": {
          "type": "parameter",
          "units": "s",
          "default": 240,
          "description": "End of the heat-flux ramp; the full fire heat flux applies from tᵣ."
        },
        "t𝒻": {
          "type": "parameter",
          "units": "s",
          "default": 3180,
          "description": "End (inclusive) of the full-intensity fire; the post-fire floor ℋₑₙd applies afterwards."
        },
        "ℋₘᵢₙ": {
          "type": "parameter",
          "units": "W/m^2",
          "default": 0.1,
          "description": "Small surface heat flux applied during the first minute, before the ramp starts."
        },
        "ℋₑₙd": {
          "type": "parameter",
          "units": "W/m^2",
          "default": 1e-06,
          "description": "Small surface heat flux applied after the fire ends."
        },
        "Δz": {
          "type": "parameter",
          "units": "m",
          "default": 100,
          "description": "Nominal vertical grid spacing, used in the transport timescale, plume-top height, damping onset, initial heights and face reconstruction."
        },
        "τₘₐₓ": {
          "type": "parameter",
          "units": "s",
          "default": 5,
          "description": "Upper bound of the transport timescale; equals the 5 s maximum time step of the reference scheme."
        },
        "wₘᵢₙ": {
          "type": "parameter",
          "units": "m/s",
          "default": 1,
          "description": "Vertical-velocity threshold that defines the plume top (first level with w ≤ wₘᵢₙ) and floor of the speed in the transport timescale."
        },
        "rₘᵢₙ": {
          "type": "parameter",
          "units": "m",
          "default": 1,
          "description": "Minimum plume radius in the entrainment and wind-exchange rates; prevents division by a vanishing radius."
        },
        "ℋᴅ": {
          "type": "parameter",
          "units": "m",
          "default": 2000,
          "description": "Depth scale of the Rayleigh damping layer above the active column."
        },
        "νₘᵢₙ": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.001,
          "description": "Minimum eddy diffusivity."
        },
        "ν₀": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 500,
          "description": "Eddy diffusivity at the surface; ν decreases linearly with level index down to νₘᵢₙ."
        },
        "vᵢ": {
          "type": "parameter",
          "units": "m/s",
          "default": -3,
          "description": "Fall speed of ice (negative is downward). Used for ice sedimentation and in the ventilation coefficient for ice sublimation and melting."
        },
        "vᵣ": {
          "type": "parameter",
          "units": "m/s",
          "default": -4,
          "description": "Fall speed of rain (negative is downward), used for rain sedimentation."
        },
        "gᵦ": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 6.533333333333334,
          "description": "Gravitational coefficient in the buoyancy acceleration, g/(1 + γ) with g = 9.8 m/s² and virtual-mass coefficient γ = 0.5 (numerically 9.8/1.5), as in the reference code."
        },
        "Γᴅ": {
          "type": "parameter",
          "units": "K/m",
          "default": 0.009770916334661355,
          "description": "Dry-adiabatic lapse rate g/cₚ, numerically 9.81/1004; rising plume air cools at the rate w̄Γᴅ."
        },
        "Λᵥᴴ": {
          "type": "parameter",
          "units": "K",
          "default": 2490.03984063745,
          "description": "Latent heat of condensation divided by cₚ (numerically 2.5×10⁶/1004). Used only in the enthalpy-budget diagnostic Rₕ; it does not affect the plume evolution."
        },
        "Λ𝒻ᴴ": {
          "type": "parameter",
          "units": "K",
          "default": 332.66932270916334,
          "description": "Latent heat of fusion divided by cₚ (numerically 3.34×10⁵/1004). Used only in the enthalpy-budget diagnostic Rₕ; it does not affect the plume evolution."
        },
        "π₀": {
          "type": "parameter",
          "units": "1",
          "default": 3.14159,
          "description": "Value of π (3.14159) for the source radius, the initial radius and the lower-boundary buoyancy flux, as in the reference code."
        },
        "πᵣ": {
          "type": "parameter",
          "units": "1",
          "default": 3.1416,
          "description": "Value of π (3.1416) in the wind-shear radius growth and in κλ and κE; it differs from π₀ as in the reference code."
        },
        "εᵥ": {
          "type": "parameter",
          "units": "1",
          "default": 0.622,
          "description": "Ratio of the molar masses of water vapor and dry air."
        },
        "aₑₛ": {
          "type": "parameter",
          "units": "1",
          "default": 17.2693882,
          "description": "Exponential coefficient in the Tetens formula eₛ = e₀ exp[aₑₛ(T − Tᵣ)/(T − Tₑₛ)]."
        },
        "η": {
          "type": "parameter",
          "units": "1",
          "default": 0.55,
          "description": "Convective fraction of the fire heat release: the part that heats the plume. It also converts the heat flux back to a fuel burning rate in δq₀."
        },
        "cᵦ": {
          "type": "parameter",
          "units": "1",
          "default": 0.9,
          "description": "Coefficient of the buoyancy-flux scale B₀ = cᵦ α f₀ in the lower-boundary similarity solution."
        },
        "Lᵥ": {
          "type": "parameter",
          "units": "kJ/kg",
          "default": 2500.0,
          "description": "Latent heat of condensation (vapor ↔ liquid)."
        },
        "Lₛ": {
          "type": "parameter",
          "units": "kJ/kg",
          "default": 2834.0,
          "description": "Latent heat of sublimation (vapor ↔ ice)."
        },
        "L𝒻": {
          "type": "parameter",
          "units": "kJ/kg",
          "default": 334.0,
          "description": "Latent heat of fusion (liquid ↔ ice)."
        },
        "cₚφ": {
          "type": "parameter",
          "units": "kJ/kg/K",
          "default": 1.004,
          "description": "Specific heat that converts latent heat into a temperature change in phase-change heating (Λ = L/cₚφ)."
        },
        "qε": {
          "type": "parameter",
          "units": "1",
          "default": 1e-10,
          "description": "Smallest condensed-water mixing ratio kept in the microphysics; smaller values are set to zero."
        },
        "T𝒻": {
          "type": "parameter",
          "units": "K",
          "default": 269.3,
          "description": "Temperature threshold for ice processes: deposition onto ice and rain freezing occur at or below T𝒻, and warm-rain conversion requires T > T𝒻."
        },
        "Tₘ": {
          "type": "parameter",
          "units": "K",
          "default": 273.0,
          "description": "Temperature at or above which ice melts to rain."
        },
        "aᵣ": {
          "type": "parameter",
          "units": "m^1.95/g^0.65/s",
          "default": 0.000544,
          "description": "Coefficient of the empirical rain-evaporation rate."
        },
        "aᵢ": {
          "type": "parameter",
          "units": "1",
          "default": 700000.0,
          "description": "Constant term in the normalized resistance to vapor transfer between air and ice."
        },
        "bᵢ": {
          "type": "parameter",
          "units": "1",
          "default": 4100000.0,
          "description": "Coefficient of the saturation-vapor-pressure term in the normalized ice-transfer resistance."
        },
        "κₑ": {
          "type": "parameter",
          "units": "1",
          "default": 10.0,
          "description": "Pressure normalization factor in the empirical ice-transfer resistance; saturation vapor pressure is scaled by 1 kPa."
        },
        "κρᵢ": {
          "type": "parameter",
          "units": "1",
          "default": 1000000.0,
          "description": "Reciprocal-density normalization factor in the empirical ice-transfer relation; air density is scaled by 1 g/m³."
        },
        "cᵢₛ": {
          "type": "parameter",
          "units": "1",
          "default": 1.13,
          "description": "Coefficient scaling the normalized vapor-transfer driving terms for ice sublimation and deposition."
        },
        "a𝒻": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.025,
          "description": "Rate coefficient for rain freezing to ice (glaciation): the fraction of rain frozen per second when freezing is possible."
        },
        "aₘ": {
          "type": "parameter",
          "units": "g/m^3*(cm^3/g)^0.525/s/K",
          "default": 2.27,
          "description": "Coefficient of the empirical ice-melting rate."
        },
        "κₘ": {
          "type": "parameter",
          "units": "m^3/cm^3",
          "default": 1e-06,
          "description": "Unit conversion from g/m³ to g/cm³ for the ice mass concentration in the empirical melting relation."
        },
        "cₘ": {
          "type": "parameter",
          "units": "1",
          "default": 0.75,
          "description": "Normalization factor in the ventilation coefficient cᵢ = cᵢ₀ + cᵢ₁|w + vᵢ|^1.5/cₘ and in the melting rate."
        },
        "Λₘ": {
          "type": "parameter",
          "units": "K",
          "default": 332.27,
          "description": "Latent cooling per unit ice mixing ratio melted (latent heat of fusion over heat capacity), used in the melting stage."
        },
        "aₐ": {
          "type": "parameter",
          "units": "m^2.625/g^0.875/s",
          "default": 0.0052,
          "description": "Coefficient of the rate at which rain collects cloud water (accretion)."
        },
        "cᵤ": {
          "type": "parameter",
          "units": "1",
          "default": 0.146,
          "description": "Coefficient of the autoconversion rate 𝒞ᵤ = cᵤ mₗ³/[tᵤ(aᵤ cᵤ mₗ + bᵤ nᵤ)], which turns cloud water into rain."
        },
        "tᵤ": {
          "type": "parameter",
          "units": "s",
          "default": 60.0,
          "description": "Time scale in the autoconversion rate 𝒞ᵤ = cᵤ mₗ³/[tᵤ(aᵤ cᵤ mₗ + bᵤ nᵤ)]."
        },
        "aᵤ": {
          "type": "parameter",
          "units": "g/m^3",
          "default": 5.0,
          "description": "Concentration coefficient in the denominator of the autoconversion rate 𝒞ᵤ = cᵤ mₗ³/[tᵤ(aᵤ cᵤ mₗ + bᵤ nᵤ)]."
        },
        "bᵤ": {
          "type": "parameter",
          "units": "(g/m^3)^2*cm^3",
          "default": 0.0366,
          "description": "Mass coefficient in the denominator of the autoconversion rate 𝒞ᵤ = cᵤ mₗ³/[tᵤ(aᵤ cᵤ mₗ + bᵤ nᵤ)]."
        },
        "nᵤ": {
          "type": "parameter",
          "units": "1/cm^3",
          "default": 100000.0,
          "description": "Cloud-droplet number concentration in the autoconversion rate 𝒞ᵤ = cᵤ mₗ³/[tᵤ(aᵤ cᵤ mₗ + bᵤ nᵤ)]."
        },
        "cᵢ₀": {
          "type": "parameter",
          "units": "1",
          "default": 1.6,
          "description": "Constant term of the ventilation coefficient cᵢ = cᵢ₀ + cᵢ₁|w + vᵢ|^1.5/cₘ, which increases ice sublimation and melting because air flows past falling ice."
        },
        "cᵢ₁": {
          "type": "parameter",
          "units": "(s/m)^1.5",
          "default": 0.00057,
          "description": "Speed coefficient of the ventilation coefficient cᵢ = cᵢ₀ + cᵢ₁|w + vᵢ|^1.5/cₘ."
        },
        "ε₁": {
          "type": "parameter",
          "units": "1",
          "default": 0.2,
          "description": "Velocity-filter weight ε after the first minute (ε = 1/2 before then)."
        },
        "aᵣ₀": {
          "type": "parameter",
          "units": "1",
          "default": 1.2,
          "description": "Coefficient of the initial radius profile r = r₀ + aᵣ₀ α z."
        },
        "κλ": {
          "type": "parameter",
          "units": "1",
          "default": 0.6366182836771073,
          "description": "Coefficient 2/πᵣ of the wind-driven exchange rate λ𝑤."
        },
        "κE": {
          "type": "parameter",
          "units": "1",
          "default": 0.31830914183855363,
          "description": "Coefficient 1/πᵣ of the wind-driven vertical-momentum loss in E𝑤."
        },
        "aᵣ₁": {
          "type": "parameter",
          "units": "1",
          "default": 0.6,
          "description": "Coefficient of radius growth by entrainment, aᵣ₁ λ r, in the radius tendency."
        },
