          "type": "unknown",
          "units": "1",
          "description": "Minimum of the four physical water-species mass mixing ratios over all 200 levels."
        },
        "R𝑞": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "zt"
          ],
          "description": "Sum of the vapor, cloud-water, rain and ice phase-change tendencies; a local water-budget residual."
