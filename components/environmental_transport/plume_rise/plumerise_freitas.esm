                    ]
                  }
                ]
              },
              "T₀⁽⁰⁾"
            ]
          },
          "_comment": "Air density κρpₑ[1]/T₀⁽⁰⁾ at the lower boundary before phase exchange."
        },
        {
          "lhs": "qₗᶜ₀",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "<=",
                "args": [
