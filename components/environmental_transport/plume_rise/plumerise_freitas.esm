          },
          "_comment": "Lower-boundary cloud-water mixing ratio retained above the threshold qε; smaller values are set to zero."
        },
        {
          "lhs": "qᵣᶜ₀",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "<=",
                "args": [
                  {
                    "op": "max",
