        "q∅": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "zt"
          ],
          "default": 0,
          "description": "Ambient mixing ratio of cloud water, rain, ice and tracer: zero, so exchange with ambient air only dilutes these quantities."
        },
        "Q𝒻": {
          "type": "parameter",
          "units": "kW/m^2",
          "default": 2.56,
          "description": "Fire heat flux (total, before the convective fraction η). Default 2.56 kW/m² (Williams Flats)."
        },
        "A𝒻": {
          "type": "parameter",
          "units": "m^2",
          "default": 7500000.0,
          "description": "Burning area defining the circular source radius sqrt(A𝒻/π₀)."
        },
        "α": {
          "type": "parameter",
          "units": "1",
          "default": 0.05,
          "description": "Entrainment coefficient controlling radial growth and exchange with ambient air."
        },
        "m𝒻": {
          "type": "parameter",
          "units": "1",
          "default": 10.0,
          "description": "Fuel moisture expressed as a numerical percentage; its integer part enters the surface moisture factor."
        },
        "χ𝑤": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "Ambient-wind switch: 1 includes the prescribed wind, 0 suppresses its contribution."
        },
        "χμ": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "Multiplier of the microphysical phase-change tendencies; zero disables phase-change forcing."
        },
        "χᵥ": {
          "type": "parameter",
          "units": "1",
          "default": 1,
          "description": "Multiplier of the prescribed eddy diffusivity profile."
        },
        "c₀": {
          "type": "parameter",
          "units": "1",
          "default": 1000.0,
          "description": "Passive-tracer value prescribed at the lower boundary (the Fortran SC(1) = 1000); the tracer is reported relative to it."
        },
        "τμ": {
          "type": "parameter",
          "units": "s",
          "default": 1.6666666666666667,
          "description": "Microphysical adjustment time. The staged microphysics computes the state the Fortran process chain would reach after an interval τμ and relaxes towards it, M = (X⁽ᵃᵈʲ⁾ − X)/τμ. For the rate-limited processes (rain evaporation, sublimation, deposition, freezing, melting, autoconversion, accretion and the |w̄Gₛ| condensation rate) M is the process rate and does not depend on τμ while the transfer over τμ is small compared with the available water; for saturation adjustment τμ is the relaxation time. The default, 5/3 s, is the Fortran microphysics substep at its maximum time step (5 s / 3 substeps). Halving it changes the asserted cloud-water values by less than their tolerance (see the tests)."
        },
        "τᴅ": {
          "type": "parameter",
          "units": "s",
          "default": 15.0,
          "description": "Relaxation time of the Rayleigh sponge at full strength (from ℋᴅ above the highest plume top kₜ upward). The Fortran uses 3·Δt (12–15 s in the reference runs, Δt ≤ 5 s); a fixed value keeps the model independent of a time step."
        },
        "g": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.80796,
          "description": "Gravitational acceleration in the lower-boundary buoyancy flux f₀ and thermal factor β₀ (the reference code's 9.80796 m/s²). Interior buoyancy uses gᵦ and adiabatic cooling uses Γᴅ."
        },
        "Rᴅ": {
          "type": "parameter",
          "units": "J/kg/K",
          "default": 287.04,
          "description": "Specific gas constant of dry air, used in the lower-boundary buoyancy flux f₀."
        },
        "cₚᴅ": {
          "type": "parameter",
          "units": "J/kg/K",
          "default": 1004.6,
          "description": "Specific heat of dry air at constant pressure, used in the lower-boundary buoyancy flux f₀."
        },
        "κρ": {
          "type": "parameter",
          "units": "g*K/m^3/kPa",
          "default": 3483.8,
          "description": "Air-density coefficient 1/Rᴅ expressed for pressure in kPa and density in g/m³, so that ρ = κρ p/T."
        },
        "e₀": {
          "type": "parameter",
          "units": "kPa",
          "default": 0.61078,
          "description": "Saturation vapor pressure at Tᵣ in the Tetens formula eₛ = e₀ exp[aₑₛ(T − Tᵣ)/(T − Tₑₛ)]."
        },
        "Tᵣ": {
          "type": "parameter",
          "units": "K",
          "default": 273.15,
          "description": "Reference temperature (0 °C) in the Tetens formula eₛ = e₀ exp[aₑₛ(T − Tᵣ)/(T − Tₑₛ)]."
        },
        "Tₑₛ": {
          "type": "parameter",
          "units": "K",
          "default": 35.85,
          "description": "Temperature offset in the denominator of the Tetens formula eₛ = e₀ exp[aₑₛ(T − Tᵣ)/(T − Tₑₛ)]."
        },
        "κW": {
          "type": "parameter",
          "units": "W/kW",
          "default": 1000,
          "description": "Unit conversion from kW to W for the surface heat flux."
        },
        "κp": {
          "type": "parameter",
          "units": "Pa/kPa",
          "default": 1000,
          "description": "Unit conversion from kPa to Pa in the lower-boundary buoyancy flux."
        },
        "κg": {
          "type": "parameter",
          "units": "g/kg",
          "default": 1000,
          "description": "Unit conversion from kg to g in the fire water-vapor increment δq₀."
        },
        "κkg": {
          "type": "parameter",
          "units": "kg/g",
          "default": 0.001,
          "description": "Unit conversion from g to kg; converts air density from g/m³ to kg/m³ in the mass fluxes."
        },
        "h𝒻": {
          "type": "parameter",
          "units": "J/kg",
          "default": 19300000.0,
          "description": "Heat of combustion of the fuel. The surface heat flux divided by η h𝒻 is the fuel burning rate, which sets the fire's water-vapor source δq₀."
        },
        "tₘ": {
          "type": "parameter",
          "units": "s",
          "default": 60,
          "description": "One-minute forcing interval: the surface heat flux is a step function of time that changes every tₘ (the Fortran indexes its heating table by minute)."
        },
        "tᵣ": {
          "type": "parameter",
          "units": "s",
          "default": 240,
          "description": "End of the heat-flux ramp; the ramp rises in equal steps every tₘ and the full fire heat flux applies from tᵣ. The reference code ramps over four minutes (tᵣ = 240 s)."
        },
        "t𝒻": {
          "type": "parameter",
          "units": "s",
          "default": 3180,
          "description": "End (inclusive) of the full-intensity fire; the post-fire floor ℋₑₙd applies afterwards."
        },
        "ℋₘᵢₙ": {
          "type": "parameter",
          "units": "W/m^2",
          "default": 0.1,
          "description": "Small surface heat flux applied during the first minute, before the ramp starts."
        },
        "ℋₑₙd": {
          "type": "parameter",
          "units": "W/m^2",
          "default": 1e-06,
          "description": "Small surface heat flux applied after the fire ends."
        },
        "Δz": {
          "type": "parameter",
          "units": "m",
          "default": 100,
          "description": "Vertical grid spacing of both staggered grids (100 m)."
        },
        "wₘᵢₙ": {
          "type": "parameter",
          "units": "m/s",
          "default": 1,
          "description": "Vertical-velocity threshold that defines the plume top (first level with w ≤ wₘᵢₙ) and floor of the speed in the transport timescale."
        },
        "rₘᵢₙ": {
          "type": "parameter",
          "units": "m",
          "default": 1,
          "description": "Minimum plume radius in the entrainment and wind-exchange rates; prevents division by a vanishing radius."
        },
        "ℋᴅ": {
          "type": "parameter",
          "units": "m",
          "default": 2000,
          "description": "Depth over which the Rayleigh sponge rate rises from zero at the highest plume top kₜ to 1/τᴅ (20 levels, the Fortran sponge depth)."
        },
        "νₘᵢₙ": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.001,
          "description": "Minimum eddy diffusivity."
        },
        "ν₀": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 500,
          "description": "Eddy diffusivity at the surface; ν decreases linearly with level index down to νₘᵢₙ."
        },
        "vᵢ": {
          "type": "parameter",
          "units": "m/s",
          "default": -3,
          "description": "Fall speed of ice (negative is downward). Used for ice sedimentation and in the ventilation coefficient of ice sublimation and melting."
        },
        "vᵣ": {
          "type": "parameter",
          "units": "m/s",
          "default": -4,
          "description": "Fall speed of rain (negative is downward), used for rain sedimentation."
        },
        "gᵦ": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 6.533333333333334,
          "description": "Gravitational coefficient in the buoyancy acceleration, g/(1 + γ) with g = 9.8 m/s² and virtual-mass coefficient γ = 0.5 (numerically 9.8/1.5), as in the reference code."
        },
        "Γᴅ": {
          "type": "parameter",
          "units": "K/m",
          "default": 0.009770916334661355,
          "description": "Dry-adiabatic lapse rate g/cₚ, numerically 9.81/1004; rising plume air cools at the rate w̄Γᴅ."
        },
        "π₀": {
          "type": "parameter",
          "units": "1",
          "default": 3.14159,
          "description": "Value of π (3.14159) for the source radius, the initial radius and the lower-boundary buoyancy flux, as in the reference code."
        },
        "πᵣ": {
          "type": "parameter",
          "units": "1",
          "default": 3.1416,
          "description": "Value of π (3.1416) in the wind-shear radius growth and in κλ and κE; it differs from π₀ as in the reference code."
        },
        "εᵥ": {
          "type": "parameter",
          "units": "1",
          "default": 0.622,
          "description": "Ratio of the molar masses of water vapor and dry air."
        },
        "aₑₛ": {
          "type": "parameter",
          "units": "1",
          "default": 17.2693882,
          "description": "Exponential coefficient in the Tetens formula eₛ = e₀ exp[aₑₛ(T − Tᵣ)/(T − Tₑₛ)]."
        },
        "η": {
          "type": "parameter",
          "units": "1",
          "default": 0.55,
          "description": "Convective fraction of the fire heat release: the part that heats the plume. It also converts the heat flux back to a fuel burning rate in δq₀."
        },
        "cᵦ": {
          "type": "parameter",
          "units": "1",
          "default": 0.9,
          "description": "Coefficient of the buoyancy-flux scale B₀ = cᵦ α f₀ in the lower-boundary similarity solution."
        },
        "Lᵥ": {
          "type": "parameter",
          "units": "kJ/kg",
          "default": 2500.0,
          "description": "Latent heat of condensation (vapor ↔ liquid)."
        },
        "Lₛ": {
          "type": "parameter",
          "units": "kJ/kg",
          "default": 2834.0,
          "description": "Latent heat of sublimation (vapor ↔ ice)."
        },
        "L𝒻": {
          "type": "parameter",
          "units": "kJ/kg",
          "default": 334.0,
          "description": "Latent heat of fusion (liquid ↔ ice)."
        },
        "cₚφ": {
          "type": "parameter",
          "units": "kJ/kg/K",
          "default": 1.004,
          "description": "Specific heat that converts latent heat into a temperature change in phase-change heating (Λ = L/cₚφ)."
        },
        "qε": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Condensate mixing ratio at or below which cloud water, rain and ice are treated as absent by the microphysics. The Fortran uses 1e-10 as an underflow guard and applies it to the state at every microphysics substep, which wipes out any rain produced in one substep by less than 1e-10; at small time steps that suppresses the onset of rain by continental (Berry) autoconversion entirely, so the onset depends on the time step. The default 0 removes that dependence; 1e-10 restores the Fortran guard."
        },
        "T𝒻": {
          "type": "parameter",
          "units": "K",
          "default": 269.3,
          "description": "Temperature threshold for ice processes: deposition onto ice and rain freezing occur at or below T𝒻, and warm-rain conversion requires T > T𝒻."
        },
        "Tₘ": {
          "type": "parameter",
          "units": "K",
          "default": 273.0,
          "description": "Temperature at or above which ice melts to rain."
        },
        "aᵣ": {
          "type": "parameter",
          "units": "m^1.95/g^0.65/s",
          "default": 0.000544,
          "description": "Coefficient of the empirical rain-evaporation rate."
        },
        "aᵢ": {
          "type": "parameter",
          "units": "1",
          "default": 700000.0,
          "description": "Constant term in the normalized resistance to vapor transfer between air and ice."
        },
        "bᵢ": {
          "type": "parameter",
          "units": "1",
          "default": 4100000.0,
          "description": "Coefficient of the saturation-vapor-pressure term in the normalized ice-transfer resistance."
        },
        "κₑ": {
          "type": "parameter",
          "units": "1",
          "default": 10.0,
          "description": "Pressure normalization factor in the empirical ice-transfer resistance; saturation vapor pressure is scaled by 1 kPa."
        },
        "κρᵢ": {
          "type": "parameter",
          "units": "1",
          "default": 1000000.0,
          "description": "Reciprocal-density normalization factor in the empirical ice-transfer relation; air density is scaled by 1 g/m³."
        },
        "cᵢₛ": {
          "type": "parameter",
          "units": "1",
          "default": 1.13,
          "description": "Coefficient scaling the normalized vapor-transfer driving terms for ice sublimation and deposition."
        },
        "a𝒻": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.025,
          "description": "Rate coefficient for rain freezing to ice (glaciation): the fraction of rain frozen per second when freezing is possible."
        },
        "aₘ": {
          "type": "parameter",
          "units": "g/m^3*(cm^3/g)^0.525/s/K",
          "default": 2.27,
          "description": "Coefficient of the empirical ice-melting rate."
        },
        "κₘ": {
          "type": "parameter",
          "units": "m^3/cm^3",
          "default": 1e-06,
          "description": "Unit conversion from g/m³ to g/cm³ for the ice mass concentration in the empirical melting relation."
        },
        "cₘ": {
          "type": "parameter",
          "units": "1",
          "default": 0.75,
          "description": "Normalization factor in the ventilation coefficient cᵢ = cᵢ₀ + cᵢ₁|w + vᵢ|^1.5/cₘ and in the melting rate."
        },
        "aₐ": {
          "type": "parameter",
          "units": "m^2.625/g^0.875/s",
          "default": 0.0052,
          "description": "Coefficient of the rate at which rain collects cloud water (accretion)."
        },
        "cᵤ": {
          "type": "parameter",
          "units": "1",
          "default": 0.146,
          "description": "Berry size-dispersion coefficient of the autoconversion rate. The default 0.146 is the Fortran continental value; 0.366 is its maritime alternative."
        },
        "tᵤ": {
          "type": "parameter",
          "units": "s",
          "default": 60.0,
          "description": "Time scale in the autoconversion rate 𝒞ᵤ = cᵤ mₗ³/[tᵤ(aᵤ cᵤ mₗ + bᵤ nᵤ)]."
        },
        "aᵤ": {
          "type": "parameter",
          "units": "g/m^3",
          "default": 5.0,
          "description": "Concentration coefficient in the denominator of the autoconversion rate 𝒞ᵤ = cᵤ mₗ³/[tᵤ(aᵤ cᵤ mₗ + bᵤ nᵤ)]."
        },
        "bᵤ": {
          "type": "parameter",
          "units": "(g/m^3)^2*cm^3",
          "default": 0.0366,
          "description": "Mass coefficient in the denominator of the autoconversion rate 𝒞ᵤ = cᵤ mₗ³/[tᵤ(aᵤ cᵤ mₗ + bᵤ nᵤ)]."
        },
        "nᵤ": {
          "type": "parameter",
          "units": "1/cm^3",
          "default": 100000.0,
          "description": "Cloud-droplet number concentration in the Berry autoconversion rate. The default 1e5 cm⁻³ is the Fortran continental value; 50 cm⁻³ is its maritime alternative."
        },
        "cᵢ₀": {
          "type": "parameter",
          "units": "1",
          "default": 1.6,
          "description": "Constant term of the ventilation coefficient cᵢ = cᵢ₀ + cᵢ₁|w + vᵢ|^1.5/cₘ, which increases ice sublimation and melting because air flows past falling ice."
        },
        "cᵢ₁": {
          "type": "parameter",
          "units": "(s/m)^1.5",
          "default": 0.00057,
          "description": "Speed coefficient of the ventilation coefficient cᵢ = cᵢ₀ + cᵢ₁|w + vᵢ|^1.5/cₘ."
        },
        "aᵣ₀": {
          "type": "parameter",
          "units": "1",
          "default": 1.2,
          "description": "Coefficient of the initial radius profile r = r₀ + aᵣ₀ α z."
        },
        "κλ": {
          "type": "parameter",
          "units": "1",
          "default": 0.6366182836771073,
          "description": "Coefficient 2/πᵣ of the wind-driven exchange rate λ𝑤."
        },
        "κE": {
          "type": "parameter",
          "units": "1",
          "default": 0.31830914183855363,
          "description": "Coefficient 1/πᵣ of the wind-driven vertical-momentum loss in E𝑤."
        },
        "aᵣ₁": {
          "type": "parameter",
          "units": "1",
          "default": 0.6,
          "description": "Coefficient of radius growth by entrainment, aᵣ₁ λ r, in the radius tendency."
        },
        "zₜ": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "zt"
          ],
          "description": "Heights of the scalar levels: 0 at level 1 (the surface), 50 m at level 2, then Δz spacing."
        },
        "z𝑤": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "zm"
          ],
          "description": "Heights of the vertical-velocity levels (faces): (k − 1)Δz."
        },
        "velocity_state": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "zm"
          ],
          "description": "Prognostic vertical velocity w. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed. The prognostic states are scaled to values of order 1–10 (temperature as the excess over the ambient profile, water in g/kg, radius in km, tracer as a fraction of c₀) so that the finite-difference Jacobian of an implicit integrator perturbs every component by a meaningful relative amount."
        },
        "temperature_state": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "zt"
          ],
          "description": "Prognostic temperature excess T − Tₑ. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed."
        },
        "vapor_state": {
          "type": "unknown",
          "units": "g/kg",
          "shape": [
            "zt"
          ],
          "description": "Prognostic water-vapor mixing ratio, in g/kg. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed."
        },
        "cloud_state": {
          "type": "unknown",
          "units": "g/kg",
          "shape": [
            "zt"
          ],
          "description": "Prognostic cloud-water mixing ratio, in g/kg. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed."
        },
        "rain_state": {
          "type": "unknown",
          "units": "g/kg",
          "shape": [
            "zt"
          ],
          "description": "Prognostic rainwater mixing ratio, in g/kg. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed."
        },
        "ice_state": {
          "type": "unknown",
          "units": "g/kg",
          "shape": [
            "zt"
          ],
          "description": "Prognostic cloud-ice mixing ratio, in g/kg. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed."
        },
        "horizontal_speed_state": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "zt"
          ],
          "description": "Prognostic horizontal plume velocity u. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed."
        },
        "radius_state": {
          "type": "unknown",
          "units": "km",
          "shape": [
            "zt"
          ],
          "description": "Prognostic plume radius, in km. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed."
        },
        "tracer_state": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Prognostic passive tracer as a fraction of its boundary value c₀. Tendencies apply at levels 2 to nₗ − 1; level 1 is the lower boundary (its physical value is prescribed separately) and the top level is held fixed."
        },
        "κkm": {
          "type": "parameter",
          "units": "m/km",
          "default": 1000.0,
          "description": "Unit conversion from km to m for the radius state."
        },
        "ℋ₀": {
          "type": "unknown",
          "units": "W/m^2",
          "description": "Convective surface heat flux at time t: ℋₘᵢₙ during the first minute, then a four-step one-minute ramp to Q𝒻κWη, held until t𝒻 and ℋₑₙd afterwards (the Fortran heating table indexed by the minute containing t)."
        },
        "r₀": {
          "type": "unknown",
          "units": "m",
          "description": "Radius of the circular burning area, sqrt(A𝒻/π₀)."
        },
        "f₀": {
          "type": "unknown",
          "units": "m^4/s^3",
          "description": "Buoyancy flux of the circular source from the convective heat flux and the surface state."
        },
        "a₀": {
          "type": "unknown",
          "units": "1",
          "description": "Similarity factor 5/(6α)."
        },
        "B₀": {
          "type": "unknown",
          "units": "m^4/s^3",
          "description": "Buoyancy-flux scale cᵦαf₀."
        },
        "b₀": {
          "type": "unknown",
          "units": "m^(4/3)/s",
          "description": "Cube root of B₀."
        },
        "ℓ₀": {
          "type": "unknown",
          "units": "m",
          "description": "Virtual-origin distance a₀r₀ below the surface."
        },
        "w₀": {
          "type": "unknown",
          "units": "m/s",
          "description": "Lower-boundary vertical velocity of the similarity solution, a₀b₀/ℓ₀^(1/3)."
        },
        "β₀": {
          "type": "unknown",
          "units": "1",
          "description": "Density (temperature) correction of the similarity solution; set to its limit 0 when ℋ₀ = 0, where the general expression is 0/0."
        },
        "T₀⁽⁰⁾": {
          "type": "unknown",
          "units": "K",
          "description": "Lower-boundary plume temperature before phase changes, Tₑ[1]/(1 − β₀)."
        },
        "φₘ": {
          "type": "unknown",
          "units": "1",
          "description": "Fuel-moisture factor 1/2 + floor(m𝒻)/100 of the fire water source."
        },
        "δq₀": {
          "type": "unknown",
          "units": "1",
          "description": "Water-vapor increment supplied by the fire (combustion water plus fuel moisture) spread over the boundary mass flux w₀ρ; zero when ℋ₀ = 0."
        },
        "qᵥ₀⁽⁰⁾": {
          "type": "unknown",
          "units": "1",
          "description": "Lower-boundary vapor before phase changes: ambient plus fire vapor, capped at saturation."
        },
        "qₗ₀⁽⁰⁾": {
          "type": "unknown",
          "units": "1",
          "description": "Lower-boundary cloud water before phase changes: the fire vapor in excess of saturation."
        },
        "T⁽⁰⁾": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "zt"
          ],
          "description": "Temperature before microphysical adjustment: T₀⁽⁰⁾ at level 1, Tₑ plus the state above."
        },
        "qᵥ⁽⁰⁾": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Vapor before microphysical adjustment: qᵥ₀⁽⁰⁾ at level 1, the prognostic state above."
        },
        "qₗ⁽⁰⁾": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Cloud water before microphysical adjustment: qₗ₀⁽⁰⁾ at level 1, the prognostic state above."
        },
        "qᵣ⁽⁰⁾": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Rain before microphysical adjustment. At level 1 the boundary takes the rain of level 2 (the Fortran \"soaks up\" hydrometeors at the surface)."
        },
        "qᵢ⁽⁰⁾": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Ice before microphysical adjustment; level 1 takes the ice of level 2."
        },
        "T": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "zt"
          ],
          "description": "Physical plume temperature: the adjusted boundary value T⁽⁶⁾[1] at level 1, Tₑ plus the state above."
        },
        "qᵥ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Physical water-vapor mixing ratio (adjusted boundary value at level 1)."
        },
        "qₗ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Physical cloud-water mixing ratio (adjusted boundary value at level 1)."
        },
        "qᵣ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Physical rainwater mixing ratio (adjusted boundary value at level 1)."
        },
        "qᵢ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Physical cloud-ice mixing ratio (adjusted boundary value at level 1)."
        },
        "u": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "zt"
          ],
          "description": "Physical horizontal plume velocity; zero at the lower boundary."
        },
        "r": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "zt"
          ],
          "description": "Physical plume radius; the source radius r₀ at the lower boundary."
        },
        "c": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Passive tracer; c₀ at the lower boundary."
        },
        "w": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "zm"
          ],
          "description": "Physical vertical velocity; w₀ at the lower boundary."
        },
        "ρ": {
          "type": "unknown",
          "units": "g/m^3",
          "shape": [
            "zt"
          ],
          "description": "Air density κρpₑ/T⁽⁰⁾ (the Fortran RHO, which at level 1 is evaluated before the boundary phase changes)."
        },
        "eₛ": {
          "type": "unknown",
          "units": "kPa",
          "shape": [
            "zt"
          ],
          "description": "Saturation vapor pressure (Tetens) at T⁽⁰⁾."
        },
        "qₛ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Saturation water-vapor mixing ratio at T⁽⁰⁾ and pₑ."
        },
        "Gₛ": {
          "type": "unknown",
          "units": "1/m",
          "shape": [
            "zt"
          ],
          "description": "Centred vertical gradient of qₛ, zero at both boundaries."
        },
        "w̄": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "zt"
          ],
          "description": "Vertical velocity averaged to the scalar levels; w₀ at level 1 and zero at the top."
        },
        "τᵏ": {
          "type": "unknown",
          "units": "s",
          "shape": [
            "zt"
          ],
          "description": "Microphysical adjustment interval by level: 3τμ at the lower boundary (where the Fortran applies one full step instead of three substeps) and τμ above."
        },
        "cᵢ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Ice ventilation coefficient at each scalar level, from the vertical velocity of the face below (w₀ at level 1)."
        },
        "qₗᶜ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Nonnegative cloud-water mixing ratio retained above the threshold qε; smaller values are set to zero."
        },
        "qᵣᶜ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Nonnegative rainwater mixing ratio retained above the threshold qε; smaller values are set to zero."
        },
        "qᵢᶜ": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "zt"
          ],
          "description": "Nonnegative ice mixing ratio retained above the threshold qε; smaller values are set to zero."
