{
  "esm": "1.0.0",
  "metadata": {
    "name": "saint_venant_upwind1_inflow",
    "description": "Discretization ADAPTER for saint_venant.esm: first-order upwind (backward) spatial discretization of the Saint-Venant mass and momentum fluxes on a uniform 1-D along-slope grid, with a prescribed inflow (Dirichlet) boundary at the upslope wall (l=0) and natural outflow at l=L. Injected into the discretization-agnostic saint_venant leaf at test/example time (esm-spec §9.7.10 form C) so the same PDE leaf can be run under different schemes without editing it. Two per-variable GROUND rules (esm-spec §9.6.8 ground-`args` selection) — one on D(q_flux, wrt: l), one on D(F_mom, wrt: l) — each reuse EarthSciDiscretizations' generic `upwind1_D_interior` backward stencil in the interior [2, N] and add their OWN inflow face at i=1, because the two conserved fluxes carry DIFFERENT boundary wall values: the mass flux q enters with q_bc (zero at a drainage divide) and the momentum flux F enters with F_bc = q_bc^2/max(h_bc,h_min) + g*h_bc^2/2 (the hydrostatic pressure of the boundary film). A single generic single-`gL` inflow rule cannot express two distinct wall values on one grid, and `where` shape-scoping cannot separate two fields declared over the same index set, so the per-variable inflow is grounded here rather than in the generic library. `q_bc`, `F_bc`, and `dx` resolve as free names in the consuming (saint_venant) scope; `N` is left open at the interior-stencil import so a test/example binds the grid size (and hence the resolution) at the injection edge. The ESD interior stencil is referenced via ${ESD_ROOT} (esm-spec §4.7 env-var ref expansion), so CI/checkouts point the two sibling repositories at each other without hard-coded paths. O(dx) first order; upwind for non-negative (downslope) transport.",
    "license": "MIT",
    "tags": ["esd:adapter", "family:finite_difference", "grid:cartesian_uniform_1d", "op:D", "order:1", "bc:inflow_dirichlet", "spec:9.6.8", "spec:9.7.10", "model:saint_venant"],
    "references": [
      {
        "citation": "LeVeque, R. J. (2002). Finite Volume Methods for Hyperbolic Problems. Cambridge University Press. Section 4.8 (upwind methods) and Section 7 (inflow boundary conditions for advection)."
      }
    ]
  },
  "expression_template_imports": [
    { "ref": "${ESD_ROOT}/grids/cartesian_uniform_1d/stencils/upwind1_D_interior.esm",
      "rename": { "x": "l" } }
  ],
  "expression_templates": {
    "q_flux_inflow_l": {
      "params": [],
      "priority": 10,
      "match": { "op": "D", "args": ["q_flux"], "wrt": "l" },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [ [[2, "N"]], [[1, 1]] ],
        "values": [
          { "op": "apply_expression_template", "args": [], "name": "upwind1_D_interior", "bindings": { "f": "q_flux" } },
          { "op": "/", "args": [ { "op": "-", "args": [ { "op": "index", "args": ["q_flux", 1] }, "q_bc" ] }, "dx" ] }
        ]
      }
    },
    "F_mom_inflow_l": {
      "params": [],
      "priority": 10,
      "match": { "op": "D", "args": ["F_mom"], "wrt": "l" },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [ [[2, "N"]], [[1, 1]] ],
        "values": [
          { "op": "apply_expression_template", "args": [], "name": "upwind1_D_interior", "bindings": { "f": "F_mom" } },
          { "op": "/", "args": [ { "op": "-", "args": [ { "op": "index", "args": ["F_mom", 1] }, "F_bc" ] }, "dx" ] }
        ]
      }
    }
  }
}
