   "description": "cap irrigation demand into the orchestration (mosart_run step 2)"
  },
  {
   "type": "variable_map",
   "from": "RofCap.qsur_ice_m3s",
   "to": "Control.qsur_ice_m3s",
   "transform": "param_to_var",
