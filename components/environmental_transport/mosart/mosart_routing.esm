   "description": "channel storage to the cap export conversion (Flrr_volrmch)"
  },
  {
   "type": "variable_map",
   "from": "Control.tdepth",
   "to": "RofCap.tdepth_m",
   "transform": "param_to_var",
   "description": "stream depth to the cap export conversion (Sr_tdepth)"
  },
  {
   "type": "variable_map",
   "from": "Control.tdepth_max",
   "to": "RofCap.tdepth_max_m",
   "transform": "param_to_var",
   "description": "maximum stream depth to the cap export conversion (Sr_tdepth_max)"
  }
 ]
}
