   "transform": "param_to_var",
   "description": "liquid glc runoff to the cap export conversion (Forr_rofl_glc)"
  },
  {
   "type": "variable_map",
   "from": "Control.rofi_glc_m3s",
   "to": "RofCap.rofi_glc_m3s",
   "transform": "param_to_var",
   "description": "frozen glc runoff to the cap export conversion (Forr_rofi_glc)"
  },
  {
