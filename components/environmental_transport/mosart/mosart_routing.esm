   "from": "Control.delt",
   "to": "Hillslope.delt",
   "transform": "param_to_var",
   "description": "Euler substep into the hillslope step (Tctl%DeltaT)"
  },
  {
   "type": "variable_map",
   "from": "Hillslope.etin",
   "to": "Subnetwork.etin",
   "transform": "param_to_var",
   "description": "hillslope lateral inflow into the subnetwork step (Euler step 2; F90:79)"
  },
  {
   "type": "variable_map",
   "from": "Control.localdelt_t",
   "to": "Subnetwork.localdelt",
   "transform": "param_to_var",
   "description": "subnetwork local substep (F90:120)"
  },
  {
   "type": "variable_map",
   "from": "Subnetwork.erlateral",
   "to": "Channel.erlateral",
   "transform": "param_to_var",
   "description": "subnetwork lateral outflow into the main channel (Euler step 4)"
  },
  {
   "type": "variable_map",
   "from": "Control.qgwl_ms",
   "to": "Channel.qgwl",
   "transform": "param_to_var",
   "description": "gwl runoff (m/s) into the channel step (Routing_KW temp_gwl, F90:325)"
  },
  {
   "type": "variable_map",
   "from": "Control.localdelt_r",
   "to": "Channel.localdelt",
   "transform": "param_to_var",
   "description": "main-channel local substep (F90:184)"
  },
  {
   "type": "variable_map",
   "from": "Channel.erout",
   "to": "Control.erout",
   "transform": "param_to_var",
   "description": "main-channel outflow back to the orchestration for the flow/runoff aggregation (Euler step 4; F90:201)"
  },
  {
   "type": "variable_map",
   "from": "Channel.wr",
   "to": "Control.wr",
   "transform": "param_to_var",
   "description": "main-channel storage into the irrigation/flood/qgwl-threshold rules (mosart_run steps 2-4)"
  },
  {
   "type": "variable_map",
