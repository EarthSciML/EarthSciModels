{
 "esm": "2.0.0",
 "metadata": {
  "name": "mosart_routing_coupling",
  "description": "Coupling library (esm-spec 10.9-10.10) for the MOSART river-routing subassembly (stage 2 of the EqESM project): the single source of the 43 variable_map param_to_var wiring edges of mosart_routing.esm, written against the five roles RofCap, Control, Hillslope, Subnetwork, Channel. The edges are the data flow of the Euler cascade of mosart_physics.F90 (hillslope -> subnetwork -> main channel) plus the med<->rof cap stream conversions: the cap runoff streams qsur/qsub/qgwl/qirrig/qsur_ice/qglc_liq/qglc_ice (m3/s) into the Control orchestration (mosart_run, mosart_driver.F90:375-873 steps 1-8), the converted m/s streams and Euler substep delt into the hillslope step (F90:74-80), the hillslope lateral inflow etin into the subnetwork step (F90:79), the subnetwork lateral outflow erlateral into the main-channel step (F90:125-127), the actual irrigation withdrawal qirrig_actual out of the main-channel storage (mosart_driver.F90:497), the channel outflow erout and storages wr/wt/wh back into the orchestration for the irrigation/flood/qgwl-threshold rules and the volr aggregation (F90:497, 513-517, 637-684, 854), and the Control export streams (rofl/rofi/rofl_glc/rofi_glc/flood/volr_m3/volrmch_m3/tdepth/tdepth_max) into the cap export conversions (rof_import_export.F90:636-643, 389-402), plus 13 cell-geometry edges that make Control the single source of area, frac, rlen, rwidth, rdepth, areaTotal2, rslpsqrt, tlen, twidth and tslpsqrt for RofCap/Hillslope/Subnetwork/Channel, so the set_subtimesteps CFL and the routing laws always see the same cell. Consumed by coupling_import in mosart_routing.esm (bind: the subassembly's own five models), so the wiring is authored once and imported by reference everywhere.",
  "tags": [
   "environmental_transport",
   "mosart",
   "river-routing",
   "coupling",
   "cesm"
  ],
  "created": "2026-11-15T00:00:00Z",
  "authors": [
   "EqESM project contributors"
  ],
  "references": [
   {
    "citation": "Li, H., Wigmosta, M. S., Wu, H., Huang, M., Ke, Y., Coleman, A. M., and Leung, L. R. (2013). A physically based runoff routing model for land surface and earth system models. Journal of Hydrometeorology, 14(3), 808-828. The MOSART (Model for Scale Adaptive River Transport) routing scheme these components transcribe.",
    "doi": "10.1175/JHM-D-12-015.1"
   },
   {
    "citation": "CESM (Community Earth System Model), ESCOMP/CESM, cesm3.0-alphabranch: MOSART river-routing source (mosart1.1.13) - mosart_physics.F90, mosart_driver.F90, mosart_tstatusflux_type.F90, mosart_tspatialunit_type.F90, rof_comp_nuopc/rof_import_export.F90 - the reference implementation these components are transcribed from.",
    "url": "https://github.com/ESCOMP/CESM"
   },
   {
    "citation": "EarthSciModels - the authoritative .esm corpus this component lives in.",
    "url": "https://github.com/EarthSciML/EarthSciModels"
   }
  ]
 },
 "coupling_roles": {
  "RofCap": {
   "description": "med<->rof cap unit-conversion model (mosart_coupling.esm)"
  },
  "Control": {
   "description": "mosart_run orchestration model (inline in mosart_routing.esm)"
  },
  "Hillslope": {
   "description": "hillslope storage step (mosart_hillslope.esm)"
  },
  "Subnetwork": {
   "description": "tributary subnetwork storage step (mosart_subnetwork.esm)"
  },
  "Channel": {
   "description": "main-channel storage step (mosart_channel.esm)"
  }
 },
 "coupling": [
  {
   "type": "variable_map",
   "from": "RofCap.qsur_m3s",
   "to": "Control.qsur_m3s",
   "transform": "param_to_var",
   "description": "cap surface-runoff stream into the orchestration (mosart_run step 1)"
  },
  {
   "type": "variable_map",
   "from": "RofCap.qsub_m3s",
   "to": "Control.qsub_m3s",
   "transform": "param_to_var",
   "description": "cap subsurface-runoff stream into the orchestration"
  },
  {
   "type": "variable_map",
   "from": "RofCap.qgwl_m3s",
   "to": "Control.qgwl_m3s",
   "transform": "param_to_var",
   "description": "cap gwl-runoff stream into the orchestration"
  },
  {
   "type": "variable_map",
   "from": "RofCap.qirrig_m3s",
   "to": "Control.qirrig_m3s",
   "transform": "param_to_var",
   "description": "cap irrigation demand into the orchestration (mosart_run step 2)"
  },
  {
   "type": "variable_map",
   "from": "RofCap.qsur_ice_m3s",
   "to": "Control.qsur_ice_m3s",
   "transform": "param_to_var",
   "description": "cap frozen-runoff stream into the direct-transfer rules (mosart_run step 4)"
  },
  {
   "type": "variable_map",
   "from": "RofCap.qglc_liq_m3s",
   "to": "Control.qglc_liq_m3s",
   "transform": "param_to_var",
   "description": "cap liquid glc runoff into the direct-transfer rules"
  },
  {
   "type": "variable_map",
   "from": "RofCap.qglc_ice_m3s",
   "to": "Control.qglc_ice_m3s",
   "transform": "param_to_var",
   "description": "cap frozen glc runoff into the direct-transfer rules"
  },
  {
   "type": "variable_map",
   "from": "Control.qsur_ms",
   "to": "Hillslope.qsur",
   "transform": "param_to_var",
   "description": "surface runoff (m/s) into the hillslope step (Euler step 1)"
  },
  {
   "type": "variable_map",
   "from": "Control.qsub_ms",
   "to": "Hillslope.qsub",
   "transform": "param_to_var",
   "description": "subsurface runoff (m/s) into the hillslope step"
  },
  {
   "type": "variable_map",
   "from": "Control.delt",
   "to": "Hillslope.delt",
   "transform": "param_to_var",
   "description": "Euler substep into the hillslope step (Tctl%DeltaT)"
  },
  {
   "type": "variable_map",
   "from": "Hillslope.etin",
   "to": "Subnetwork.etin",
   "transform": "param_to_var",
   "description": "hillslope lateral inflow into the subnetwork step (Euler step 2; F90:79)"
  },
  {
   "type": "variable_map",
   "from": "Control.localdelt_t",
   "to": "Subnetwork.localdelt",
   "transform": "param_to_var",
   "description": "subnetwork local substep (F90:120)"
  },
  {
   "type": "variable_map",
   "from": "Subnetwork.erlateral",
   "to": "Channel.erlateral",
   "transform": "param_to_var",
   "description": "subnetwork lateral outflow into the main channel (Euler step 4)"
  },
  {
   "type": "variable_map",
   "from": "Control.qgwl_ms",
   "to": "Channel.qgwl",
   "transform": "param_to_var",
   "description": "gwl runoff (m/s) into the channel step (Routing_KW temp_gwl, F90:325)"
  },
  {
   "type": "variable_map",
   "from": "Control.localdelt_r",
   "to": "Channel.localdelt",
   "transform": "param_to_var",
   "description": "main-channel local substep (F90:184)"
  },
  {
   "type": "variable_map",
   "from": "Control.qirrig_actual",
   "to": "Channel.qirrig",
   "transform": "param_to_var",
   "description": "actual irrigation withdrawal (<= 0) out of the main channel (mosart_run step 2: wr -= irrig_volume, mosart_driver.F90:497), so the water sent to the land leaves the channel storage"
  },
  {
   "type": "variable_map",
   "from": "Channel.erout",
   "to": "Control.erout",
   "transform": "param_to_var",
   "description": "main-channel outflow back to the orchestration for the flow/runoff aggregation (Euler step 4; F90:201)"
  },
  {
   "type": "variable_map",
   "from": "Channel.wr",
   "to": "Control.wr",
   "transform": "param_to_var",
   "description": "main-channel storage into the irrigation/flood/qgwl-threshold rules (mosart_run steps 2-4)"
  },
  {
   "type": "variable_map",
   "from": "Subnetwork.wt",
   "to": "Control.wt",
   "transform": "param_to_var",
   "description": "subnetwork storage into the volr aggregation (F90:854)"
  },
  {
   "type": "variable_map",
   "from": "Hillslope.wh",
   "to": "Control.wh",
   "transform": "param_to_var",
   "description": "hillslope storage into the volr aggregation (F90:854)"
  },
  {
   "type": "variable_map",
   "from": "Subnetwork.yt",
   "to": "Control.yt",
   "transform": "param_to_var",
   "description": "tributary depth into the Sr_tdepth export (rof_import_export.F90:399)"
  },
  {
   "type": "variable_map",
   "from": "Control.rofl_m3s",
   "to": "RofCap.rofl_m3s",
   "transform": "param_to_var",
   "description": "liquid ocean runoff to the cap export conversion (Forr_rofl)"
  },
  {
   "type": "variable_map",
   "from": "Control.rofi_m3s",
   "to": "RofCap.rofi_m3s",
   "transform": "param_to_var",
   "description": "frozen ocean runoff to the cap export conversion (Forr_rofi)"
  },
  {
   "type": "variable_map",
   "from": "Control.rofl_glc_m3s",
   "to": "RofCap.rofl_glc_m3s",
   "transform": "param_to_var",
   "description": "liquid glc runoff to the cap export conversion (Forr_rofl_glc)"
  },
  {
   "type": "variable_map",
   "from": "Control.rofi_glc_m3s",
   "to": "RofCap.rofi_glc_m3s",
   "transform": "param_to_var",
   "description": "frozen glc runoff to the cap export conversion (Forr_rofi_glc)"
  },
  {
   "type": "variable_map",
   "from": "Control.flood_m3s",
   "to": "RofCap.flood_m3s",
   "transform": "param_to_var",
   "description": "flood flux to the cap export conversion (Flrr_flood, sign flip in the cap)"
  },
  {
   "type": "variable_map",
   "from": "Control.volr_m3",
   "to": "RofCap.volr_m3",
   "transform": "param_to_var",
   "description": "total storage to the cap export conversion (Flrr_volr)"
  },
  {
   "type": "variable_map",
   "from": "Control.volrmch_m3",
   "to": "RofCap.volrmch_m3",
   "transform": "param_to_var",
   "description": "channel storage to the cap export conversion (Flrr_volrmch)"
  },
  {
   "type": "variable_map",
   "from": "Control.tdepth",
   "to": "RofCap.tdepth_m",
   "transform": "param_to_var",
   "description": "stream depth to the cap export conversion (Sr_tdepth)"
  },
  {
   "type": "variable_map",
   "from": "Control.tdepth_max",
   "to": "RofCap.tdepth_max_m",
   "transform": "param_to_var",
   "description": "maximum stream depth to the cap export conversion (Sr_tdepth_max)"
  },
  {
   "type": "variable_map",
   "from": "Control.area",
   "to": "RofCap.area",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: cell area (ctl%area) into the cap conversions"
  },
  {
   "type": "variable_map",
   "from": "Control.area",
   "to": "Hillslope.area",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: cell area (TUnit%area) into the hillslope etin"
  },
  {
   "type": "variable_map",
   "from": "Control.area",
   "to": "Channel.area",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: cell area (TUnit%area) into the channel qgwl term"
  },
  {
   "type": "variable_map",
   "from": "Control.frac",
   "to": "Hillslope.frac",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: cell study-area fraction (TUnit%frac) into the hillslope etin"
  },
  {
   "type": "variable_map",
   "from": "Control.frac",
   "to": "Channel.frac",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: cell study-area fraction (TUnit%frac) into the channel qgwl term"
  },
  {
   "type": "variable_map",
   "from": "Control.rlen",
   "to": "Channel.rlen",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: main-reach length (TUnit%rlen): the CFL phi_r and the channel routing see the same reach"
  },
  {
   "type": "variable_map",
   "from": "Control.rwidth",
   "to": "Channel.rwidth",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: main-reach bankfull width (TUnit%rwidth)"
  },
  {
   "type": "variable_map",
   "from": "Control.rdepth",
   "to": "Channel.rdepth",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: bankfull depth (TUnit%rdepth): Sr_tdepth_max and the channel cross section see the same value"
  },
  {
   "type": "variable_map",
   "from": "Control.areaTotal2",
   "to": "Channel.areaTotal2",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: upstream drainage area (TUnit%areaTotal2): the CFL phi_r and the channel small-catchment branch see the same value"
  },
  {
   "type": "variable_map",
   "from": "Control.rslpsqrt",
   "to": "Channel.rslpsqrt",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: sqrt main-reach slope (TUnit%rslpsqrt): the CFL phi_r and the channel Manning law see the same slope"
  },
  {
   "type": "variable_map",
   "from": "Control.tlen",
   "to": "Subnetwork.tlen",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: tributary length (TUnit%tlen): the CFL phi_t and the subnetwork routing see the same value"
  },
  {
   "type": "variable_map",
   "from": "Control.twidth",
   "to": "Subnetwork.twidth",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: tributary width (TUnit%twidth)"
  },
  {
   "type": "variable_map",
   "from": "Control.tslpsqrt",
   "to": "Subnetwork.tslpsqrt",
   "transform": "param_to_var",
   "description": "cell geometry, single source in Control: sqrt tributary slope (TUnit%tslpsqrt): the CFL phi_t and the subnetwork Manning law see the same slope"
  }
 ]
}
