            "tests": [
                {
                    "id": "upstream_defaults_all_outputs",
                    "description": "Reproduces and tightens the four upstream `COOxidation` equation-verification tests at the canonical default scenario (every input and rate constant at its declared default: CO=2.5e18, OH=1e12, HO₂=1e14, NO=2.5e15, NO₂=2.5e16, O₃=1e18 m⁻³). The upstream `Eq 6.18 HO2 Steady-State` test (test_co_oxidation.jl:60-93) asserts HO2_ss≈2.963e13 at rtol=0.05; `Net O3 Production Rate` (95-126) asserts P_O3≈1.752e12 at rtol=0.01; `HOx Loss Rate` (128-158) asserts L_HOx≈3.08e11 at rtol=0.01; `Chain Length` (160-192) asserts chain_length≈6.58 at rtol=0.02 with 1 < chain_length < 100; `HOx Catalytic Cycling` (368-395) asserts chain_length>1 and P_O3>0. This test pins all six outputs at rel=1e-10 — up to 8 orders of magnitude tighter than the upstream bounds. Because nothing is overridden it also implicitly reproduces the upstream `Rate Constants at 298 K` test (197-211): any wrong rate-constant default would shift a pinned output off its value.",
                    "parameter_overrides": {},
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "assertions": [
                        {
                            "variable": "L_OH",
                            "time": 0.0,
                            "expected": 923000000000.0001
                        },
                        {
                            "variable": "L_HO2",
