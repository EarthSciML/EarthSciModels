            "analyses": [
                {
                    "id": "chain_length_vs_no2_regime_sweep",
                    "description": "HOx chain length and HOx termination rate as functions of NO₂, swept logarithmically from 2.5e15 to 2.5e17 m⁻³ (~0.1 to ~10 ppb at STP) with all other inputs at their defaults (CO=2.5e18, OH=1e12, HO₂=1e14, NO=2.5e15, O₃=1e18). As NO₂ rises the OH+NO₂→HNO₃ termination accelerates: L_HOx grows while the gross propagation rate k_HO2_NO·HO₂·NO is unchanged, so chain_length falls. This is the within-component analog of S&P Figure 6.3 (docs/src/co_oxidation.md) — the transition from the low-NOx long-chain (NOx-limited) regime to the high-NOx short-chain (VOC-limited) regime.",
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "parameter_sweep": {
                        "type": "cartesian",
                        "dimensions": [
                            {
                                "parameter": "NO2",
                                "range": {
                                    "start": 2500000000000000.0,
                                    "stop": 2.5e+17,
                                    "count": 60,
                                    "scale": "log"
                                }
                            }
                        ]
                    },
                    "plots": [
                        {
                            "id": "chain_length_vs_no2",
                            "type": "line",
                            "description": "HOx chain length vs NO₂ number density on log-log axes. Monotonically falling curve: higher NO₂ accelerates OH+NO₂ termination, shortening the catalytic chain from ~24 cycles at NO₂=2.5e15 down through 1 and toward ~0.8 at NO₂=2.5e17.",
                            "x": {
                                "variable": "NO2",
                                "label": "NO₂ number density (m⁻³)"
                            },
                            "y": {
                                "variable": "chain_length",
                                "label": "HOx chain length (dimensionless)"
                            }
                        },
                        {
                            "id": "l_hox_vs_no2",
                            "type": "line",
                            "description": "HOx termination rate L_HOx vs NO₂ number density. Rises with NO₂ — the OH+NO₂ termination term is linear in NO₂ — while the HO₂-self-reaction term stays fixed; the growing termination rate is what drives the chain-length decline.",
                            "x": {
                                "variable": "NO2",
                                "label": "NO₂ number density (m⁻³)"
                            },
                            "y": {
                                "variable": "L_HOx",
                                "label": "HOx termination rate L_HOx (m⁻³·s⁻¹)"
                            }
                        }
                    ]
                },
                {
                    "id": "o3_production_vs_no_sweep",
                    "description": "Net ozone production rate and high-NOx HO₂ steady state as functions of NO, swept logarithmically from 2.5e14 to 2.5e16 m⁻³ (~0.01 to ~1 ppb at STP) with all other inputs at their defaults. The gross-production term k_HO2_NO·HO₂·NO is linear in NO so P_O3 rises with NO (and goes net-negative at the low-NO end where the fixed O₃-loss terms dominate). HO2_ss = k_CO_OH·CO·OH/(k_HO2_NO·NO) is inversely proportional to NO, so it falls as NO rises — the more NO available, the faster HO₂ is consumed and the lower its high-NOx steady state.",
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "parameter_sweep": {
                        "type": "cartesian",
                        "dimensions": [
                            {
                                "parameter": "NO",
                                "range": {
                                    "start": 250000000000000.0,
                                    "stop": 2.5e+16,
                                    "count": 60,
                                    "scale": "log"
                                }
                            }
                        ]
                    },
                    "plots": [
                        {
                            "id": "p_o3_vs_no",
                            "type": "line",
                            "description": "Net O₃ production rate P_O3 vs NO number density. Rises with NO — the gross HO₂+NO production term is linear in NO — crossing from net destruction (negative) at low NO to net production at higher NO once the propagation term overtakes the fixed OH+O₃ and HO₂+O₃ ozone-loss terms.",
                            "x": {
                                "variable": "NO",
                                "label": "NO number density (m⁻³)"
                            },
                            "y": {
                                "variable": "P_O3",
                                "label": "Net O₃ production rate P_O3 (m⁻³·s⁻¹)"
                            }
                        },
                        {
                            "id": "ho2_ss_vs_no",
                            "type": "line",
                            "description": "High-NOx HO₂ steady state HO2_ss vs NO number density on log-log axes. Falls as 1/NO (HO2_ss = k_CO_OH·CO·OH/(k_HO2_NO·NO)) — a straight line of slope -1 — since more NO drains HO₂ faster.",
                            "x": {
                                "variable": "NO",
                                "label": "NO number density (m⁻³)"
                            },
                            "y": {
                                "variable": "HO2_ss",
                                "label": "HO₂ steady-state concentration (m⁻³)"
                            }
                        }
                    ]
                },
                {
                    "id": "hox_termination_vs_ho2_sweep",
                    "description": "HOx and HO₂ loss rates as functions of the HO₂ radical concentration, swept logarithmically from 1e13 to 1e15 m⁻³ with all other inputs at their defaults. The HO₂ self-reaction term two·k_HO2_HO2·HO₂² is quadratic in HO₂ while the OH+NO₂ term of L_HOx is HO₂-independent, so L_HOx crosses over from NHL-dominated (OH+NO₂ termination) at low HO₂ to HHL-dominated (HO₂ self-reaction) at high HO₂. This is the within-component analog of the HHL/NHL crossover in S&P Figure 6.4 panel (c).",
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "parameter_sweep": {
                        "type": "cartesian",
                        "dimensions": [
                            {
                                "parameter": "HO2",
                                "range": {
                                    "start": 10000000000000.0,
                                    "stop": 1000000000000000.0,
                                    "count": 50,
                                    "scale": "log"
                                }
                            }
                        ]
                    },
                    "plots": [
                        {
                            "id": "l_hox_vs_ho2",
                            "type": "line",
                            "description": "HOx termination rate L_HOx vs HO₂ number density on log-log axes. Flat at the OH+NO₂ floor (~2.5e11) at low HO₂, then rising as the quadratic HO₂-self-reaction term overtakes it — the NHL→HHL termination crossover.",
                            "x": {
                                "variable": "HO2",
                                "label": "HO₂ number density (m⁻³)"
                            },
                            "y": {
                                "variable": "L_HOx",
                                "label": "HOx termination rate L_HOx (m⁻³·s⁻¹)"
                            }
                        },
                        {
                            "id": "l_ho2_vs_ho2",
                            "type": "line",
                            "description": "HO₂ loss rate L_HO2 vs HO₂ number density on log-log axes. Rises monotonically, steepening from the linear HO₂+NO and HO₂+O₃ channels toward the quadratic HO₂-self-reaction channel at high HO₂.",
                            "x": {
                                "variable": "HO2",
                                "label": "HO₂ number density (m⁻³)"
                            },
                            "y": {
                                "variable": "L_HO2",
                                "label": "HO₂ loss rate L_HO2 (m⁻³·s⁻¹)"
                            }
                        }
                    ]
                },
                {
                    "id": "chain_length_heatmap_no_no2",
                    "description": "HOx chain length as a joint function of NO and NO₂ (2-D log-log sweep), surfacing the NOx-regime structure of the catalytic cycle. NO ∈ [2.5e14, 2.5e16] m⁻³ × NO₂ ∈ [2.5e15, 2.5e17] m⁻³, with CO/OH/HO₂/O₃ at their defaults. chain_length = k_HO2_NO·HO₂·NO / (k_OH_NO2·OH·NO₂ + two·k_HO2_HO2·HO₂²): the numerator rises with NO while the denominator rises with NO₂, so the high-chain-length corner is high NO / low NO₂ (NOx-limited long-chain regime) and the low-chain-length corner is low NO / high NO₂ (VOC-limited short-chain regime).",
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "parameter_sweep": {
                        "type": "cartesian",
                        "dimensions": [
                            {
                                "parameter": "NO",
                                "range": {
                                    "start": 250000000000000.0,
                                    "stop": 2.5e+16,
                                    "count": 25,
                                    "scale": "log"
                                }
                            },
                            {
                                "parameter": "NO2",
                                "range": {
                                    "start": 2500000000000000.0,
                                    "stop": 2.5e+17,
                                    "count": 20,
                                    "scale": "log"
                                }
                            }
                        ]
                    },
                    "plots": [
                        {
                            "id": "chain_length_heatmap",
                            "type": "heatmap",
                            "description": "HOx chain length as a function of (NO, NO₂) on log-log axes. The lower-right region (high NO, low NO₂) is the high-chain-length NOx-limited regime; the upper-left region (low NO, high NO₂) is the low-chain-length VOC-limited regime where NOx termination cuts the catalytic cycle short.",
                            "x": {
                                "variable": "NO",
                                "label": "NO number density (m⁻³, log)"
                            },
                            "y": {
                                "variable": "NO2",
                                "label": "NO₂ number density (m⁻³, log)"
                            },
                            "value": {
                                "variable": "chain_length",
                                "reduce": "final"
                            }
                        }
                    ]
                }
