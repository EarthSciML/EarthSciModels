      "RADM2.MGLY": 7387056787.887973,
      "RADM2.MO2": 123117613.13146622,
      "RADM2.DCB": 2462352262.629325,
      "RADM2.ONIT": 12311761313.146624,
      "RADM2.PAN": 24623522626.293247,
      "RADM2.TPAN": 1231176131.3146625,
      "RADM2.OP1": 12311761313.146624,
