  "RADM2Tendencies": {
   "reference": {
    "notes": "The instantaneous net production rate of every variable RADM2 species, exposed as an observed so that it can be asserted at t = 0. Each equation is the identity d<SPC>_dt = D(RADM2.<SPC>, t): esm-spec 7.4 resolves a right-hand-side time derivative over a mechanism species to the tendency the reaction system already derives, so this model adds no physics -- it is the derivative-test surface of the mechanism, and the companion to the RADM2 trajectory tests that check the same mechanism through an integrator."
   },
   "variables": {
    "dSULF_dt": {
     "type": "unknown",
     "units": "molec/cm^3/s",
     "description": "Instantaneous net production rate of SULF, the mass-action tendency the RADM2 reaction system derives for it (KPP Vdot of radm2_Fun)."
    },
    "dORA1_dt": {
