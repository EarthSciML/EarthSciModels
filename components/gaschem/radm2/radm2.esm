{
 "esm": "1.1.0",
 "metadata": {
  "name": "radm2",
  "description": "The RADM2 gas-phase mechanism (Stockwell et al. 1990) exactly as WRF-Chem chem_opt = 101 (the KPP build of RADM2; chem_opt = 1 is the older hand-coded RADM2 of chem/module_radm.F, a different code path) integrates it: 156 reactions (21 photolysis + 135 thermal) over 59 variable species plus the fixed H2O and M, translated from chem/KPP/mechanisms/radm2/radm2.eqn and radm2.spc of WRF v4.8.0 by the translation script radm2_from_kpp.py (data/eqwefic/chem_build; CLAUDE.md permits scripts for KPP .eqn reaction lists). The document holds two components: the model RADM2RateConstants evaluates every thermal rate coefficient from the hand-authored WRF rate-law templates (radm2_ratelaws.esm) with the .eqn coefficients bound once, and exposes them as observeds tested at t = 0 against the real64 KPP box driver and against a real WRF-Chem chem_opt = 101 single-column run (test regime wrfchem_scm_midtrop_rate_constants); the reaction system RADM2 carries the stoichiometry only, each rate being a scoped reference to the model (photolysis rates are the model parameters j_*). Species are in molec/cm^3 (the KPP units; WRF converts its ppmV chem array with conv = 1e-6 dens2con_a rho). The KPP rates that read a fixed species (M, H2O) do so through mass action on the constant species, exactly as KPP multiplies by FIX. Single-precision literals of radm2.eqn (.20946e0, .78084, -2.3, the constants of rc_n2o5) are transcribed as the binary64 value of the single-precision number, since that is what the Fortran evaluates.",
  "license": "MIT",
  "tags": [
   "gaschem",
   "wrf-chem",
   "radm2",
   "kpp",
   "mechanism"
  ],
  "references": [
   {
    "citation": "Stockwell, W. R., P. Middleton, J. S. Chang, and X. Tang (1990). The second generation regional acid deposition model chemical mechanism for regional air quality modeling. J. Geophys. Res. 95, 16343-16367.",
    "doi": "10.1029/JD095iD10p16343"
   },
   {
    "citation": "Grell, G. A., et al. (2005). Fully coupled online chemistry within the WRF model. Atmos. Environ. 39, 6957-6975.",
    "doi": "10.1016/j.atmosenv.2005.04.027"
   },
   {
    "citation": "Damian, V., A. Sandu, M. Damian, F. Potra, and G. R. Carmichael (2002). The kinetic preprocessor KPP - a software environment for solving chemical kinetics. Comput. Chem. Eng. 26, 1567-1579."
   }
  ]
 },
 "solver": {
  "stiffness": "high",
  "reltol": 1e-09,
  "abstol": 0.001
 },
 "models": {
  "RADM2RateConstants": {
   "expression_template_imports": [
    {
     "ref": "./radm2_ratelaws.esm"
    }
   ],
   "variables": {
    "T": {
     "type": "parameter",
     "units": "K",
     "default": 298.0,
     "description": "Air temperature (KPP TEMP)."
    },
    "T_ref": {
     "type": "parameter",
     "units": "K",
     "default": 300.0,
     "description": "Reference temperature of the (T/300)^n forms (WRF literal 300)."
    },
    "M_air": {
     "type": "parameter",
     "units": "molec/cm^3",
     "default": 2.4623522626293244e+19,
     "description": "Air number density (KPP C_M = dens2con_a rho, chem_driver.F). Named M_air, not M, because the reaction system of this document has a constant species M and the Python binding resolves bare parameter_overrides across the whole document (AmbiguousParameterError); the Rust CLI resolves them per component."
    },
    "RH": {
     "type": "parameter",
     "units": "1",
     "default": 0.55,
     "description": "Relative humidity (0-1) used only by the heterogeneous N2O5 rate (kpp_mechd_ibu_radm2.inc computes it from qv, p, T with the Bolton-type es formula and clips it to [0, 1])."
    },
    "j_no2": {
     "type": "parameter",
     "units": "1/s",
     "default": 0.0085,
     "description": "Photolysis frequency ph_no2 (WRF Registry, min^-1) divided by 60 (KPP interface jv(Pj_no2))."
    },
    "j_o31d": {
