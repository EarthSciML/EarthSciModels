{
  "esm": "1.0.0",
  "metadata": {
    "name": "radm2_ratelaws",
    "description": "Rate-coefficient forms of the WRF-Chem KPP RADM2 mechanism as pure expression templates, transcribed from chem/KPP/kpp/kpp-2.1/util/WRF_conform/WRFUserRateLaws.f90 (ARR2, TROE, TROEE, THERMAL_T2), the inline F90_RATES of chem/KPP/mechanisms/radm2/radm2.def (k46) and the in-line rate expressions of radm2.eqn (WRF v4.8.0). Every template returns a rate coefficient in the KPP units (molec/cm^3 concentrations, seconds); the numeric coefficients of each RADM2 reaction are bound where the templates are applied (components/gaschem/radm2/radm2.esm), so the mechanism's numbers live in one place. Temperature-power forms take the reference temperature T_ref (300 K in WRF) as a bound quantity so that the power base is dimensionless.",
    "license": "MIT",
    "tags": [
      "gaschem",
      "rate-laws",
      "wrf-chem",
      "radm2",
      "kpp"
    ]
  },
  "expression_templates": {
    "wrf_arr2": {
      "params": [
        "A",
        "B",
        "T"
      ],
      "description": "Simplified Arrhenius (WRFUserRateLaws ARR2): k = A exp(-B/T); B is the activation temperature in K (negative B = negative temperature dependence).",
      "body": {
        "op": "*",
        "args": [
          "A",
          {
            "op": "exp",
            "args": [
              {
                "op": "/",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      -1,
                      "B"
                    ]
                  },
                  "T"
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_arr2_scaled": {
      "params": [
        "f",
        "A",
        "B",
        "T"
      ],
      "description": "A constant fraction of an ARR2 coefficient, k = f A exp(-B/T); RADM2 uses it for reactions with O2 as the third body, f = 0.20946 the O2 volume fraction of air (written .20946e0 in radm2.eqn, i.e. a single-precision literal).",
      "body": {
        "op": "*",
        "args": [
          "f",
          "A",
          {
            "op": "exp",
            "args": [
              {
                "op": "/",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      -1,
                      "B"
                    ]
                  },
                  "T"
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_o1d_quenching": {
      "params": [
        "f_n2",
        "A_n2",
        "B_n2",
        "f_o2",
        "A_o2",
        "B_o2",
        "T"
      ],
      "description": "Quenching of O(1D) by air as the volume-fraction-weighted sum of the N2 and O2 channels, k = f_n2 A_n2 exp(-B_n2/T) + f_o2 A_o2 exp(-B_o2/T) (radm2.eqn reaction O1D + M -> O3P; f_n2 = .78084, f_o2 = .20946e0 single-precision literals).",
      "body": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              "f_n2",
              "A_n2",
              {
                "op": "exp",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          -1,
                          "B_n2"
                        ]
                      },
                      "T"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              "f_o2",
              "A_o2",
              {
                "op": "exp",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          -1,
                          "B_o2"
                        ]
                      },
                      "T"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_o3p_o2_m": {
      "params": [
        "f_o2",
        "a",
        "n",
        "T",
        "T_ref",
        "M"
      ],
      "description": "Ozone formation O(3P) + O2 + M with O2 = f_o2 M: k = f_o2 M a (T/T_ref)^n, applied to [O3P][M] by mass action so the rate is quadratic in M (radm2.eqn: .20946e0*(C_M*6.00D-34*(TEMP/300.0)**(-2.3)); the exponent -2.3 is a single-precision literal).",
      "body": {
        "op": "*",
        "args": [
          "f_o2",
          "M",
          "a",
          {
            "op": "^",
            "args": [
              {
                "op": "/",
                "args": [
                  "T",
                  "T_ref"
                ]
              },
              "n"
            ]
          }
        ]
      }
    },
    "wrf_troe": {
      "params": [
        "k0_300",
        "n",
        "kinf_300",
        "m",
        "T",
        "T_ref",
        "M"
      ],
      "description": "Troe falloff as in Stockwell et al. (1997) (WRFUserRateLaws TROE): k0 = k0_300 (T_ref/T)^n M, kinf = kinf_300 (T_ref/T)^m, k = k0/(1 + k0/kinf) 0.6^(1/(1 + log10(k0/kinf)^2)) with the broadening factor F_c = 0.6 fixed by the scheme.",
      "body": {
        "op": "*",
        "args": [
          {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  "k0_300",
                  {
                    "op": "^",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          "T_ref",
                          "T"
                        ]
                      },
                      "n"
                    ]
                  },
                  "M"
                ]
              },
              {
                "op": "+",
                "args": [
                  1,
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "k0_300",
                          {
                            "op": "^",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  "T_ref",
                                  "T"
                                ]
                              },
                              "n"
                            ]
                          },
                          "M"
                        ]
                      },
                      {
                        "op": "*",
                        "args": [
                          "kinf_300",
                          {
                            "op": "^",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  "T_ref",
                                  "T"
                                ]
                              },
                              "m"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "^",
            "args": [
              0.6,
              {
                "op": "/",
                "args": [
                  1,
                  {
                    "op": "+",
                    "args": [
                      1,
                      {
                        "op": "^",
                        "args": [
                          {
                            "op": "log10",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  {
                                    "op": "*",
                                    "args": [
                                      "k0_300",
                                      {
                                        "op": "^",
                                        "args": [
                                          {
                                            "op": "/",
                                            "args": [
                                              "T_ref",
                                              "T"
                                            ]
                                          },
                                          "n"
                                        ]
                                      },
                                      "M"
                                    ]
                                  },
                                  {
                                    "op": "*",
                                    "args": [
                                      "kinf_300",
                                      {
                                        "op": "^",
                                        "args": [
                                          {
                                            "op": "/",
                                            "args": [
                                              "T_ref",
                                              "T"
                                            ]
                                          },
                                          "m"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          2
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_troee": {
      "params": [
        "A",
        "B",
        "k0_300",
        "n",
        "kinf_300",
        "m",
        "T",
        "T_ref",
        "M"
      ],
      "description": "Thermal decomposition as the Troe association coefficient divided by the equilibrium constant (WRFUserRateLaws TROEE): k = A exp(-B/T) troe(k0_300, n, kinf_300, m, T, M), with the same F_c = 0.6 Stockwell (1997) falloff.",
      "body": {
        "op": "*",
        "args": [
          "A",
          {
            "op": "exp",
            "args": [
              {
                "op": "/",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      -1,
                      "B"
                    ]
                  },
                  "T"
                ]
              }
            ]
          },
          {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  "k0_300",
                  {
                    "op": "^",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          "T_ref",
                          "T"
                        ]
                      },
                      "n"
                    ]
                  },
                  "M"
                ]
              },
              {
                "op": "+",
                "args": [
                  1,
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "k0_300",
                          {
                            "op": "^",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  "T_ref",
                                  "T"
                                ]
                              },
                              "n"
                            ]
                          },
                          "M"
                        ]
                      },
                      {
                        "op": "*",
                        "args": [
                          "kinf_300",
                          {
                            "op": "^",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  "T_ref",
                                  "T"
                                ]
                              },
                              "m"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "^",
            "args": [
              0.6,
              {
                "op": "/",
                "args": [
                  1,
                  {
                    "op": "+",
                    "args": [
                      1,
                      {
                        "op": "^",
                        "args": [
                          {
                            "op": "log10",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  {
                                    "op": "*",
                                    "args": [
                                      "k0_300",
                                      {
                                        "op": "^",
                                        "args": [
                                          {
                                            "op": "/",
                                            "args": [
                                              "T_ref",
                                              "T"
                                            ]
                                          },
                                          "n"
                                        ]
                                      },
                                      "M"
                                    ]
                                  },
                                  {
                                    "op": "*",
                                    "args": [
                                      "kinf_300",
                                      {
                                        "op": "^",
                                        "args": [
                                          {
                                            "op": "/",
                                            "args": [
                                              "T_ref",
                                              "T"
                                            ]
                                          },
                                          "m"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          2
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_thermal_t2": {
      "params": [
        "c",
        "d",
        "T"
      ],
      "description": "k = T^2 c exp(-d/T) (WRFUserRateLaws THERMAL_T2), the RADM2 form for OH + CH4, OH + ETH and OH + PAN.",
      "body": {
        "op": "*",
        "args": [
          {
            "op": "^",
            "args": [
              "T",
              2
            ]
          },
          "c",
          {
            "op": "exp",
            "args": [
              {
                "op": "/",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      -1,
                      "d"
                    ]
                  },
                  "T"
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_termolecular_sum": {
      "params": [
        "a0",
        "b0",
        "a2",
        "b2",
        "a3",
        "b3",
        "T",
        "M"
      ],
      "description": "OH + HNO3 (radm2.def k46, the JPL form): k = k0 + k3/(1 + k3/k2) with k0 = a0 exp(b0/T), k2 = a2 exp(b2/T), k3 = a3 exp(b3/T) M; note the POSITIVE sign convention exp(+b/T) of the Fortran.",
      "body": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              "a0",
              {
                "op": "exp",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      "b0",
                      "T"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  "a3",
                  {
                    "op": "exp",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          "b3",
                          "T"
                        ]
                      }
                    ]
                  },
                  "M"
                ]
              },
              {
                "op": "+",
                "args": [
                  1,
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "a3",
                          {
                            "op": "exp",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  "b3",
                                  "T"
                                ]
                              }
                            ]
                          },
                          "M"
                        ]
                      },
                      {
                        "op": "*",
                        "args": [
                          "a2",
                          {
                            "op": "exp",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  "b2",
                                  "T"
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_ho2_self": {
      "params": [
        "a1",
        "e1",
        "a2",
        "e2",
        "T",
        "M"
      ],
      "description": "HO2 + HO2 (and its water-enhanced channel): k = a1 exp(e1/T) + a2 M exp(e2/T), the bimolecular plus termolecular sum written in radm2.eqn with POSITIVE exponents (EXP(600./TEMP), EXP(980._dp/TEMP)).",
      "body": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              "a1",
              {
                "op": "exp",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      "e1",
                      "T"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              "a2",
              "M",
              {
                "op": "exp",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      "e2",
                      "T"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_co_oh": {
      "params": [
        "a",
        "b",
        "M"
      ],
      "description": "CO + OH pressure dependence, k = a (1 + b M) (radm2.eqn: 1.5D-13*(1._dp + 2.439D-20*C_M)).",
      "body": {
        "op": "*",
        "args": [
          "a",
          {
            "op": "+",
            "args": [
              1,
              {
                "op": "*",
                "args": [
                  "b",
                  "M"
                ]
              }
            ]
          }
        ]
      }
    },
    "wrf_n2o5_aerosol": {
      "params": [
        "rh",
        "tau_dry",
        "rh_scale",
        "p",
        "tau_min"
      ],
      "description": "Heterogeneous N2O5 + H2O -> 2 HNO3 as a relative-humidity-dependent first-order rate (WRF-Chem chem/KPP/inc/radm2/kpp_mechd_ibu_radm2.inc): rc_n2o5 = 1/(tau_dry exp(-(rh/rh_scale)^p) + tau_min), rh clipped to [0, 1] by the caller; WRF evaluates this expression in single precision.",
      "body": {
        "op": "/",
        "args": [
          1,
          {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "tau_dry",
                  {
                    "op": "exp",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          -1,
                          {
                            "op": "^",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  "rh",
                                  "rh_scale"
                                ]
                              },
                              "p"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "tau_min"
            ]
          }
        ]
      }
    }
  }
}