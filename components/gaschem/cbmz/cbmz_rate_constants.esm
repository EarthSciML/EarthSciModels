        },
        "g_ch3o2": {
          "type": "unknown",
          "units": "cm^1.5/molec^0.5/s^0.5",
          "description": "Half-rate weight of CH3O2 in the peroxy pool, sqrt(A) exp(B/2T) with the self-reaction coefficients A = 2.499999990010493e-13, B = 190.0 of cbmz_mosaic.def's Aperox/Bperox diagonal (A is a single-precision literal there, so it is bound as the binary64 value of its float32 rounding)."
        },
        "g_ethp": {
          "type": "unknown",
          "units": "cm^1.5/molec^0.5/s^0.5",
          "description": "Half-rate weight of ETHP in the peroxy pool, sqrt(A) exp(B/2T) with the self-reaction coefficients A = 6.8000001517219e-14, B = 0.0 of cbmz_mosaic.def's Aperox/Bperox diagonal (A is a single-precision literal there, so it is bound as the binary64 value of its float32 rounding)."
        },
        "g_ro2": {
          "type": "unknown",
          "units": "cm^1.5/molec^0.5/s^0.5",
