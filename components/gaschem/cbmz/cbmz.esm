            "API2": 0.4873120499890077,
            "LIM1": 0.3341692526559263,
            "LIM2": 0.48730880159438505,
            "SO2": 1150714307.501945,
            "O1D": 0.0,
            "ANOL": 0.002367300948723647,
            "H2O2": 30032058791.35429,
            "PAN": 6080373.379778968,
            "TOL": 0.1304813648133024,
            "N2O5": 196418.49869104094,
            "XYL": 0.02161075983220233,
            "CH4": 39994399673368.41,
            "CRO": 0.002367300948723647,
