{
  "esm": "1.1.0",
  "metadata": {
    "name": "CBMZPeroxyPool",
    "description": "Coupling library (esm-spec \u00a710.9) closing CBM-Z's lumped peroxy-peroxy loop: CBM-Z writes reactions {127:107}..{136:116} pseudo-first-order, so ten of its rate COEFFICIENTS read the concentrations of the ten peroxy radicals of the pool, and these ten edges hand the reaction system's peroxy species to the rate-constant component that forms the pool sum (cbmz_rate_constants.esm, k_i = 2 g_i S - g_i^2 c_i). Factored out of cbmz.esm on 2026-11-12 so that every document that mounts the mechanism -- the box tests of cbmz.esm and the chemistry column couplings/cbmz_column.esm -- closes the loop with the same ten edges instead of a copy of them. Roles: Mech (the CBMZ reaction system) and Rates (CBMZRateConstants). Import with coupling_import + bind {Mech, Rates}.",
    "tags": [
      "coupling-library",
      "wrf-chem",
      "cbm-z",
      "peroxy",
      "param_to_var"
    ]
  },
  "coupling_roles": {
    "Mech": {
      "description": "The CBM-Z reaction system; provides the ten peroxy radical concentrations (molec/cm^3)."
    },
    "Rates": {
      "description": "CBMZRateConstants; its c_<peroxy> parameters are driven by the mechanism's own species."
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Mech.CH3O2",
      "to": "Rates.c_ch3o2",
      "transform": "param_to_var",
      "description": "CH3O2 drives its own entry in the lumped peroxy pool. CBM-Z writes reactions {127:107}..{136:116} pseudo-first-order, so ten of its rate COEFFICIENTS read the peroxy concentrations; this is the edge that closes that loop."
    },
    {
      "type": "variable_map",
      "from": "Mech.ETHP",
      "to": "Rates.c_ethp",
      "transform": "param_to_var",
      "description": "ETHP drives its own entry in the lumped peroxy pool. CBM-Z writes reactions {127:107}..{136:116} pseudo-first-order, so ten of its rate COEFFICIENTS read the peroxy concentrations; this is the edge that closes that loop."
    },
    {
      "type": "variable_map",
      "from": "Mech.RO2",
      "to": "Rates.c_ro2",
      "transform": "param_to_var",
      "description": "RO2 drives its own entry in the lumped peroxy pool. CBM-Z writes reactions {127:107}..{136:116} pseudo-first-order, so ten of its rate COEFFICIENTS read the peroxy concentrations; this is the edge that closes that loop."
    },
    {
      "type": "variable_map",
      "from": "Mech.C2O3",
