                                "parameter": "O3",
                                "range": {
                                    "start": 5e+17,
                                    "stop": 3e+18,
                                    "count": 200,
                                    "scale": "linear"
                                }
                            }
                        ]
                    },
                    "plots": [
                        {
                            "id": "p_o3_vs_o3",
                            "type": "line",
                            "description": "Net ozone production rate P_O3 vs measured O₃ number density at NO = 1 ppb, NO₂ = 2 ppb. A straight line decreasing in O3, crossing zero at O3 = O3_pss ≈ 8.42e17 m⁻³ — positive (net production) to the left, negative (net loss) to the right.",
                            "x": {
                                "variable": "O3",
                                "label": "Measured O₃ number density (m⁻³)"
                            },
                            "y": {
                                "variable": "P_O3",
                                "label": "Net O₃ production rate (m⁻³ s⁻¹)"
                            }
                        }
                    ]
                },
                {
                    "id": "o3_pss_heatmap_no_no2",
                    "description": "Photostationary-state ozone O3_pss as a joint function of NO and NO₂ (2-D log-log sweep), surfacing the full Leighton-relationship surface O3_pss = (j_NO2/k_NO_O3)·([NO₂]/[NO]). NO ∈ [1e15, 1e18] m⁻³ and NO2 ∈ [1e15, 1e18] m⁻³ each span three decades (clean-remote to heavily-polluted). O3_pss is constant along the diagonals of constant NO₂/NO ratio: the top-left corner (high NO₂, low NO) gives the highest photostationary ozone, the bottom-right (low NO₂, high NO) the lowest. The realistic urban band sits near the NO₂/NO ≈ 1-5 diagonal.",
                    "parameters": {
                        "O3": 1e+18,
                        "O2": 5.25e+24,
                        "M": 2.5e+25
                    },
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "parameter_sweep": {
                        "type": "cartesian",
                        "dimensions": [
