                                "args": [
                                    "j_NO2",
                                    "NO2"
                                ]
                            },
                            {
                                "op": "*",
                                "args": [
                                    "k_NO_O3",
                                    "NO",
                                    "O3"
                                ]
                            }
                        ]
                    }
                },
                {
                    "lhs": "P_O3",
                    "rhs": {
                        "op": "-",
                        "args": [
                            {
                                "op": "*",
                                "args": [
                                    "j_NO2",
                                    "NO2"
