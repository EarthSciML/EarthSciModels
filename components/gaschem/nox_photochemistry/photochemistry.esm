            "analyses": [
                {
                    "id": "photostationary_o3_vs_no2_no_ratio",
                    "description": "Photostationary-state ozone O3_pss as a function of the NO₂/NO ratio — reproduces the GasChem.jl doc-page figure `nox_pss_o3.svg` (docs/src/nox_photochemistry.md, lines 94-135). NO is held fixed at 2.5e16 m⁻³ (~1 ppb) and NO2 is swept from 2.5e15 to 2.5e17 m⁻³, spanning a NO₂/NO ratio of 0.1 to 10. The Leighton relationship (Eq. 6.6) predicts O3_pss ∝ [NO₂]/[NO], so the curve is an exact straight line through the origin — higher NO₂/NO ratios (more polluted conditions) give higher photostationary ozone.",
                    "parameters": {
                        "NO": 2.5e+16,
                        "O3": 1e+18,
                        "O2": 5.25e+24,
                        "M": 2.5e+25
                    },
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "parameter_sweep": {
                        "type": "cartesian",
                        "dimensions": [
                            {
                                "parameter": "NO2",
                                "range": {
                                    "start": 2500000000000000.0,
                                    "stop": 2.5e+17,
                                    "count": 200,
                                    "scale": "linear"
                                }
                            }
                        ]
                    },
                    "plots": [
                        {
                            "id": "o3_pss_vs_no2",
                            "type": "line",
                            "description": "Photostationary-state ozone O3_pss vs NO₂ number density at fixed NO = 2.5e16 m⁻³. A straight line through the origin (the Leighton relationship Eq. 6.6), O3_pss rising from ~8e16 m⁻³ at NO2/NO = 0.1 to ~8e18 m⁻³ at NO2/NO = 10.",
                            "x": {
                                "variable": "NO2",
                                "label": "NO₂ number density (m⁻³)"
                            },
                            "y": {
                                "variable": "O3_pss",
                                "label": "Photostationary-state O₃ (m⁻³)"
                            }
                        }
                    ]
                },
                {
                    "id": "phi_vs_measured_o3",
                    "description": "Photostationary-state parameter Φ as a function of the measured/ambient ozone — reproduces the GasChem.jl doc-page figure `nox_phi.svg` (docs/src/nox_photochemistry.md, lines 149-183). NO and NO2 are held at 2.5e16 and 5.0e16 m⁻³ (1 and 2 ppb) and the ambient O3 is swept from 5.0e17 to 3.0e18 m⁻³ (~20 to ~120 ppb). Φ = O3_pss/O3 falls as a 1/O3 hyperbola, crossing Φ = 1 exactly at the photostationary value O3_pss ≈ 8.42e17 m⁻³ (~34 ppb). Φ > 1 to the left (measured O3 below PSS → net ozone production, peroxy radicals active); Φ < 1 to the right (measured O3 above PSS → net loss).",
                    "parameters": {
                        "NO": 2.5e+16,
                        "NO2": 5e+16,
                        "O2": 5.25e+24,
                        "M": 2.5e+25
                    },
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "parameter_sweep": {
                        "type": "cartesian",
                        "dimensions": [
                            {
                                "parameter": "O3",
                                "range": {
                                    "start": 5e+17,
                                    "stop": 3e+18,
                                    "count": 200,
                                    "scale": "linear"
                                }
                            }
                        ]
                    },
                    "plots": [
                        {
                            "id": "phi_vs_o3",
                            "type": "line",
                            "description": "Photostationary-state parameter Φ vs measured O₃ number density at NO = 1 ppb, NO₂ = 2 ppb. A 1/O3 hyperbola crossing Φ = 1 at O3 = O3_pss ≈ 8.42e17 m⁻³. Φ > 1 below the crossing (net O₃ production), Φ < 1 above it (net O₃ loss).",
                            "x": {
                                "variable": "O3",
                                "label": "Measured O₃ number density (m⁻³)"
                            },
                            "y": {
                                "variable": "Φ",
                                "label": "Photostationary-state parameter Φ (dimensionless)"
                            }
                        }
                    ]
                },
                {
                    "id": "net_o3_production_vs_o3",
                    "description": "Net ozone production rate P_O3 (Eq. 6.8) as a function of the ambient ozone, at the typical-midday NO/NO2 (2.5e16 and 5.0e16 m⁻³). The ambient O3 is swept from 5.0e17 to 3.0e18 m⁻³. P_O3 = j_NO2·NO2 − k_NO_O3·NO·O3 is an exact straight line decreasing in O3, crossing zero at the photostationary value O3_pss ≈ 8.42e17 m⁻³: net ozone production to the left of the crossing, net loss to the right. This is the linear (Eq. 6.8) companion to the `phi_vs_measured_o3` hyperbola — the same departure from photostationary state viewed as a rate rather than a ratio.",
                    "parameters": {
                        "NO": 2.5e+16,
                        "NO2": 5e+16,
                        "O2": 5.25e+24,
                        "M": 2.5e+25
                    },
                    "time_span": {
                        "start": 0.0,
