                                "parameter": "NO2",
                                "range": {
                                    "start": 1000000000000000.0,
                                    "stop": 1e+18,
                                    "count": 25,
                                    "scale": "log"
                                }
                            }
                        ]
                    },
                    "plots": [
                        {
                            "id": "o3_pss_heatmap",
                            "type": "heatmap",
                            "description": "Photostationary-state O₃ as a function of (NO, NO₂) on log-log axes. O3_pss is constant along constant-NO₂/NO diagonals; highest in the high-NO₂/low-NO corner, lowest in the low-NO₂/high-NO corner.",
                            "x": {
                                "variable": "NO",
                                "label": "NO number density (m⁻³, log)"
                            },
                            "y": {
                                "variable": "NO2",
                                "label": "NO₂ number density (m⁻³, log)"
                            },
                            "value": {
                                "variable": "O3_pss",
                                "reduce": "final"
                            }
                        }
                    ]
                }
