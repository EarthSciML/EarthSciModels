                            "variable": "O3_pss",
                            "time": 0.0,
                            "expected": 8.421052631578948e+17
                        }
                    ]
                },
                {
                    "id": "o3_pss_inverse_in_no",
                    "description": "Complements the upstream NO2/NO-ratio test by exercising the 1/[NO] dependence of Eq. 6.6. With NO doubled to 5.0e16 m⁻³ (NO2 held at the default 5.0e16), O3_pss = j_NO2·NO2/(k_NO_O3·NO) = 4.210526315789474e17 m⁻³ — exactly half the typical-midday default O3_pss of 8.421052631578948e17 (doubling NO halves the photostationary ozone). Pinned at rel=1e-10. This gates the regression where [NO] is accidentally moved out of the Eq. 6.6 denominator.",
                    "parameter_overrides": {
                        "NO": 5e+16
                    },
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "assertions": [
