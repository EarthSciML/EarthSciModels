                            "variable": "O3_pss",
                            "time": 0.0,
                            "expected": 4.210526315789474e+17
                        }
                    ]
                },
                {
                    "id": "o3_pss_independent_of_o3_input",
                    "description": "Structural test: O3_pss (Eq. 6.6) depends only on j_NO2, NO2, k_NO_O3 and NO — it is independent of the ambient O3 input. With O3 overridden to 5.0e18 m⁻³ (5× the default) and all other inputs at their defaults, O3_pss is unchanged at 8.421052631578948e17 m⁻³ (identical to the `typical_midday_all_outputs` value). Pinned at rel=1e-10. This gates the regression where the ambient O3 input is accidentally wired into the Eq. 6.6 expression — a confusion between the measured O3 and the diagnostic O3_pss.",
                    "parameter_overrides": {
                        "O3": 5e+18
                    },
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "assertions": [
