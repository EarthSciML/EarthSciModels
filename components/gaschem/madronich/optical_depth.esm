            "lev",
            "wlbin"
          ]
        },
        "zd": {
          "type": "unknown",
          "units": "km",
          "description": "Interface heights above the surface, ordered top-down (sphers's zd).",
          "shape": [
            "lev_nodes"
          ]
        },
        "re": {
          "type": "unknown",
          "units": "km",
          "description": "Earth radius plus the surface height."
        },
        "sinz": {
          "type": "unknown",
          "units": "1",
          "description": "Sine of the solar zenith angle."
        },
        "rpsinz": {
          "type": "unknown",
          "units": "km",
          "description": "Impact parameter of the solar ray at each interface, (re+zd) sin(zenith).",
          "shape": [
            "lev_nodes"
          ]
        },
        "dsdh": {
          "type": "unknown",
          "units": "1",
          "description": "Ratio of slant to vertical path through layer j for a ray reaching interface i, sphers's dsdh(i,j). Lower triangular: a ray reaching interface i has only crossed the layers above it. GUARD, with no Fortran counterpart: where a layer has zero thickness, dsdh is 0/0, and it is set to 0. WRF never produces a zero-thickness layer; MadronichCloudGrid's padding does. The value is immaterial -- such a layer's dsdh is multiplied by taun = 2e-36 (WRF's 1/largest floor on dtscat and dtabs), and setting it to 0 or to its true finite secant limit gives fluxes that agree to 3e-15 -- but it is new logic, and it is the only division by a thickness anywhere in the chain that can reach zero. It never fires on a column without padding, so every clear-column result is untouched.",
          "shape": [
            "lev_nodes",
            "lev"
          ]
        },
        "tausla": {
          "type": "unknown",
          "units": "1",
          "description": "SLANT optical depth from the top of the atmosphere to each interface. The Fortran accumulates it in a running sum; that telescopes exactly to this contraction of taun with dsdh, so no recurrence is needed here.",
          "shape": [
            "lev_nodes",
            "wlbin"
          ]
        },
        "tauc": {
          "type": "unknown",
          "units": "1",
          "description": "VERTICAL cumulative optical depth to each interface, likewise a contraction rather than a running sum.",
          "shape": [
            "lev_nodes",
            "wlbin"
          ]
        },
        "dtauc": {
          "type": "unknown",
          "units": "1",
          "description": "Vertical optical depth of the layer above interface i.",
          "shape": [
            "lev_nodes",
            "wlbin"
          ]
        },
        "dtausla": {
          "type": "unknown",
          "units": "1",
          "description": "Slant optical depth of the layer above interface i.",
          "shape": [
            "lev_nodes",
            "wlbin"
          ]
        },
        "mu2": {
          "type": "unknown",
          "units": "1",
          "description": "Effective cosine of the slant path through each layer, dtauc/dtausla. This is what makes the scheme PSEUDO-SPHERICAL: the direct beam sees a curved atmosphere, not a plane-parallel one.",
          "shape": [
            "lev_nodes",
            "wlbin"
          ]
        },
        "fldir_td": {
          "type": "unknown",
          "units": "1",
          "description": "Direct-beam actinic flux, top-down.",
          "shape": [
            "lev_nodes",
            "wlbin"
          ]
        },
        "fldir": {
          "type": "unknown",
          "units": "1",
          "description": "Direct-beam actinic flux on the upright grid, exp(-tausla). This is photolysis_mad's fldir and one of the three components the j-value integral sums.",
          "shape": [
            "lev_nodes",
            "wlbin"
          ]
        },
        "endir": {
          "type": "unknown",
          "units": "1",
          "description": "Direct-beam IRRADIANCE, mu fldir; photolysis_mad's endir.",
          "shape": [
            "lev_nodes",
            "wlbin"
          ]
        }
      },
