{
  "esm": "1.2.0",
  "metadata": {
    "name": "MadronichParameters",
    "description": "Scheme constants of WRF-Chem's Madronich photolysis (phot_opt = 1, PHOTMAD), transcribed from chem/module_phot_mad.F of WRF v4.8.0. Only constants that the scheme itself defines or redefines live here; everything physical comes from lib/wrf_constants.esm. Three separate values of pi are in play on this code path and they are NOT interchangeable at the tolerance these tests use, so each is named for where it is spelled: pi_zenith is the literal 3.1415926535590 that SUBROUTINE calc_zenith assigns to its own local `pi` (module_phot_mad.F:2676) and uses for every degree-to-radian conversion inside the ephemeris; pi_driver is the 3.141592654 of chem/module_data_radm2.F:123, which is the `pi` in scope in madronich1_driver and therefore the one used for zenita = cos(zenith*pi/180.) (module_phot_mad.F:1497); WRF's own piconst (3.141592653589793, share/module_model_constants.F:72) is used by neither. The difference between pi_zenith and piconst is 4e-11 relative and between pi_driver and piconst 2e-10 relative, both below the 1e-5 single-precision tolerance of the tests here, but they are transcribed faithfully so that a future double-precision kernel reference still matches."
  },
  "models": {
    "MadronichParameters": {
      "variables": {
        "pi_zenith": {
          "type": "parameter",
          "units": "1",
          "default": 3.141592653559,
          "description": "Pi as SUBROUTINE calc_zenith spells it (module_phot_mad.F:2676, `pi = 3.1415926535590`)."
        },
        "degrad_zenith": {
          "type": "unknown",
          "units": "rad/deg",
          "description": "Radians per degree inside calc_zenith, its local `dr = pi/180.` (module_phot_mad.F:2677)."
        },
        "pi_driver": {
          "type": "parameter",
          "units": "1",
          "default": 3.141592654,
          "description": "Pi as seen by madronich1_driver, from chem/module_data_radm2.F:123. This is the one in `zenita = cos(zenith*pi/180.)`."
        },
        "degrad_driver": {
          "type": "unknown",
          "units": "rad/deg",
          "description": "Radians per degree in madronich1_driver, pi_driver/180."
        },
        "ml_c0": {
          "type": "parameter",
          "units": "deg",
          "default": 279.2801988,
          "description": "Geometric mean longitude of the sun, constant term (calc_zenith: ml = 279.2801988 + .9856473354*d + 2.267E-13*d*d)."
        },
        "ml_c1": {
          "type": "parameter",
          "units": "deg/day",
          "default": 0.9856473354,
          "description": "Geometric mean longitude, linear term."
        },
        "ml_c2": {
          "type": "parameter",
          "units": "deg/day^2",
          "default": 2.267e-13,
          "description": "Geometric mean longitude, quadratic term."
        },
        "w_c0": {
          "type": "parameter",
          "units": "deg",
          "default": 282.4932328,
          "description": "Mean longitude of perigee, constant term (w = 282.4932328 + 4.70684E-5*d + 3.39E-13*d*d)."
        },
        "w_c1": {
          "type": "parameter",
          "units": "deg/day",
          "default": 4.70684e-05,
          "description": "Mean longitude of perigee, linear term."
        },
        "w_c2": {
          "type": "parameter",
          "units": "deg/day^2",
          "default": 3.39e-13,
          "description": "Mean longitude of perigee, quadratic term."
        },
        "ec_c0": {
          "type": "parameter",
          "units": "1",
          "default": 0.016720041,
          "description": "Orbital eccentricity, constant term (ec = 1.6720041E-2 - 1.1444E-9*d - 9.4E-17*d*d)."
        },
        "ec_c1": {
          "type": "parameter",
          "units": "1/day",
          "default": -1.1444e-09,
          "description": "Orbital eccentricity, linear term."
        },
        "ec_c2": {
          "type": "parameter",
          "units": "1/day^2",
          "default": -9.4e-17,
          "description": "Orbital eccentricity, quadratic term."
        },
        "epsi_c0": {
          "type": "parameter",
          "units": "deg",
          "default": 23.44266511,
          "description": "Mean obliquity of the ecliptic, constant term (epsi = 23.44266511 - 3.5626E-7*d - 1.23E-15*d*d)."
        },
        "epsi_c1": {
          "type": "parameter",
          "units": "deg/day",
          "default": -3.5626e-07,
          "description": "Mean obliquity, linear term."
        },
        "epsi_c2": {
          "type": "parameter",
          "units": "deg/day^2",
          "default": -1.23e-15,
          "description": "Mean obliquity, quadratic term."
        },
        "eqt_scale": {
          "type": "parameter",
          "units": "s",
          "default": 13751.0,
          "description": "Scale converting the dimensionless Fourier sum feqt to the equation of time in seconds (eqt = feqt*13751.0)."
        },
        "eot_sec_per_deg": {
          "type": "parameter",
          "units": "s/deg",
          "default": 240.0,
          "description": "Seconds of the equation of time per degree of right ascension (reqt = eqt/240.); 86400 s / 360 deg."
        },
        "decl_tan_coeff": {
          "type": "parameter",
          "units": "1",
          "default": 0.4336,
          "description": "Coefficient of the declination, tab = 0.43360*sin(rra) with rdecl = atan(tab). 0.4336 = tan(23.44 deg)."
        },
        "solar_noon": {
          "type": "parameter",
          "units": "h",
          "default": 12.0,
          "description": "Local solar noon in hours, the leading term of lbgmt = 12.0 - eqt/3600. + long*24./360."
        },
        "sec_per_hour": {
          "type": "parameter",
          "units": "s/h",
          "default": 3600.0,
          "description": "Seconds per hour, converting the equation of time to an hour offset."
        },
        "hours_per_day": {
          "type": "parameter",
          "units": "h/day",
          "default": 24.0,
          "description": "Hours per day; used both for d = jd + gmt/24. and, with degrees_per_turn, for the longitude-to-hour conversion."
        },
        "degrees_per_turn": {
          "type": "parameter",
          "units": "deg",
          "default": 360.0,
          "description": "Degrees in a full rotation, the 360. of long*24./360."
        },
        "deg_per_hour": {
          "type": "parameter",
          "units": "deg/h",
          "default": 15.0,
          "description": "Degrees of hour angle per hour (lzgmt = 15.0*(gmt-lbgmt))."
        },
        "half_turn": {
          "type": "parameter",
          "units": "deg",
          "default": 180.0,
          "description": "Half a rotation; the 180. of the azimuth reflection azimuth = azimuth + 2*(180.-azimuth) and of the caz < -0.999999 branch."
        },
        "caz_lo": {
          "type": "parameter",
          "units": "1",
          "default": -0.999999,
          "description": "Lower guard on the cosine of the azimuth: below it calc_zenith returns azimuth = 180 rather than calling acos."
        },
        "caz_hi": {
          "type": "parameter",
          "units": "1",
          "default": 0.999999,
          "description": "Upper guard on the cosine of the azimuth: above it calc_zenith returns azimuth = 0."
        },
        "night_zenith": {
          "type": "parameter",
          "units": "deg",
          "default": 90.0,
          "description": "Zenith angle at which madronich1_driver declares night: `if(zenith.ge.90.) go to 199` skips the radiative transfer and leaves every j-value at zero (module_phot_mad.F:1495)."
        },
        "zenith_nudge": {
          "type": "parameter",
          "units": "deg",
          "default": 89.9,
          "description": "The value madronich1_driver substitutes for an exactly-90-degree zenith, `if(zenith.eq.90.) zenith = 89.9` (module_phot_mad.F:1494), so that the Chapman branch stays finite."
        },
        "chap_threshold": {
          "type": "parameter",
          "units": "deg",
          "default": 75.0,
          "description": "Zenith angle above which the effective cosine is replaced by the reciprocal Chapman function, `if(zenith.gt.75.) zenita=1./chap(zenith)` (module_phot_mad.F:1498)."
        },
        "xnkg": {
          "type": "parameter",
          "units": "1/kg",
          "default": 2.143e+25,
          "description": "Molecules of air per kilogram, DATA xnkg/2.143E25/ (photolysis_mad). air(k) = xnkg pmm5(k) 1e-6 converts the density rhoa in kg/m^3 to a number density in cm^-3."
        },
        "per_cm3_per_per_m3": {
          "type": "parameter",
          "units": "1",
          "default": 1e-06,
          "description": "The 1.E-6 of air(k) = xnkg*pmm5(k)*1.E-6: cubic metres per cubic centimetre."
        },
        "ppmv": {
          "type": "parameter",
          "units": "1",
          "default": 1e-06,
          "description": "Parts per million by volume as a fraction, the 1.E-6 of o3(k) = o3mm5(k)*1.E-6*air(k)."
        },
        "o3_floor": {
          "type": "parameter",
          "units": "1",
          "default": 0.001,
          "description": "Floor on the model ozone mixing ratio, max(1.e-3, chem(p_o3)) in ppmV (module_phot_mad.F:1553)."
        },
        "ho3": {
          "type": "parameter",
          "units": "km",
          "default": 4.5,
          "description": "Ozone scale height above the top of the grid, used by o3scal for the above-column term dobsref = o3(nn) 1e5 ho3 (module_phot_mad.F:1893, 2117)."
        },
        "dobsi": {
          "type": "parameter",
          "units": "DU",
          "default": 325.0,
          "description": "Total ozone column the profile is rescaled to, dobsi = 325. (module_phot_mad.F:1578). The 350. just above it is commented out; McKeen's 2013 header note records the change as worth +25 percent surface JO1D at 17 deg zenith."
        },
        "dobson_unit": {
          "type": "parameter",
          "units": "cm^-2",
          "default": 2.687e+16,
          "description": "Molecules per square centimetre in one Dobson unit, the 2.687E16 of o3scal."
        },
        "km_to_cm": {
          "type": "parameter",
          "units": "cm/km",
          "default": 100000.0,
          "description": "Centimetres per kilometre, the 1.E5 that turns the km-based column integrals into cm^-2."
        },
        "z_stretch_top": {
          "type": "parameter",
          "units": "km",
          "default": 50.0,
          "description": "Top of the above-model grid; both the anchor of znorm = (50-zz(top))/(50-20) and the highest level."
        },
        "z_stretch_base": {
          "type": "parameter",
          "units": "km",
          "default": 20.0,
          "description": "Lower anchor of the above-model stretch, the 20. of znorm."
        },
        "reff_a": {
          "type": "parameter",
          "units": "um",
          "default": 9.6,
          "description": "Coefficient of the cloud effective radius, reff = 9.6 wlmm5^0.333 microns."
        },
        "reff_p": {
          "type": "parameter",
          "units": "1",
          "default": 0.333,
          "description": "Exponent of the cloud effective radius."
        },
        "qll_min": {
          "type": "parameter",
          "units": "g/m^3",
          "default": 1e-30,
          "description": "Guard on the cloud water content so that reff stays finite where there is no cloud; the surrounding ifelse makes the value itself unobservable."
        },
        "bext_a": {
          "type": "parameter",
          "units": "1/km",
          "default": 0.0275,
          "description": "Constant term of the cloud extinction per unit water content, bextn = (0.0275 + 1.3/reff)*1000."
        },
        "bext_b": {
          "type": "parameter",
          "units": "um",
          "default": 1.3,
          "description": "Effective-radius term of the cloud extinction."
        },
        "bext_scale": {
          "type": "parameter",
          "units": "1",
          "default": 1000.0,
          "description": "The *1000 of bextn, which puts the cloud extinction in per-kilometre."
        },
        "o2_fraction": {
          "type": "parameter",
          "units": "1",
          "default": 0.2095,
          "description": "Volume mixing ratio of O2 in dry air, the 0.2095 of cvo2 and of srband (module_phot_mad.F:2506, 2046)."
        },
        "jpl_t_lo": {
          "type": "parameter",
          "units": "K",
          "default": 218.0,
          "description": "Lower temperature of the NASA-JPL-2011 ozone cross-section pair; below it the 218 K spectrum is used unchanged."
        },
        "jpl_t_hi": {
          "type": "parameter",
          "units": "K",
          "default": 295.0,
          "description": "Upper temperature of the pair; above it the 295 K spectrum is used unchanged."
        },
        "jpl_scale": {
          "type": "parameter",
          "units": "cm^2",
          "default": 1e-20,
          "description": "The 1.E-20 that puts the tabulated jpl218/jpl295 numbers into cm^2."
        },
        "boltz_cm": {
          "type": "parameter",
          "units": "cm^-1/K",
          "default": 0.695,
          "description": "Boltzmann constant in wavenumbers per kelvin, the 0.695 of kt = 0.695 zt(lev)."
        },
        "o1d_e1": {
          "type": "parameter",
          "units": "cm^-1",
          "default": 825.518,
          "description": "Energy of the O3 vibrational state whose population enters the O(1D) yield."
        },
        "o1d_t_ref": {
          "type": "parameter",
          "units": "K",
          "default": 300.0,
          "description": "Reference temperature of the O(1D) yield and of the CH2O quenching term."
        },
        "o1d_c0": {
          "type": "parameter",
          "units": "1",
          "default": 0.0765,
          "description": "Constant term of the 305-328 nm O(1D) yield."
        },
        "o1d_a1": {
          "type": "parameter",
          "units": "1",
          "default": 0.8036,
          "description": "Amplitude of the first (quartic-exponential) term."
        },
        "o1d_l1": {
          "type": "parameter",
          "units": "nm",
          "default": 304.225,
          "description": "Centre wavelength of the first term."
        },
        "o1d_w1": {
          "type": "parameter",
          "units": "nm",
          "default": 5.576,
          "description": "Width of the first term."
        },
        "o1d_a2": {
          "type": "parameter",
          "units": "1",
          "default": 8.9061,
          "description": "Amplitude of the second (hot-band) term."
        },
        "o1d_l2": {
          "type": "parameter",
          "units": "nm",
          "default": 314.957,
          "description": "Centre wavelength of the second term."
        },
        "o1d_w2": {
          "type": "parameter",
          "units": "nm",
          "default": 6.601,
          "description": "Width of the second term."
        },
        "o1d_a3": {
          "type": "parameter",
          "units": "1",
          "default": 0.1192,
          "description": "Amplitude of the third term."
        },
        "o1d_l3": {
          "type": "parameter",
          "units": "nm",
          "default": 310.737,
          "description": "Centre wavelength of the third term."
        },
        "o1d_w3": {
          "type": "parameter",
          "units": "nm",
          "default": 2.187,
          "description": "Width of the third term."
        },
        "o1d_lam_a": {
          "type": "parameter",
          "units": "nm",
          "default": 305.0,
          "description": "Below this wavelength the O(1D) yield is the flat 0.90."
        },
        "o1d_lam_b": {
          "type": "parameter",
          "units": "nm",
          "default": 328.0,
          "description": "Upper end of the fitted branch."
        },
        "o1d_lam_c": {
          "type": "parameter",
          "units": "nm",
          "default": 340.0,
          "description": "Upper end of the flat 0.08 tail; above it the yield is zero."
        },
        "o1d_qy_uv": {
          "type": "parameter",
          "units": "1",
          "default": 0.9,
          "description": "O(1D) yield below 305 nm."
        },
        "o1d_qy_tail": {
          "type": "parameter",
          "units": "1",
          "default": 0.08,
          "description": "O(1D) yield between 328 and 340 nm."
        },
        "ch2o_lam_min": {
          "type": "parameter",
          "units": "nm",
          "default": 330.0,
          "description": "Wavelength above which the CH2O molecular yield is pressure-quenched."
        },
        "ch2o_lam_ref": {
          "type": "parameter",
          "units": "nm",
          "default": 329.0,
          "description": "Reference wavelength of the CH2O quenching temperature term."
        },
        "ch2o_dens_ref": {
          "type": "parameter",
          "units": "cm^-3",
          "default": 2.54e+19,
          "description": "Reference air density of the CH2O quenching coefficient."
        },
        "ch2o_tdep": {
          "type": "parameter",
          "units": "1",
          "default": 61.69,
          "description": "Temperature/wavelength coefficient of the CH2O quenching."
        },
        "sv_dens_ref": {
          "type": "parameter",
          "units": "cm^-3",
          "default": 2.465e+19,
          "description": "Reference air density of the Stern-Volmer quenching shared by CH3CHO, both glyoxal channels and methylglyoxal."
        },
        "acet_c0": {
          "type": "parameter",
          "units": "1",
          "default": 0.0766,
          "description": "Constant term of the acetone yield."
        },
        "acet_a": {
          "type": "parameter",
          "units": "1",
          "default": 0.09415,
          "description": "Amplitude of the acetone yield's density term."
        },
        "acet_dens": {
          "type": "parameter",
          "units": "cm^-3",
          "default": 3.222e+18,
          "description": "e-folding density of the acetone yield."
        },
        "qy_eps": {
          "type": "parameter",
          "units": "1",
          "default": 1e-30,
          "description": "Floor applied to a tabulated yield inside a branch that is discarded when the yield is zero, so the discarded branch stays finite instead of producing an infinity."
        },
        "nm_per_um": {
          "type": "parameter",
          "units": "nm/um",
          "default": 1000.0,
          "description": "Nanometres per micron, the 1.E3 of wmicron = wl(kl)/1.E3."
        },
        "ray_a": {
          "type": "parameter",
          "units": "cm^2 um^0",
          "default": 3.9e-28,
          "description": "Amplitude of the Rayleigh cross section, 3.90E-28/(wmicron)**xx (Frohlich & Shaw 1980)."
        },
        "ray_c0": {
          "type": "parameter",
          "units": "1",
          "default": 3.916,
          "description": "Constant term of the Rayleigh exponent."
        },
        "ray_c1": {
          "type": "parameter",
          "units": "1/um",
          "default": 0.074,
          "description": "Linear term of the Rayleigh exponent."
        },
        "ray_c2": {
          "type": "parameter",
          "units": "um",
          "default": 0.05,
          "description": "Inverse-wavelength term of the Rayleigh exponent."
        },
        "aer_tau340": {
          "type": "parameter",
          "units": "1",
          "default": 0.379,
          "description": "Total vertical aerosol optical depth at 340 nm, Elterman (1968): aaer(kl) = 0.379 (340/wl)."
        },
        "aer_lam_ref": {
          "type": "parameter",
          "units": "nm",
          "default": 340.0,
          "description": "Reference wavelength of the aerosol optical depth."
        },
        "alb_l1": {
          "type": "parameter",
          "units": "nm",
          "default": 400.0,
          "description": "Surface albedo breakpoints, Demerjian et al. (1980)."
        },
        "alb_l2": {
          "type": "parameter",
          "units": "nm",
          "default": 450.0,
          "description": "Surface albedo breakpoint."
        },
        "alb_l3": {
          "type": "parameter",
          "units": "nm",
          "default": 500.0,
          "description": "Surface albedo breakpoint."
        },
        "alb_l4": {
          "type": "parameter",
          "units": "nm",
          "default": 550.0,
          "description": "Surface albedo breakpoint."
        },
        "alb_l5": {
          "type": "parameter",
          "units": "nm",
          "default": 600.0,
          "description": "Surface albedo breakpoint."
        },
        "alb_l6": {
          "type": "parameter",
          "units": "nm",
          "default": 640.0,
          "description": "Surface albedo breakpoint."
        },
        "alb_l7": {
          "type": "parameter",
          "units": "nm",
          "default": 660.0,
          "description": "Surface albedo breakpoint."
        },
        "alb_v1": {
          "type": "parameter",
          "units": "1",
          "default": 0.05,
          "description": "Surface albedo below 400 nm."
        },
        "alb_v2": {
          "type": "parameter",
          "units": "1",
          "default": 0.06,
          "description": "Surface albedo 400-450 nm."
        },
        "alb_v3": {
          "type": "parameter",
          "units": "1",
          "default": 0.08,
          "description": "Surface albedo 450-500 nm."
        },
        "alb_v4": {
          "type": "parameter",
          "units": "1",
          "default": 0.1,
          "description": "Surface albedo 500-550 nm."
        },
        "alb_v5": {
          "type": "parameter",
          "units": "1",
          "default": 0.11,
          "description": "Surface albedo 550-600 nm."
        },
        "alb_v6": {
          "type": "parameter",
          "units": "1",
          "default": 0.12,
          "description": "Surface albedo 600-640 nm."
        },
        "alb_v7": {
          "type": "parameter",
          "units": "1",
          "default": 0.135,
          "description": "Surface albedo 640-660 nm."
        },
        "alb_v8": {
          "type": "parameter",
          "units": "1",
          "default": 0.15,
          "description": "Surface albedo above 660 nm."
        },
        "g_rayleigh": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Asymmetry factor for Rayleigh scattering, gray = 0."
        },
        "g_aerosol": {
          "type": "parameter",
          "units": "1",
          "default": 0.61,
          "description": "Aerosol asymmetry factor, Hansen & Travis."
        },
        "g_cloud": {
          "type": "parameter",
          "units": "1",
          "default": 0.86,
          "description": "Cloud asymmetry factor."
        },
        "om_rayleigh": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Rayleigh single-scattering albedo."
        },
        "om_aerosol": {
          "type": "parameter",
          "units": "1",
          "default": 0.99,
          "description": "Aerosol single-scattering albedo."
        },
        "om_cloud": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Cloud single-scattering albedo. NOTE: omray/omaer/omcld are passed to optics but optics never uses them -- it forms om from the optical depths directly. They are transcribed for completeness."
        },
        "tau_floor": {
          "type": "parameter",
          "units": "1",
          "default": 1e-36,
          "description": "The 1./largest floor optics applies to dtscat, dtabs and om."
        },
        "earth_radius": {
          "type": "parameter",
          "units": "km",
          "default": 6371.0,
          "description": "Earth radius as sphers spells it, 6.371E+3 km."
        },
        "mu2_big": {
          "type": "parameter",
          "units": "1",
          "default": 1e+18,
          "description": "sqrt(largest): the effective slant cosine where a layer contributes no slant path."
        },
        "mu2_small": {
          "type": "parameter",
          "units": "1",
          "default": 1e-18,
          "description": "1/sqrt(largest): floor on the magnitude of the effective slant cosine."
        },
        "ps_precis": {
          "type": "parameter",
          "units": "1",
          "default": 1e-07,
          "description": "ps2str's `precis`: the clip applied to the delta-scaled single-scattering albedo and asymmetry factor."
        },
        "ps_eps": {
          "type": "parameter",
          "units": "1",
          "default": 0.001,
          "description": "ps2str's `eps`: the floor on the magnitude of lam^2 - 1/mu2^2."
        },
        "edd_a": {
          "type": "parameter",
          "units": "1",
          "default": 7.0,
          "description": "The 7 of gamma1 = (7 - om(4 + 3g))/4."
        },
        "edd_b": {
          "type": "parameter",
          "units": "1",
          "default": 4.0,
          "description": "The 4 of the gamma1/gamma2 pair."
        },
        "edd_c": {
          "type": "parameter",
          "units": "1",
          "default": 3.0,
          "description": "The 3 of the gamma1/gamma2/gamma3 triple."
        },
        "mu1": {
          "type": "parameter",
          "units": "1",
          "default": 0.5,
          "description": "ps2str's mu1, fixed at 0.5 for every layer. It converts between irradiance and actinic flux: fdn = edn/mu1, i.e. the actinic flux is exactly TWICE the diffuse irradiance. Verified bit-exact against the dump."
        },
        "air_flat_tol": {
          "type": "parameter",
          "units": "1",
          "default": 100000.0,
          "description": "WRF treats two air densities as equal when they differ by less than air(i-1)/1.e5 and skips the interpolation."
        },
        "air_eps": {
          "type": "parameter",
          "units": "cm^-3",
          "default": 1e-300,
          "description": "Guard keeping the log finite in a branch that is discarded."
        },
        "cloud_fnum": {
          "type": "parameter",
          "units": "1",
          "default": 0.02,
          "description": "subgrid's fnum: the number of levels inserted into a cloudy half-layer is max(ifix(cloud*dzt*fnum),1) (module_phot_mad.F:2205-2206). fnum = 0.02 means one extra level per 50 units of half-layer cloud optical depth."
        }
      },
      "equations": [
        {
          "lhs": "degrad_zenith",
          "rhs": {
            "op": "/",
            "args": [
              "pi_zenith",
              180
            ]
          }
        },
        {
          "lhs": "degrad_driver",
          "rhs": {
            "op": "/",
            "args": [
              "pi_driver",
              180
            ]
          }
        }
      ]
    }
  }
}
