 "models": {
  "MadronichColumnSetup": {
   "expression_template_imports": [
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/grid.esm",
     "bindings": {
      "NLEV": "NLEV"
     }
    },
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/rules/integral_lev_whole.esm",
     "bindings": {
      "NLEV": "NLEV"
     }
    }
   ],
   "subsystems": {
    "par": {
     "ref": "./madronich_parameters.esm"
    }
   },
   "variables": {
    "phizz": {
     "type": "parameter",
     "units": "km",
     "description": "Height of each WRF w-level above the ground, phizz(k)=z_at_w(k)-z_at_w(1) in km (module_phot_mad.F:1558). phizz(1)=0.",
     "shape": [
      "mlev"
     ],
     "default": 0.0
    },
    "tt": {
     "type": "parameter",
     "units": "K",
     "description": "Temperature on the w-levels as madronich1_driver assembles it: tt(k+1)=t_phy(k) and tt(1)=t8w(kts).",
     "shape": [
      "mlev"
     ],
     "default": 250.0
    },
    "rhoa": {
     "type": "parameter",
     "units": "kg/m^3",
     "description": "Air density on the w-levels: rhoa(k+1)=rho_phy(k), rhoa(1)=p8w(kts)/t8w(kts)/r_d.",
     "shape": [
      "mlev"
     ],
     "default": 1.0
    },
    "o33": {
     "type": "parameter",
     "units": "1",
     "description": "Model ozone volume mixing ratio in ppmV, max(1e-3, chem(p_o3)); o33(1) repeats the lowest layer.",
     "shape": [
      "mlev"
     ],
     "default": 0.03
    },
    "aerext": {
     "type": "parameter",
     "units": "1/km",
     "description": "Aerosol extinction on the w-levels. With haveaer false (which chem_opt=101 sets) this is aerwrf, the Elterman climatology photmad_init laid down.",
     "shape": [
      "mlev"
     ],
     "default": 0.0
    },
    "qll": {
     "type": "parameter",
     "units": "g/m^3",
     "description": "Cloud water+ice content, 1e3 (qc+qi) rho, zeroed below 1e-5 g/m^3 by the driver.",
     "shape": [
      "mlev"
     ],
     "default": 0.0
    },
    "z_model_top": {
     "type": "unknown",
     "units": "km",
     "description": "Height of the WRF model top, phizz(NMODEL) (renamed from z_top on 2026-11-11 so that z_top can name the radiative-transfer grid top ze[NLEV+1], the upper bound the EarthSciDiscretizations integral rules match)."
    },
    "znorm": {
     "type": "unknown",
     "units": "1",
     "description": "Stretch factor of the above-model grid, (50-z_top)/(50-20)."
    },
    "zz_abv": {
     "type": "unknown",
     "units": "km",
     "description": "The ten above-model levels, 50 - znorm (50 - zabv).",
     "shape": [
      "abv"
     ]
    },
    "ze": {
     "type": "unknown",
     "units": "km",
     "description": "The full radiative-transfer interface grid: the NMODEL model w-levels followed by the ten above-model levels. This is `zz` in photolysis_mad and the `ze` the EarthSciDiscretizations column grid derives dz and the layer mid-points from.",
     "shape": [
      "lev_nodes"
     ]
    },
    "air_model": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Air number density on the model levels, xnkg rho 1e-6.",
     "shape": [
      "mlev"
     ]
    },
    "air_top": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Air number density at the model top."
    },
    "air_abv": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Air number density on the above-model levels.",
     "shape": [
      "abv"
     ]
    },
    "air_node": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Air number density on the full interface grid (`air` in photolysis_mad).",
     "shape": [
      "lev_nodes"
     ]
    },
    "t_top": {
     "type": "unknown",
     "units": "K",
     "description": "Temperature at the model top."
    },
    "t_abv": {
     "type": "unknown",
     "units": "K",
     "description": "Temperature on the above-model levels.",
     "shape": [
      "abv"
     ]
    },
    "t_node": {
     "type": "unknown",
     "units": "K",
     "description": "Temperature on the full interface grid (`t` in photolysis_mad).",
     "shape": [
      "lev_nodes"
     ]
    },
    "aer_top": {
     "type": "unknown",
     "units": "1/km",
     "description": "Aerosol extinction at the model top."
    },
    "aer_abv": {
     "type": "unknown",
     "units": "1/km",
     "description": "Aerosol extinction on the above-model levels.",
     "shape": [
      "abv"
     ]
    },
    "aer_node": {
     "type": "unknown",
     "units": "1/km",
     "description": "Aerosol extinction on the full interface grid (`aer`).",
     "shape": [
      "lev_nodes"
     ]
    },
    "o3_model": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Ozone number density on the model levels, max(1e-3,o33) 1e-6 air.",
     "shape": [
      "mlev"
     ]
    },
    "o3_top": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Ozone number density at the model top."
    },
    "o3_abv": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Ozone number density on the above-model levels.",
     "shape": [
      "abv"
     ]
    },
    "o3_raw": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Ozone on the full interface grid BEFORE the Dobson rescaling.",
     "shape": [
      "lev_nodes"
     ]
    },
    "o3_layer": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Layer-mean ozone, (o3_raw[j]+o3_raw[j+1])/2. The composite trapezoidal rule over interface values is the midpoint rule over this field, which is what lets the column below be written as an integral.",
     "shape": [
      "lev"
     ]
    },
    "o3_column": {
     "type": "unknown",
     "units": "cm^-3 km",
     "description": "Vertical ozone column of the model grid, the integral of o3 dz."
    },
    "dobsref": {
     "type": "unknown",
     "units": "DU",
     "description": "Ozone column of THIS profile in Dobson units, including the above-top term o3(top) ho3 (o3scal, module_phot_mad.F:2117-2122)."
    },
    "o3_node": {
     "type": "unknown",
     "units": "cm^-3",
     "description": "Ozone on the full interface grid AFTER o3scal has rescaled the whole profile so the column is exactly dobsi = 325 DU. THIS is the ozone the radiative transfer sees: the profile SHAPE is the model's own, the TOTAL is prescribed.",
     "shape": [
      "lev_nodes"
     ]
    },
    "reff": {
     "type": "unknown",
     "units": "um",
     "description": "Cloud droplet effective radius, 9.6 qll^0.333 (microns).",
     "shape": [
      "mlev"
     ]
    },
    "bext": {
     "type": "unknown",
     "units": "1/km",
     "description": "Cloud extinction per unit water content, (0.0275 + 1.3/reff) 1000.",
     "shape": [
      "mlev"
     ]
    },
    "cloud_model": {
     "type": "unknown",
     "units": "1/km",
     "description": "Cloud extinction on the model levels, qll bext.",
     "shape": [
      "mlev"
     ]
    },
    "cloud_node": {
     "type": "unknown",
     "units": "1/km",
     "description": "Cloud extinction on the full interface grid; zero above the model top.",
     "shape": [
      "lev_nodes"
     ]
    },
    "dz": {
     "type": "unknown",
     "units": "km",
     "shape": [
      "lev"
     ],
     "description": "Layer thicknesses of the radiative-transfer grid, z(i+1)-z(i), supplied by the EarthSciDiscretizations column grid (column_cell_thickness) from ze. Read by the integral rule by bare name."
    },
    "zmid": {
     "type": "unknown",
     "units": "km",
     "shape": [
      "lev"
     ],
     "description": "Layer mid-points of the radiative-transfer grid, z(i)+dz/2, supplied by the grid (column_cell_center). This is `zmid` in subgrid, the altitude every layer-mean optical quantity is referenced to."
    },
    "z_sfc": {
     "type": "unknown",
     "units": "km",
     "description": "Lower boundary of the column, ze[1]: the free name the EarthSciDiscretizations column_nonuniform_1d integral rules match as the lower bound of a bottom-anchored integral (ESD #39)."
    },
    "z_top": {
     "type": "unknown",
     "units": "km",
     "description": "Upper boundary of the column, ze[NLEV+1]: the free name the EarthSciDiscretizations column_nonuniform_1d integral rules match as the upper bound of a top-anchored integral (ESD #39)."
    }
   },
   "equations": [
    {
     "lhs": "z_model_top",
     "rhs": {
