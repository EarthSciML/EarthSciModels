{
 "esm": "1.0.0",
 "metadata": {
  "name": "IgnitionTimeWRFFire",
  "description": "Ignition time of a fire-grid cell as updated by fire_behavior's Update_ignition_times (physics/level_set_mod.F90) after each level-set step: cells the front crosses during the step get the linearly interpolated crossing time ts + dt lfn_in/(lfn_in - lfn_out); cells still unburnt at the end of the step carry time_now (the step end nudged up by two real32 epsilons, so that Calc_fuel_left treats them as not ignited); burning cells keep their ignition time. Tests: cells of the instrumented test7 run at step 20 (ls_tign dump), rel 1e-5 (the interpolated time is a ratio of O(1-100 m) level-set values, real32).",
  "license": "MIT",
  "tags": [
   "wildland_fire",
   "fire_behavior",
   "wrf-fire",
   "level-set",
   "ignition"
  ],
  "references": [
   {
    "citation": "NCAR Community Fire Behavior Model (fire_behavior), develop @ eb77580; instrumented fork ctessum-claude/fire_behavior branch earthsciml-instrumented (c9dda02)."
   }
  ]
 },
 "models": {
  "IgnitionTimeWRFFire": {
   "variables": {
    "ts": {
     "type": "parameter",
     "units": "s",
     "default": 0.0,
     "description": "Time at the start of the step."
    },
    "dt": {
     "type": "parameter",
     "units": "s",
     "default": 0.5,
     "description": "Time step."
    },
    "lfn_in": {
     "type": "parameter",
     "units": "m",
     "default": 1.0,
     "description": "Level-set value at the cell at the start of the step."
    },
    "lfn_out": {
     "type": "parameter",
     "units": "m",
     "default": 1.0,
     "description": "Level-set value at the cell at the end of the step."
    },
    "tign_before": {
     "type": "parameter",
     "units": "s",
     "default": 0.0,
     "description": "Ignition time carried from the previous step."
    },
    "time_now": {
     "type": "unknown",
     "units": "s",
     "description": "End of the step, ts + dt, nudged up by 2 epsilon(real32) |ts + dt| as the Fortran does so that a node marked 'not yet ignited' compares strictly later than the step end."
    },
    "crossing": {
     "type": "unknown",
     "units": "1",
     "description": "1 where the front crosses the cell during the step (lfn_out <= 0 < lfn_in)."
    },
    "tign": {
     "type": "unknown",
     "units": "s",
     "description": "Ignition time after the step: ts + dt lfn_in/(lfn_in - lfn_out) (linear interpolation of the zero crossing) where the front crosses the cell, time_now where the cell is still unburnt (lfn_out > 0), otherwise unchanged."
    },
    "eps_real32": {
     "type": "parameter",
     "units": "1",
     "default": 1.1920928955078125e-07,
     "description": "epsilon(real32); the nudge of time_now is |time_now| epsilon 2 (Update_ignition_times)."
    }
   },
   "equations": [
    {
     "lhs": "time_now",
     "rhs": {
      "op": "*",
      "args": [
       {
        "op": "+",
        "args": [
         "ts",
         "dt"
        ]
       },
       {
        "op": "+",
        "args": [
         1.0,
         {
          "op": "*",
          "args": [
           2.0,
           "eps_real32"
          ]
         }
        ]
       }
      ]
     }
    },
    {
     "lhs": "crossing",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "and",
        "args": [
         {
          "op": "<=",
          "args": [
           "lfn_out",
           0.0
          ]
         },
         {
          "op": ">",
          "args": [
           "lfn_in",
           0.0
          ]
         }
        ]
       },
       1.0,
       0.0
      ]
     }
    },
    {
     "lhs": "tign",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": ">",
        "args": [
         "lfn_out",
         0.0
        ]
       },
       "time_now",
       {
        "op": "ifelse",
        "args": [
         {
          "op": ">",
          "args": [
           "crossing",
           0.5
          ]
         },
         {
          "op": "+",
          "args": [
           "ts",
           {
            "op": "*",
            "args": [
             "dt",
             {
              "op": "/",
              "args": [
               "lfn_in",
               {
                "op": "-",
                "args": [
                 "lfn_in",
                 "lfn_out"
                ]
               }
              ]
             }
            ]
           }
          ]
         },
         "tign_before"
        ]
       }
      ]
     }
    }
   ],
   "tests": [
     {
       "id": "step20_crossing_cell",
       "description": "Reference: NCAR fire_behavior test7 (80x80 fire cells of 25 m, dt = 0.5 s, num_tiles = 1), default real32 build, dumped in-model by the ctessum-claude/fire_behavior fork (-DESM_DUMP=ON; summary output bit-identical to the uninstrumented build). Single precision: rel 1e-5 (CLAUDE.md contract). Regime: cell (i,j) = (16, 60), step 20 (ts = 10 s), the front crosses the cell during step 20 (lfn_in > 0 >= lfn_out): interpolated ignition time.",
       "parameter_overrides": {
         "ts": 10.0,
         "dt": 0.5,
         "lfn_in": 13.677032470703125,
         "lfn_out": 13.668548583984375,
         "tign_before": 10.000001907348633
       },
       "expression_template_imports": [
         {
           "ref": "./tests/step20_crossing_cell_inputs.esm"
         }
       ],
       "time_span": {
         "start": 0,
         "end": 1
       },
       "tolerance": {
         "rel": 1e-05
       },
       "assertions": [
         {
           "variable": "time_now",
           "time": 0.0,
           "expected": 10.50000286102295,
           "tolerance": {
             "rel": 1e-07
           }
         },
         {
           "variable": "tign",
           "time": 0.0,
           "expected": 10.50000286102295,
           "tolerance": {
             "rel": 1e-05
           }
         }
       ]
     },
     {
       "id": "step20_burning_cell",
       "description": "Reference: NCAR fire_behavior test7 (80x80 fire cells of 25 m, dt = 0.5 s, num_tiles = 1), default real32 build, dumped in-model by the ctessum-claude/fire_behavior fork (-DESM_DUMP=ON; summary output bit-identical to the uninstrumented build). Single precision: rel 1e-5 (CLAUDE.md contract). Regime: cell (i,j) = (17, 60), step 20 (ts = 10 s), already burning (lfn_in <= 0): ignition time unchanged.",
       "parameter_overrides": {
         "ts": 10.0,
         "dt": 0.5,
         "lfn_in": -12.104354858398438,
         "lfn_out": -12.11306381225586,
         "tign_before": 8.99034309387207
       },
       "expression_template_imports": [
         {
           "ref": "./tests/step20_burning_cell_inputs.esm"
         }
       ],
       "time_span": {
         "start": 0,
         "end": 1
       },
       "tolerance": {
         "rel": 1e-05
       },
       "assertions": [
         {
           "variable": "time_now",
           "time": 0.0,
           "expected": 10.50000286102295,
           "tolerance": {
             "rel": 1e-07
           }
         },
         {
           "variable": "tign",
           "time": 0.0,
           "expected": 8.99034309387207,
           "tolerance": {
             "rel": 1e-05
           }
         }
       ]
     },
     {
       "id": "step20_unburnt_cell",
       "description": "Reference: NCAR fire_behavior test7 (80x80 fire cells of 25 m, dt = 0.5 s, num_tiles = 1), default real32 build, dumped in-model by the ctessum-claude/fire_behavior fork (-DESM_DUMP=ON; summary output bit-identical to the uninstrumented build). Single precision: rel 1e-5 (CLAUDE.md contract). Regime: cell (i,j) = (40, 40), step 20 (ts = 10 s), unburnt at the end of the step: tign = time_now.",
       "parameter_overrides": {
         "ts": 10.0,
         "dt": 0.5,
         "lfn_in": 646.3157348632812,
         "lfn_out": 646.3075561523438,
         "tign_before": 10.000001907348633
       },
       "expression_template_imports": [
         {
           "ref": "./tests/step20_unburnt_cell_inputs.esm"
         }
       ],
       "time_span": {
         "start": 0,
         "end": 1
       },
       "tolerance": {
         "rel": 1e-05
       },
       "assertions": [
         {
           "variable": "time_now",
           "time": 0.0,
           "expected": 10.50000286102295,
           "tolerance": {
             "rel": 1e-07
           }
         },
         {
           "variable": "tign",
           "time": 0.0,
           "expected": 10.50000286102295,
           "tolerance": {
             "rel": 1e-05
           }
         }
       ]
     }
   ]
  }
 }
}
