{
 "esm": "1.1.0",
 "metadata": {
  "name": "FireWindWRFFire",
  "description": "Atmosphere -> fire wind of NCAR fire_behavior: Interp_profile (share/interp_mod.F90) interpolates the atmosphere wind column to the fire wind height h_f (namelist fire_wind_height, default 6.096 m; test7 uses 1 m) with the profile the level-set spread uses (WRF-coupled path Interp_wrfwinds_to_cfbm; standalone path Calc_fire_wind -- the same routine on the same column). Heights: the mass-level heights above ground hgt_k = (zw_k + zw_{k+1})/2 - zw_1 from the w-level heights zw (WRF z_at_w). k* is the first mass level at or above h_f among k <= kdmax = NZW - 2. If k* = 1 the wind follows a logarithmic law between the roughness length z0 (u = 0) and the first mass level: u_f = u_1 ln(h_f/z0)/ln(hgt_1/z0); otherwise it is interpolated linearly in ln z between levels k*-1 and k*; if no level reaches h_f the wind of level kdmax is used; if z0 >= h_f the fire wind is 0. With fire_lsm_zcoupling the interpolation is done at the reference height (default 50 m) and the result is extrapolated down to h_f with a neutral log law, u* = kappa |u|/ln(z_ref/z0), |u_f| = (u*/kappa) ln((h_f + z0)/z0), with |u| floored at 0.1 m/s. The horizontal mapping from atmosphere cells to fire cells (nearest column in WRF, bilinear or nearest in the standalone) is outside this component. Compared with EarthSciModels wildland_fire/midflame_wind.esm (u_mf = wind_reduction * u10 with a Baughman-Albini or WAF reduction): only fire_behavior's wind_vinterp_opt = 1 (10 m winds times the WAF of the fuel table) has that form; this component is the default wind_vinterp_opt = 0 log-profile interpolation, which shares no equation with it. Tests: real32 references, rel 1e-5 -- (a) the standalone test7 run (Calc_fire_wind dump, k* = 1 branch, h_f = 1 m), (b) fire_behavior's Interp_profile replayed on WRF columns of test7/wrf.nc by the EarthSciML feedback driver with h_f = 1, 6.096 and 30 m and with fire_lsm_zcoupling (Fortran-generated regimes exercising the first-layer, interior-layer and z-coupling branches).",
  "license": "MIT",
  "tags": [
   "wildland_fire",
   "fire_behavior",
   "wrf-fire",
   "coupling",
   "wind"
  ],
  "references": [
   {
    "citation": "NCAR Community Fire Behavior Model (fire_behavior), develop @ eb77580; instrumented fork ctessum-claude/fire_behavior branch earthsciml-instrumented (8d519c6: coupling dumps). WRF v4.8.0 CMake build with ENABLE_CFBM (ctessum-claude/WRF branch earthsciml-instrumented-fire, c01746f)."
   }
  ]
 },
 "metaparameters": {
  "NZW": {
   "type": "integer",
   "default": 44,
   "description": "Number of w-level heights supplied (fire_behavior kime - kims + 1: WRF kde - 1 = 44 for the 45-level test7 column). kdmax = NZW - 2 is the highest mass level searched (Interp_profile kdmax = kfde - 2)."
  }
 },
 "index_sets": {
  "wlev": {
   "kind": "interval",
   "size": "NZW"
  }
 },
 "models": {
  "FireWindWRFFire": {
   "subsystems": {
    "par": {
     "ref": "./fire_behavior_parameters.esm"
    }
   },
   "variables": {
    "u": {
     "type": "unknown",
     "units": "m/s",
     "shape": [
      "wlev"
     ],
     "description": "Zonal wind on the mass levels of the atmosphere column above the fire cell (WRF u_phy; index k = mass level k, only k <= kdmax is read), consumer-supplied through `input_u`."
    },
    "v": {
     "type": "unknown",
     "units": "m/s",
     "shape": [
      "wlev"
     ],
     "description": "Meridional wind on the mass levels (WRF v_phy), consumer-supplied through `input_v`."
    },
    "zw": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "wlev"
     ],
     "description": "Height of the w-levels (WRF z_at_w, above sea level; zw_1 = surface), consumer-supplied through `input_zw`."
    },
    "z0": {
     "type": "parameter",
     "units": "m",
     "default": 0.1,
     "description": "Roughness length of the fire cell (fire_behavior fz0, WRF znt interpolated to the fire mesh)."
    },
    "fire_wind_height": {
     "type": "parameter",
     "units": "m",
     "default": 6.096,
     "description": "Height above ground at which the fire wind is evaluated (namelist fire_wind_height; WRF default 6.096 m = 20 ft, test7 1 m)."
    },
    "zcoupling": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "1 if fire_lsm_zcoupling: interpolate at zcoupling_ref and extrapolate to fire_wind_height with a neutral log law; 0 otherwise."
    },
    "zcoupling_ref": {
     "type": "parameter",
     "units": "m",
     "default": 50.0,
     "description": "Reference height of the z-coupling option (fire_lsm_zcoupling_ref)."
    },
    "vk_kappa": {
     "type": "parameter",
     "units": "1",
     "default": 0.4,
     "description": "Von Karman constant of interp_mod (VK_KAPPA = 0.4, equal to WRF's karman)."
    },
    "wind_floor": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.1,
     "description": "Floor of the interpolated wind speed in the z-coupling extrapolation (max(wsf, 0.1))."
    },
    "kdmax": {
     "type": "unknown",
     "units": "1",
     "description": "Highest mass level searched, NZW - 2 (Interp_profile kdmax = kfde - 2)."
    },
    "hgt": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "wlev"
     ],
     "description": "Height of mass level k above ground: (zw_k + zw_{k+1})/2 - zw_1 for k < NZW (the last entry repeats level NZW-1 and is never selected)."
    },
    "h_loc": {
     "type": "unknown",
     "units": "m",
     "description": "Height at which the profile is interpolated: zcoupling_ref if zcoupling, else fire_wind_height."
    },
    "above": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "wlev"
     ],
     "description": "1 where k <= kdmax and hgt_k >= h_loc (candidate levels), else 0."
    },
    "kstar": {
     "type": "unknown",
     "units": "1",
     "description": "First mass level at or above h_loc (min over candidates), kdmax + 1 if none."
    },
    "u_hi": {
     "type": "unknown",
     "units": "m/s",
     "description": "u at level kstar (0 if kstar > kdmax)."
    },
    "v_hi": {
     "type": "unknown",
     "units": "m/s",
     "description": "v at level kstar."
    },
    "u_lo": {
     "type": "unknown",
     "units": "m/s",
     "description": "u at level kstar - 1 (0 if kstar = 1)."
    },
    "v_lo": {
     "type": "unknown",
     "units": "m/s",
     "description": "v at level kstar - 1."
    },
    "hgt_hi": {
     "type": "unknown",
     "units": "m",
     "description": "hgt at level kstar (0 if kstar > kdmax)."
    },
    "hgt_lo": {
     "type": "unknown",
     "units": "m",
     "description": "hgt at level kstar - 1 (0 if kstar = 1)."
    },
    "u_last": {
     "type": "unknown",
     "units": "m/s",
     "description": "u at level kdmax (used when no level reaches h_loc)."
    },
    "v_last": {
     "type": "unknown",
     "units": "m/s",
     "description": "v at level kdmax."
    },
    "w_first": {
     "type": "unknown",
     "units": "1",
     "description": "Log-law weight of the first-layer branch, ln(h_loc/z0)/ln(hgt_1/z0) evaluated at kstar = 1 (1 when kstar > 1 to keep it finite)."
    },
    "w_interior": {
     "type": "unknown",
     "units": "1",
     "description": "Log-linear interpolation weight ln(h_loc/hgt_lo)/ln(hgt_hi/hgt_lo) of the interior branch (0 when kstar = 1 to keep it finite)."
    },
    "u_interp": {
     "type": "unknown",
     "units": "m/s",
     "description": "u interpolated to h_loc: 0 if h_loc <= z0; u_last if no level reaches h_loc; u_hi w_first if kstar = 1; u_lo + (u_hi - u_lo) w_interior otherwise."
    },
    "v_interp": {
     "type": "unknown",
     "units": "m/s",
     "description": "v interpolated to h_loc (same branches as u_interp)."
    },
    "wsf": {
     "type": "unknown",
     "units": "m/s",
     "description": "Interpolated wind speed floored at wind_floor (z-coupling)."
    },
    "ust_d": {
     "type": "unknown",
     "units": "m/s",
     "description": "Neutral friction velocity kappa wsf/ln(zcoupling_ref/z0) (z-coupling)."
    },
    "wsf1": {
     "type": "unknown",
     "units": "m/s",
     "description": "Wind speed extrapolated to fire_wind_height, (ust_d/kappa) ln((fire_wind_height + z0)/z0) (z-coupling)."
    },
    "uf": {
     "type": "unknown",
     "units": "m/s",
     "description": "Fire-mesh zonal wind (fire_behavior uf): u_interp, or wsf1 u_interp/wsf with z-coupling."
    },
    "vf": {
     "type": "unknown",
     "units": "m/s",
     "description": "Fire-mesh meridional wind (fire_behavior vf)."
    }
   },
