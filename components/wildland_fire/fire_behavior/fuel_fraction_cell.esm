   "tests": [
    {
     "id": "step20_front_cell_area_0p19",
     "description": "Reference: NCAR fire_behavior (develop @ eb77580, default real32 build, gfortran 13.3 -O2 in the EqWeFiC container) running its test7 case (80x80 fire cells of 25 m, dt = 0.5 s, num_tiles = 1), dumped in-model by the ctessum-claude/fire_behavior fork (branch earthsciml-instrumented, c9dda02, -DESM_DUMP=ON; summary output bit-identical to the uninstrumented build). Single-precision source: rel 1e-5 (CLAUDE.md contract), abs 1e-7 where a value is exactly 0 or 1. Regime: cell (i,j) = (16, 60) at the end of step 20 (time_now = 10.5 s), a cell the front has just entered (fire_area 0.19, fuel_frac 0.9916, all ignition within the last steps); inputs are the 3x3 node neighbourhood of lfn and tign_g and the cell's fuel_time and previous fuel fraction from the fuel_left dump.",
     "parameter_overrides": {
      "lfn_mm": 35.504486083984375,
      "lfn_m0": 30.6441650390625,
      "lfn_mp": 29.562484741210938,
      "lfn_0m": 12.986724853515625,
      "lfn_00": 7.3419189453125,
      "lfn_0p": 6.0775146484375,
      "lfn_pm": -11.590614318847656,
      "lfn_p0": -18.453147888183594,
      "lfn_pp": -20.008995056152344,
      "tign_mm": 10.50000286102295,
      "tign_m0": 10.50000286102295,
      "tign_mp": 10.50000286102295,
      "tign_0m": 10.50000286102295,
      "tign_00": 10.50000286102295,
      "tign_0p": 10.50000286102295,
      "tign_pm": 9.589017868041992,
      "tign_p0": 8.99034309387207,
      "tign_pp": 8.85060977935791,
      "time_now": 10.5,
      "fuel_time": 8.235294342041016,
      "fuel_frac_before": 1.0
     },
     "expression_template_imports": [
      {
       "ref": "./tests/step20_front_cell_area_0p19_inputs.esm"
      }
     ],
     "time_span": {
      "start": 0,
      "end": 1
     },
     "tolerance": {
      "rel": 1e-05
     },
     "assertions": [
      {
       "variable": "fire_area",
       "time": 0.0,
       "expected": 0.19250541925430298,
       "tolerance": {
        "rel": 1e-05,
        "abs": 1e-07
       }
      },
      {
       "variable": "fuel_frac",
       "time": 0.0,
       "expected": 0.991601824760437,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "fuel_frac_burnt_dt",
       "time": 0.0,
       "expected": 0.008398175239562988,
       "tolerance": {
        "rel": 2e-05,
        "abs": 1e-07
       }
      }
     ]
    },
    {
     "id": "step20_mostly_burning_area_0p93",
     "description": "Reference: NCAR fire_behavior (develop @ eb77580, default real32 build, gfortran 13.3 -O2 in the EqWeFiC container) running its test7 case (80x80 fire cells of 25 m, dt = 0.5 s, num_tiles = 1), dumped in-model by the ctessum-claude/fire_behavior fork (branch earthsciml-instrumented, c9dda02, -DESM_DUMP=ON; summary output bit-identical to the uninstrumented build). Single-precision source: rel 1e-5 (CLAUDE.md contract), abs 1e-7 where a value is exactly 0 or 1. Regime: cell (i,j) = (17, 59) at the end of step 20 (time_now = 10.5 s), a nearly engulfed cell (fire_area 0.93, fuel_frac_before 0.947 already below 1); inputs are the 3x3 node neighbourhood of lfn and tign_g and the cell's fuel_time and previous fuel fraction from the fuel_left dump.",
     "parameter_overrides": {
      "lfn_mm": 22.531967163085938,
      "lfn_m0": 12.986724853515625,
      "lfn_mp": 7.3419189453125,
      "lfn_0m": -0.24945068359375,
      "lfn_00": -11.590614318847656,
      "lfn_0p": -18.453147888183594,
      "lfn_pm": -1.4908447265625,
      "lfn_p0": -35.35760498046875,
      "lfn_pp": -44.060279846191406,
      "tign_mm": 10.50000286102295,
      "tign_m0": 10.50000286102295,
      "tign_mp": 10.50000286102295,
      "tign_0m": 10.480124473571777,
      "tign_00": 9.589017868041992,
      "tign_0p": 8.99034309387207,
      "tign_pm": 10.381208419799805,
      "tign_p0": 7.636563777923584,
      "tign_pp": 6.953971862792969,
      "time_now": 10.5,
      "fuel_time": 8.235294342041016,
      "fuel_frac_before": 0.946826159954071
     },
     "expression_template_imports": [
      {
       "ref": "./tests/step20_mostly_burning_area_0p93_inputs.esm"
      }
     ],
     "time_span": {
      "start": 0,
      "end": 1
     },
     "tolerance": {
      "rel": 1e-05
     },
     "assertions": [
      {
       "variable": "fire_area",
       "time": 0.0,
       "expected": 0.9255641102790833,
       "tolerance": {
        "rel": 1e-05,
        "abs": 1e-07
       }
      },
      {
       "variable": "fuel_frac",
       "time": 0.0,
       "expected": 0.8999848365783691,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
