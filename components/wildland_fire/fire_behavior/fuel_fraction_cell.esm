    },
    "ta_11": {
     "type": "unknown",
     "units": "s",
     "description": "Mean of the four corner times since ignition of subcell 11, each zeroed where the corner is unburnt (lfn > 0) or not yet ignited (tign > time_now); <= 0."
    },
    "left_11": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel fraction left in subcell 11: area exp(ta/fuel_time) + (1 - area), or 1 where area = 0."
    },
    "area_21": {
     "type": "unknown",
     "units": "1",
     "description": "Burning area fraction of subcell 21 (isubcl, jsubcl): (1 - sum lfn / sum |lfn|)/2 over its four corners, clipped to [0, 1]."
    },
    "ta_21": {
     "type": "unknown",
     "units": "s",
     "description": "Mean of the four corner times since ignition of subcell 21, each zeroed where the corner is unburnt (lfn > 0) or not yet ignited (tign > time_now); <= 0."
    },
    "left_21": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel fraction left in subcell 21: area exp(ta/fuel_time) + (1 - area), or 1 where area = 0."
    },
    "area_12": {
     "type": "unknown",
     "units": "1",
     "description": "Burning area fraction of subcell 12 (isubcl, jsubcl): (1 - sum lfn / sum |lfn|)/2 over its four corners, clipped to [0, 1]."
    },
    "ta_12": {
     "type": "unknown",
     "units": "s",
     "description": "Mean of the four corner times since ignition of subcell 12, each zeroed where the corner is unburnt (lfn > 0) or not yet ignited (tign > time_now); <= 0."
    },
    "left_12": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel fraction left in subcell 12: area exp(ta/fuel_time) + (1 - area), or 1 where area = 0."
    },
    "area_22": {
     "type": "unknown",
     "units": "1",
     "description": "Burning area fraction of subcell 22 (isubcl, jsubcl): (1 - sum lfn / sum |lfn|)/2 over its four corners, clipped to [0, 1]."
    },
    "ta_22": {
     "type": "unknown",
     "units": "s",
     "description": "Mean of the four corner times since ignition of subcell 22, each zeroed where the corner is unburnt (lfn > 0) or not yet ignited (tign > time_now); <= 0."
    },
    "left_22": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel fraction left in subcell 22: area exp(ta/fuel_time) + (1 - area), or 1 where area = 0."
    },
    "fire_area": {
     "type": "unknown",
     "units": "1",
     "description": "Burning area fraction of the cell, mean of the four subcell fractions (fire_behavior fire_area)."
    },
    "fuel_frac": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel fraction remaining at time_now, mean of the four subcell fractions (fire_behavior fuel_frac after Calc_fuel_left)."
    },
    "fuel_frac_burnt_dt": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel fraction burnt during the step, fuel_frac_before - fuel_frac; drives the heat and moisture fluxes (Calc_fire_fluxes) and the smoke emission."
    },
    "dfuel_frac_dt_burning": {
     "type": "unknown",
     "units": "1/s",
     "description": "Continuous rate form for a fully burning cell: -fuel_frac/fuel_time, i.e. Mandel et al. (2011) eq. 3 dF/dt = -F/T_f, which the subcell exponentials integrate exactly. Where fire_area < 1 the cell rate is not a single exponential, so this is a diagnostic of the fully-burning limit only."
    }
   },
