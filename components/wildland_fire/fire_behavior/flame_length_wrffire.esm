         "end": 1
       },
       "tolerance": {
         "rel": 1e-05
       },
       "assertions": [
         {
           "variable": "flame_length",
           "time": 0.0,
           "expected": 0.2593342363834381,
           "tolerance": {
             "rel": 1e-05,
             "abs": 1e-09
           }
         },
         {
           "variable": "ros_front",
           "time": 0.0,
           "expected": 0.01777469739317894,
