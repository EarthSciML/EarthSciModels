   "tests": [
    {
     "id": "hinterp_step20",
     "description": "The whole 80 x 80 fire mesh at step 20 of the fire_behavior test7 standalone run, from the 19 x 19 atmosphere-grid winds of the same call. Reference: the `hinterp` dump hook on Interp_horizontal_bilinear (fork ctessum-claude/fire_behavior@22d426e), calls 55 (ua) and 56 (va); call 55's data_out reproduces the uf field of esm_dump_ls_tend_58 with Linf exactly 0, which is how the call indices were confirmed. Single precision: rel 1e-5 pointwise, and a whole-field Linf at abs 1e-6. MEASURED residuals over all 6400 cells: uf 1.084e-7, vf 4.353e-7 (1.3e-7 relative against ~3.3 m/s) -- real32 rounding in the reference, not interpolation error. (18,64) is the fire-front cell couplings/wildlandfire_behavior.esm is built on; (17,57), (21,59), (40,40) and (20,66) are other interior cells; (1,1) and (80,80) are the two CLAMPED corners, where i_real = 0.625 < 1 and 20.39 > 19 put the target outside the atmosphere extent. At those two the result is the atmosphere edge value itself and matches the Fortran EXACTLY (residual below 1e-15), because clamping produces a stored real32 number with no arithmetic on it.",
     "expression_template_imports": [
      {
       "ref": "./tests/hinterp_step20_inputs.esm"
      }
     ],
     "parameter_overrides": {
      "Lx": 2000.0,
      "Ly": 2000.0
     },
     "time_span": {
      "start": 0,
      "end": 1
     },
     "tolerance": {
      "rel": 1e-05
     },
     "assertions": [
      {
       "variable": "uf",
       "time": 0.0,
       "coords": {
        "x": 18,
        "y": 64
       },
       "expected": 0.7921292781829834,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "uf",
       "time": 0.0,
       "coords": {
        "x": 17,
        "y": 57
       },
       "expected": 0.7797356247901917,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "uf",
       "time": 0.0,
       "coords": {
        "x": 21,
        "y": 59
       },
       "expected": 0.8264791965484619,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "uf",
       "time": 0.0,
       "coords": {
        "x": 40,
        "y": 40
       },
       "expected": 0.7638868093490601,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "uf",
       "time": 0.0,
       "coords": {
        "x": 20,
        "y": 66
       },
       "expected": 0.8132514953613281,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "uf",
       "time": 0.0,
       "coords": {
        "x": 1,
        "y": 1
       },
       "expected": 0.8016912937164307,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "uf",
       "time": 0.0,
       "coords": {
        "x": 80,
        "y": 80
       },
       "expected": 0.8053443431854248,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "vf",
       "time": 0.0,
       "coords": {
        "x": 18,
        "y": 64
       },
       "expected": 3.2887778282165527,
