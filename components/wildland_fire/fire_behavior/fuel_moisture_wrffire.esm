{
 "esm": "1.2.0",
 "metadata": {
  "name": "FuelMoistureWRFFire",
  "description": "Dead and live fuel moisture of the five WRF-SFIRE moisture classes (1-h, 10-h, 100-h, 1000-h dead fuel and live fuel) for one fire-grid cell, as advanced by fire_behavior's Advance_moisture_classes and averaged by Average_moisture_classes (physics/fmc_wrffire_mod.F90; Mandel et al. 2014). From the step-mean 2 m temperature, humidity and surface pressure the relative humidity follows Murphy & Koop (2005) eq. 10; without rain the Van Wagner & Pickett (1972) drying and wetting equilibrium moisture contents bracket the class moisture, which relaxes with its class time lag towards the nearer bracket (a class already between them does not move); with rain above 0.05 mm/h both brackets become the saturation moisture 2.5 and the rate is the wetting lag scaled by 1 - exp(-r/8 mm/h). Every coefficient and class table is a FireBehaviorParameters (par) entry. The physics is the time-lag ODE d m_k/dt = (equi_k - m_k)/tau_k (dfmc_dt); fire_behavior integrates it exactly over its moisture step (exponential form, or the 2nd-order Taylor form when the step covers less than 1 % of the lag), reproduced as fmc_new so the Fortran step can be tested. The cell's ground fuel moisture fmc_g is the load-weighted mean of the classes (Anderson13FuelTable w_1h .. w_live). The assimilation adjustments deltae/deltas (fmep) and their decay are transcribed; the fmc_gc initialisation branches (from the equilibrium or from the namelist) are the consumer's initial condition and are not transcribed. The EarthSciModels wildland_fire/nfdrs moisture components (NFDRS 1-h/10-h/100-h/1000-h models) are a different formulation and are not reused. Tests: cells of the instrumented test7 run with the moisture model on (fmoist_run, fmoist_freq = 1, dt_moisture = 0.5 s, so every class is in the Taylor branch; the 10 s case has no rain, so the wetting branch is transcribed but untested), real32, rel 1e-5.",
  "license": "MIT",
  "tags": [
   "wildland_fire",
   "fire_behavior",
   "wrf-fire",
   "fuel-moisture"
  ],
  "references": [
   {
    "citation": "NCAR Community Fire Behavior Model (fire_behavior), develop @ eb77580, physics/fmc_wrffire_mod.F90 Advance_moisture_classes / Average_moisture_classes; instrumented fork ctessum-claude/fire_behavior branch earthsciml-instrumented."
   },
   {
    "citation": "Mandel, J., Amram, S., Beezley, J.D., Kelman, G., Kochanski, A.K., Kondratenko, V.Y., Lynn, B.H., Regev, B., Vejmelka, M. (2014). Recent advances and applications of WRF-SFIRE. Nat. Hazards Earth Syst. Sci. 14, 2829-2845 (fuel moisture model).",
    "doi": "10.5194/nhess-14-2829-2014"
   },
   {
    "citation": "Van Wagner, C.E., Pickett, T.L. (1972/1985). Equations and FORTRAN program for the Canadian Forest Fire Weather Index System; Viney (1991) eqs 7-8 (equilibrium moisture content fits)."
   },
   {
    "citation": "Murphy, D.M., Koop, T. (2005). Review of the vapour pressures of ice and supercooled water for atmospheric applications. Q.J.R. Meteorol. Soc. 131, 1539-1565, eq. 10.",
    "doi": "10.1256/qj.04.94"
   }
  ]
 },
 "index_sets": {
  "fmc_class": {
   "kind": "interval",
   "size": 5
  }
 },
 "models": {
  "FuelMoistureWRFFire": {
   "subsystems": {
    "par": {
     "ref": "./fire_behavior_parameters.esm"
    }
   },
   "variables": {
    "rain": {
     "type": "parameter",
     "units": "mm",
     "default": 0.0,
     "description": "Accumulated rain at the end of the moisture step (fire_rain, mm)."
    },
    "rain_old": {
     "type": "parameter",
     "units": "mm",
     "default": 0.0,
     "description": "Accumulated rain at the previous moisture step."
    },
    "t2": {
     "type": "parameter",
     "units": "K",
     "default": 300.0,
     "description": "2 m temperature now."
    },
    "t2_old": {
     "type": "parameter",
     "units": "K",
     "default": 300.0,
     "description": "2 m temperature at the previous moisture step."
    },
    "q2": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.005,
     "description": "2 m specific humidity now."
    },
    "q2_old": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.005,
     "description": "2 m specific humidity at the previous moisture step."
    },
    "psfc": {
     "type": "parameter",
     "units": "Pa",
     "default": 85000.0,
     "description": "Surface pressure now."
    },
    "psfc_old": {
     "type": "parameter",
     "units": "Pa",
     "default": 85000.0,
     "description": "Surface pressure at the previous moisture step."
    },
    "dt_moisture": {
     "type": "parameter",
     "units": "s",
     "default": 0.5,
     "description": "Moisture model time step (time since the previous moisture update)."
    },
    "deltae": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Assimilated adjustment of the drying/wetting equilibria, fmep(1) (0 without data assimilation)."
    },
    "deltas": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Assimilated adjustment of the rain saturation moisture, fmep(2)."
    },
    "rain_int": {
     "type": "unknown",
     "units": "mm/h",
     "description": "Rain intensity from the accumulated rain difference over the moisture step, 3600 (rain - rain_old) / dt_moisture mm/h; 0 if dt_moisture = 0."
    },
    "pw": {
     "type": "unknown",
     "units": "Pa",
     "description": "Water vapour pressure q p/(eps + (1 - eps) q), eps = 0.622."
    },
    "pws": {
     "type": "unknown",
     "units": "Pa",
     "description": "Saturation vapour pressure over water, Murphy & Koop (2005) eq. 10."
    },
    "rh": {
     "type": "unknown",
     "units": "1",
     "description": "Relative humidity pw/pws (the diagnostic rh_fire; not capped)."
    },
    "rh_c": {
     "type": "unknown",
     "units": "1",
     "description": "Relative humidity capped at 1 for the equilibrium fits (CHECK_RH = .false.)."
    },
    "hpct": {
     "type": "unknown",
     "units": "1",
     "description": "Relative humidity in per cent, 100 rh_c."
    },
    "emc_drying_pct": {
     "type": "unknown",
     "units": "1",
     "description": "Van Wagner & Pickett equilibrium moisture for drying (desorption), per cent: 0.942 H^0.679 + 0.000499 e^{0.1 H} + 0.18 (21.1 + 273.15 - T)(1 - e^{-0.115 H})."
    },
    "emc_wetting_pct": {
     "type": "unknown",
     "units": "1",
     "description": "Equilibrium moisture for adsorption, per cent: 0.618 H^0.753 + 0.000454 e^{0.1 H} + 0.18 (21.1 + 273.15 - T)(1 - e^{-0.115 H})."
    },
    "drying_lag_h": {
     "type": "unknown",
     "units": "h",
     "description": "Drying time lag of each class (par.fmc_drying_lag_1 .. _5: 1, 10, 100, 1000 h and 1e9 h for 1-h, 10-h, 100-h, 1000-h, live).",
     "shape": [
      "fmc_class"
     ]
    },
    "wetting_lag_h": {
     "type": "unknown",
     "units": "h",
     "description": "Wetting time lag of each class in rain (par.fmc_wetting_lag_1 .. _5: 1.4, 14, 140, 1400 h and 1e9 h).",
     "shape": [
      "fmc_class"
     ]
    },
    "saturation_moisture": {
     "type": "unknown",
     "units": "1",
     "description": "Saturation moisture content reached in rain (2.5 for every class).",
     "shape": [
      "fmc_class"
     ]
    },
    "saturation_rain": {
     "type": "unknown",
     "units": "mm/h",
     "description": "Rain intensity scale of the wetting rate (8 mm/h for every class).",
     "shape": [
      "fmc_class"
     ]
    },
    "rain_threshold": {
     "type": "unknown",
     "units": "mm/h",
     "description": "Rain intensity below which a class sees no rain (0.05 mm/h).",
     "shape": [
      "fmc_class"
     ]
    },
    "r": {
     "type": "unknown",
     "units": "mm/h",
     "description": "Excess rain intensity rain_int - rain_threshold of each class.",
     "shape": [
      "fmc_class"
     ]
    },
    "raining": {
     "type": "unknown",
     "units": "1",
     "description": "1 where r > 0 (wetting model active), else 0 (drying model).",
     "shape": [
      "fmc_class"
     ]
    },
    "emc_d": {
     "type": "unknown",
     "units": "1",
     "description": "Upper equilibrium: in rain saturation_moisture + deltas; otherwise max(max(d, w) + deltae, 0).",
     "shape": [
      "fmc_class"
     ]
    },
    "emc_w": {
     "type": "unknown",
     "units": "1",
     "description": "Lower equilibrium: in rain saturation_moisture + deltas; otherwise max(min(d, w) + deltae, 0).",
     "shape": [
      "fmc_class"
     ]
    },
    "rlag": {
     "type": "unknown",
     "units": "1/s",
     "description": "Inverse time lag of each class: 1/(3600 drying_lag) when dry, 1/(3600 wetting_lag) (1 - exp(-r/saturation_rain)) in rain.",
     "shape": [
      "fmc_class"
     ]
    },
    "fmc_old": {
     "type": "unknown",
     "units": "1",
     "description": "Moisture content of each class at the start of the step (fmc_gc).",
     "shape": [
      "fmc_class"
     ]
    },
    "equi": {
     "type": "unknown",
     "units": "1",
     "description": "Equilibrium the class relaxes towards: fmc_old clipped into [emc_w, emc_d] (a class already between the two equilibria does not move).",
     "shape": [
      "fmc_class"
     ]
    },
    "dfmc_dt": {
     "type": "unknown",
     "units": "1/s",
     "description": "Time-lag ODE of the class moisture: d fmc/dt = (equi - fmc) rlag, evaluated at fmc_old (Mandel et al. 2014 eq. 6). This is the physics; fire_behavior integrates it over dt_moisture with the exact exponential (or its 2nd-order Taylor form when dt rlag < 0.01), see fmc_new.",
     "shape": [
      "fmc_class"
     ]
    },
    "change": {
     "type": "unknown",
     "units": "1",
     "description": "dt_moisture rlag, the fraction of the time lag covered by the step.",
     "shape": [
      "fmc_class"
     ]
    },
    "fmc_new": {
     "type": "unknown",
     "units": "1",
     "description": "Moisture content after the step as fire_behavior computes it: fmc_old + (equi - fmc_old)(change (1 - change/2)) for change < TOL, else fmc_old + (equi - fmc_old)(1 - exp(-change)) -- the exact solution of dfmc_dt over the step (Taylor form to 2nd order).",
     "shape": [
      "fmc_class"
     ]
    },
    "fmc_lag_h": {
     "type": "unknown",
     "units": "h",
     "description": "Diagnostic time lag 1/(3600 rlag) (fmc_lag).",
     "shape": [
      "fmc_class"
     ]
    },
    "fmep_decay": {
     "type": "unknown",
     "units": "1",
     "description": "Factor by which the assimilated adjustments fmep decay over the step: 1 - c (1 - c/2) for c = dt/(3600 FMEP_DECAY_TLAG) < TOL, else exp(-c)."
    },
    "class_weight": {
     "type": "unknown",
     "units": "1",
     "description": "Load fraction of each moisture class for the cell's fuel category (Anderson13FuelTable w_1h .. w_live).",
     "shape": [
      "fmc_class"
     ]
    },
    "fmc_g": {
     "type": "unknown",
     "units": "1",
     "description": "Ground fuel moisture of the cell after the step, the class-weighted mean sum_k w_k fmc_new_k (Average_moisture_classes)."
    },
    "t_mean": {
     "type": "unknown",
     "units": "K",
     "description": "Step-mean 2 m temperature (t2_old + t2)/2 (second-order averaging of the forcing). Named t_mean because `t` is the time variable."
    },
    "p_mean": {
     "type": "unknown",
     "units": "Pa",
     "description": "Step-mean surface pressure."
    },
    "q_mean": {
     "type": "unknown",
     "units": "kg/kg",
     "description": "Step-mean 2 m specific humidity."
    },
    "fmc_g_state": {
     "type": "unknown",
     "units": "1",
     "description": "Ground fuel moisture of the cell at the START of the step, the class-weighted mean sum_k w_k fmc_old_k. In a continuous formulation this is the STATE (fmc_g is the state after the scheme's own Fortran sub-step), and it is what a consumer evaluating the rest of the fire-behavior chain at one instantaneous state must hand to Rothermel: fire_behavior's Calc_ros_params likewise runs on the pre-update moisture (measured: ros_params fmc_g = 0.05835314 against fmc_g = 0.05835231 after the step, at cell (18,64) of test7 step 20)."
    },
    "dfmc_g_dt": {
     "type": "unknown",
     "units": "1/s",
     "description": "Tendency of the cell's bulk fuel moisture: the class weights applied to the per-class tendencies, sum_k w_k dfmc_dt_k. This is d(fmc_g)/dt, the rate a consumer integrating fmc_g must add. It equals (fmc_g_after - fmc_g_before)/dt_moisture only to O(dt_moisture), because fmc_new takes the second-order Taylor (or exponential) step of Advance_moisture_classes rather than a plain Euler one."
    }
   },
