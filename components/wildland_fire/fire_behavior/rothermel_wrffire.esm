       "par.ms_per_ftmin"
      ]
     }
    }
   ],
   "tests": [
     {
       "id": "category_1_short_grass_fmc008",
       "description": "Reference: NCAR fire_behavior (develop @ eb77580, default real32 build, gfortran 13.3 -O2 in the EqWeFiC container) running its own test7 case (real Colorado domain, 80x80 fire cells of 25 m, dt = 0.5 s, 20 steps, num_tiles = 1), dumped in-model by the ctessum-claude/fire_behavior fork (branch earthsciml-instrumented, commit c9dda02, -DESM_DUMP=ON; the dumped run's summary output is bit-identical to the uninstrumented build). Single-precision source, so rel 1e-5 (CLAUDE.md contract); a real64 re-evaluation of the same formulae agrees with the dumps to <= 8e-7 relative. Regime: Anderson category 1 (short grass) at cell (i,j) = (19, 66) with fmc_g = 0.08 (namelist fuelmc_g; the test7 run has uniform moisture), from the ros_params dump written by Set_ros_parameters_wrffire at initialisation; every intermediate of the routine is asserted.",
       "parameter_overrides": {
         "fgi": 0.16599999368190765,
         "fueldepthm": 0.3050000071525574,
         "fueldens": 32.0,
         "savr": 3500.0,
         "st": 0.05550000071525574,
         "se": 0.009999999776482582,
         "fuelmce": 0.11999999731779099,
         "ischap": 0.0,
         "fmc_g": 0.07999999821186066,
         "has_fuel": 1.0
       },
       "expression_template_imports": [
         {
           "ref": "./tests/category_1_short_grass_fmc008_inputs.esm"
         }
       ],
       "time_span": {
         "start": 0,
         "end": 1
       },
       "tolerance": {
         "rel": 1e-05
       },
       "assertions": [
         {
           "variable": "bmst",
