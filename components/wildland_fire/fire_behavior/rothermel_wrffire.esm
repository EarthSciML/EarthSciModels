{
 "esm": "1.0.0",
 "metadata": {
  "name": "RothermelWRFFire",
  "description": "Rothermel (1972) fuel-bed spread parameters as evaluated by fire_behavior's Set_ros_parameters_wrffire (physics/ros_wrffire_mod.F90) for one cell: from the category's fuel properties and the ground fuel moisture, the packing ratio, optimum packing ratio, reaction velocity, moisture and mineral damping, reaction intensity, propagating flux ratio, heat of preignition and effective heating number, and hence the no-wind no-slope spread rate r_0 (ft/min, and ros_base in m/s), the wind-factor coefficients bbb (exponent B) and phiwc, and I_R t_r (iboros) for Byram's flame length. The fits are evaluated in US customary units exactly as the Fortran does (SI load and depth converted with 0.3048 and 2.205), so the intermediates are dimensionless carriers of lb/ft^2, ft, 1/ft, Btu/lb quantities. DIFFERENCES from the EarthSciModels rothermel/fire_spread.esm (Andrews 2018 SI form), which is therefore NOT reused: (1) the reaction-velocity exponent is Rothermel's original A = 1/(4.774 savr^0.1 - 7.27), not Albini's 133 savr^-0.7913; (2) the net load is w_0/(1 + S_T), not w_0 (1 - S_T); (3) the moisture ratio and the mineral damping are not capped at 1; (4) the load entering the fits is the DRY part (1 - M/(1+M)) of fgi, fire_behavior treating fgi as the moist load; (5) the wind factor is split into the cell constants B and phiwc = C (beta/beta_op)^-E applied per time step in ROSWRFFire. The no-fuel category (has_fuel = 0) returns betafl = bbb = 1, phiwc = r_0 = iboros = 0 as the Fortran does. Tests are the dumped per-cell intermediates of the instrumented fire_behavior test7 run (real32; a real64 re-evaluation of the same formulae agrees to <= 8e-7 relative), rel 1e-5.",
  "license": "MIT",
  "tags": [
   "wildland_fire",
   "fire_behavior",
   "wrf-fire",
   "rothermel",
   "rate-of-spread"
  ],
  "references": [
   {
    "citation": "NCAR Community Fire Behavior Model (fire_behavior), develop @ eb77580 (WRF 4.8 phys/fire_behavior submodule), physics/ros_wrffire_mod.F90; instrumented fork ctessum-claude/fire_behavior branch earthsciml-instrumented."
   },
   {
    "citation": "Rothermel, R.C. (1972). A mathematical model for predicting fire spread in wildland fuels. USDA Forest Service Res. Pap. INT-115."
   },
   {
    "citation": "Mandel, J., Beezley, J.D., Kochanski, A.K. (2011). Coupled atmosphere-wildland fire modeling with WRF 3.3 and SFIRE 2011. Geosci. Model Dev. 4, 591-610.",
    "doi": "10.5194/gmd-4-591-2011"
   },
   {
    "citation": "Clark, T.L., Coen, J., Latham, D. (2004). Description of a coupled atmosphere-fire model. Int. J. Wildland Fire 13, 49-63 (chaparral spread-rate fit)."
   }
  ]
 },
 "models": {
  "RothermelWRFFire": {
   "subsystems": {
    "par": {
     "ref": "./fire_behavior_parameters.esm"
    }
   },
   "variables": {
    "fgi": {
     "type": "parameter",
     "units": "kg/m^2",
     "default": 0.166,
     "description": "Total (moist) surface fuel load of the cell's category (Anderson13FuelTable fgi)."
    },
    "fueldepthm": {
     "type": "parameter",
     "units": "m",
     "default": 0.305,
     "description": "Fuel bed depth (Anderson13FuelTable fueldepthm)."
    },
    "fueldens": {
     "type": "parameter",
     "units": "1",
     "default": 32.0,
     "description": "Oven-dry particle density, lb/ft^3 (dimensionless carrier of a US-unit quantity)."
    },
    "savr": {
     "type": "parameter",
     "units": "1",
     "default": 3500.0,
     "description": "Surface-area-to-volume ratio, 1/ft (dimensionless carrier)."
    },
    "st": {
     "type": "parameter",
     "units": "1",
     "default": 0.0555,
     "description": "Total mineral content."
    },
    "se": {
     "type": "parameter",
     "units": "1",
     "default": 0.01,
     "description": "Effective mineral content."
    },
    "fuelmce": {
     "type": "parameter",
     "units": "1",
     "default": 0.12,
     "description": "Dead fuel moisture of extinction."
    },
    "ischap": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Chaparral flag of the category (Anderson13FuelTable ichap)."
    },
    "has_fuel": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "1 for a fuel category 1-13, 0 for the no-fuel category 14, for which fire_behavior sets betafl = bbb = 1 and phiwc = r_0 = iboros = 0."
    },
    "fmc_g": {
     "type": "parameter",
     "units": "1",
     "default": 0.08,
     "description": "Ground (dead) fuel moisture content, dry-mass fraction (fire_behavior fmc_g, namelist fuelmc_g or the fuel-moisture model)."
    },
    "bmst": {
     "type": "unknown",
     "units": "1",
     "description": "Moisture mass fraction of the wet fuel, M/(1 + M)."
    },
    "fuelloadm": {
     "type": "unknown",
     "units": "kg/m^2",
     "description": "Dry fuel load (1 - bmst) fgi: fire_behavior treats fgi as the moist load and removes the water."
    },
    "fuelload": {
     "type": "unknown",
     "units": "1",
     "description": "Dry fuel load in lb/ft^2 (fuelloadm * 0.3048^2 * 2.205)."
    },
    "fueldepth": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel bed depth in ft."
    },
    "betafl": {
     "type": "unknown",
     "units": "1",
     "description": "Packing ratio beta = fuelload/(fueldepth fueldens) (1 for the no-fuel category, to keep beta^-0.3 finite)."
    },
    "betaop": {
     "type": "unknown",
     "units": "1",
     "description": "Optimum packing ratio 3.348 savr^-0.8189."
    },
    "qig": {
     "type": "unknown",
     "units": "1",
     "description": "Heat of preignition 250 + 1116 M, Btu/lb."
    },
    "epsilon": {
     "type": "unknown",
     "units": "1",
     "description": "Effective heating number exp(-138/savr)."
    },
    "rhob": {
     "type": "unknown",
     "units": "1",
     "description": "Oven-dry bulk density fuelload/fueldepth, lb/ft^3."
    },
    "c": {
     "type": "unknown",
     "units": "1",
     "description": "Wind coefficient C = 7.47 exp(-0.133 savr^0.55)."
    },
    "bbb": {
     "type": "unknown",
     "units": "1",
     "description": "Wind exponent B = 0.02526 savr^0.54 (1 for the no-fuel category)."
    },
    "e": {
     "type": "unknown",
     "units": "1",
     "description": "Packing-ratio exponent E = 0.715 exp(-3.59e-4 savr)."
    },
    "phiwc": {
     "type": "unknown",
     "units": "1",
     "description": "Wind-factor coefficient C (beta/beta_op)^-E, so that phi_w = phiwc U^B with U in ft/min (0 for the no-fuel category)."
    },
    "rtemp2": {
     "type": "unknown",
     "units": "1",
     "description": "savr^1.5."
    },
    "gammax": {
     "type": "unknown",
     "units": "1",
     "description": "Maximum reaction velocity savr^1.5/(495 + 0.0594 savr^1.5), 1/min."
    },
    "a": {
     "type": "unknown",
     "units": "1",
     "description": "Reaction-velocity exponent 1/(4.774 savr^0.1 - 7.27) (Rothermel 1972)."
    },
    "ratio": {
     "type": "unknown",
     "units": "1",
     "description": "Relative packing ratio beta/beta_op."
    },
    "gamma": {
     "type": "unknown",
     "units": "1",
     "description": "Optimum reaction velocity gammax ratio^a exp(a (1 - ratio)), 1/min."
    },
    "wn": {
     "type": "unknown",
     "units": "1",
     "description": "Net fuel load fuelload/(1 + st), lb/ft^2 (Rothermel 1972 form; Albini's w0 (1 - S_T) is not used)."
    },
    "rtemp1": {
     "type": "unknown",
     "units": "1",
     "description": "Moisture ratio M/M_x (not capped)."
    },
    "etam": {
     "type": "unknown",
     "units": "1",
     "description": "Moisture damping coefficient 1 - 2.59 r + 5.11 r^2 - 3.52 r^3 (not clipped to [0,1])."
    },
    "etas": {
     "type": "unknown",
     "units": "1",
     "description": "Mineral damping coefficient 0.174 se^-0.19 (not capped at 1)."
    },
    "fuelheat": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel low heat content cmbcnst * 4.30e-4 = 7496.19 Btu/lb."
    },
    "ir": {
     "type": "unknown",
     "units": "1",
     "description": "Reaction intensity gamma wn fuelheat etam etas, Btu/ft^2/min."
    },
    "iboros": {
     "type": "unknown",
     "units": "1",
     "description": "Reaction intensity times residence time, I_R t_r, in kJ/m^2: ir * 1055/(0.3048^2 60) * 1e-3 * (60 * 384/savr) (0 for the no-fuel category); feeds Byram's flame length as I_B = iboros * ros."
    },
    "xifr": {
     "type": "unknown",
     "units": "1",
     "description": "Propagating flux ratio exp((0.792 + 0.681 savr^0.5)(beta + 0.1))/(192 + 0.2595 savr)."
    },
    "r_0": {
     "type": "unknown",
     "units": "1",
     "description": "No-wind, no-slope spread rate ir xifr/(rhob epsilon qig), ft/min (0 for the no-fuel category)."
    },
    "ros_base": {
     "type": "unknown",
     "units": "m/s",
     "description": "r_0 converted to m/s (r_0 * 0.00508), the base spread rate used by ROSWRFFire."
    }
   },
   "equations": [
    {
     "lhs": "bmst",
     "rhs": {
      "op": "/",
      "args": [
       "fmc_g",
       {
        "op": "+",
        "args": [
         1.0,
         "fmc_g"
        ]
       }
      ]
     }
    },
    {
     "lhs": "fuelloadm",
     "rhs": {
      "op": "*",
      "args": [
       {
        "op": "-",
        "args": [
         1.0,
         "bmst"
        ]
       },
       "fgi"
      ]
     }
    },
    {
     "lhs": "fuelload",
     "rhs": {
      "op": "*",
      "args": [
       "fuelloadm",
       {
        "op": "^",
        "args": [
         "par.m_per_ft",
         2
        ]
       },
       "par.lb_per_kg"
      ]
     }
    },
    {
     "lhs": "fueldepth",
     "rhs": {
      "op": "/",
      "args": [
       "fueldepthm",
       "par.m_per_ft"
      ]
     }
    },
    {
     "lhs": "betafl",
     "rhs": {
