        ]
       }
      ]
     }
    },
    {
     "lhs": "fuelheat",
     "rhs": {
      "op": "*",
      "args": [
       "par.cmbcnst",
       "par.convert_j_per_kg_to_btu_per_pound"
      ]
     }
    },
    {
     "lhs": "ir",
     "rhs": {
      "op": "*",
      "args": [
       "gamma",
