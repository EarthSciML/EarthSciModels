       {
        "op": "/",
        "args": [
         "fuelload",
         {
          "op": "*",
          "args": [
           "fueldepth",
           "fueldens"
          ]
         }
        ]
       },
       1.0
      ]
     }
    },
    {
     "lhs": "betaop",
     "rhs": {
      "op": "*",
      "args": [
       "par.c_betaop",
       {
        "op": "^",
        "args": [
         "savr",
         "par.e_betaop"
        ]
       }
      ]
     }
    },
    {
     "lhs": "qig",
     "rhs": {
      "op": "+",
      "args": [
       "par.c_qig_dry",
       {
        "op": "*",
        "args": [
