{
 "esm": "1.0.0",
 "metadata": {
  "name": "Anderson13FuelTable",
  "description": "The Anderson (1982) 13-category surface fuel table exactly as fire_behavior carries it (physics/fuel_anderson_mod.F90 Init_anderson_fuel_model, plus the derived quantities of share/fuel_mod.F90 Calc_wind_adjustment_factor, state/state_mod.F90 Init_fuel_vars and fmc_wrffire_mod Init_fmc_wrffire), as a lookup on the integer category code: fuel load fgi (fire_behavior's own kg/m^2 values), bed depth, mass-loss weight, chaparral flag, particle density, surface-area-to-volume ratio, mineral contents, moisture of extinction, the Albini (1976) 1-h/10-h/100-h/1000-h/live load proportions, the canopy fuel parameters, and the derived wind adjustment factor, fuel e-folding time and fuel-moisture class weights. Category 14 is 'no fuel'. Each property is a piecewise-linear interpolation through the 14 integer nodes, exact at the nodes (the same spelling as the EarthSciModels wildland_fire/fuel_model_lookup.esm, which this component does NOT reuse because its numbers differ: that file converts Anderson's ton/acre loads to SI -- 0.449 kg/m^2 for category 2 where fire_behavior has 0.896 -- rounds the depths differently (1.8288 vs 1.829 m) and divides the residence time by 0.8514 instead of 0.85). Tests are the dumped fuel tables and waf array of the instrumented fire_behavior (real32), rel 1e-6 on the transcribed literals and 1e-5 on the derived waf.",
  "license": "MIT",
  "tags": [
   "wildland_fire",
   "fire_behavior",
   "fuel_model",
   "anderson1982"
  ],
  "references": [
   {
    "citation": "NCAR Community Fire Behavior Model (fire_behavior), develop @ eb77580 (WRF 4.8 phys/fire_behavior submodule); instrumented fork ctessum-claude/fire_behavior branch earthsciml-instrumented."
   },
   {
    "citation": "Mandel, J., Beezley, J.D., Kochanski, A.K. (2011). Coupled atmosphere-wildland fire modeling with WRF 3.3 and SFIRE 2011. Geosci. Model Dev. 4, 591-610.",
    "doi": "10.5194/gmd-4-591-2011"
   },
   {
    "citation": "Rothermel, R.C. (1972). A mathematical model for predicting fire spread in wildland fuels. USDA Forest Service Res. Pap. INT-115."
   },
   {
    "citation": "Anderson, H.E. (1982). Aids to determining fuel models for estimating fire behavior. USDA Forest Service GTR INT-122."
   }
  ]
 },
 "models": {
  "Anderson13FuelTable": {
   "subsystems": {
    "par": {
     "ref": "./fire_behavior_parameters.esm"
    }
   },
   "variables": {
    "code": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "Anderson (1982) fuel category 1-13 as used by fire_behavior (nfuel_cat, an integer stored in a real array); 14 = no fuel (NO_FUEL_CAT_ANDERSON). Scott & Burgan codes are crosswalked to 1-14 upstream (fuel_mod Crosswalk_from_scottburgan_to_anderson) and are out of scope here."
    },
    "fuelmc_c": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "Canopy fuel moisture content (namelist fuelmc_c, default 1.0) entering the initial canopy fuel mass fci = (1 + fuelmc_c) fci_d."
    },
    "fgi": {
     "type": "unknown",
     "units": "kg/m^2",
     "description": "Initial total mass of surface fuel per unit area (fuel_anderson_mod fgi; fire_behavior's own kg/m^2 values, which differ from Anderson's ton/acre loads converted to SI for several categories, e.g. 0.896 vs 0.449 kg/m^2 for category 2)."
    },
    "fueldepthm": {
     "type": "unknown",
     "units": "m",
     "description": "Fuel bed depth (fueldepthm)."
    },
    "weight": {
     "type": "unknown",
     "units": "s",
     "description": "Weighting parameter of the mass-loss curve (fuel_anderson_mod weight): weight = 1000 s means a 40 % decrease over 10 min; fuel_time = weight/0.85."
    },
    "ichap": {
     "type": "unknown",
     "units": "1",
     "description": "1 if the category is chaparral (category 4), whose spread rate follows the Clark et al. empirical wind law instead of Rothermel."
    },
    "fueldens": {
     "type": "unknown",
     "units": "1",
     "description": "Oven-dry fuel particle density, lb/ft^3 (32 for every category; carried dimensionless because it enters the US-unit Rothermel fits)."
    },
    "savr": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel particle surface-area-to-volume ratio, 1/ft (carried dimensionless; the Rothermel fits are US-unit empirical formulae)."
    },
    "st": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel particle total mineral content (0.0555 for every category)."
    },
    "se": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel particle effective (silica-free) mineral content (0.010 for every category)."
    },
    "fuelmce": {
     "type": "unknown",
     "units": "1",
     "description": "Dead fuel moisture content of extinction."
    },
    "fgi_1h": {
     "type": "unknown",
     "units": "1",
     "description": "1-h dead fuel load, ton/acre (Albini 1976 proportions; used only for the fuel-moisture class weights)."
    },
    "fgi_10h": {
     "type": "unknown",
     "units": "1",
     "description": "10-h dead fuel load, ton/acre."
    },
    "fgi_100h": {
     "type": "unknown",
     "units": "1",
     "description": "100-h dead fuel load, ton/acre."
    },
    "fgi_1000h": {
     "type": "unknown",
     "units": "1",
     "description": "1000-h dead fuel load, ton/acre (zero for every category)."
    },
    "fgi_live": {
     "type": "unknown",
     "units": "1",
     "description": "Live fuel load, ton/acre."
    },
    "windrf": {
     "type": "unknown",
     "units": "1",
     "description": "Legacy wind reduction factor table (fuel_anderson_mod windrf); not used by fire_behavior's spread rate, which uses waf."
    },
    "fct": {
     "type": "unknown",
     "units": "s",
     "description": "Canopy fuel burn-out time after drying."
    },
    "fci_d": {
     "type": "unknown",
     "units": "kg/m^2",
     "description": "Initial dry mass of canopy fuel."
    },
    "fci": {
     "type": "unknown",
     "units": "kg/m^2",
     "description": "Initial total (wet) mass of canopy fuel, (1 + fuelmc_c) fci_d."
    },
    "fcbr": {
     "type": "unknown",
     "units": "kg/(m^2*s)",
     "description": "Canopy fuel burn rate fci_d/fct."
    },
    "fuel_time": {
     "type": "unknown",
     "units": "s",
     "description": "Fuel e-folding time constant of the surface fuel, weight/0.85 (state_mod Init_fuel_vars); the no-fuel category uses 7/0.85."
    },
    "waf": {
     "type": "unknown",
     "units": "1",
     "description": "Wind adjustment factor from the 10 m wind to the mid-flame wind (fuel_mod Calc_wind_adjustment_factor, Baughman & Albini 1980): with the flame assumed to reach twice the fuel bed height h, hf = max(2h - h, 0.13 h) = h and waf = (1 + 0.36 h/hf) / ln(((10 - h) + 0.36 h)/(0.13 h)) * (ln((hf/h + 0.36)/0.13) - 1). Defined for categories 1-13 (fire_behavior allocates waf(1:13)); the no-fuel category returns the category-13 formula value here but is never used."
    },
    "fgi_class_total": {
     "type": "unknown",
     "units": "1",
     "description": "Total of the five moisture-class loads, ton/acre (fmc_wrffire_mod Init: fgi_t)."
    },
    "w_1h": {
     "type": "unknown",
     "units": "1",
     "description": "Fuel-moisture class weight of the 1-h class, fgi_1h/fgi_class_total (0 when the total is 0)."
    },
    "w_10h": {
     "type": "unknown",
     "units": "1",
     "description": "Class weight of the 10-h class."
    },
    "w_100h": {
     "type": "unknown",
     "units": "1",
     "description": "Class weight of the 100-h class."
    },
    "w_1000h": {
     "type": "unknown",
     "units": "1",
     "description": "Class weight of the 1000-h class."
    },
    "w_live": {
     "type": "unknown",
     "units": "1",
     "description": "Class weight of the live class."
    }
   },
