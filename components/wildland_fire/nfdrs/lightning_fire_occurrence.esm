          },
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "CGRATE",
              "time": 0.0,
              "expected": 100.0
            }
          ]
        },
        {
          "id": "stmdia_lal_low",
