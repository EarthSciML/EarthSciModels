              "time": 0.0,
              "expected": 0.0
            }
          ]
        },
        {
          "id": "stmdia_lal_mid",
          "description": "LAL = 3.0 (in [2.5, 3.5)): STMDIA = 4 mi converted to meters = 4 * 1609.344 = 6437.376.",
