      "tests": [
        {
          "id": "cgrate_lal_low",
          "description": "LAL = 1.0 (< 1.5): CGRATE = 0 (no lightning activity at very low LAL).",
          "parameter_overrides": {
            "LAL": 1.0
          },
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "CGRATE",
              "time": 0.0,
              "expected": 0.0
            }
          ]
        },
        {
          "id": "cgrate_lal_mid",
          "description": "LAL = 3.0 (in [2.5, 3.5)): CGRATE = 25 strikes/min (PSW-82 LAL table).",
          "parameter_overrides": {
            "LAL": 3.0
          },
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "CGRATE",
              "time": 0.0,
              "expected": 25.0
            }
          ]
        },
        {
          "id": "cgrate_lal_high",
          "description": "LAL = 5.0 (>= 4.5): CGRATE = 100 strikes/min (PSW-82 LAL table).",
          "parameter_overrides": {
            "LAL": 5.0
          },
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "assertions": [
            {
              "variable": "CGRATE",
              "time": 0.0,
              "expected": 100.0
            }
          ]
        },
        {
          "id": "cgrate_lal_max",
          "description": "LAL = 6.0: CGRATE stays at the LAL 5 value of 100 strikes/min (LAL 6 forces LRISK and LOI to 100 separately).",
