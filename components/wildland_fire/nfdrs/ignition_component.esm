            "tests": [
                {
                    "id": "high_temperature_low_moisture",
                    "description": "High temperature (40°C) and low fuel moisture (5%) should produce high IC Closed form (PSW-82 with MC1 as a fraction, TMPPRM in K): QIGN = 172.758, CHI = 17.1242, P(I) = 50.9571, SCN = 100*SC/SCM = 200, IC = 0.1*P(I)*sqrt(SCN) = 72.0642.",
                    "parameter_overrides": {
                        "TMPPRM": 313.15,
                        "MC1": 0.05,
                        "SC": 0.01,
                        "SCM": 0.005
                    },
                    "time_span": {
                        "start": 0.0,
                        "end": 1.0
                    },
                    "assertions": [
                        {
                            "variable": "IC",
                            "time": 1.0,
                            "expected": 72.06417934106372,
                            "tolerance": {
                                "rel": 1e-06
                            }
                        },
                        {
                            "variable": "PI",
                            "time": 1.0,
                            "expected": 50.95706989270966,
                            "tolerance": {
                                "rel": 1e-05
                            }
                        }
                    ]
                },
                {
                    "id": "low_temperature_high_moisture",
                    "description": "Low temperature (10°C) and high fuel moisture (20%) should produce low IC Closed form (PSW-82 with MC1 as a fraction, TMPPRM in K): QIGN = 285.417, CHI = 5.85828, P(I) = 0.844312, SCN = 100*SC/SCM = 20, IC = 0.1*P(I)*sqrt(SCN) = 0.377588.",
                    "parameter_overrides": {
