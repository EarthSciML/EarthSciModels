      "abs": 0.0
     },
     "assertions": [
      {
       "variable": "ifrac",
       "time": 0.0,
       "expected": 0.009848449155449343
      },
      {
       "variable": "ofrac",
       "time": 0.0,
       "expected": 0.10461665353868223
      }
