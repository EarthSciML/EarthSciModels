{
 "esm": "1.3.0",
 "metadata": {
  "name": "cmeps_aoflux_steps_coupling",
  "description": "Coupling library (esm-spec section 10.9) of the CMEPS atmosphere-ocean bulk-flux stability iteration: the 86 variable_map param_to_var edges that wire the AoFlux parent (flux_atmOcn_large of cesm/flux_atmocn/flux_atmocn_Large.F90) to its five AoFluxStep mounts (step1..step5, one do-while pass each, F90:242-290) and the exit-state mount (the fields of the first-converged update recomputed from the frozen pre-convergence state). Import with a coupling_import entry binding all seven roles; both cmeps_aoflux.esm (roles bound to its top-level AoFlux model and its step1..step5/exit mounts) and the m9_ocn_flux.esm subassembly (same role names at top level, AoFlux plus five AoFluxStep mounts and the exit mount) import this library so the iteration wiring is authored once and reused by reference. The roles carry no structural contract: each edge's scoped references check, at flatten, that the bound component exposes the referenced variables (unresolved_scoped_ref otherwise).",
  "tags": [
   "coupler",
   "cmeps",
   "coupling",
   "bulk-flux",
   "cesm"
  ],
  "created": "2026-11-15T00:00:00Z",
  "authors": [
   "EqESM project contributors"
  ],
  "references": [
   {
    "citation": "CESM (Community Earth System Model), ESCOMP/CESM: CMEPS (Coupled Mediator for Earth System Prediction) source (cesm3.0-alphabranch) - flux_atmocn/flux_atmocn_Large.F90, share/src/shr_wv_sat_mod.F90, share/src/shr_orb_mod.F90, mediator/med_phases_aofluxes_mod.F90, mediator/med_phases_ocnalb_mod.F90, mediator/med_phases_prep_ocn_mod.F90, mediator/med_phases_prep_atm_mod.F90, mediator/med_merge_mod.F90, mediator/esmFldsExchange_cesm_mod.F90 - the reference implementation these components are transcribed from.",
    "url": "https://github.com/ESCOMP/CESM"
   },
   {
    "citation": "EarthSciModels - the authoritative .esm corpus this component lives in.",
    "url": "https://github.com/EarthSciML/EarthSciModels"
   }
  ],
  "license": "MIT"
 },
 "coupling_roles": {
  "AoFlux": {
   "description": "the bulk-flux parent: computes the update-invariant pointwise fields vmag/delt/delq/alz/zbot/thbot/qbot, the neutral seeds ustar0/tstar0/qstar0/rdn0 (F90:193-225) and the first-converged-state selector, and consumes the converged ustar/tstar/qstar/rdn for the 10-m wind and exchange fluxes (F90:295-334)"
  },
  "step1": {
   "description": "the 1st do-while pass: receives the 7 invariant fields, the 4 neutral seeds as ustar_prev/tstar_prev/qstar_prev/rdn_prev and conv_prev = 0, and hands its update to step2"
  },
  "step2": {
   "description": "the 2nd do-while pass: receives the 7 invariant fields and step1's ustar/tstar/qstar/rdn/conv as the prev state, and hands its update to step3"
  },
  "step3": {
   "description": "the 3rd do-while pass: receives the 7 invariant fields and step2's ustar/tstar/qstar/rdn/conv as the prev state, and hands its update to step4"
  },
  "step4": {
   "description": "the 4th do-while pass: receives the 7 invariant fields and step3's ustar/tstar/qstar/rdn/conv as the prev state, and hands its update to step5"
  },
  "step5": {
   "description": "the 5th do-while pass: receives the 7 invariant fields and step4's ustar/tstar/qstar/rdn/conv as the prev state, and hands its frozen first-converged state to the exit mount"
  },
  "exit": {
   "description": "the exit-state recomputation: receives the 7 invariant fields and the frozen first-converged ustar/tstar/qstar/rdn, reproducing the Fortran exit state after the do-while"
  }
 },
