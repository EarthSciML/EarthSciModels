    "lw_gas_atrans": {
     "description": "The gaseous layer absorptivity atrans of the two branches of rrtmg_lw_rtrnmc.f90:301-302/319-320/346 and 368-369/377: below the branch boundary odepth <= 0.06 the quadratic expansion odepth - 0.5*odepth*odepth (the Fortran operation order 0.5*odepth first, then *odepth), above it the Pade-table absorptivity 1 - exp_tbl(itr).",
     "params": [
      "odepth"
     ],
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "<=",
        "args": [
         "odepth",
         0.06
        ]
       },
       {
        "op": "-",
        "args": [
         "odepth",
         {
          "op": "*",
          "args": [
           {
            "op": "*",
            "args": [
             0.5,
             "odepth"
            ]
           },
           "odepth"
          ]
         }
        ]
       },
       {
        "op": "-",
        "args": [
         1.0,
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "lw_tbl_exp",
          "bindings": {
           "odepth": "odepth"
          }
         }
        ]
       }
      ]
     }
    },
    "lw_gas_tfac": {
     "description": "The gaseous Planck interpolation factor tfacgas of the two branches of rrtmg_lw_rtrnmc.f90:303/321/338/347/363 and 370/378-380: odepth/6 below the branch boundary (rec_6 = 0.166667), the Pade-table tfn_tbl(itr) above it.",
     "params": [
      "odepth"
     ],
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "<=",
        "args": [
         "odepth",
         0.06
        ]
       },
       {
        "op": "*",
        "args": [
         0.166667,
         "odepth"
        ]
       },
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "lw_tbl_tfn",
        "bindings": {
         "odepth": "odepth"
        }
       }
      ]
     }
    },
    "lw_gas_odepth": {
     "description": "The gaseous optical depth that enters the total optical depth odtot = odepth + odcld: the raw odepth on the quadratic branch, and the table value tau_tbl(itr) on the table branch, where the Fortran overwrites odepth with tau_tbl(itr) before forming odtot (rrtmg_lw_rtrnmc.f90:345, 350).",
     "params": [
      "odepth"
     ],
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "<=",
        "args": [
         "odepth",
         0.06
        ]
       },
       "odepth",
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "lw_tbl_tau",
        "bindings": {
         "odepth": "odepth"
        }
       }
      ]
     }
    },
    "lw_tot_atot": {
     "description": "The total (gas plus cloud) layer absorptivity atot of rrtmg_lw_rtrnmc.f90:306/330/356: the quadratic expansion odtot - 0.5*odtot*odtot below odtot < 0.06, the Pade-table absorptivity 1 - exp_tbl(ittot) above it (the small-total cloudy branch of rrtmg_lw_rtrnmc.f90:301-307 is the same quadratic; odtot < 0.06 implies the gas quadratic branch too, so the gas laws do not need the small-total special case).",
     "params": [
      "odtot"
     ],
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "<",
        "args": [
         "odtot",
         0.06
        ]
       },
       {
        "op": "-",
        "args": [
         "odtot",
         {
          "op": "*",
          "args": [
           {
            "op": "*",
            "args": [
             0.5,
             "odtot"
            ]
           },
           "odtot"
          ]
         }
        ]
       },
       {
        "op": "-",
        "args": [
         1.0,
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "lw_tbl_exp",
          "bindings": {
           "odepth": "odtot"
          }
         }
        ]
       }
      ]
     }
    },
    "lw_tot_tfactot": {
     "description": "The total (gas plus cloud) Planck interpolation factor tfactot of rrtmg_lw_rtrnmc.f90:308/327/353: odtot/6 below odtot < 0.06, the Pade-table tfn_tbl(ittot) above it.",
     "params": [
      "odtot"
     ],
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "<",
        "args": [
         "odtot",
         0.06
        ]
       },
       {
        "op": "*",
        "args": [
         0.166667,
         "odtot"
        ]
       },
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "lw_tbl_tfn",
        "bindings": {
         "odepth": "odtot"
        }
       }
      ]
     }
    },
    "lw_bb": {
     "description": "The linear-in-tau Planck source factor plfrac*(blay + tfac*dplank) of rrtmg_lw_rtrnmc.f90:304-309, 316-317, 322-329, 338-339, 348-355, 363-364, 371-380 (bbd and bbugas with the gas tfacgas, bbdtot and bbutot with the total tfactot): plfrac = fracs, blay = planklay, dplank = the Planck difference planklev - blay at the layer boundary toward the stream, tfac = the interpolation factor.",
     "params": [
      "plfrac",
      "blay",
      "tfac",
      "dplank"
     ],
     "body": {
      "op": "*",
      "args": [
       "plfrac",
       {
        "op": "+",
        "args": [
         "blay",
         {
          "op": "*",
          "args": [
           "tfac",
           "dplank"
          ]
         }
        ]
       }
      ]
     }
    },
    "lw_surface_up": {
     "description": "The surface upwelling radiance rad0 + reflect*radld of rrtmg_lw_rtrnmc.f90:403-407: the spectral emissivity radiance rad0 = fracs(1,ig)*plankbnd(ib) of the bottom layer plus the specular reflection of the downwelling radiance at the surface.",
     "params": [
      "rad0",
      "reflect",
      "radld"
     ],
     "body": {
      "op": "+",
      "args": [
       "rad0",
       {
        "op": "*",
        "args": [
         "reflect",
         "radld"
        ]
       }
      ]
     }
    },
    "lw_cloudy_update": {
     "description": "The one-layer radiance update of the cloudy branches of rrtmg_lw_rtrnmc.f90:310-313 and 418-421, rad' = rad - rad*A + gassrc + cldfmc*(bbtot*atot - gassrc) with A = atrans + efclfrac*(1 - atrans), where gassrc is the layer source matched to the sweep direction: the down sweep binds gassrc = atrans*bbd and the up sweep binds gassrc_up = atrans*bbugas (the Fortran up loop reassigns gassrc = bbugas*atrans at rrtmg_lw_rtrnmc.f90:416-418; the unified form: for clear layers cldfmc = efclfrac = 0 and the update reduces to rad - rad*atrans + gassrc = rad + (bb - rad)*atrans with bb = bbd down and bb = bbugas up, bit-identical to the clear branch; the Fortran operation order rad - rad*A + gassrc + cldfmc*(...) is preserved).",
     "params": [
      "rad",
      "absorpt",
      "gassrc",
      "cldfmc",
      "bbtot",
      "atot"
     ],
     "body": {
      "op": "+",
      "args": [
       {
        "op": "+",
        "args": [
         {
          "op": "-",
          "args": [
           "rad",
           {
            "op": "*",
            "args": [
             "rad",
             "absorpt"
            ]
           }
          ]
         },
         "gassrc"
        ]
       },
       {
        "op": "*",
        "args": [
         "cldfmc",
         {
          "op": "-",
          "args": [
           {
            "op": "*",
            "args": [
             "bbtot",
             "atot"
            ]
           },
           "gassrc"
          ]
         }
        ]
       }
      ]
     }
    },
    "lw_clear_update": {
     "description": "The one-layer radiance update of the clear branches and of the clear-sky streams of rrtmg_lw_rtrnmc.f90:382, 389, 425, 433, rad' = rad + (bb - rad)*atrans, with bb = bbd for the down streams and bb = bbugas for the up streams.",
     "params": [
      "rad",
      "bb",
      "atrans"
     ],
     "body": {
      "op": "+",
      "args": [
       "rad",
       {
        "op": "*",
        "args": [
         {
          "op": "-",
          "args": [
           "bb",
           "rad"
          ]
         },
         "atrans"
        ]
       }
      ]
     }
    },
    "lw_secdiff": {
     "description": "The variable diffusivity angle secdiff of rrtmg_lw_rtrnmc.f90:224-232: 1.66 for bands 1, 4 and 10-16, and a0 + a1*exp(a2*pwvcm) clamped to [1.5, 1.8] for bands 2-3 and 5-9, with the a0/a1/a2 coefficient arrays of rrtmg_lw_rtrnmc.f90:211-222 (the min/max clamp form selects the same values as the Fortran's two if statements).",
     "params": [
      "band",
      "pwvcm",
      "a0",
      "a1",
      "a2"
     ],
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "or",
        "args": [
         {
          "op": "==",
          "args": [
           "band",
