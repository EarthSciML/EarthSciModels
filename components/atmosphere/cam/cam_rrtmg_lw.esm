    "totuflux": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "k_ifc"
     ],
     "description": "The total-sky upwelling interface flux of the solver column, the sum over the band g-points of the per-g-point uflux scaling wtdiff*delwave(ib)*fluxfac (rrtmg_lw_rtrnmc.f90:449-466); the spectral sum is kept a plain sum, the exact transcription of the Fortran totals loop, because the g-points of a band are a discrete spectral set with no ordered integration axis."
    },
    "totdflux": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "k_ifc"
     ],
     "description": "The total-sky downwelling interface flux of the solver column, the sum over the band g-points of the per-g-point dflux scaling wtdiff*delwave(ib)*fluxfac (rrtmg_lw_rtrnmc.f90:449-466); the spectral sum is kept a plain sum, the exact transcription of the Fortran totals loop, because the g-points of a band are a discrete spectral set with no ordered integration axis."
    },
    "totuclfl": {
