{
 "esm": "2.0.0",
 "metadata": {
 "name": "cam_zm_coupling",
 "description": "Coupling library (esm-spec 10.9-10.10) for the ZM deep-convection subassembly of the CAM physics column (stage 2 of the EqESM project): the single source of the 37 ZM-internal wiring edges of zm_convr_run / zm_conv_intr.zm_conv_tend between the mounted Parcel, Closure, Q1Q2, Evap and Control components, written against the five roles ZmParcel/ZmClosure/ZmQ1Q2/ZmEvap/ZmControl and imported by reference into cam_zm.esm's own coupling block and into the cam_physics_column.esm driver (esm-spec 10.9-10.10: a mount does not carry a file's coupling array, so the library is the one place the ZM wiring is authored; cam_zm.esm's standalone tests and the column driver consume exactly the same edges through their own coupling_import entries, ending the previous duplication of every edge between the two files). The edges are the data flow of the Zhang-McFarlane chain: the parcel-ascent boundary into the closure (the gathered t/q/p/s profiles, the saturation states tp/qstp, the CAPE and the level indices lel/maxi), the mb mass-flux scaling of the normalized closure fluxes into q1q2 (mu = mb*mu_norm, md = mb*md_norm, du = mb*du_norm, zm_convr.F90:725-735), the q1q2 tendencies and the detrained-condensate dlf into the Control environment update (t1 = t + ztodt*dsdt, q1 = q + ztodt*dqdt, zm_conv_intr.F90:640), the parcel working pressure into the evap layer midpoint pressure (pmid = 100 p, the hPa-to-Pa conversion of zm_convr.F90:518 through the named ZmControl.hpa_to_pa constant), the precipitation budget of zm_convr.F90:770-779 and the evap's post-zm_convr boundary (prec/t1/q1 of the zm_conv_evap_run call). The four ZM tendency-output edges into the column driver (ZmQ1Q2.dsdt/dqdt -> Column.dsdt3/dqdt3, ZmEvap.tend_s/tend_q -> Column.tend_s3/tend_q3) live in the sibling driver-side library cam_physics_column_coupling.esm, whose roles ZmQ1Q2/ZmEvap/ZmColumn bind to the driver's same-named mounts.",
 "tags": [
  "atmosphere",
  "cam",
  "zm",
  "deep-convection",
  "coupling-library",
  "cesm"
 ],
 "created": "2026-11-24T00:00:00Z",
 "authors": [
  "EqESM project contributors"
 ],
 "references": [
  {
   "citation": "CESM (Community Earth System Model), ESCOMP/CESM: CAM6 physics sources of the instrumented cam6_4_212 fork (components/cam/src/) - zm_convr.F90, zm_conv_intr.F90 - the reference implementation these components are transcribed from.",
   "url": "https://github.com/ESCOMP/CESM"
  },
  {
   "citation": "EarthSciModels - the authoritative .esm corpus this component lives in.",
   "url": "https://github.com/EarthSciML/EarthSciModels"
  }
 ]
},
 "coupling_roles": {
  "ZmParcel": { "description": "the ZM parcel ascent (Parcel of cam_zm_parcel.esm, mounted in cam_zm.esm and cam_physics_column.esm)" },
  "ZmClosure": { "description": "the ZM closure (Closure of cam_zm_closure.esm)" },
  "ZmQ1Q2": { "description": "the ZM q1/q2 tendencies (Q1Q2 of cam_zm_q1q2.esm)" },
  "ZmEvap": { "description": "the ZM precip evaporation (Evap of cam_zm_evap.esm)" },
  "ZmControl": { "description": "the ZM environment update and prec budget (Control of cam_zm.esm)" }
 },
 "coupling": [
  {
   "type": "variable_map",
   "from": "ZmParcel.cape",
   "to": "ZmClosure.cape",
   "transform": "param_to_var",
   "description": "parcel CAPE into the closure (buoyan_dilute cape of zm_convr.F90:537 consumed by closure at F90:2500; the parcel->closure edge of the chain)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.lel",
   "to": "ZmClosure.lel",
   "transform": "param_to_var",
   "description": "equilibrium level lel into the closure (the same dumped index; the closure reads it at F90:2457-2499)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.tp",
   "to": "ZmClosure.tpg",
   "transform": "param_to_var",
   "description": "parcel temperature tp into the gathered tpg of the closure (the gather tp(ideep) of zm_convr.F90:565-570)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.T",
   "to": "ZmClosure.tg",
   "transform": "param_to_var",
   "description": "environment temperature into the gathered tg of the closure (the gather tg(i,k) = t(ideep(i),k) of zm_convr.F90:584; the single-column gather is the identity, so tg = T)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.q",
   "to": "ZmClosure.qg",
   "transform": "param_to_var",
   "description": "environment specific humidity into the gathered qg of the closure (the gather qg(i,k) = q(ideep(i),k) of zm_convr.F90:583; the single-column gather is the identity, so qg = q)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.p",
   "to": "ZmClosure.pg",
   "transform": "param_to_var",
   "description": "working pressure into the gathered pg of the closure (the gather pg(i,k) = p(ideep(i),k) of zm_convr.F90:585; the single-column gather is the identity, so pg = p)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.pf_lo",
   "to": "ZmClosure.pf_lo",
   "transform": "param_to_var",
   "description": "interface pressure above level k into the gathered pf_lo of the closure (the same pf field of zm_convr.F90:513-519; the single-column gather is the identity)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.pf_hi",
   "to": "ZmClosure.pf_hi",
   "transform": "param_to_var",
   "description": "interface pressure below level k into the gathered pf_hi of the closure (the same pf field of zm_convr.F90:513-519; the single-column gather is the identity)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.qstp",
   "to": "ZmClosure.qstpg",
   "transform": "param_to_var",
   "description": "parcel saturation specific humidity qstp into the gathered qstpg of the closure (the gather qstp(ideep) of zm_convr.F90:565-570)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.maxi",
   "to": "ZmClosure.mx",
   "transform": "param_to_var",
   "description": "parcel launch level maxi into the closure's cloud-base index mx (the gather maxg = maxi(ideep) of zm_convr.F90:581-584; = 32 on all dumped rows)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.maxi",
   "to": "ZmQ1Q2.maxg",
   "transform": "param_to_var",
   "description": "parcel launch level maxi into the q1q2 subcloud-top index maxg (the kbm of the q1q2_pjr loop, zm_convr.F90:2607; = 32 = pver on all dumped rows)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.mb",
   "to": "ZmQ1Q2.mu",
   "transform": {
    "op": "*",
    "args": [
     "ZmClosure.mb",
     "ZmClosure.mu"
    ]
   },
   "description": "updraft mass flux scaled by the closure mass flux: mu = mb mu_norm (the xmb scaling of zm_convr.F90:725-727; the closure receives the NORMALIZED flux and q1q2 the mb/s flux)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.mb",
   "to": "ZmQ1Q2.md",
   "transform": {
    "op": "*",
    "args": [
     "ZmClosure.mb",
     "ZmClosure.md"
    ]
   },
   "description": "downdraft mass flux scaled by the closure mass flux: md = mb md_norm (zm_convr.F90:728-729)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.mb",
   "to": "ZmQ1Q2.du",
   "transform": {
    "op": "*",
    "args": [
     "ZmClosure.mb",
     "ZmClosure.du"
    ]
   },
   "description": "updraft detrainment scaled by the closure mass flux: du = mb du_norm (zm_convr.F90:731-733; the closure's du is per unit mb, q1q2's per second)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.dsubcld",
   "to": "ZmQ1Q2.dsubcld",
   "transform": "param_to_var",
   "description": "subcloud-layer pressure thickness dsubcld of the closure into q1q2 (the dsubcld of zm_convr.F90:600-604, read by q1q2_pjr at F90:2612-2619)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.jt",
   "to": "ZmQ1Q2.jt",
   "transform": "param_to_var",
   "description": "convection top index jt into q1q2 (the same cldprp output, the ktm of q1q2_pjr, zm_convr.F90:2583; = 15 on all dumped rows)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.qu",
   "to": "ZmQ1Q2.qu",
   "transform": "param_to_var",
   "description": "updraft specific humidity qu (the same cldprp output consumed by closure and q1q2, zm_convr.F90:741-751)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.su",
   "to": "ZmQ1Q2.su",
   "transform": "param_to_var",
   "description": "updraft dry static energy su (the same cldprp output consumed by closure and q1q2)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.qd",
   "to": "ZmQ1Q2.qd",
   "transform": "param_to_var",
   "description": "downdraft specific humidity qd (the same cldprp output consumed by closure and q1q2)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.sd",
   "to": "ZmQ1Q2.sd",
   "transform": "param_to_var",
   "description": "downdraft dry static energy sd (the same cldprp output consumed by closure and q1q2)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.qhat",
   "to": "ZmQ1Q2.qhat",
   "transform": "param_to_var",
   "description": "interface specific humidity qhat (the same interfacial-mean field consumed by closure and q1q2, zm_convr.F90:590-616)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.shat",
   "to": "ZmQ1Q2.shat",
   "transform": "param_to_var",
   "description": "interface dry static energy shat (the same interfacial-mean field consumed by closure and q1q2)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.pdel",
   "to": "ZmQ1Q2.pdel",
   "transform": "param_to_var",
   "description": "layer pressure thickness pdel into q1q2 (the same dpp field; the q1q2 dp = 0.01 pdel of zm_convr.F90:717)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.pdel",
   "to": "ZmEvap.pdel",
   "transform": "param_to_var",
   "description": "layer pressure thickness pdel into the evap (state1%pdel of the zm_conv_evap_run call, zm_conv_intr.F90:671-679)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.p",
   "to": "ZmEvap.pmid",
   "transform": {
    "op": "*",
    "args": [
     "ZmParcel.p",
     "ZmControl.hpa_to_pa"
    ]
   },
   "description": "layer midpoint pressure into the evap: pmid = 100 p, the hPa-to-Pa conversion of the state1%pmid the evap receives (zm_conv_intr.F90:671-679) vs the parcel working pressure p = 0.01 pmid (zm_convr.F90:518)"
  },
  {
   "type": "variable_map",
   "from": "ZmClosure.pdel",
   "to": "ZmControl.pdel",
   "transform": "param_to_var",
   "description": "layer pressure thickness pdel into the prec budget measure (the dpp of zm_convr.F90:772-774)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.T",
   "to": "ZmControl.t0",
   "transform": "param_to_var",
   "description": "environment temperature into the t1 physics_update coupling (the same boundary state t the Parcel receives; zm_conv_intr.F90:640)"
  },
  {
   "type": "variable_map",
   "from": "ZmParcel.q",
   "to": "ZmControl.q",
   "transform": "param_to_var",
   "description": "environment specific humidity into the q1 physics_update coupling (the same boundary state q the Parcel receives)"
  },
  {
   "type": "variable_map",
   "from": "ZmQ1Q2.dqdt",
   "to": "ZmControl.dqdt",
   "transform": "param_to_var",
   "description": "q1q2 moisture tendency into the prec budget and the q1 update (the dqdt of zm_convr.F90:751-754, 770-779)"
  },
  {
   "type": "variable_map",
   "from": "ZmQ1Q2.dsdt",
   "to": "ZmControl.dsdt",
   "transform": "param_to_var",
   "description": "q1q2 heating tendency into the t1 update (the dsdt of zm_convr.F90:741-750, applied by physics_update at zm_conv_intr.F90:640)"
  },
  {
   "type": "variable_map",
   "from": "ZmQ1Q2.dlf",
   "to": "ZmControl.dlf",
   "transform": "param_to_var",
   "description": "q1q2 detrained-condensate tendency into the prec budget (the dlf of zm_convr.F90:773-774)"
  },
  {
   "type": "variable_map",
   "from": "ZmEvap.deltat",
   "to": "ZmControl.delt",
   "transform": "param_to_var",
   "description": "physics timestep into the t1/q1 update and the prec budget: the Evap component's deltat = ztodt (zm_conv_evap.F90:168-170) is the single source of the constant both the driver couplings use (zm_convr.F90:776, zm_conv_intr.F90:640)"
  },
  {
   "type": "variable_map",
   "from": "ZmEvap.gravit",
   "to": "ZmControl.grav",
   "transform": "param_to_var",
   "description": "gravity into the prec conversion: the Evap component's gravit = SHR_CONST_G (zm_conv_evap.F90:234-236) is the single source of the rgrav of zm_convr.F90:779"
  },
  {
   "type": "variable_map",
   "from": "ZmEvap.density_fresh_water",
   "to": "ZmControl.density_fresh_water",
   "transform": "param_to_var",
   "description": "fresh-water density into the prec conversion: the Evap component's density_fresh_water = SHR_CONST_RHOFW (zm_conv_evap.F90:234-236) is the single source of the /1000 of zm_convr.F90:779"
  },
  {
   "type": "variable_map",
   "from": "ZmControl.prec",
   "to": "ZmEvap.prec_convr",
   "transform": "param_to_var",
   "description": "precipitation rate out of zm_convr_run into the evap (the prec passed to zm_conv_evap_run, zm_conv_intr.F90:671-679; the q1q2->evap precip-flux edge of the chain)"
  },
  {
   "type": "variable_map",
   "from": "ZmControl.t1",
   "to": "ZmEvap.t1",
   "transform": "param_to_var",
   "description": "evap entry temperature (state1%t of the zm_conv_evap_run call, zm_conv_intr.F90:671-679)"
  },
  {
   "type": "variable_map",
   "from": "ZmControl.q1",
   "to": "ZmEvap.q1",
   "transform": "param_to_var",
   "description": "evap entry specific humidity (state1%q of the zm_conv_evap_run call)"
  }
 ]
}
