      "op": "faq",
      "args": [],
      "output_idx": [
       "g",
       "k",
       "s"
      ],
      "ranges": {
       "g": {
        "from": "gpt"
       },
       "k": {
        "from": "k_ifc"
       },
       "s": {
        "from": "sky"
       }
      },
      "expr": {
       "op": "ifelse",
       "args": [
        {
         "op": "<=",
         "args": [
          "k",
          1
         ]
        },
        1.0,
        {
         "op": "*",
         "args": [
          {
           "op": "index",
           "args": [
            "ptdbt",
            "g",
            {
             "op": "-",
             "args": [
              "k",
              1
             ]
            },
            "s"
           ]
          },
          {
           "op": "index",
           "args": [
            "pdbt",
            "g",
            {
             "op": "-",
             "args": [
              "k",
              1
             ]
            },
            "s"
           ]
          }
         ]
        }
       ]
      }
     }
    }
   ],
   "tests": [
    {
     "id": "step37",
     "description": "DirectBeam at step 37 (defaults are the step-37 dump arrays; no overrides): the two branches of the spcvmc_zdbt law at the two cloudy cells of the pinned column, gpt 3 = RRTMG g-point 13 and gpt 4 = RRTMG g-point 47, k = 16 (the only cloudy layers of the column, so the cumulative ptdbt below the cell is the product of the single non-unit layer factor and the unitary clear factors). gpt 3 takes the exponential-table branch (ze1 = 0.2650/0.2785 > od_lo = 0.06 on the real dumped gas-plus-cloud optics) and gpt 4 the quadratic expansion branch (ze1 = 0.0135 <= od_lo; exact, pinned at rtol 1e-12). Expected values are the dump columns zdbtc/zdbt of the clear and total members (cam_rad_spcvmc.csv, k = 16) and their interface cumulants ztdbtc/ztdbt (cam_rad_spcvmc_ifc.csv, k_ifc 17 for gpt 3 where the surface underflows to 0, k_ifc 34 for gpt 47). The gpt-3 pins sit at rtol 1e-6, not 1e-12, because the Fortran's exp_tbl is filled with tfn = float(itr)/float(ntbl) in the build's 32-bit default REAL (rrtmg_sw_init.f90:92-94), so the dumped table values differ from the esm's closed form (the exact limit of the table, written per the template description) by the single-precision rounding of tfn, up to ~3e-8 relative at these cells; the closed form is the model law and the difference is documented, not transcribed. The clear-layer cells (zdbt = 1) are not pinned (unitary values).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "initial_conditions": {},
     "parameter_overrides": {},
     "assertions": [
      {
       "variable": "pdbt",
       "time": 0.0,
       "coords": {
        "gpt": 3,
        "k": 16,
        "sky": 2
       },
       "expected": 0.7567900291849393,
       "tolerance": {
        "rel": 1e-6
       }
      },
      {
       "variable": "ptdbt",
       "time": 0.0,
       "coords": {
        "gpt": 3,
        "k_ifc": 17,
        "sky": 2
       },
       "expected": 0.6091753631787643,
       "tolerance": {
        "rel": 1e-6
       }
      },
      {
       "variable": "pdbt",
       "time": 0.0,
       "coords": {
        "gpt": 3,
        "k": 16,
        "sky": 1
       },
       "expected": 0.7672540679363538,
       "tolerance": {
        "rel": 1e-6
       }
      },
      {
       "variable": "ptdbt",
       "time": 0.0,
       "coords": {
        "gpt": 3,
        "k_ifc": 17,
        "sky": 1
       },
       "expected": 0.6175983528600301,
       "tolerance": {
        "rel": 1e-6
       }
      },
      {
       "variable": "pdbt",
       "time": 0.0,
       "coords": {
        "gpt": 4,
        "k": 16,
        "sky": 2
       },
       "expected": 0.9866326559271738,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "ptdbt",
       "time": 0.0,
       "coords": {
        "gpt": 4,
        "k_ifc": 34,
        "sky": 2
       },
       "expected": 0.7735844862537127,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "pdbt",
       "time": 0.0,
       "coords": {
        "gpt": 4,
        "k": 16,
        "sky": 1
       },
       "expected": 0.9999148898836753,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "ptdbt",
