  "CamRrtmgSwFluxes": {
   "variables": {
    "pfu_tot": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc"
     ],
     "default": 0.0,
     "description": "Total-sky upwelling interface flux fraction of the adding method (member 2, zfu of spcvmc.f90:598-602; dump column zfu of cam_rad_spcvmc_ifc.csv, step 37, overridden in the step37 test); zero defaults, coupled by data in stage 3."
    },
    "pfd_tot": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc"
     ],
     "default": 0.0,
     "description": "Total-sky downwelling interface flux fraction of the adding method (zfd; dump column zfd of cam_rad_spcvmc_ifc.csv, step 37, overridden in the step37 test)."
    },
    "pfu_clr": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc"
     ],
     "default": 0.0,
     "description": "Clear-sky upwelling interface flux fraction of the adding method (member 1, zcu of spcvmc.f90:594-597; dump column zcu of cam_rad_spcvmc_ifc.csv, step 37, overridden in the step37 test)."
    },
    "pfd_clr": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc"
     ],
     "default": 0.0,
     "description": "Clear-sky downwelling interface flux fraction of the adding method (zcd; dump column zcd of cam_rad_spcvmc_ifc.csv, step 37, overridden in the step37 test)."
    },
    "zincflx": {
     "type": "parameter",
     "units": "W/m^2",
     "shape": [
      "gpt"
     ],
     "default": [3.4024533840691498, 2.733579257572399, 1.2066848361418852, 13.956153850741902],
     "description": "Per-g-point incident spectral flux at the top of the atmosphere zincflx = adjflux_g*zsflxzen*muz of spcvmc_sw (spcvmc.f90:244-252, with adjflux = eccf*sfac per band, radsw.F90:395-396); dump column zincflx of cam_rad_spcvmc.csv (step 37). The zincflx law itself is unpinned: zsflxzen, the k-distribution solar spectrum of rrtmg_sw_rad.f90:1089-1092, is not dumped, so the per-g-point incident flux is a data input here and the band-summed flux pins are the per-g-point sums of the dumped pfd/pfu columns (see the step37 test)."
    },
    "fus_ifc": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "k_ifc"
     ],
     "description": "Total-sky upwelling spectral sum over the pinned g-points, the pbbfu accumulation of spcvmc.f90:606-608 (the band sums collapse to one sum over the g-point axis)."
    },
    "fds_ifc": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "k_ifc"
     ],
     "description": "Total-sky downwelling spectral sum (pbbfd, spcvmc.f90:609-611)."
    },
    "fus_clr_ifc": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "k_ifc"
     ],
     "description": "Clear-sky upwelling spectral sum (pbbcu, spcvmc.f90:612-614)."
    },
    "fds_clr_ifc": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "k_ifc"
     ],
     "description": "Clear-sky downwelling spectral sum (pbbcd, spcvmc.f90:615-617)."
    },
    "fus": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "lev_nodes"
     ],
     "description": "Total-sky upwelling flux on the esd interface axis (1 = surface): fus(n) = fus_ifc(NK+2-n), dropping the solver interface of the extra top layer (the swuflx of radsw.F90:1134-1136)."
    },
    "fds": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "lev_nodes"
     ],
     "description": "Total-sky downwelling flux on the esd interface axis (swdflx)."
    },
    "fus_clr": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "lev_nodes"
     ],
     "description": "Clear-sky upwelling flux on the esd interface axis."
    },
    "fds_clr": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "lev_nodes"
     ],
     "description": "Clear-sky downwelling flux on the esd interface axis."
    }
   },
