     "description": "Layer direct reflectance of the sky member (the CamRrtmgSwLayer output zref of the two vrtqdr_sw calls; the step37 test overrides the arrays with the dump columns zrefc/zrefo of cam_rad_spcvmc.csv, member 2 the McICA blend)."
    },
    "prefd": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k",
      "sky"
     ],
     "default": 0.0,
     "description": "Layer diffuse reflectance of the sky member (zrefd; dump columns zrefdc/zrefdo of cam_rad_spcvmc.csv, member 2 the McICA blend)."
    },
    "ptra": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k",
      "sky"
     ],
     "default": 0.0,
     "description": "Layer direct transmittance of the sky member (ztra; dump columns ztrac/ztrao of cam_rad_spcvmc.csv, member 2 the McICA blend)."
    },
    "ptrad": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k",
      "sky"
     ],
     "default": 0.0,
     "description": "Layer diffuse transmittance of the sky member (ztrad; dump columns ztradc/ztrado of cam_rad_spcvmc.csv, member 2 the McICA blend)."
    },
    "pdbt": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k",
      "sky"
     ],
     "default": 0.0,
     "description": "Layer mean direct-beam transmittance of the sky member (the CamRrtmgSwDirectBeam output zdbt; dump columns zdbtc/zdbt of cam_rad_spcvmc.csv)."
    },
    "ptdbt": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc",
      "sky"
     ],
     "default": 0.0,
     "description": "Cumulative interface direct-beam transmittance of the sky member (the CamRrtmgSwDirectBeam output ztdbt; dump columns ztdbtc/ztdbt of cam_rad_spcvmc_ifc.csv)."
    },
    "aldir": {
     "type": "parameter",
     "units": "1",
     "default": 0.39254839788667734,
     "description": "Direct-beam near-IR surface albedo (dump column aldir, step 37; rrtmg_sw_rad.f90:452)."
    },
    "asdir": {
     "type": "parameter",
     "units": "1",
     "default": 0.39254839788667734,
     "description": "Direct-beam UV/visible surface albedo (dump column asdir, step 37)."
    },
    "aldif": {
     "type": "parameter",
     "units": "1",
     "default": 0.06,
     "description": "Diffuse near-IR surface albedo (dump column aldif, step 37)."
    },
    "asdif": {
     "type": "parameter",
     "units": "1",
     "default": 0.06,
     "description": "Diffuse UV/visible surface albedo (dump column asdif, step 37)."
    },
    "band_of_gpt": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gpt"
     ],
     "default": [1, 2, 2, 6],
     "description": "The RRTMG shortwave band -> g-point map sliced to the pinned g-points (rrtmg_sw_init.f90:266-280): members 1..4 = RRTMG g-points 1, 9, 13, 47 in bands 1, 2, 2, 6."
    },
    "albdir": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "band"
     ],
     "description": "Direct-beam surface albedo per band (rrtmg_sw_rad.f90:452-470): bands 1-8 and 14 the near-IR aldir, band 9 the mean of the near-IR and UV/visible albedos, bands 10-13 the UV/visible asdir."
    },
    "albdif": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "band"
     ],
     "description": "Diffuse surface albedo per band (the aldif/asdif analogues of rrtmg_sw_rad.f90:452-470)."
    },
    "palbp_g": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt"
     ],
     "description": "Direct-beam surface albedo gathered per g-point, palbp = albdir(band_of_gpt(g)) (the klev+1 boundary of the first vrtqdr_sw input)."
    },
    "palbd_g": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt"
     ],
     "description": "Diffuse surface albedo gathered per g-point, palbd = albdif(band_of_gpt(g))."
    },
    "prupd": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "kb",
      "sky"
     ],
     "description": "Bottom-up diffuse reflectance chain prupd(j) = prefd(NK+2-j) + ptrad(NK+2-j)^2*prupd(j-1)*zreflect with prupd(1) = palbd (vrtqdr_sw.f90:98-107, 116; j = 1 at the surface)."
    },
    "prup": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "kb",
      "sky"
     ],
     "description": "Bottom-up direct reflectance chain prup(j) = pref(NK+2-j) + ptrad(NK+2-j)*((ptra(NK+2-j) - pdbt(NK+2-j))*prupd(j-1) + pdbt(NK+2-j)*prup(j-1))*zreflect with prup(1) = palbp (vrtqdr_sw.f90:100-105, 113)."
    },
    "prdnd": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc",
      "sky"
     ],
     "description": "Top-down diffuse reflectance chain prdnd(k) = prefd(k-1) + ptrad(k-1)^2*prdnd(k-1)*zreflect with prdnd(1) = 0 and prdnd(2) = prefd(1) (vrtqdr_sw.f90:163-181)."
    },
    "ztdn": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc",
      "sky"
     ],
     "description": "Top-down direct transmittance chain ztdn(k) = ptdbt(k-1)*ptra(k-1) + ptrad(k-1)*((ztdn(k-1) - ptdbt(k-1)) + ptdbt(k-1)*pref(k-1)*prdnd(k-1))*zreflect with ztdn(1) = 1 and ztdn(2) = ptra(1) (vrtqdr_sw.f90:164-177)."
    },
    "pfu": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc",
      "sky"
     ],
     "description": "Upwelling interface flux pfu(k) = (ptdbt(k)*prup(NK+2-k) + (ztdn(k) - ptdbt(k))*prupd(NK+2-k))*zreflect, zreflect = 1/(1 - prdnd(k)*prupd(NK+2-k)) (vrtqdr_sw.f90:200-203)."
    },
    "pfd": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc",
      "sky"
     ],
     "description": "Downwelling interface flux pfd(k) = ptdbt(k) + (ztdn(k) - ptdbt(k) + ptdbt(k)*prup(NK+2-k)*prdnd(k))*zreflect (vrtqdr_sw.f90:204)."
    },
    "pfu_tot": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc"
     ],
     "description": "Upwelling interface flux of the total-sky vrtqdr_sw call (member 2 projection, zfu of spcvmc.f90:598-602)."
    },
    "pfd_tot": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc"
     ],
     "description": "Downwelling interface flux of the total-sky vrtqdr_sw call (zfd)."
    },
    "pfu_clr": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc"
     ],
     "description": "Upwelling interface flux of the clear-sky vrtqdr_sw call (member 1 projection, zcu of spcvmc.f90:594-597)."
    },
    "pfd_clr": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpt",
      "k_ifc"
     ],
     "description": "Downwelling interface flux of the clear-sky vrtqdr_sw call (zcd)."
    }
