   "expression_templates": {
    "pifm_gamma1": {
     "description": "Meador-Weaver / PIFM coefficient gamma1 = (8 - ssa*(5 + 3*asm))/4 of the two-stream layer solution (reftra_sw, kmodts = 2, rrtmg_sw_reftra.f90:132-133).",
     "params": [
      "ssa",
      "asm"
     ],
     "body": {
      "op": "*",
      "args": [
       {
        "op": "-",
        "args": [
         8.0,
         {
          "op": "*",
          "args": [
           "ssa",
           {
            "op": "+",
            "args": [
             5.0,
             {
              "op": "*",
              "args": [
               3.0,
               "asm"
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       0.25
      ]
     }
    },
    "pifm_gamma2": {
     "description": "Meador-Weaver / PIFM coefficient gamma2 = 3*ssa*(1 - asm)/4 (rrtmg_sw_reftra.f90:134-135).",
     "params": [
      "ssa",
      "asm"
     ],
     "body": {
      "op": "*",
      "args": [
       3.0,
       {
        "op": "*",
        "args": [
         "ssa",
         {
          "op": "-",
          "args": [
           1.0,
           "asm"
          ]
         }
        ]
       },
       0.25
      ]
     }
    },
    "pifm_gamma3": {
     "description": "Meador-Weaver / PIFM coefficient gamma3 = (2 - 3*asm*muz)/4 (rrtmg_sw_reftra.f90:136-137).",
     "params": [
      "asm",
      "muz"
     ],
     "body": {
      "op": "*",
      "args": [
       {
        "op": "-",
        "args": [
         2.0,
         {
          "op": "*",
          "args": [
           3.0,
           "asm",
           "muz"
          ]
         }
        ]
       },
       0.25
      ]
     }
    },
    "pifm_zwo": {
     "description": "Conservative-branch selector zwo = ssa*(1 - 2*asm + asm^2)/(1 - 2*asm + asm^2*ssa) (rrtmg_sw_reftra.f90:147-150): the branch with zwo >= zwcrit = 0.9999995 takes the conservative (non-absorbing) solution.",
     "params": [
      "ssa",
      "asm"
     ],
     "body": {
      "op": "/",
      "args": [
       {
        "op": "*",
        "args": [
         "ssa",
         {
          "op": "+",
          "args": [
           {
            "op": "-",
            "args": [
             1.0,
             {
              "op": "*",
              "args": [
               2.0,
               "asm"
              ]
             }
            ]
           },
           {
            "op": "*",
            "args": [
             "asm",
             "asm"
            ]
           }
          ]
         }
        ]
       },
       {
        "op": "+",
        "args": [
         {
          "op": "-",
          "args": [
           1.0,
           {
            "op": "*",
            "args": [
             2.0,
             "asm"
            ]
           }
          ]
         },
         {
          "op": "*",
          "args": [
           "asm",
           "asm",
           "ssa"
          ]
         }
        ]
       }
      ]
     }
    },
    "pifm_exp_clamped": {
     "description": "Exponential optical term exp(-min(x, 500)) with the ze1 clamp of rrtmg_sw_reftra.f90:151 (ze1 = min(tau/muz, 500); the non-conservative branch's zep1/zep2 are the reciprocals, zem1/zem2 its values: zep1 = 1/pifm_exp_clamped(zrk*tau), zem1 = pifm_exp_clamped(zrk*tau), zep2 = 1/pifm_exp_clamped(tau/muz), zem2 = pifm_exp_clamped(tau/muz)).",
     "params": [
      "x"
     ],
     "body": {
      "op": "exp",
      "args": [
       {
        "op": "-",
        "args": [
         {
          "op": "min",
          "args": [
           "x",
           500.0
          ]
         }
        ]
       }
      ]
     }
    },
    "reftra_sky_member": {
     "description": "Sky-member selection of the reftra layer solve (rrtmg_sw_spcvmc.f90:544-560): member 1 always, and member 1 again in place of member 2 at clear cells cld <= repclc = 1e-12 (rrtmg_sw_spcvmc.f90:276, 414; the two reftra_sw calls of spcvmc collapse to the cld_sto-blended total member).",
     "params": [
