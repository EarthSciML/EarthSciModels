  "CamRrtmgSwAdding": {
   "expression_templates": {
    "pifm_zreflect": {
     "description": "The zreflect = 1/(1 - a*b) factor of the adding method (vrtqdr_sw, rrtmg_sw_vrtqdr.f90:105, 179, 200): the infinite-series sum of the up/down diffuse reflections between two stacked reflectances. Shared by the bottom-up (prupd/prup), top-down (prdnd/ztdn) and interface-flux (pfu/pfd) recurrences.",
     "params": [
      "a",
      "b"
     ],
     "body": {
      "op": "/",
      "args": [
       1.0,
       {
        "op": "-",
        "args": [
         1.0,
         {
          "op": "*",
          "args": [
           "a",
           "b"
          ]
         }
        ]
       }
      ]
     }
    },
    "sky_member": {
     "description": "Projection of the sky member sky_index out of a g-point x interface x sky array x: out[g, k] = x[g, k, sky_index], the single-member faq range that binds the clear/total sky axis of the two vrtqdr_sw calls back to the esd flux columns.",
     "params": [
      "x",
      "sky_index"
     ],
     "body": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "g",
       "k"
      ],
      "ranges": {
       "g": {
        "from": "gpt"
       },
       "k": {
        "from": "k_ifc"
       },
       "sky": [
        "sky_index",
        "sky_index"
       ]
      },
      "expr": {
       "op": "index",
       "args": [
        "x",
        "g",
        "k",
        "sky"
       ]
      }
     }
    },
    "vrtqdr_pfd_step": {
     "description": "Downwelling interface flux step pfd(k) = ptdbt_k + (ztdn_k - ptdbt_k + ptdbt_k*prup_r*prdnd_k)*zreflect (vrtqdr_sw.f90:204).",
     "params": [
      "ptdbt_k",
      "prup_r",
      "ztdn_k",
      "prupd_r",
      "prdnd_k"
     ],
     "body": {
      "op": "+",
      "args": [
       "ptdbt_k",
       {
        "op": "*",
        "args": [
         {
          "op": "+",
          "args": [
           {
            "op": "-",
            "args": [
             "ztdn_k",
             "ptdbt_k"
            ]
           },
           {
            "op": "*",
            "args": [
             "ptdbt_k",
             "prup_r",
             "prdnd_k"
            ]
           }
          ]
         },
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "pifm_zreflect",
          "bindings": {
           "a": "prdnd_k",
           "b": "prupd_r"
          }
         }
        ]
       }
      ]
     }
    }
   ,
    "vrtqdr_pfu_step": {
     "description": "Upwelling interface flux step pfu(k) = (ptdbt_k*prup_r + (ztdn_k - ptdbt_k)*prupd_r)*zreflect with zreflect = 1/(1 - prdnd_k*prupd_r) (vrtqdr_sw.f90:200-203; the r-suffix values are the bottom-up chains read at the reversed index NK+2-k).",
     "params": [
      "ptdbt_k",
      "prup_r",
      "ztdn_k",
      "prupd_r",
      "prdnd_k"
     ],
     "body": {
      "op": "*",
      "args": [
       {
        "op": "+",
        "args": [
         {
          "op": "*",
          "args": [
           "ptdbt_k",
           "prup_r"
          ]
         },
         {
          "op": "*",
          "args": [
           {
            "op": "-",
            "args": [
             "ztdn_k",
             "ptdbt_k"
            ]
           },
           "prupd_r"
          ]
         }
        ]
       },
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "pifm_zreflect",
        "bindings": {
         "a": "prdnd_k",
         "b": "prupd_r"
        }
       }
      ]
     }
    }
   ,
    "vrtqdr_ztdn_step": {
     "description": "One top-down direct-transmittance step ztdn(k) = ptdbt_km1*ptra_km1 + ptrad_km1*((ztdn_km1 - ptdbt_km1) + ptdbt_km1*pref_km1*prdnd_km1)*zreflect (vrtqdr_sw.f90:164-177).",
     "params": [
      "ptdbt_km1",
      "ptra_km1",
      "ptrad_km1",
      "ztdn_km1",
      "pref_km1",
      "prdnd_km1",
      "prefd_km1"
     ],
     "body": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         "ptdbt_km1",
         "ptra_km1"
        ]
       },
       {
        "op": "*",
        "args": [
         "ptrad_km1",
         {
          "op": "+",
          "args": [
           {
            "op": "-",
            "args": [
             "ztdn_km1",
             "ptdbt_km1"
            ]
           },
           {
            "op": "*",
            "args": [
             "ptdbt_km1",
             "pref_km1",
             "prdnd_km1"
            ]
           }
          ]
         },
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "pifm_zreflect",
          "bindings": {
           "a": "prdnd_km1",
           "b": "prefd_km1"
          }
         }
        ]
       }
      ]
     }
    }
   ,
    "vrtqdr_prup_step": {
     "description": "One bottom-up direct-reflectance step prup(j) = pref_j + ptrad_j*((ptra_j - pdbt_j)*prupd_jm1 + pdbt_j*prup_jm1)*zreflect (vrtqdr_sw.f90:100-105).",
     "params": [
      "pref_j",
      "ptrad_j",
      "ptra_j",
      "pdbt_j",
      "prupd_jm1",
      "prup_jm1",
      "prefd_j"
     ],
     "body": {
      "op": "+",
      "args": [
       "pref_j",
       {
        "op": "*",
        "args": [
         "ptrad_j",
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             {
              "op": "-",
              "args": [
               "ptra_j",
               "pdbt_j"
              ]
             },
             "prupd_jm1"
            ]
           },
           {
            "op": "*",
            "args": [
             "pdbt_j",
             "prup_jm1"
            ]
           }
          ]
         },
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "pifm_zreflect",
          "bindings": {
           "a": "prupd_jm1",
           "b": "prefd_j"
          }
         }
        ]
       }
      ]
     }
    }
   ,
    "vrtqdr_reflect_step": {
     "description": "One diffuse-reflectance accumulation step of the adding method, shared by the bottom-up prupd and top-down prdnd chains: reflect = prefd_x + ptrad_x^2*refl_prev*zreflect with zreflect = 1/(1 - refl_prev*prefd_x) (vrtqdr_sw.f90:106-107 prupd, 178-181 prdnd).",
     "params": [
      "prefd_x",
      "ptrad_x",
      "refl_prev"
     ],
     "body": {
      "op": "+",
      "args": [
       "prefd_x",
       {
        "op": "*",
        "args": [
         {
          "op": "^",
          "args": [
           "ptrad_x",
           2
          ]
         },
         "refl_prev",
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "pifm_zreflect",
          "bindings": {
           "a": "refl_prev",
           "b": "prefd_x"
          }
         }
        ]
       }
      ]
     }
    }
   
   },
   "variables": {
    "pref": {
