      "tests": [
        {
          "id": "wesely_vd_call3_gas2",
          "description": "Reference: the WRF-Chem 4.8 em_scm_xy run (chem_opt = 101 RADM2 KPP) with gas_drydep_opt = 1 (data/eqwefic/chem_scm_dep; the chem_scm reference has it OFF and yields no dry-deposition truth at all). GNU gfortran 13.3 REAL*4 build; dumped by the ctessum-claude/WRF fork, branch earthsciml-instrumented-chem, in wesely_driver after landusevg at call 3 (ustar 0.5892 m/s, rmol -0.01188 1/m, z0 0.050 m, first layer 51.20 m). Gas slot 2; Rc is taken from the same dump so this test isolates the Ra/Rb/cellvg chain. Expected value is ddvel0d, the CELL-AVERAGED velocity WRF hands the vertical-diffusion solver. Gas slot 3 (sulf) is excluded: it takes the particle path through deppart, which this component does not implement. Single-precision reference, rel 1e-5.",
          "parameter_overrides": {
            "ustar": 0.5892362594604492,
            "rmol_in": -0.011878129094839096,
            "z0": 0.05000000074505806,
            "dz1": 51.202232360839844,
            "igas": 2.0,
            "srfres": 2401.579833984375
          },
          "time_span": {
            "start": 0,
            "end": 1
          },
          "tolerance": {
            "rel": 1e-05
          },
          "assertions": [
            {
              "variable": "vd",
              "time": 0.0,
              "expected": 0.00041173817589879036,
              "tolerance": {
                "rel": 1e-05,
                "abs": 1e-30
              }
            }
          ]
        },
        {
          "id": "wesely_vd_call3_gas4",
          "description": "Reference: the WRF-Chem 4.8 em_scm_xy run (chem_opt = 101 RADM2 KPP) with gas_drydep_opt = 1 (data/eqwefic/chem_scm_dep; the chem_scm reference has it OFF and yields no dry-deposition truth at all). GNU gfortran 13.3 REAL*4 build; dumped by the ctessum-claude/WRF fork, branch earthsciml-instrumented-chem, in wesely_driver after landusevg at call 3 (ustar 0.5892 m/s, rmol -0.01188 1/m, z0 0.050 m, first layer 51.20 m). Gas slot 4; Rc is taken from the same dump so this test isolates the Ra/Rb/cellvg chain. Expected value is ddvel0d, the CELL-AVERAGED velocity WRF hands the vertical-diffusion solver. Gas slot 3 (sulf) is excluded: it takes the particle path through deppart, which this component does not implement. Single-precision reference, rel 1e-5.",
          "parameter_overrides": {
            "ustar": 0.5892362594604492,
            "rmol_in": -0.011878129094839096,
            "z0": 0.05000000074505806,
            "dz1": 51.202232360839844,
            "igas": 4.0,
            "srfres": 1183.732177734375
          },
          "time_span": {
            "start": 0,
            "end": 1
          },
          "tolerance": {
            "rel": 1e-05
          },
          "assertions": [
            {
              "variable": "vd",
              "time": 0.0,
              "expected": 0.0008266522781923413,
              "tolerance": {
                "rel": 1e-05,
                "abs": 1e-30
              }
            }
          ]
        },
