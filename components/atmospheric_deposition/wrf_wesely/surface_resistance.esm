          "description": "Six-class land-use index for this category."
        },
        "hstar": {
          "type": "unknown",
          "units": "M/atm",
          "description": "Effective Henry's law constant at 298 K for this gas.",
          "shape": [
            "spc"
          ]
        },
        "f0": {
          "type": "unknown",
          "units": "1",
