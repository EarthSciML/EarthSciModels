          "units": "s/m",
          "description": "Lower-canopy resistance for SO2."
        },
        "r_clo": {
          "type": "unknown",
          "units": "s/m",
          "description": "Lower-canopy resistance for O3."
        },
        "ixxxlu": {
          "type": "unknown",
