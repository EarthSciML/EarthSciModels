          "type": "unknown",
          "units": "s/m",
          "description": "The three-term SO2 combination: stomatal and cuticle in parallel with the SERIES chain rcls + rdc + rgsx. Note there is no rac term at all, unlike every other path."
        },
        "rc_so2": {
          "type": "unknown",
          "units": "s/m",
          "description": "Surface resistance of SO2, Erisman et al. (1994). Over snow, bare/urban soil, water or ice it collapses to the ground resistance alone."
        },
        "rsmx_nh3": {
          "type": "unknown",
          "units": "s/m",
          "description": "Stomatal resistance of NH3, again with no mesophyll term."
        },
        "is_winter": {
          "type": "unknown",
          "units": "1",
          "description": "1 for seasonal categories 2, 3 and 5, which the NH3 branch treats together as 'winter, no snow'."
        },
        "nh3_cold": {
          "type": "unknown",
          "units": "s/m",
          "description": "NH3 resistance below -1 C in the winter branches."
        },
        "nh3_grass": {
          "type": "unknown",
          "units": "s/m",
          "description": "NH3 over grassland. Per species only because its fall-through branch is the species' own general-path rc_general; rc reads it at the species whose igas is NH3, where that is NH3's.",
          "shape": [
            "spc"
          ]
        },
        "nh3_agri": {
          "type": "unknown",
          "units": "s/m",
          "description": "NH3 over agricultural land. Per species only because its fall-through branch is the species' own general-path rc_general; rc reads it at the species whose igas is NH3, where that is NH3's.",
          "shape": [
            "spc"
          ]
        },
        "nh3_forest": {
          "type": "unknown",
          "units": "s/m",
          "description": "NH3 over forest and semi-natural ecosystems."
        },
        "nh3_urban": {
          "type": "unknown",
          "units": "s/m",
          "description": "NH3 over urban and desert soils."
        },
        "nh3_class": {
          "type": "unknown",
          "units": "s/m",
          "description": "NH3 resistance selected by the six-class land-use index. Per species only because its fall-through branch is the species' own general-path rc_general; rc reads it at the species whose igas is NH3, where that is NH3's.",
          "shape": [
            "spc"
          ]
        },
        "nh3_snow": {
          "type": "unknown",
          "units": "s/m",
          "description": "NH3 snow/ice ramp."
        },
        "rc_nh3": {
          "type": "unknown",
          "units": "s/m",
          "description": "Surface resistance of NH3, Erisman et al. (1994). It bypasses H* and f0 entirely. Per species only because its fall-through branch is the species' own general-path rc_general; rc reads it at the species whose igas is NH3, where that is NH3's.",
          "shape": [
            "spc"
          ]
        },
        "rc": {
          "type": "unknown",
          "units": "s/m",
          "description": "Surface resistance of this gas, rcx(igas) as rc() returns it.",
          "shape": [
            "spc"
          ]
        },
        "srfres": {
          "type": "unknown",
          "units": "s/m",
          "description": "Rc as wesely_driver passes it on: rcx, except that the last two gas slots (HO and HO2 for RADM2) are set to ZERO, so those two deposit at the aerodynamic limit 1/(Ra+Rb).",
          "shape": [
            "spc"
          ]
        },
        "n_gas": {
          "type": "parameter",
          "units": "1",
          "default": 44.0,
          "description": "Number of gas slots, WRF's numgas (44 for chem_opt = 101). wesely_driver zeroes Rc for the LAST TWO slots, so this is what selects HO and HO2."
        }
      },
      "equations": [
        {
          "lhs": "r_i",
          "rhs": {
            "op": "index",
            "args": [
              "dat.ri_table",
              "iland",
              "iseason"
            ]
          }
        },
        {
          "lhs": "r_lu",
          "rhs": {
            "op": "index",
            "args": [
              "dat.rlu_table",
              "iland",
              "iseason"
            ]
          }
        },
        {
          "lhs": "r_ac",
          "rhs": {
            "op": "index",
            "args": [
              "dat.rac_table",
              "iland",
              "iseason"
            ]
          }
        },
        {
          "lhs": "r_gss",
          "rhs": {
            "op": "index",
            "args": [
              "dat.rgss_table",
              "iland",
              "iseason"
            ]
          }
        },
        {
          "lhs": "r_gso",
          "rhs": {
            "op": "index",
            "args": [
              "dat.rgso_table",
              "iland",
              "iseason"
            ]
          }
        },
        {
          "lhs": "r_cls",
          "rhs": {
            "op": "index",
            "args": [
              "dat.rcls_table",
              "iland",
              "iseason"
            ]
          }
        },
        {
          "lhs": "r_clo",
          "rhs": {
            "op": "index",
            "args": [
              "dat.rclo_table",
              "iland",
              "iseason"
            ]
          }
        },
        {
          "lhs": "ixxxlu",
          "rhs": {
            "op": "index",
            "args": [
              "dat.ixxxlu_table",
              "iland"
            ]
          }
        },
        {
          "lhs": "hstar",
          "rhs": {
            "op": "faq",
            "output_idx": [
              "s"
            ],
            "args": [],
            "ranges": {
              "s": {
                "from": "spc"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "dat.hstar_table",
                {
                  "op": "index",
                  "args": [
                    "igas",
                    "s"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "f0",
          "rhs": {
            "op": "faq",
            "output_idx": [
              "s"
            ],
            "args": [],
            "ranges": {
              "s": {
                "from": "spc"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "dat.f0_table",
                {
                  "op": "index",
                  "args": [
                    "igas",
                    "s"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "dhr",
          "rhs": {
            "op": "faq",
            "output_idx": [
              "s"
            ],
            "args": [],
            "ranges": {
              "s": {
                "from": "spc"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "dat.dhr_table",
                {
                  "op": "index",
                  "args": [
                    "igas",
                    "s"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "dratio",
          "rhs": {
            "op": "faq",
            "output_idx": [
              "s"
            ],
            "args": [],
            "ranges": {
              "s": {
                "from": "spc"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "dat.dratio_table",
                {
                  "op": "index",
                  "args": [
                    "igas",
                    "s"
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "tc",
          "rhs": {
            "op": "-",
            "args": [
              "T",
              "par.t_celsius"
            ]
          }
        },
        {
          "lhs": "z_rad",
          "rhs": {
            "op": "/",
            "args": [
              "par.rs_rad_num",
              {
                "op": "+",
                "args": [
                  "rad",
                  "par.rs_rad_eps"
                ]
              }
            ]
          }
        },
        {
          "lhs": "rs_open",
          "rhs": {
            "op": "*",
            "args": [
              "r_i",
              {
                "op": "+",
                "args": [
                  1,
                  {
                    "op": "^",
                    "args": [
                      "z_rad",
                      2
                    ]
                  }
                ]
              },
              {
                "op": "/",
                "args": [
                  "par.rs_t_num",
                  {
                    "op": "max",
                    "args": [
                      "par.rc_eps",
                      {
                        "op": "*",
                        "args": [
                          "tc",
                          {
                            "op": "-",
                            "args": [
                              "par.rs_t_hi",
                              "tc"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": "rs",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "<=",
                "args": [
                  "tc",
                  0
                ]
              },
              "par.r_big",
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": ">=",
                    "args": [
                      "tc",
                      "par.rs_t_hi"
                    ]
                  },
                  "par.r_big",
                  "rs_open"
                ]
              }
            ]
          }
        },
        {
          "lhs": "rdc",
          "rhs": {
            "op": "*",
            "args": [
              "par.rdc_a",
              {
                "op": "+",
                "args": [
                  1,
                  {
                    "op": "/",
                    "args": [
                      "par.rdc_b",
                      {
                        "op": "+",
                        "args": [
                          "rad",
                          "par.rdc_c"
                        ]
                      }
                    ]
