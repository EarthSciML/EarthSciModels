{
    "esm": "1.2.0",
    "metadata": {
        "name": "wesely1989_resistance_templates",
        "description": "Wesely (1989) surface-resistance terms shared by WesleySurfaceResistance (surface_resistance.esm) and DryDepositionGas (../wesley_dry_gas.esm), as pure expression templates so the two models hold one definition of each. Wesely writes these terms with temperature as a number of degrees Celsius and irradiation as a number of W/m^2. Here every temperature is divided by a 1 degC constant (only the scale of degC is used, not its offset, so the number is the temperature in degrees Celsius) and every dimensional coefficient carries its unit on a const (esm-spec 4.8.5), so each template is dimensionally consistent and the units checker can verify every call. The numbers are those of the source.",
        "license": "MIT",
        "tags": [
            "atmospheric_deposition",
            "dry-deposition",
            "wesley-1989",
            "surface-resistance",
            "expression-templates"
        ],
        "references": [
            {
                "citation": "Wesely, M. L. (1989). Parameterization of surface resistances to gaseous dry deposition in regional-scale numerical models. Atmospheric Environment 23(6), 1293-1304. doi:10.1016/0004-6981(89)90153-4"
            }
        ]
    },
    "expression_templates": {
        "wesely_cold_correction": {
            "params": [
                "T_c"
            ],
            "description": "Cold-surface additive correction [s/m] to the leaf-cuticle, lower-canopy and ground resistances (Wesely 1989, p. 1296): 1000 s/m * exp(-T_c/(1 degC) - 4) when T_c < 0 degC, else 0. T_c is the surface air temperature in degC.",
            "body": {
                "op": "ifelse",
                "args": [
                    {
                        "op": "<",
                        "args": [
                            "T_c",
                            0.0
                        ]
                    },
                    {
                        "op": "*",
                        "args": [
                            {
                                "op": "const",
                                "args": [],
                                "value": 1000.0,
                                "units": "s/m"
                            },
                            {
                                "op": "exp",
                                "args": [
                                    {
                                        "op": "-",
                                        "args": [
                                            {
                                                "op": "-",
                                                "args": [
                                                    {
                                                        "op": "/",
                                                        "args": [
                                                            "T_c",
                                                            {
                                                                "op": "const",
                                                                "args": [],
                                                                "value": 1.0,
                                                                "units": "degC"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            4
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    0.0
                ]
            }
        },
        "wesely_stomatal_resistance": {
            "params": [
                "r_i",
                "G",
                "T_c"
            ],
            "description": "Bulk-canopy stomatal resistance [s/m] (Wesely 1989 Eq. 3): r_i * (1 + (200 W/m^2 / (G + 1 W/m^2))^2) * 400 / (T (40 - T)) with T = T_c/(1 degC), the surface air temperature as a number of degrees Celsius; set to 1e25 s/m (stomata closed) when T <= 0.1. r_i is the minimum stomatal resistance [s/m] and G the solar irradiation [W/m^2]. Any wet-surface multiplier is applied by the caller.",
            "body": {
                "op": "ifelse",
                "args": [
                    {
                        "op": "<=",
                        "args": [
                            {
                                "op": "/",
                                "args": [
                                    "T_c",
                                    {
                                        "op": "const",
                                        "args": [],
                                        "value": 1.0,
                                        "units": "degC"
                                    }
                                ]
                            },
                            0.1
                        ]
                    },
                    {
                        "op": "const",
                        "args": [],
                        "value": 1e+25,
                        "units": "s/m"
                    },
                    {
                        "op": "*",
                        "args": [
                            "r_i",
                            {
                                "op": "+",
                                "args": [
                                    1,
                                    {
                                        "op": "^",
                                        "args": [
                                            {
                                                "op": "/",
                                                "args": [
                                                    {
                                                        "op": "const",
                                                        "args": [],
                                                        "value": 200.0,
                                                        "units": "W/m^2"
                                                    },
                                                    {
                                                        "op": "+",
                                                        "args": [
                                                            "G",
                                                            {
                                                                "op": "const",
                                                                "args": [],
                                                                "value": 1.0,
                                                                "units": "W/m^2"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            2
                                        ]
                                    }
                                ]
                            },
                            {
                                "op": "/",
                                "args": [
                                    400.0,
                                    {
                                        "op": "*",
                                        "args": [
                                            {
                                                "op": "/",
                                                "args": [
                                                    "T_c",
                                                    {
                                                        "op": "const",
                                                        "args": [],
                                                        "value": 1.0,
                                                        "units": "degC"
                                                    }
                                                ]
                                            },
                                            {
                                                "op": "-",
                                                "args": [
                                                    40.0,
                                                    {
                                                        "op": "/",
                                                        "args": [
                                                            "T_c",
                                                            {
                                                                "op": "const",
                                                                "args": [],
                                                                "value": 1.0,
                                                                "units": "degC"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    }
}