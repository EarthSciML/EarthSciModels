  "esat": {
   "description": "Saturation vapor pressure datm_eSat(tK, tKbot) (datm_datamode_clmncep_mod.F90:545-586): t = clamp(tK - tkfrz, -50, 50) degrees C; over ice when tKbot < tkfrz else over water (the phase test is on the unclamped bottom temperature, F90:581-585); result x100 converts the hPa polynomials to Pa. Used for the qsat and tdew paths of Sa_shum (F90:408-425) and by the lwdn fallback.",
   "params": [
    "tK",
    "tKbot"
   ],
   "body": {
    "op": "ifelse",
    "args": [
     {
      "op": "<",
      "args": [
       "tKbot",
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "tkfrz",
        "bindings": {}
       }
      ]
     },
     {
      "op": "*",
      "args": [
       {
        "op": "const",
        "args": [],
        "value": 100.0,
        "units": "1"
       },
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "esat_poly_ice",
        "bindings": {
         "t": {
          "op": "min",
          "args": [
           {
            "op": "const",
            "args": [],
            "value": 50.0,
            "units": "degC"
           },
           {
            "op": "max",
            "args": [
             {
              "op": "const",
              "args": [],
              "value": -50.0,
              "units": "degC"
             },
             {
              "op": "-",
              "args": [
               "tK",
               {
                "op": "apply_expression_template",
                "args": [],
                "name": "tkfrz",
                "bindings": {}
               }
              ]
             }
            ]
           }
          ]
         }
        }
       }
      ]
     },
     {
      "op": "*",
      "args": [
       {
        "op": "const",
        "args": [],
        "value": 100.0,
        "units": "1"
       },
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "esat_poly_water",
        "bindings": {
         "t": {
          "op": "min",
          "args": [
           {
            "op": "const",
            "args": [],
            "value": 50.0,
            "units": "degC"
           },
           {
            "op": "max",
            "args": [
             {
              "op": "const",
              "args": [],
              "value": -50.0,
              "units": "degC"
             },
             {
              "op": "-",
              "args": [
               "tK",
               {
                "op": "apply_expression_template",
                "args": [],
                "name": "tkfrz",
                "bindings": {}
               }
              ]
             }
            ]
           }
          ]
         }
        }
       }
      ]
     }
    ]
   }
  },
  "qsat": {
   "description": "Saturation specific humidity qsat = eps e / (pbot - eps1 e) with eps = 0.622 and eps1 = 1 - eps = 0.378 (datm_datamode_clmncep_mod.F90:410, 415, 422), e in Pa (from esat), pbot in Pa. Sa_shum = min(qsat, stream shum) on the shum path (F90:411-417).",
   "params": [
    "e",
    "pbot"
   ],
   "body": {
    "op": "/",
    "args": [
     {
      "op": "*",
      "args": [
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "eps",
        "bindings": {}
       },
       "e"
      ]
     },
     {
      "op": "-",
      "args": [
       "pbot",
       {
        "op": "*",
        "args": [
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "eps1",
          "bindings": {}
         },
         "e"
        ]
       }
      ]
     }
    ]
   }
  },
  "vapor_pressure": {
   "description": "Vapor pressure vp = q pbot / (eps + eps1 q) with eps = 0.622 and eps1 = 1 - eps = 0.378 (datm_datamode_clmncep_mod.F90:428), q = specific humidity [kg/kg], pbot [Pa], vp [Pa]. Intermediate of Sa_dens.",
   "params": [
    "q",
    "pbot"
   ],
   "body": {
    "op": "/",
    "args": [
     {
      "op": "*",
      "args": [
       "q",
       "pbot"
      ]
     },
     {
      "op": "+",
      "args": [
       {
        "op": "apply_expression_template",
        "args": [],
        "name": "eps",
        "bindings": {}
       },
       {
        "op": "*",
        "args": [
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "eps1",
          "bindings": {}
         },
         "q"
        ]
       }
      ]
     }
    ]
   }
  },
  "density": {
   "description": "Air density Sa_dens = (pbot - eps1 vp) / (tbot RDAIR) with eps1 = 1 - eps = 0.378 (datm_datamode_clmncep_mod.F90:429) with RDAIR = 287.0423113650487 J/kg/K = SHR_CONST_AVOGAD*SHR_CONST_BOLTZ/SHR_CONST_MWDAIR (share/shr_const_mod.F90:23-29), tbot [K], pbot and vp [Pa], density [kg/m3].",
   "params": [
    "pbot",
    "vp",
    "tbot"
   ],
   "body": {
    "op": "/",
    "args": [
     {
      "op": "-",
      "args": [
       "pbot",
       {
        "op": "*",
        "args": [
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "eps1",
          "bindings": {}
         },
         "vp"
        ]
       }
      ]
     },
     {
      "op": "*",
      "args": [
       "tbot",
       {
        "op": "const",
        "args": [],
        "value": 287.0423113650487,
        "units": "J/(kg*K)"
       }
      ]
     }
    ]
   }
  },
  "ratio_rvrf_nir": {
   "description": "Near-infrared direct/diffuse ratio ratio_rvrf of datm_datamode_clmncep_mod.F90:450-451: min(0.99, max(0.29548 + 0.00504 s - 1.4957e-5 s^2 + 1.4881e-8 s^3, 0.01)) with s = swndr = 0.5 swdn (F90:447-448). The cam3_5_55-derived polynomial gives the fraction of the NIR half of the incoming shortwave that is direct; the diffuse half is (1 - ratio_rvrf).",
   "params": [
    "s"
   ],
   "body": {
    "op": "min",
    "args": [
     {
      "op": "const",
      "args": [],
      "value": 0.99,
      "units": "1"
     },
     {
      "op": "max",
      "args": [
       {
        "op": "const",
        "args": [],
        "value": 0.01,
        "units": "1"
       },
       {
        "op": "+",
        "args": [
         {
          "op": "const",
          "args": [],
          "value": 0.29548,
          "units": "1"
         },
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             {
              "op": "const",
              "args": [],
              "value": 0.00504,
              "units": "m^2/W"
             },
             "s"
            ]
           },
           {
            "op": "+",
            "args": [
             {
              "op": "*",
              "args": [
               {
                "op": "const",
                "args": [],
                "value": -1.4957e-05,
                "units": "m^4/W^2"
               },
               {
                "op": "^",
                "args": [
                 "s",
                 2
                ]
               }
              ]
             },
             {
              "op": "*",
              "args": [
               {
                "op": "const",
                "args": [],
                "value": 1.4881e-08,
                "units": "m^6/W^3"
               },
               {
                "op": "^",
                "args": [
                 "s",
                 3
                ]
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  },
  "ratio_rvrf_vis": {
   "description": "Visible direct/diffuse ratio ratio_rvrf of datm_datamode_clmncep_mod.F90:455-456: min(0.99, max(0.17639 + 0.00380 s - 9.0039e-6 s^2 + 8.1351e-9 s^3, 0.01)) with s = swvdr = 0.5 swdn (F90:453-454).",
   "params": [
    "s"
   ],
   "body": {
    "op": "min",
    "args": [
     {
      "op": "const",
      "args": [],
      "value": 0.99,
      "units": "1"
     },
     {
      "op": "max",
      "args": [
       {
        "op": "const",
        "args": [],
        "value": 0.01,
        "units": "1"
       },
       {
        "op": "+",
        "args": [
         {
          "op": "const",
          "args": [],
          "value": 0.17639,
          "units": "1"
         },
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             {
              "op": "const",
              "args": [],
              "value": 0.0038,
              "units": "m^2/W"
             },
             "s"
            ]
