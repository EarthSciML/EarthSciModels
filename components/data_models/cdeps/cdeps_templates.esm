    "rain_snow_frac": {
      "description": "Rain fraction of shr_precip_partition_rain_snow_ramp (share/shr_precip_mod.F90:17-45): frac = min(1, max(0, (T - tkfrz)*0.5)), T in K; the rest (1 - frac) falls as snow. Applied to the convective-scale and large-scale precipitation separately (datm_datamode_clmncep_mod.F90:483-487): snow = rain0*(1 - frac), rain = rain0*frac, each max(0, .).",
      "params": [
        "tbot"
      ],
      "body": {
        "op": "min",
        "args": [
          {
            "op": "const",
            "args": [],
            "value": 1.0,
            "units": "1"
          },
          {
            "op": "max",
            "args": [
              {
                "op": "const",
                "args": [],
                "value": 0.0,
                "units": "1"
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "tbot",
                      {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "tkfrz",
                        "bindings": {}
                      }
                    ]
                  },
                  {
                    "op": "const",
                    "args": [],
                    "value": 0.5,
                    "units": "1/K"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "wind_split": {
      "description": "Horizontal wind components Sa_u = Sa_v = wind/sqrt(2) (datm_datamode_clmncep_mod.F90:402-403): the stream wind magnitude is split equally between the zonal and meridional components.",
      "params": [
        "wind"
      ],
      "body": {
        "op": "/",
        "args": [
          "wind",
          {
            "op": "sqrt",
            "args": [
              {
                "op": "const",
                "args": [],
                "value": 2.0,
                "units": "1"
              }
            ]
          }
        ]
      }
    },
    "tkfrz": {
      "description": "The freezing-point temperature of the esat phase branch and the rain/snow ramp: tkfrz = TKFRZ = 273.15 K (share/shr_const_mod.F90 SHR_CONST_TKFRZ). Zero-parameter constant-fragment template applied with empty bindings; the fragment names the repeated 273.15 K literal.",
      "params": [],
      "body": {
        "op": "const",
        "args": [],
        "value": 273.15,
        "units": "K"
      }
    },
    "eps": {
      "description": "The ratio of the molecular weight of water vapor to that of dry air: eps = 0.622 (SHR_CONST_EPS, share/shr_const_mod.F90), shared by the qsat and vapor-pressure laws. Zero-parameter constant-fragment template applied with empty bindings.",
      "params": [],
      "body": {
        "op": "const",
        "args": [],
        "value": 0.622,
        "units": "1"
      }
    },
    "eps1": {
      "description": "The companion constant eps1 = 1 - eps = 0.378 of the qsat/vapor-pressure/density laws, derived from the eps fragment. Zero-parameter fragment template applied with empty bindings.",
      "params": [],
      "body": {
        "op": "-",
        "args": [
          {
            "op": "const",
            "args": [],
            "value": 1.0,
            "units": "1"
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "eps",
            "bindings": {}
          }
        ]
      }
    },
    "orb_lambm": {
      "description": "Mean longitude of perihelion at calendar day calday of shr_orb_decl (share/src/shr_orb_mod.F90:768): lambm = lambm0 + (calday - ve)*2*pi/dayspy with ve = 80.5 (calday of the vernal equinox) and dayspy = 365 (days per year); calday is the 1-based julian day including its fraction (Jan 1 00Z = 1.0). Evaluated in the Fortran operation order.",
      "params": [
        "calday",
        "lambm0"
      ],
      "body": {
        "op": "+",
        "args": [
          "lambm0",
          {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          "calday",
                          {
                            "op": "const",
                            "args": [],
                            "value": 80.5,
                            "units": "1"
                          }
                        ]
                      },
                      {
                        "op": "const",
                        "args": [],
                        "value": 2.0,
                        "units": "1"
                      }
                    ]
                  },
                  {
                    "op": "const",
                    "args": [],
                    "value": 3.141592653589793,
                    "units": "rad"
                  }
                ]
              },
              {
                "op": "const",
                "args": [],
                "value": 365.0,
                "units": "1"
              }
            ]
          }
        ]
      }
    },
    "orb_lamb": {
      "description": "Earth's true longitude lamb of shr_orb_decl (shr_orb_mod.F90:769-776): lmm = lambm - mvelpp, lamb = lambm + eccen*(2 sin(lmm) + eccen*(1.25 sin(2 lmm) + eccen*((13/12) sin(3 lmm) - 0.25 sin(lmm)))), the third-order expansion of the equation of center in the eccentricity.",
      "params": [
        "lambm",
        "eccen",
        "mvelpp"
      ],
      "body": {
        "op": "+",
        "args": [
          "lambm",
          {
            "op": "*",
            "args": [
              "eccen",
              {
                "op": "+",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "const",
                        "args": [],
                        "value": 2.0,
                        "units": "rad"
                      },
                      {
                        "op": "sin",
                        "args": [
                          {
                            "op": "-",
                            "args": [
                              "lambm",
                              "mvelpp"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "eccen",
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              {
                                "op": "const",
                                "args": [],
                                "value": 1.25,
                                "units": "rad"
                              },
                              {
                                "op": "sin",
                                "args": [
                                  {
                                    "op": "*",
                                    "args": [
                                      {
                                        "op": "const",
                                        "args": [],
                                        "value": 2.0,
                                        "units": "1"
                                      },
                                      {
                                        "op": "-",
                                        "args": [
                                          "lambm",
                                          "mvelpp"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "op": "*",
                            "args": [
                              "eccen",
                              {
                                "op": "-",
                                "args": [
                                  {
                                    "op": "*",
                                    "args": [
                                      {
                                        "op": "const",
                                        "args": [],
                                        "value": 1.0833333333333333,
                                        "units": "rad"
                                      },
                                      {
                                        "op": "sin",
                                        "args": [
                                          {
                                            "op": "*",
                                            "args": [
                                              {
                                                "op": "const",
                                                "args": [],
                                                "value": 3.0,
                                                "units": "1"
                                              },
                                              {
                                                "op": "-",
                                                "args": [
                                                  "lambm",
                                                  "mvelpp"
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "op": "*",
                                    "args": [
                                      {
                                        "op": "const",
                                        "args": [],
                                        "value": 0.25,
                                        "units": "rad"
                                      },
                                      {
                                        "op": "sin",
                                        "args": [
                                          {
                                            "op": "-",
                                            "args": [
                                              "lambm",
                                              "mvelpp"
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "orb_decl": {
      "description": "Solar declination delta = asin(sin(obliqr) sin(lamb)) of shr_orb_decl (shr_orb_mod.F90:785) at calendar day calday, for the orbital parameters eccen, obliqr, lambm0, mvelpp (shr_orb_params output; the reference case runs orb_mode fixed_year, orb_iyear 2000).",
      "params": [
        "calday",
        "eccen",
        "obliqr",
        "lambm0",
        "mvelpp"
      ],
      "body": {
        "op": "asin",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "sin",
                "args": [
                  "obliqr"
                ]
              },
              {
                "op": "sin",
                "args": [
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "orb_lamb",
                    "bindings": {
                      "lambm": {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "orb_lambm",
                        "bindings": {
                          "calday": "calday",
                          "lambm0": "lambm0"
                        }
                      },
                      "eccen": "eccen",
                      "mvelpp": "mvelpp"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "orb_cosz": {
      "description": "Cosine of the solar zenith angle as the CDEPS stream layer uses it (streams/dshr_tinterp_mod.F90:313-318, shr_tInterp_getCosz): cosz = max(solZenMin, shr_orb_cosz(calday, lat, lon, delta)) with solZenMin = 0.001 and shr_orb_cosz = sin(lat) sin(delta) - cos(lat) cos(delta) cos((calday - floor(calday)) 2 pi + lon) (share/src/shr_orb_mod.F90:155-156); lat, lon in degrees, converted with deg2rad = SHR_CONST_PI/180; delta from orb_decl at the same calday.",
      "params": [
        "calday",
        "lat",
        "lon",
        "eccen",
        "obliqr",
        "lambm0",
        "mvelpp"
      ],
      "body": {
        "op": "max",
        "args": [
          {
            "op": "const",
            "args": [],
            "value": 0.001,
            "units": "1"
          },
          {
            "op": "-",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "sin",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "lat",
                          {
                            "op": "const",
                            "args": [],
                            "value": 0.017453292519943295,
                            "units": "rad/deg"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "sin",
                    "args": [
                      {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "orb_decl",
                        "bindings": {
                          "calday": "calday",
                          "eccen": "eccen",
                          "obliqr": "obliqr",
                          "lambm0": "lambm0",
                          "mvelpp": "mvelpp"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "cos",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              "lat",
                              {
                                "op": "const",
                                "args": [],
                                "value": 0.017453292519943295,
                                "units": "rad/deg"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "op": "cos",
                        "args": [
                          {
                            "op": "apply_expression_template",
                            "args": [],
                            "name": "orb_decl",
                            "bindings": {
                              "calday": "calday",
                              "eccen": "eccen",
                              "obliqr": "obliqr",
                              "lambm0": "lambm0",
                              "mvelpp": "mvelpp"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  {
                                    "op": "-",
                                    "args": [
                                      "calday",
                                      {
                                        "op": "floor",
                                        "args": [
                                          "calday"
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "op": "const",
                                    "args": [],
                                    "value": 2.0,
                                    "units": "1"
                                  }
                                ]
                              },
                              {
                                "op": "const",
                                "args": [],
                                "value": 3.141592653589793,
                                "units": "rad"
                              }
                            ]
                          },
                          {
                            "op": "*",
                            "args": [
                              "lon",
                              {
                                "op": "const",
                                "args": [],
                                "value": 0.017453292519943295,
                                "units": "rad/deg"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "record_lower_time": {
      "description": "Time of the stream record at or before t on a regular record axis t0 + n*dt (the CDEPS lower time bound LB of shr_strdata_advance for a stream whose records sit every dt starting at t0): t_lb = t0 + dt*floor((t - t0)/dt). This is the record a data-fed parameter receives first (esm-spec 8.5.1), so the factors computed from t_lb pair with the delivered records.",
      "params": [
        "t",
        "t0",
        "dt"
      ],
      "body": {
        "op": "+",
        "args": [
          "t0",
          {
            "op": "*",
            "args": [
              "dt",
              {
                "op": "floor",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          "t",
                          "t0"
                        ]
                      },
                      "dt"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
