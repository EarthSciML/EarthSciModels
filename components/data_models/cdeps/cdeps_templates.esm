           {
            "op": "+",
            "args": [
             {
              "op": "*",
              "args": [
               {
                "op": "const",
                "args": [],
                "value": -9.0039e-06,
                "units": "m^4/W^2"
               },
               {
                "op": "^",
                "args": [
                 "s",
                 2
                ]
               }
              ]
             },
             {
              "op": "*",
              "args": [
               {
                "op": "const",
                "args": [],
                "value": 8.1351e-09,
                "units": "m^6/W^3"
               },
               {
                "op": "^",
                "args": [
                 "s",
                 3
                ]
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  },
  "rain_snow_frac": {
   "description": "Rain fraction of shr_precip_partition_rain_snow_ramp (share/shr_precip_mod.F90:17-45): frac = min(1, max(0, (T - tkfrz)*0.5)), T in K; the rest (1 - frac) falls as snow. Applied to the convective-scale and large-scale precipitation separately (datm_datamode_clmncep_mod.F90:483-487): snow = rain0*(1 - frac), rain = rain0*frac, each max(0, .).",
   "params": [
    "tbot"
   ],
   "body": {
    "op": "min",
    "args": [
     {
      "op": "const",
      "args": [],
      "value": 1.0,
      "units": "1"
     },
     {
      "op": "max",
      "args": [
       {
        "op": "const",
        "args": [],
        "value": 0.0,
        "units": "1"
       },
       {
        "op": "*",
        "args": [
         {
          "op": "-",
          "args": [
           "tbot",
           {
            "op": "apply_expression_template",
            "args": [],
            "name": "tkfrz",
            "bindings": {}
           }
          ]
         },
         {
          "op": "const",
          "args": [],
          "value": 0.5,
          "units": "1/K"
         }
        ]
       }
      ]
     }
    ]
   }
  },
  "wind_split": {
   "description": "Horizontal wind components Sa_u = Sa_v = wind/sqrt(2) (datm_datamode_clmncep_mod.F90:402-403): the stream wind magnitude is split equally between the zonal and meridional components.",
   "params": [
    "wind"
   ],
   "body": {
    "op": "/",
    "args": [
     "wind",
     {
      "op": "sqrt",
      "args": [
       {
        "op": "const",
        "args": [],
        "value": 2.0,
        "units": "1"
       }
      ]
     }
    ]
   }
  },
  "tkfrz": {
   "description": "The freezing-point temperature of the esat phase branch and the rain/snow ramp: tkfrz = TKFRZ = 273.15 K (share/shr_const_mod.F90 SHR_CONST_TKFRZ). Zero-parameter constant-fragment template applied with empty bindings; the fragment names the repeated 273.15 K literal.",
   "params": [],
   "body": {
    "op": "const",
    "args": [],
    "value": 273.15,
    "units": "K"
   }
  },
  "eps": {
   "description": "The ratio of the molecular weight of water vapor to that of dry air: eps = 0.622 (SHR_CONST_EPS, share/shr_const_mod.F90), shared by the qsat and vapor-pressure laws. Zero-parameter constant-fragment template applied with empty bindings.",
   "params": [],
   "body": {
    "op": "const",
    "args": [],
    "value": 0.622,
    "units": "1"
   }
  },
  "eps1": {
   "description": "The companion constant eps1 = 1 - eps = 0.378 of the qsat/vapor-pressure/density laws, derived from the eps fragment. Zero-parameter fragment template applied with empty bindings.",
   "params": [],
   "body": {
    "op": "-",
    "args": [
     {
      "op": "const",
      "args": [],
      "value": 1.0,
      "units": "1"
     },
     {
      "op": "apply_expression_template",
      "args": [],
      "name": "eps",
      "bindings": {}
     }
    ]
   }
  }
 }
}