 },
 "models": {
  "Streams": {
   "expression_template_imports": [
    {
     "ref": "./cdeps_templates.esm"
    }
   ],
   "variables": {
    "lb": {
     "type": "parameter",
     "units": "1",
     "description": "stream value at the lower time bound on the model grid after the spatial map (fldbun_data(LB)), [field units] (the field's own units vary per stream; the law is unit-agnostic)",
     "default": 0.0
    },
    "ub": {
     "type": "parameter",
     "units": "1",
     "description": "stream value at the upper time bound (fldbun_data(UB)), [field units] (the field's own units vary per stream; the law is unit-agnostic)",
     "default": 0.0
    },
    "flb": {
     "type": "parameter",
     "units": "1",
     "description": "time-interpolation factor on lb (linear: (t_ub - t_q)/(t_ub - t_lb); nearest/lower: 1 or 0; coszen: cosz/tavCosz, unused at night)",
     "default": 1.0
    },
    "fub": {
     "type": "parameter",
     "units": "1",
     "description": "time-interpolation factor on ub (linear: 1 - flb; nearest/upper: 0 or 1; coszen: 0, unused)",
     "default": 0.0
    },
    "day": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "coszen day/night flag: 1 when cosz > 0.001 (the traced rows; all polar day), 0 at night when the law zeroes the value"
    },
    "value": {
     "type": "unknown",
     "units": "1",
     "description": "the interpolated stream value written into fldbun_model and consumed by the datamode, [field units] (the field's own units vary per stream; the law is unit-agnostic)"
    }
   },
   "equations": [
    {
     "lhs": "value",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "==",
        "args": [
         "day",
         {
          "op": "const",
          "args": [],
          "value": 0.0,
          "units": "1"
         }
        ]
       },
       {
        "op": "const",
        "args": [],
        "value": 0.0,
        "units": "1"
       },
       {
        "op": "+",
        "args": [
         {
          "op": "*",
          "args": [
           "flb",
           "lb"
          ]
         },
         {
          "op": "*",
          "args": [
           "fub",
           "ub"
          ]
         }
        ]
       }
      ]
     }
    }
   ],
   "tests": [
    {
     "id": "coszen_day_step0_p1",
     "description": "Solar stream (coszen), traced row step 0 point 1 (lat -90, lon 0): value = lb*flb with fub = 0, flb = cosz/tavCosz = 1.000157806 (cdeps_strdata_streams.csv).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 429.9039257897292,
      "ub": 438.02563417222825,
      "flb": 1.0001578062610825,
      "fub": 0.0,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 429.97176732088275,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "coszen_day_step11_p16",
     "description": "Solar stream (coszen), traced row step 11 point 16 (lon 37.5): flb = 0.999839611, fub = 0.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 438.02563417222825,
      "ub": 435.1825587802471,
      "flb": 0.9998396108711268,
      "fub": 0.0,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 437.9553796223393,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "coszen_night_synthetic",
     "description": "Coszen night branch (dshr_strdata_mod.F90:1292-1296): value = 0 when cosz <= 0.001 even though flb > 0. The traced window is polar day (all 16 traced points at lat -90 on Jan 1), so this branch is pinned synthetically.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 100.0,
      "ub": 200.0,
      "flb": 0.5,
      "fub": 0.0,
      "day": 0.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 0.0
      }
     ]
    },
    {
     "id": "linear_tbot_step0_p1",
     "description": "TPQW stream Sa_tbot (linear), traced row step 0 point 1: flb = fub = 0.5 (query at the interval midpoint), value = flb*lb + fub*ub = 249.309243138630478 K.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 249.1546637852978,
      "ub": 249.46382249196316,
      "flb": 0.5,
      "fub": 0.5,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 249.30924313863048,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "linear_tbot_step11_p1",
     "description": "TPQW stream Sa_tbot (linear), traced row step 11 point 1: flb = 2/3, fub = 1/3 (non-midpoint query), value = 249.361815000463992 K.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 249.49590365091888,
      "ub": 249.09363769955428,
      "flb": 0.6666666666666666,
      "fub": 0.33333333333333337,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 249.361815000464,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "nearest_step0_p1",
     "description": "Precip stream Faxa_precn (nearest), traced row step 0 point 1: (flb, fub) = (1, 0) - the lower bound is the nearer record - so value = lb.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 5.22216069182629e-06,
      "ub": 7.058281049252279e-06,
      "flb": 1.0,
      "fub": 0.0,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 5.22216069182629e-06,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "lower_topo_step0_p1",
     "description": "topo.observed stream Sa_topo (lower), traced row step 0 point 1: (flb, fub) = (1, 0), lb = ub = 2824.92102657638907 m (the topo file is time-invariant).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 2824.921026576389,
      "ub": 2824.921026576389,
      "flb": 1.0,
      "fub": 0.0,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 2824.921026576389,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    }
   ]
  },
  "Clmncep": {
   "expression_template_imports": [
    {
     "ref": "./cdeps_templates.esm"
    }
   ],
   "variables": {
    "strm_tbot": {
     "type": "parameter",
     "units": "K",
     "description": "interpolated TPQW Sa_tbot stream value, [K]",
     "default": 249.30924313863048
    },
    "strm_pbot": {
     "type": "parameter",
     "units": "Pa",
     "description": "interpolated TPQW Sa_pbot stream value, [Pa]",
     "default": 68134.13610026057
    },
    "strm_wind": {
     "type": "parameter",
     "units": "m/s",
     "description": "interpolated TPQW Sa_wind stream value, [m/s]",
     "default": 4.88208296870192
    },
    "strm_shum": {
     "type": "parameter",
     "units": "kg/kg",
     "description": "interpolated TPQW Sa_shum stream value, [kg/kg]",
     "default": 0.0007554910110128631
    },
    "strm_lwdn": {
     "type": "parameter",
     "units": "W/m^2",
     "description": "interpolated TPQW Faxa_lwdn stream value, [W/m2]",
     "default": 147.6519253730771
    },
    "strm_swdn": {
     "type": "parameter",
     "units": "W/m^2",
     "description": "interpolated Solar Faxa_swdn stream value, [W/m2]",
     "default": 429.97176732088275
    },
    "strm_precn": {
     "type": "parameter",
     "units": "kg/m^2/s",
     "description": "interpolated Precip Faxa_precn stream value, [kg/m2/s]",
     "default": 5.22216069182629e-06
    },
    "strm_topo": {
     "type": "parameter",
     "units": "m",
     "description": "interpolated topo Sa_topo stream value, [m]",
     "default": 2824.921026576389
    },
    "strm_z": {
     "type": "parameter",
     "units": "m",
     "default": 1e+30,
     "description": "interpolated z stream value (1e30 spval when no z stream, as in GSWP3), [m]"
    },
    "tbotmax": {
     "type": "parameter",
     "units": "K",
     "description": "first-call global max of Sa_tbot before the tkfrz adjustment (units detector: <50 means the stream temperature is in degC), [K]",
     "default": 310.35066065749163
    },
    "anidrmax": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 1e+30,
     "description": "first-call global max of the Sx_anidr import (existence detector; 1e30 when the imports are absent), [W/m2]"
    },
    "topo_present": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "1 when the topo stream is associated"
    },
    "pbot_present": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "1 when the pbot stream is associated"
    },
    "lwdn_present": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "1 when the lwdn stream is associated"
    },
    "Sx_anidr": {
     "type": "parameter",
     "units": "1",
     "default": 1e+30,
     "description": "NIR direct albedo import (1e30 spval when absent), [-]"
    },
    "Sx_avsdr": {
     "type": "parameter",
     "units": "1",
     "default": 1e+30,
     "description": "VIS direct albedo import (1e30 spval when absent), [-]"
    },
    "Sx_anidf": {
     "type": "parameter",
     "units": "1",
     "default": 1e+30,
     "description": "NIR diffuse albedo import (1e30 spval when absent), [-]"
    },
    "Sx_avsdf": {
     "type": "parameter",
     "units": "1",
     "default": 1e+30,
     "description": "VIS diffuse albedo import (1e30 spval when absent), [-]"
    },
    "e": {
     "type": "unknown",
     "units": "Pa",
     "description": "saturation vapor pressure esat(Sa_tbot, Sa_tbot) from the water/ice polynomials, [Pa]"
    },
    "qsat_": {
     "type": "unknown",
     "units": "kg/kg",
     "description": "saturation specific humidity 0.622 e / (pbot - 0.378 e), [kg/kg]"
    },
    "vp": {
