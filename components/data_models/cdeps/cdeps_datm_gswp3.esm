            }
          ]
        },
        {
          "id": "coszen_polar_night",
          "description": "Polar night (lat +90 on Jan 1): cosz = max(0.001, sin(delta)) = 0.001 at every sample, so the night branch zeroes swdn even though lb > 0 (dshr_strdata_mod.F90:1396-1397).",
          "time_span": {
            "start": 0.0,
            "end": 0.0
          },
          "tolerance": {
