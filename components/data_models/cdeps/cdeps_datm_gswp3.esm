          "lhs": "day",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  "cosz",
                  {
                    "op": "const",
                    "args": [],
                    "value": 0.001,
                    "units": "1"
                  }
                ]
              },
              {
