{
 "esm": "2.0.0",
 "metadata": {
  "name": "cism_diva",
  "description": "The CISM DIVA depth-integrated momentum balance as a PDE on the 2-D vertex grid (stage 2 of the EqESM project; CISM = cismwrap_3_00_002 as built in CESM cesm3.0-alphabranch, glissade_velo_higher.F90, which_ho_approx = HO_APPROX_DIVA = 4 for the reference run). The model solves nothing: it evaluates the discretized balance on the dumped converged FE solution of the fixed 9x9-vertex patch (stage1/dumps/cism/cism_velo_patch.csv, dump_patch_i0 = 24, dump_patch_j0 = 14, dump_patch_n = 8, 2026-11-12 run 12362182), pins the slope-correction chain (F_x/y, beta_eff_x/y) straight to the dumped columns and the balance sums Rx/Ry to the measured FE-vs-FD scale (1.5% of the largest local term and of the dumped driving stress) at interior vertices, so the stage-2 lane can hold the discretization accountable against the FE solve it replaces.",
  "license": "MIT",
  "tags": [
   "cryosphere",
   "ice-sheet",
   "cism",
   "momentum",
   "diva",
   "residual",
   "cesm"
  ],
  "created": "2026-11-06T00:00:00Z",
  "authors": [
   "EqESM project contributors"
  ],
  "references": [
   {
    "citation": "CISM (Community Ice Sheet Model) cismwrap_3_00_002 / cism_main_3.00.002, as built in CESM cesm3.0-alphabranch (checkout stage1/cesm/components/cism, reference run T1850Gg/f09_g17_gris20): libglissade/glissade_basal_traction.F90, libglissade/glissade_therm.F90, libglissade/glissade_grid_operators.F90, libglissade/glissade_velo_higher.F90, libglissade/glissade_mass_balance.F90, libglissade/glissade_calving.F90, libglissade/glissade_masks.F90, libglissade/glissade_utils.F90, libglimmer/glimmer_physcon.F90, libglimmer/glimmer_utils.F90, libglide/glide_types.F90, libglide/glide_setup.F90, libglad/glad_main.F90, libglad/glad_timestep.F90, libglad/glad_output_states.F90, libglad/glad_output_fluxes.F90, drivers/cpl/nuopc/glc_import_export.F90 - the reference implementation these components are transcribed from.",
    "url": "https://github.com/ESCOMP/CESM"
   },
   {
    "citation": "CISM (Community Ice Sheet Model) cism_main_3.00.002, libglissade/glissade_velo_higher.F90 (glissade_velo_higher_solve, compute_element_matrix, glissade_calcbeta) and libglissade/glissade_grid_operators.F90 (glissade_gradient, glissade_slope_angle_staggered)."
   },
   {
    "citation": "Goldberg, D. N. (2011). A variationally derived, depth-integrated approximation for a full-Stokes ice sheet model. Journal of Glaciology, 57(204), 717-728. Eq. 37 (the depth-integrated momentum balance) and eq. 40-41 (the effective basal friction)."
   },
   {
    "citation": "EarthSciModels - the authoritative .esm corpus this component lives in.",
    "url": "https://github.com/EarthSciML/EarthSciModels"
   }
  ]
 },
 "index_sets": {
  "i": {
   "kind": "interval",
   "size": "NX"
  },
  "j": {
   "kind": "interval",
   "size": "NY"
  },
  "lev": {
   "kind": "interval",
   "size": "NLAYERS"
  },
  "lev_nodes": {
   "kind": "interval",
   "size": {
    "op": "+",
    "args": [
     "NLAYERS",
     1
    ]
   }
  }
 },
 "models": {
  "DivaBalance": {
   "expression_template_imports": [
    {
     "ref": "./cism_diva_discretization.esm"
    },
    {
     "ref": "./cism_templates.esm"
    },
    {
     "ref": "./cism_velo_discretization.esm"
    }
   ],
   "variables": {
    "uvel_2d": {
     "type": "parameter",
     "units": "m/yr",
     "shape": [
      "i",
      "j"
     ],
     "description": "Converged DIVA 2-D x-velocity at the vertices (solve-internal m/yr, scale_output not yet run; glissade_velo_higher.F90:3908-3933).",
     "default": 0.0
    },
    "vvel_2d": {
     "type": "parameter",
     "units": "m/yr",
     "shape": [
      "i",
      "j"
     ],
     "description": "Converged DIVA 2-D y-velocity at the vertices.",
     "default": 0.0
    },
    "thck": {
     "type": "parameter",
     "units": "m",
     "shape": [
      "i",
      "j"
     ],
     "description": "Cell-centered ice thickness (the 8x8 cell block of the patch; row/column NX unused).",
     "default": 0.0
    },
    "usrf": {
     "type": "parameter",
     "units": "m",
     "shape": [
      "i",
      "j"
     ],
     "description": "Cell-centered upper surface elevation (the 8x8 cell block).",
     "default": 0.0
    },
    "efvs": {
     "type": "parameter",
     "units": "Pa yr",
     "shape": [
      "lev",
      "i",
      "j"
     ],
     "description": "Cell-centered per-layer effective viscosity (the arithmetic mean of the 4 quad-point viscosities, glissade_velo_higher.F90:5411-5416; the 8x8 cell block per layer).",
     "default": 0.0
    },
    "sigma": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "lev_nodes"
     ],
     "description": "The sigma coordinate at the 11 velocity levels (0 at the surface, 1 at the bed; identical on every patch cell).",
     "default": 0.0
    },
    "beta_internal": {
     "type": "parameter",
     "units": "Pa yr/m",
     "shape": [
      "i",
      "j"
     ],
     "description": "The accepted calcbeta pass's f_ground*beta at the vertices (glissade_calcbeta, which_ho_babc = 3).",
     "default": 0.0
    },
    "stag_omega": {
     "type": "parameter",
     "units": "m/(Pa yr)",
     "shape": [
      "i",
      "j"
     ],
     "description": "The ice-masked 4-cell mean of the DIVA double integral at the vertices (glissade_velo_higher.F90:2549-2552).",
     "default": 0.0
    },
    "taudx": {
     "type": "parameter",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "The x driving stress at the vertices, -rhoi*g*stagthck*dusrf_dx (Pa, converted from model units at glissade_velo_higher.F90:2041).",
     "default": 0.0
    },
    "taudy": {
     "type": "parameter",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "The y driving stress at the vertices.",
     "default": 0.0
    },
    "dx": {
     "type": "parameter",
     "units": "m",
     "default": 20000.0,
     "description": "Grid spacing in x (gris20: 20 km)."
    },
    "dy": {
     "type": "parameter",
     "units": "m",
     "default": 20000.0,
     "description": "Grid spacing in y (gris20: 20 km)."
    },
    "dz": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "The dimensionless sigma layer widths dz[l] = sigma[l+1] - sigma[l] (cism_sigma_measure)."
    },
    "z_sfc": {
     "type": "unknown",
     "units": "1",
     "description": "The surface sigma level, 0 (the lower bound of the layer integral)."
    },
    "z_top": {
     "type": "unknown",
     "units": "1",
     "description": "The bed sigma level, 1 (the upper bound of the layer integral)."
    },
    "etaH": {
     "type": "unknown",
     "units": "Pa yr m",
     "shape": [
      "i",
      "j"
     ],
     "description": "The depth-integrated effective viscosity of the DIVA 2-D balance at the cell centers, thck * sum_k efvs_k * dsigma_k: the exact stencil of the Fortran quad-point vertical average efvs_qp_vertavg = sum_k efvs_qp(k,p)*(sigma(k+1) - sigma(k)) (glissade_velo_higher.F90:5366-5369) applied to the dumped quad-point-mean layer viscosities, with the thickness factor carried by the model (the element matrix coefficient is h_qp*efvs_qp_vertavg, F90:5404)."
    },
    "z_mean": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "i",
      "j"
     ],
     "description": "The mid-surface elevation of the DIVA slope correction at the cell centers, 0.5*(usrf + lsrf) = usrf - thck/2 for the grounded patch cells (glissade_velo_higher.F90:2160)."
    },
    "dz_dx": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "i",
      "j"
     ],
     "description": "The plain vertex gradient of z_mean in x (glissade_slope_angle_staggered's glissade_gradient with gradient_margin = 1, glissade_grid_operators.F90:309-468, F90:1414-1552)."
    },
    "dz_dy": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "i",
      "j"
     ],
     "description": "The plain vertex gradient of z_mean in y."
    },
    "theta_x": {
     "type": "unknown",
     "units": "rad",
     "shape": [
      "i",
      "j"
     ],
     "description": "The x-direction vertex slope angle of the DIVA slope correction, atan(|dz_dx|) (cism_theta_slope_x)."
    },
    "theta_y": {
     "type": "unknown",
     "units": "rad",
     "shape": [
      "i",
      "j"
     ],
     "description": "The y-direction vertex slope angle, atan(|dz_dy|)."
    },
    "F_x": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "i",
      "j"
     ],
     "description": "The x DIVA slope correction factor, cos^2(theta_x) + 4 sin^2(theta_x) (cism_diva_slope_factor, glissade_velo_higher.F90:2189-2193)."
    },
    "F_y": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "i",
      "j"
     ],
     "description": "The y DIVA slope correction factor."
    },
    "beta_eff_x": {
     "type": "unknown",
     "units": "Pa yr/m",
     "shape": [
      "i",
      "j"
     ],
     "description": "The effective basal friction of the x momentum equation, F_x*beta_internal/(F_x + beta_internal*stag_omega*cos(theta_x)) (cism_beta_eff, glissade_velo_higher.F90:2589-2601)."
    },
    "beta_eff_y": {
     "type": "unknown",
     "units": "Pa yr/m",
     "shape": [
      "i",
      "j"
     ],
     "description": "The effective basal friction of the y momentum equation."
    },
    "k4": {
     "type": "unknown",
     "units": "Pa yr m",
     "shape": [
      "i",
      "j"
     ],
     "description": "The 4*etaH coefficient of the D(4*etaH*D(u,x),x) and D(4*etaH*D(v,y),y) terms (the rule stencils need the coefficient as a named field)."
    },
    "k2": {
     "type": "unknown",
     "units": "Pa yr m",
     "shape": [
      "i",
      "j"
     ],
     "description": "The 2*etaH coefficient of the D(2*etaH*D(v,y),x) and D(2*etaH*D(u,x),y) mixed terms."
    },
    "T1x": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "D(4*etaH*D(u,x),x) at the vertices: the x-divergence of the xx membrane stress component (cism_stag_Dx_Dx)."
    },
    "T2x": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "D(2*etaH*D(v,y),x) at the vertices: the x-divergence of the xy membrane stress component acting on the y-velocity gradient (cism_stag_Dx_Dy)."
    },
    "T3x": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "D(etaH*D(u,y),y) at the vertices: the y-divergence of the xy membrane stress component acting on the x-velocity gradient (cism_stag_Dy_Dy)."
    },
    "T4x": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "D(etaH*D(v,x),y) at the vertices: the y-divergence of the yy membrane stress component (cism_stag_Dy_Dx)."
    },
    "T1y": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "D(4*etaH*D(v,y),y) at the vertices (cism_stag_Dy_Dy)."
    },
    "T2y": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "D(2*etaH*D(u,x),y) at the vertices (cism_stag_Dy_Dx)."
    },
    "T3y": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "D(etaH*D(v,x),x) at the vertices (cism_stag_Dx_Dx)."
    },
    "T4y": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "D(etaH*D(u,y),x) at the vertices (cism_stag_Dx_Dy)."
    },
    "Rx": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "The discretized x-momentum balance residual at the vertices, T1x + T2x + T3x + T4x - beta_eff_x*uvel_2d + taudx (the balance div(sigma) - beta_eff*u = rho*g*H*ds/dx = -taudx, so the sum is 0 on the FE solution up to the FE-vs-FD discretization difference)."
    },
    "Ry": {
     "type": "unknown",
     "units": "Pa",
     "shape": [
      "i",
      "j"
     ],
     "description": "The discretized y-momentum balance residual, T1y + T2y + T3y + T4y - beta_eff_y*vvel_2d + taudy."
    }
   },
   "equations": [
    {
     "lhs": "dz",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_sigma_measure",
      "bindings": {
       "sigma": "sigma"
      }
     }
    },
    {
     "lhs": "z_sfc",
     "rhs": {
      "op": "const",
      "args": [],
      "value": 0.0,
      "units": "1"
     }
    },
    {
     "lhs": "z_top",
     "rhs": {
      "op": "const",
      "args": [],
      "value": 1.0,
      "units": "1"
     }
    },
    {
     "lhs": "etaH",
     "rhs": {
      "op": "*",
      "args": [
       "thck",
       {
        "op": "integral",
        "args": [
         "efvs"
        ],
        "var": "lev",
        "lower": "z_sfc",
        "upper": "z_top"
       }
      ]
     }
    },
    {
     "lhs": "z_mean",
     "rhs": {
      "op": "-",
      "args": [
       "usrf",
       {
        "op": "*",
        "args": [
         0.5,
         "thck"
        ]
       }
      ]
     }
    },
    {
     "lhs": "dz_dx",
     "rhs": {
      "op": "cism_stag_vertex_gradient_x",
      "args": [
       "z_mean"
      ]
     }
    },
    {
     "lhs": "dz_dy",
     "rhs": {
      "op": "cism_stag_vertex_gradient_y",
      "args": [
       "z_mean"
      ]
     }
    },
    {
     "lhs": "theta_x",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_theta_slope_x",
      "bindings": {
       "dz_dx": "dz_dx"
      }
     }
    },
    {
     "lhs": "theta_y",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_theta_slope_x",
      "bindings": {
       "dz_dx": "dz_dy"
      }
     }
    },
    {
     "lhs": "F_x",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_diva_slope_factor",
      "bindings": {
       "theta": "theta_x"
      }
     }
    },
    {
     "lhs": "F_y",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_diva_slope_factor",
      "bindings": {
       "theta": "theta_y"
      }
     }
    },
    {
     "lhs": "beta_eff_x",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_beta_eff",
      "bindings": {
       "F": "F_x",
       "beta": "beta_internal",
       "omega": "stag_omega",
       "theta": "theta_x"
      }
     }
    },
    {
     "lhs": "beta_eff_y",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_beta_eff",
      "bindings": {
       "F": "F_y",
       "beta": "beta_internal",
       "omega": "stag_omega",
       "theta": "theta_y"
      }
     }
    },
    {
     "lhs": "k4",
     "rhs": {
      "op": "*",
      "args": [
       4.0,
       "etaH"
      ]
     }
    },
    {
     "lhs": "k2",
     "rhs": {
      "op": "*",
      "args": [
       2.0,
       "etaH"
      ]
     }
    },
    {
     "lhs": "T1x",
     "rhs": {
      "op": "D",
      "args": [
       {
        "op": "*",
        "args": [
         "k4",
         {
          "op": "D",
          "args": [
           "uvel_2d"
          ],
          "wrt": "x"
