    },
    "frain": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "m/s",
     "default": 0.0,
     "description": "rain rate in m/s (cap Faxa_rain kg/m2/s divided by rhofresh, as consumed by the melt pond code, icepack_meltpond_sealvl.F90:157), [m/s]"
    },
    "fsnow": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "kg/m^2/s",
     "default": 0.0,
     "description": "snowfall rate (cap Faxa_snow); the new-snow thickness is hsn_new = fsnow*dt/rhos (thickness_changes, icepack_therm_vertical.F90:1632-1660), [kg/m2/s]"
    },
    "fsnow_dEdd": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "m/s",
     "default": 0.0,
     "description": "snowfall rate as consumed by the dEdd pond code: shortwave_dEdd_set_eff receives the coupled mass flux fsnow (kg/m2/s, F90:3511) but uses it numerically as a depth rate in dhs = hsnlvl - fsnow*dt (F90:3588) and fsnow*dt > hs_min, without the /rhos conversion; the .esm carries the same numeric value in an m/s parameter to reproduce the Fortran exactly (bugs.md #10), [m/s]"
    },
    "strocnxT": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "N/m^2",
     "default": 0.0,
     "description": "ice-ocean stress, x direction at T points (from the dynamics component; used for ustar, icepack_therm_vertical.F90:665), [N/m2]"
    },
    "strocnyT": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "N/m^2",
     "default": 0.0,
     "description": "ice-ocean stress, y direction at T points, [N/m2]"
    },
    "aicen": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "1",
     "default": 0.0,
     "description": "ice area fraction per category (the coupled ice state; the column physics consumes it and the ITD/transport steps update it), [-]"
    },
    "vicen": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "m",
     "default": 0.0,
     "description": "ice volume per unit grid-cell area per category, [m]"
    },
    "vsnon": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "m",
     "default": 0.0,
     "description": "snow volume per unit grid-cell area per category, [m]"
    },
