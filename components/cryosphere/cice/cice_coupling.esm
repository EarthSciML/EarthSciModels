     "type": "unknown",
     "units": "m^2/s",
     "description": "strain-rate invariant of the elliptical yield curve at the U corner, Delta = sqrt(divu^2 + e_factor*(tension^2 + shear^2)) (strain_rates, ice_dyn_shared.F90:2156-2159; dump column Delta), [m2/s]"
    },
    "evp_tmpcalc": {
     "type": "unknown",
     "units": "kg/m^2/s",
