     "type": "parameter",
     "units": "1",
     "description": "inverse elastic parameter arlx1i = 1/arlx = 1/(2*elasticDamp*ndte) (set_evp_parameters, ice_dyn_shared.F90:476; dump column arlx1i), [-]",
     "default": 0.011574074074074073
    },
