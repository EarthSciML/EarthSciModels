          {"op": "const", "args": [], "value": 2158359.41, "units": "J/m^3/degC"},
          "T"
         ]
        },
        {
         "op": "*",
         "args": [
          {"op": "const", "args": [], "value": 1941536.59, "units": "J/m^3/degC"},
