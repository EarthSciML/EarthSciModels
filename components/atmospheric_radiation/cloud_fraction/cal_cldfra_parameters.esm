{
 "esm": "1.2.0",
 "metadata": {
  "name": "CalCldfraParameters",
  "description": "Scheme constants of WRF's icloud = 1 grid-scale cloud-fraction diagnostic, transcribed from the local PARAMETER declarations and in-line literals of SUBROUTINE cal_cldfra1 in phys/module_radiation_driver.F (WRF 4.8). Mounted by the CalCldfra component as subsystem `par` so that no tuning constant is written inline in the physics. cal_cldfra1 REDEFINES the Bolton saturation coefficients locally rather than taking the share/module_model_constants.F values: its SVP1 = 0.61078 kPa, SVP2 = 17.2693882 and SVP3 = 35.86 K are the Murray (1966) over-water fit, not the model's svp1 = 0.6112, svp2 = 17.67, svp3 = 29.65, so they belong here and not in lib/wrf_constants.esm. SVPT0 = 273.15 K and EP_2 = r_d/r_v do agree with the model constants and are taken from there (wrf.svpt0, wrf.ep_2); the routine's local r_d = 287. and r_v = 461.6 are the same numbers as the model's. Values are the nominal decimal values of the Fortran source; the real64 kernel build used for the reference tests promotes these default-real literals to binary64 (-fdefault-real-8), so no single-precision rounding note applies here.",
  "license": "MIT",
  "tags": ["wrf", "radiation", "cloud-fraction", "scheme-constants"],
  "references": [
   {"citation": "Randall, D. A. (1994). Cloud parameterization for climate modeling: Status and prospects. Atmos. Res. 31, 1-26.", "doi": "10.1016/0169-8095(94)00014-X"},
   {"citation": "Hong, S.-Y., Juang, H.-M. H. and Zhao, Q. (1998). Implementation of prognostic cloud scheme for a regional spectral model. Mon. Wea. Rev. 126, 2621-2639.", "doi": "10.1175/1520-0493(1998)126<2621:IOPCSF>2.0.CO;2"},
   {"citation": "Murray, F. W. (1966). On the computation of saturation vapor pressure. J. Appl. Meteor. 6, 203-204.", "doi": "10.1175/1520-0450(1967)006<0203:OTCOSV>2.0.CO;2"},
   {"citation": "wrf-model/WRF v4.8.0 phys/module_radiation_driver.F, SUBROUTINE cal_cldfra1."}
  ]
 },
 "models": {
  "CalCldfraParameters": {
   "variables": {
    "svp1": {"type": "parameter", "units": "kPa", "default": 0.61078,
     "description": "Saturation vapor pressure prefactor of the Murray (1966) fit, SVP1; shared by the over-water and over-ice forms. cal_cldfra1 writes the fit as 1000.0*SVP1*EXP(...), i.e. it treats SVP1 as kPa and converts to Pa in line -- hence pa_per_kpa below."},
    "svp2": {"type": "parameter", "units": "1", "default": 17.2693882,
     "description": "Exponent coefficient of the over-WATER saturation fit, SVP2 (Murray 1966 'a' over water)."},
    "svp3": {"type": "parameter", "units": "K", "default": 35.86,
     "description": "Denominator offset of the over-WATER saturation fit, SVP3 (Murray 1966 'b' over water)."},
    "svpi2": {"type": "parameter", "units": "1", "default": 21.8745584,
     "description": "Exponent coefficient of the over-ICE saturation fit, SVPI2 (Murray 1966 'a' over ice)."},
    "svpi3": {"type": "parameter", "units": "K", "default": 7.66,
     "description": "Denominator offset of the over-ICE saturation fit, SVPI3 (Murray 1966 'b' over ice)."},
    "pa_per_kpa": {"type": "parameter", "units": "Pa/kPa", "default": 1000.0,
     "description": "Unit conversion carrying cal_cldfra1's literal 1000.0 in esw = 1000.0*SVP1*EXP(...): SVP1 is in kPa and the saturation vapor pressure is compared against p_phy in Pa."},
    "qcldmin": {"type": "parameter", "units": "kg/kg", "default": 1e-12,
     "description": "Condensate threshold QCLDMIN below which the layer is declared cloud-free: both the ice weight and the cloud fraction are set to zero."},
    "rhgrid": {"type": "parameter", "units": "1", "default": 1.0,
     "description": "Critical relative humidity for grid-box saturation, RHGRID. At or above it a layer holding condensate is fully cloudy. The source carries a commented-out resolution-dependent alternative RHGRID = 0.90 + 0.08*((100.-DX)/95.)**0.5, which WRF 4.8 does not use."},
    "alpha0": {"type": "parameter", "units": "1", "default": 100.0,
     "description": "Coefficient ALPHA0 of the Randall (1994) / Zhao (1995) fractional-cloud formula, multiplying the condensate over the sub-saturation raised to GAMMA."},
    "gamma": {"type": "parameter", "units": "1", "default": 0.49,
     "description": "Exponent GAMMA applied to the sub-saturation in the denominator of the Randall (1994) formula. The sub-saturation is a mixing-ratio difference and therefore dimensionless, so the fractional power is dimensionally well posed."},
    "pexp": {"type": "parameter", "units": "1", "default": 0.25,
     "description": "Exponent PEXP applied to the relative humidity prefactor (RHUM/RHGRID)**PEXP of the Randall (1994) formula."},
    "arg_floor": {"type": "parameter", "units": "1", "default": -6.9,
     "description": "Floor on the exponential argument, MAX(-6.9, -ALPHA0*QCLD/DENOM); EXP(-6.9) = 0.001, so it caps 1 - EXP(ARG) at 0.999."},
    "subsat_floor": {"type": "parameter", "units": "kg/kg", "default": 1e-10,
     "description": "Floor on the sub-saturation, SUBSAT = MAX(1.E-10, RHGRID*QVS_WEIGHT - QV), which keeps the denominator positive when the layer is at or past saturation."},
    "rh_floor": {"type": "parameter", "units": "1", "default": 1e-10,
     "description": "Floor on the relative humidity, RHUM = MAX(1.E-10, RHUM), applied only inside the fractional branch ('prevent negative values (new)' in the source)."},
    "cldfra_floor": {"type": "parameter", "units": "1", "default": 0.01,
     "description": "Cloud fractions below 0.01 are snapped to zero, IF (CLDFRA .LT. .01) CLDFRA = 0."}
   },
   "equations": []
  }
 }
}
