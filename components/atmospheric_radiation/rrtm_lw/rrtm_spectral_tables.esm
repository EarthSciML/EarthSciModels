{
 "esm": "1.0.0",
 "metadata": {
  "name": "rrtm_spectral_tables",
  "description": "Spectral constants of WRF's RRTM longwave scheme (phys/module_ra_rrtm.F, WRF 4.8), transcribed by script from the module's DATA statements: the band widths DELWAVE (cm^-1), the band index NGB of each of the 140 g-points, and the TOTPLNK table of band-integrated Planck functions at 1 K intervals from 160 K to 340 K (row i is T = 159 + i K; RTRN interpolates it linearly). Tabular data only; the equations that use it are in rtrn_sweep.esm.",
  "license": "MIT",
  "tags": [
   "wrf",
   "radiation",
   "longwave",
   "rrtm",
   "tables",
   "generated-data"
  ]
 },
