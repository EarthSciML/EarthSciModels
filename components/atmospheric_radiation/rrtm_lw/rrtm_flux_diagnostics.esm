{
 "esm": "1.2.0",
 "metadata": {
  "name": "rrtm_flux_diagnostics",
  "description": "The two surface/top flux diagnostics WRF's RRTM longwave scheme reports (SUBROUTINE RRTM of phys/module_ra_rrtm.F, WRF 4.8), as expression templates over a bottom-up interface flux profile whose level 1 is the surface and whose level NLEV + 1 is the MODEL top: GLW = TOTDFLUX(0) and OLR = TOTUFLUX(kte). The level choices live here once so that rtrn_sweep.esm (RTRN on the extended RRTM column) and rrtm_lw_heating.esm (the model column) read the same levels; OLR in particular is WRF's model-top flux, not the flux at the top of the extended column (EqWeFiC FORTRAN_BUGS.md N14). NLEV is the number of MODEL layers (WRF kte) in both importers, bound at the import edge. EqWeFiC, cited here for FORTRAN_BUGS.md, is https://github.com/EarthSciML/EqWeFiC, where these components were developed and are coupled into a WRF column.",
  "license": "MIT",
  "tags": ["wrf", "radiation", "longwave", "rrtm", "expression-templates"]
 },
 "metaparameters": {
  "NLEV": {"type": "integer", "default": 59, "description": "Number of model layers (WRF kte); the model top is interface NLEV + 1 of the bottom-up flux profile."}
 },
 "expression_templates": {
  "wrf_glw": {
   "params": ["F_dn"],
   "description": "Downward longwave flux at the surface, F_dn[1] (RRTM GLW = TOTDFLUX(0)).",
   "body": {"op": "index", "args": ["F_dn", 1]}
  },
  "wrf_olr": {
   "params": ["F_up"],
   "description": "WRF's OLR diagnostic: the upward longwave flux at the MODEL top, F_up[NLEV + 1] (RRTM OLR = TOTUFLUX(kte)), not at the top of the extended RRTM column.",
   "body": {"op": "index", "args": ["F_up", {"op": "+", "args": ["NLEV", 1]}]}
  }
 }
}
