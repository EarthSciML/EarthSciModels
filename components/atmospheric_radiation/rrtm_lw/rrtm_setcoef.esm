{
  "esm": "1.0.0",
  "metadata": {
    "name": "RRTMSetcoef",
    "description": "The pressure/temperature interpolation coefficients of WRF's RRTM longwave scheme (SUBROUTINE SETCOEF of phys/module_ra_rrtm.F, WRF 4.8) for the RRTM column of rrtm_column.esm. For every RRTM layer the reference-pressure bin JP of ln(pavel) on the 0.2-wide grid PREFLOG, the reference-temperature bins JT (at PREF(JP)) and JT1 (at PREF(JP+1)) on the 15 K grid around TREF, the four bilinear weights FAC00, FAC10, FAC01, FAC11 that the band routines TAUGBn apply to the k-tables, the foreign- and self-continuum scalings FORFAC and SELFFAC with the self-continuum temperature row INDSELF and fraction SELFFRAC, the CO2 excess weighting CO2MULT, and the three layer counts LAYTROP (lower-atmosphere k-tables), LAYSWTCH (band 8) and LAYLOW (band 9). Inputs are the column's layer pressures and temperatures and the dry-air, water-vapour and CO2 columns (rrtm_column.esm pavel, tavel, coldry, colh2o, colco2). The scheme is diagnostic. Fortran INT() truncations are written as floor(): every truncated argument is either positive or is followed by a clamp that makes floor and truncation agree (documented per variable). SELFFAC, SELFFRAC and INDSELF are assigned by SETCOEF only below LAYTROP and are left undefined above it; here they are defined on every layer by the same formula, and the tests compare them below LAYTROP only. Reference: real32 WRF dumps (no standalone driver), tolerance contract rel 1e-5; the residual is dominated by the real32 PREFLOG/TREF table values and ln(). Reference: Mlawer, E. J., S. J. Taubman, P. D. Brown, M. J. Iacono and S. A. Clough (1997), RRTM, a validated correlated-k model for the longwave, J. Geophys. Res. 102, 16663-16682; WRF 4.8 phys/module_ra_rrtm.F SUBROUTINE SETCOEF (lines 4267-4450)."
  },
  "metaparameters": {
    "NLEV": {
      "type": "integer",
      "default": 59,
      "description": "Number of model layers (WRF kte); 59 for the em_scm_xy reference column."
    },
    "NBUF": {
      "type": "integer",
      "default": 44,
      "description": "Buffer layers MM5ATM adds above the model top (see rrtm_column.esm); 44 for the reference column. NLAYERS = NLEV + NBUF."
    }
  },
  "index_sets": {
    "rlay": {
      "kind": "interval",
      "size": {
        "op": "+",
        "args": [
          "NLEV",
          "NBUF"
        ]
      }
    }
  },
  "models": {
    "RRTMSetcoef": {
      "subsystems": {
        "par": {
          "ref": "./rrtm_parameters.esm"
        }
      },
      "expression_template_imports": [
        {
          "ref": "./rrtm_reference_atmosphere.esm"
        }
      ],
      "expression_templates": {
        "reference_pressure_bin": {
          "params": [
            "plog",
            "plog_top",
            "step",
            "jp_max"
          ],
          "description": "SETCOEF JP = INT(36 - 5 (PLOG + 0.04)) clamped to 1..jp_max: the bin of ln p on the reference grid PREFLOG(k) = plog_top - step (k - 1), i.e. 1 + floor((plog_top - plog)/step) (the argument 36 - 5(PLOG + 0.04) = 1 + (6.96 - PLOG)/0.2 is positive for every atmospheric pressure, so INT = floor).",
          "body": {
            "op": "min",
            "args": [
              "jp_max",
              {
                "op": "max",
                "args": [
                  1.0,
                  {
                    "op": "+",
                    "args": [
                      1.0,
                      {
                        "op": "floor",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              {
                                "op": "-",
                                "args": [
                                  "plog_top",
                                  "plog"
                                ]
                              },
                              "step"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "reference_temperature_bin": {
          "params": [
            "T",
            "T_ref",
            "dT",
            "jt_max"
          ],
          "description": "SETCOEF JT = INT(3 + (TAVEL - TREF(JP))/15) clamped to 1..jt_max: the bin of T on the five reference temperatures T_ref - 2 dT .. T_ref + 2 dT. INT truncates toward zero while floor rounds down; they differ only for arguments below 0, which the clamp to 1 maps to the same bin.",
          "body": {
            "op": "min",
            "args": [
              "jt_max",
              {
                "op": "max",
                "args": [
                  1.0,
                  {
                    "op": "floor",
                    "args": [
                      {
                        "op": "+",
                        "args": [
                          3.0,
                          {
                            "op": "/",
                            "args": [
                              {
                                "op": "-",
                                "args": [
                                  "T",
                                  "T_ref"
                                ]
                              },
                              "dT"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "reference_temperature_fraction": {
          "params": [
            "T",
            "T_ref",
            "dT",
            "jt"
          ],
          "description": "SETCOEF FT = (TAVEL - TREF)/15 - (JT - 3): the position of T within its (clamped) reference-temperature bin; outside the table it extrapolates linearly, exactly as the Fortran.",
          "body": {
            "op": "-",
            "args": [
              {
                "op": "/",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "T",
                      "T_ref"
                    ]
                  },
                  "dT"
                ]
              },
              {
                "op": "-",
                "args": [
                  "jt",
                  3.0
                ]
              }
            ]
          }
        },
        "layer_count": {
          "params": [
            "indicator"
          ],
          "description": "Number of RRTM layers with a true indicator (SETCOEF's LAYTROP/LAYSWTCH/LAYLOW counters; the column is monotone in pressure, so the count is also the index of the last such layer).",
          "body": {
            "op": "aggregate",
            "args": [],
            "output_idx": [],
            "ranges": {
              "L": {
                "from": "rlay"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "indicator",
                "L"
              ]
            }
          }
        }
      },
      "variables": {
        "pavel": {
          "type": "unknown",
          "units": "hPa",
          "shape": [
            "rlay"
          ],
          "description": "RRTM layer pressure (rrtm_column.esm pavel), consumer-supplied through `input_pavel`."
        },
        "tavel": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "rlay"
          ],
          "description": "RRTM layer temperature (rrtm_column.esm tavel), consumer-supplied through `input_tavel`."
        },
        "coldry": {
          "type": "unknown",
          "units": "1/cm^2",
          "shape": [
            "rlay"
          ],
          "description": "Dry-air molecular column of the layer (rrtm_column.esm coldry), consumer-supplied through `input_coldry`."
        },
        "colh2o": {
          "type": "unknown",
          "units": "1/cm^2",
          "shape": [
            "rlay"
          ],
          "description": "Scaled water-vapour column 1e-20 coldry w_h2o (rrtm_column.esm colh2o), consumer-supplied through `input_colh2o`."
        },
        "colco2": {
          "type": "unknown",
          "units": "1/cm^2",
          "shape": [
            "rlay"
          ],
          "description": "Scaled CO2 column 1e-20 coldry co2vmr (rrtm_column.esm colco2), consumer-supplied through `input_colco2`."
        },
        "plog": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "ln of the layer pressure in hPa (SETCOEF PLOG)."
        },
        "jp": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Reference-pressure bin of the layer, 1..58 (SETCOEF JP): PREF(JP) >= pavel > PREF(JP+1)."
        },
        "jp1": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "The next reference pressure, JP + 1 (SETCOEF JP1)."
        },
        "fp": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Fraction of the way from PREFLOG(JP) to PREFLOG(JP+1) at which ln p lies, FP = 5 (PREFLOG(JP) - PLOG) = (PREFLOG(JP) - PLOG)/step (SETCOEF)."
        },
        "jt": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Reference-temperature bin at PREF(JP), 1..4 (SETCOEF JT)."
        },
        "ft": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Temperature fraction within bin JT (SETCOEF FT)."
        },
        "jt1": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Reference-temperature bin at PREF(JP+1), 1..4 (SETCOEF JT1)."
        },
        "ft1": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Temperature fraction within bin JT1 (SETCOEF FT1)."
        },
        "fac00": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Bilinear k-table weight of node (JP, JT): (1 - FP)(1 - FT) (SETCOEF FAC00)."
        },
        "fac10": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Bilinear k-table weight of node (JP, JT + 1): (1 - FP) FT (SETCOEF FAC10)."
        },
        "fac01": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Bilinear k-table weight of node (JP + 1, JT1): FP (1 - FT1) (SETCOEF FAC01)."
        },
        "fac11": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Bilinear k-table weight of node (JP + 1, JT1 + 1): FP FT1 (SETCOEF FAC11)."
        },
        "water": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Water-vapour volume mixing ratio relative to dry air, WKL(1)/COLDRY = colh2o/(1e-20 coldry) (SETCOEF WATER)."
        },
        "scalefac": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Continuum pressure/temperature scaling pavel (296 K/1013 hPa)/tavel (SETCOEF SCALEFAC)."
        },
        "forfac": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Foreign-broadened water-vapour continuum scaling SCALEFAC/(1 + WATER) (SETCOEF FORFAC)."
        },
        "selffac": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Self-broadened water-vapour continuum scaling WATER FORFAC (SETCOEF SELFFAC; defined only below LAYTROP in the Fortran)."
        },
        "self_temperature_index": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Position of the layer temperature on the self-continuum temperature grid, (TAVEL - 188 K)/7.2 K (SETCOEF FACTOR)."
        },
        "indself": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Lower interpolation row of the SELFREF tables, min(9, max(1, INT(FACTOR) - 7)) (SETCOEF INDSELF). INT and floor differ only for FACTOR < 0, where the clamp gives 1 in both cases."
        },
        "selffrac": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "Interpolation fraction between SELFREF rows INDSELF and INDSELF + 1, FACTOR - (INDSELF + 7) (SETCOEF SELFFRAC)."
        },
        "co2reg": {
          "type": "unknown",
          "units": "1/cm^2",
          "shape": [
            "rlay"
          ],
          "description": "Scaled CO2 column of the reference atmosphere the k-tables were built for, 1e-20 coldry 3.55e-4 (SETCOEF CO2REG = 3.55E-24 COLDRY)."
        },
        "co2mult": {
          "type": "unknown",
          "units": "1/cm^2",
          "shape": [
            "rlay"
          ],
          "description": "Weight of the CO2 minor-absorption terms of bands 6-8: the excess CO2 column over the reference times 272.63 exp(-1919.4 K/T)/(8.7604e-4 T/K) (SETCOEF CO2MULT)."
        },
        "in_lower_atmosphere": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "1 where PLOG > 4.56 (p > 95.6 hPa): the layer uses the lower-atmosphere k-tables ABSA (SETCOEF's LAYTROP branch)."
        },
        "below_switch": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "1 where PLOG > 5.76 (p > 317 hPa): counted in LAYSWTCH (band 8's lower/upper split)."
        },
        "in_lowest_block": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "1 where PLOG >= 6.62 (p >= 750 hPa): counted in LAYLOW (band 9's first N2O block)."
        },
        "laytrop": {
          "type": "unknown",
          "units": "1",
          "description": "Number of lower-atmosphere layers (SETCOEF LAYTROP): layers 1..LAYTROP use ABSA."
        },
        "layswtch_count": {
          "type": "unknown",
          "units": "1",
          "description": "Number of layers with PLOG > 5.76 before SETCOEF's round-off correction."
        },
        "layswtch": {
          "type": "unknown",
          "units": "1",
          "description": "Band 8's switch layer (SETCOEF LAYSWTCH): the count of layers with PLOG > 5.76, moved up by one when JP(LAYSWTCH + 1) <= 6 (the round-off guard SETCOEF applies after the loop)."
        },
        "laylow": {
          "type": "unknown",
          "units": "1",
          "description": "Band 9's lowest-block layer (SETCOEF LAYLOW): the count of layers with PLOG >= 6.62, at least 1 (profiles with surface pressure below 750 hPa)."
        },
        "selffac_lower": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "SELFFAC on the lower-atmosphere layers and 0 above: the part of selffac that SETCOEF assigns (test view)."
        },
        "selffrac_lower": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "SELFFRAC on the lower-atmosphere layers and 0 above (test view)."
        },
        "indself_lower": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "rlay"
          ],
          "description": "INDSELF on the lower-atmosphere layers and 0 above (test view)."
        }
      },
