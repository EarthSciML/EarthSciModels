{
  "esm": "1.0.0",
  "metadata": {"name": "rrtm_ozone_climatology", "description": "The ozone climatology tables of WRF's RRTM longwave scheme (SUBROUTINE O3DATA of phys/module_ra_rrtm.F, WRF 4.8): summer and winter mass-mixing-ratio profiles on 31 pressure nodes, transcribed by script from the module's DATA statements. The annual mean, the bin edges and the layer averages are equations of rrtm_column.esm."},
  "expression_templates": {
  "o3data_ppsum": {"params": [], "description": "O3DATA PPSUM(31): pressures (hPa) of the summer ozone climatology, decreasing with index; also the annual-mean pressure nodes PPANN.", "body": {"op": "const", "args": [], "value": [955.89, 850.532, 754.599, 667.742, 589.841, 519.421, 455.48, 398.085, 347.171, 301.735, 261.31, 225.36, 193.419, 165.49, 141.032, 120.125, 102.689, 87.829, 75.123, 64.306, 55.086, 47.209, 40.535, 34.795, 29.865, 19.122, 9.277, 4.66, 2.421, 1.294, 0.647]}},
  "o3data_o3sum": {"params": [], "description": "O3DATA O3SUM(31): summer ozone mass mixing ratio (kg/kg) at PPSUM.", "body": {"op": "const", "args": [], "value": [5.297e-08, 5.852e-08, 6.579e-08, 7.505e-08, 8.577e-08, 9.895e-08, 1.175e-07, 1.399e-07, 1.677e-07, 2.003e-07, 2.571e-07, 3.325e-07, 4.438e-07, 6.255e-07, 8.168e-07, 1.036e-06, 1.366e-06, 1.855e-06, 2.514e-06, 3.24e-06, 4.033e-06, 4.854e-06, 5.517e-06, 6.089e-06, 6.689e-06, 1.106e-05, 1.462e-05, 1.321e-05, 9.856e-06, 5.96e-06, 5.96e-06]}},
  "o3data_ppwin": {"params": [], "description": "O3DATA PPWIN(31): pressures (hPa) of the winter ozone climatology.", "body": {"op": "const", "args": [], "value": [955.747, 841.783, 740.199, 649.538, 568.404, 495.815, 431.069, 373.464, 322.354, 277.19, 237.635, 203.433, 174.07, 148.949, 127.408, 108.915, 93.114, 79.551, 67.94, 58.072, 49.593, 42.318, 36.138, 30.907, 26.362, 16.423, 7.583, 3.62, 1.807, 0.938, 0.469]}},
  "o3data_o3win": {"params": [], "description": "O3DATA O3WIN(31): winter ozone mass mixing ratio (kg/kg) at PPWIN.", "body": {"op": "const", "args": [], "value": [4.629e-08, 4.686e-08, 5.017e-08, 5.613e-08, 6.871e-08, 8.751e-08, 1.138e-07, 1.516e-07, 2.161e-07, 3.264e-07, 4.968e-07, 7.338e-07, 1.017e-06, 1.308e-06, 1.625e-06, 2.011e-06, 2.516e-06, 3.13e-06, 3.84e-06, 4.703e-06, 5.486e-06, 6.289e-06, 6.993e-06, 7.494e-06, 8.197e-06, 9.632e-06, 1.113e-05, 1.146e-05, 9.389e-06, 6.135e-06, 6.135e-06]}}
