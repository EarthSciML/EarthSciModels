{
 "esm": "1.0.0",
 "metadata": {
  "name": "rtrn_sweep",
  "description": "RRTM longwave radiative transfer (SUBROUTINE RTRN of phys/module_ra_rrtm.F, WRF 4.8; Mlawer et al. 1997, Iacono's CCM revision): from the quantised gas optical depths ITR and Planck fractions PFRAC of GASABS, the cloud optical depths and fractions, and the layer/level temperatures of the extended RRTM column, compute the Planck sources, the one-angle (diffusivity-angle, secant 1.66) downward and upward radiance sweeps for all 140 g-points with the RRTM cloud-fraction overlap, the clear-sky sweeps, the band-summed and total up/down fluxes, and RRTM's heating rates HTR/HTRC. The two sweeps are esm-spec 4.3.1.1 recurrences over the level index (one per g-point): each level's radiance is the previous level's radiance transmitted through the intervening layer plus that layer's emission, a genuinely sequential integration of the Schwarzschild equation that has no closed form once the layer sources vary (CLAUDE.md: recurrences are reserved for sequential sweeps such as two-stream up/down passes). Layer 1 of rlay is the lowest RRTM layer (surface), level 1 of rlev the surface; the downward sweep is written on a top-counted index and gathered back so that the recurrence reads strictly earlier cells. Gas optics (GASABS/TAUGB1-16) are NOT transcribed: ITR and PFRAC are inputs (stage 3 of PLAN.md).",
  "license": "MIT",
  "tags": [
   "wrf",
   "radiation",
   "longwave",
   "rrtm",
   "radiative-transfer",
   "column"
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 59,
   "description": "Number of model layers (WRF kte); 59 for the em_scm_xy reference column."
  },
  "NBUF": {
   "type": "integer",
   "default": 44,
   "description": "Buffer layers MM5ATM adds above the model top (see rrtm_column.esm); 44 for the reference column. NLAYERS = NLEV + NBUF."
  },
  "NGPT": {
   "type": "integer",
   "default": 140,
   "description": "Number of g-points (RRTM NGPT), 8 to 16 per band."
  },
  "NBANDS": {
   "type": "integer",
   "default": 16,
   "description": "Number of longwave bands."
  },
  "PLANCK_T0": {
   "type": "integer",
   "default": 159,
   "description": "TOTPLNK(i, band) holds the band Planck integral at T = PLANCK_T0 + i kelvin, i = 1..181 (RRTM's INDLEV = INT(T - 159.))."
  },
  "PLANCK_NODES": {
   "type": "integer",
   "default": 181,
   "description": "Temperature nodes of the TOTPLNK table (160..340 K)."
  }
 },
 "index_sets": {
  "rlay": {
   "kind": "interval",
   "size": {
    "op": "+",
    "args": [
     "NLEV",
     "NBUF"
    ]
   }
  },
  "rlev": {
   "kind": "interval",
   "size": {
    "op": "+",
    "args": [
     "NLEV",
     "NBUF",
     1
    ]
   }
  },
  "bands": {
   "kind": "interval",
   "size": "NBANDS"
  },
  "gpts": {
   "kind": "interval",
   "size": "NGPT"
  },
  "gl": {
   "kind": "interval",
   "size": {
    "op": "*",
    "args": [
     "NGPT",
     {
      "op": "+",
      "args": [
       "NLEV",
       "NBUF"
      ]
     }
    ]
   }
  },
  "tnodes": {
   "kind": "interval",
   "size": "PLANCK_NODES"
  }
 },
 "models": {
  "RTRNSweep": {
   "subsystems": {
    "wrf": {
     "ref": "../../../lib/wrf_constants.esm"
    },
    "par": {
     "ref": "./rrtm_parameters.esm"
    }
   },
   "expression_template_imports": [
    {
     "ref": "./rrtm_spectral_tables.esm"
    }
   ],
   "expression_templates": {
    "table_optical_depth": {
     "params": [
      "itr",
      "n_table",
      "bpade",
      "tau_saturated"
     ],
     "description": "The optical depth RTRN actually uses: the TAU table entry at the GASABS index ITR = INT(5000 TFF + 0.5), TAU(ITR) = BPADE (ITR/5000)/(1 - ITR/5000), i.e. the Pade transition fraction quantised to 1/5000 and inverted; the last entry is the saturated value 1e10 (RRTMINIT loop 1000).",
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": ">=",
        "args": [
         "itr",
         "n_table"
        ]
       },
       "tau_saturated",
       {
        "op": "/",
        "args": [
         {
          "op": "*",
          "args": [
           "bpade",
           {
            "op": "/",
            "args": [
             "itr",
             "n_table"
            ]
           }
          ]
         },
         {
          "op": "-",
          "args": [
           1.0,
           {
            "op": "/",
            "args": [
             "itr",
             "n_table"
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "tau_transition": {
     "params": [
      "tau",
      "trans",
      "threshold"
     ],
     "description": "RRTM's tau-transition function TF (linear-in-tau Planck weighting of the layer source): tau/6 for tau below the threshold, else 1 - 2 (1/tau - e^-tau/(1 - e^-tau)) (RRTMINIT loop 1000, written as the closed form rather than the 5001-entry table). The inactive large-tau branch is evaluated at max(tau, threshold) so that it is finite for tau = 0.",
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "<",
        "args": [
         "tau",
         "threshold"
        ]
       },
       {
        "op": "/",
        "args": [
         "tau",
         6.0
        ]
       },
       {
        "op": "-",
        "args": [
         1.0,
         {
          "op": "*",
          "args": [
           2.0,
           {
            "op": "-",
            "args": [
             {
              "op": "/",
              "args": [
               1.0,
               {
                "op": "max",
                "args": [
                 "tau",
                 "threshold"
                ]
               }
              ]
             },
             {
              "op": "/",
              "args": [
               "trans",
               {
                "op": "-",
                "args": [
                 1.0,
                 "trans"
                ]
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "planck_band_integral": {
     "params": [
      "T",
      "b",
      "totplnk",
      "delwave",
      "kelvin"
     ],
     "description": "Band-integrated Planck emission at temperature T (RTRN: DELWAVE(IBAND) (TOTPLNK(IND, IBAND) + FRAC (TOTPLNK(IND+1, IBAND) - TOTPLNK(IND, IBAND))) with IND = INT(T - 159) and FRAC = T - INT(T)): linear interpolation of the TOTPLNK table on its 1 K nodes, times the band width in cm^-1. T is divided by one kelvin so that the table index and the fraction are dimensionless.",
     "body": {
      "op": "*",
      "args": [
       {
        "op": "index",
        "args": [
         "delwave",
         "b"
        ]
       },
       {
        "op": "+",
        "args": [
         {
          "op": "index",
          "args": [
           "totplnk",
           {
            "op": "-",
            "args": [
             {
              "op": "floor",
              "args": [
               {
                "op": "/",
                "args": [
                 "T",
                 "kelvin"
                ]
               }
              ]
             },
             "PLANCK_T0"
            ]
           },
           "b"
          ]
         },
         {
          "op": "*",
          "args": [
           {
            "op": "-",
            "args": [
             {
              "op": "/",
              "args": [
               "T",
               "kelvin"
              ]
             },
             {
              "op": "floor",
              "args": [
               {
                "op": "/",
                "args": [
                 "T",
                 "kelvin"
                ]
               }
              ]
             }
            ]
           },
           {
            "op": "-",
            "args": [
             {
              "op": "index",
              "args": [
               "totplnk",
               {
                "op": "+",
                "args": [
                 {
                  "op": "-",
                  "args": [
                   {
                    "op": "floor",
                    "args": [
                     {
                      "op": "/",
                      "args": [
                       "T",
                       "kelvin"
                      ]
                     }
                    ]
                   },
                   "PLANCK_T0"
                  ]
                 },
                 1
                ]
               },
               "b"
              ]
             },
             {
              "op": "index",
              "args": [
               "totplnk",
               {
                "op": "-",
                "args": [
                 {
                  "op": "floor",
                  "args": [
                   {
                    "op": "/",
                    "args": [
                     "T",
                     "kelvin"
                    ]
                   }
                  ]
                 },
                 "PLANCK_T0"
                ]
               },
               "b"
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "band_value_at_gpoint": {
     "params": [
      "field",
      "ngb",
      "g",
      "l"
     ],
     "description": "The value of a per-band level/layer field at the band NGB(g) of g-point g (RTRN's PLVL(NGB(IPR), LEV)), written as a sum over bands with the band-membership indicator so that no index is taken from a table value.",
     "body": {
      "op": "aggregate",
      "args": [],
      "output_idx": [],
      "ranges": {
       "b": {
        "from": "bands"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "ifelse",
         "args": [
          {
           "op": "==",
           "args": [
            {
             "op": "index",
             "args": [
              "ngb",
              "g"
             ]
            },
            "b"
           ]
          },
          1.0,
          0.0
         ]
        },
        {
         "op": "index",
         "args": [
          "field",
          "b",
          "l"
         ]
        }
       ]
      }
     }
    },
    "band_scalar_at_gpoint": {
     "params": [
      "field",
      "ngb",
      "g"
     ],
     "description": "The value of a per-band scalar field (SEMISS, PLANKBND) at the band of g-point g.",
     "body": {
      "op": "aggregate",
      "args": [],
      "output_idx": [],
      "ranges": {
       "b": {
        "from": "bands"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        {
         "op": "ifelse",
         "args": [
          {
           "op": "==",
           "args": [
            {
             "op": "index",
             "args": [
              "ngb",
              "g"
             ]
            },
            "b"
           ]
          },
          1.0,
          0.0
         ]
        },
        {
         "op": "index",
         "args": [
          "field",
          "b"
         ]
        }
       ]
      }
     }
    },
    "clear_layer_transfer": {
     "params": [
      "incoming",
      "source",
      "absorptance"
     ],
     "description": "Radiance leaving a clear layer: the incoming radiance relaxed towards the layer's linear-in-tau Planck source by the gas absorptance 1 - e^-tau (RTRN loops 2100/4100).",
     "body": {
      "op": "+",
      "args": [
       "incoming",
       {
        "op": "*",
        "args": [
         {
          "op": "-",
          "args": [
           "source",
           "incoming"
          ]
         },
         "absorptance"
        ]
       }
      ]
     }
    },
    "cloudy_layer_transfer": {
     "params": [
      "incoming",
      "gas_source",
      "total_source",
      "absorptance",
      "atot",
      "efclfrac",
      "cldfrac"
     ],
     "description": "Radiance leaving a partly cloudy layer (RTRN loops 2000/4000): the incoming radiance is depleted by the gas absorptance plus the cloud absorptance of the cloudy fraction, the clear part emits the gas source with the gas absorptance and the cloudy fraction emits the Pade-weighted total source with the combined gas+cloud absorptance atot.",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "-",
        "args": [
         "incoming",
         {
          "op": "*",
          "args": [
           "incoming",
           {
            "op": "+",
            "args": [
             "absorptance",
             {
              "op": "*",
              "args": [
               "efclfrac",
               {
                "op": "-",
                "args": [
                 1.0,
                 "absorptance"
                ]
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         "gas_source",
         "absorptance"
        ]
       },
       {
        "op": "*",
        "args": [
         "cldfrac",
         {
          "op": "-",
          "args": [
           {
            "op": "*",
            "args": [
             "total_source",
             "atot"
            ]
           },
           {
            "op": "*",
            "args": [
             "gas_source",
             "absorptance"
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    }
   },
   "variables": {
    "tavel_in": {
     "type": "parameter",
     "units": "K",
     "shape": [
      "rlay"
     ],
     "default": 250.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives `tavel` from the upstream component through a document-level `coupling.variable_map` (`param_to_var`) when the assembly's mount-edge template library lowers `input_tavel` to this parameter (see couplings/rrtm_lw_column.esm). Standalone, `input_tavel` is lowered to a dumped column by the test's library and this parameter is unused (default 0)."
    },
    "tz_in": {
     "type": "parameter",
     "units": "K",
     "shape": [
      "rlev"
     ],
     "default": 250.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives `tz` from the upstream component through a document-level `coupling.variable_map` (`param_to_var`) when the assembly's mount-edge template library lowers `input_tz` to this parameter (see couplings/rrtm_lw_column.esm). Standalone, `input_tz` is lowered to a dumped column by the test's library and this parameter is unused (default 0)."
    },
    "pz_in": {
     "type": "parameter",
     "units": "hPa",
     "shape": [
      "rlev"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives `pz` from the upstream component through a document-level `coupling.variable_map` (`param_to_var`) when the assembly's mount-edge template library lowers `input_pz` to this parameter (see couplings/rrtm_lw_column.esm). Standalone, `input_pz` is lowered to a dumped column by the test's library and this parameter is unused (default 0)."
    },
    "cldfrac_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "rlay"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives `cldfrac` from the upstream component through a document-level `coupling.variable_map` (`param_to_var`) when the assembly's mount-edge template library lowers `input_cldfrac` to this parameter (see couplings/rrtm_lw_column.esm). Standalone, `input_cldfrac` is lowered to a dumped column by the test's library and this parameter is unused (default 0)."
    },
    "taucloud_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "rlay"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives `taucloud` from the upstream component through a document-level `coupling.variable_map` (`param_to_var`) when the assembly's mount-edge template library lowers `input_taucloud` to this parameter (see couplings/rrtm_lw_column.esm). Standalone, `input_taucloud` is lowered to a dumped column by the test's library and this parameter is unused (default 0)."
    },
    "semiss_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "bands"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives `semiss` from the upstream component through a document-level `coupling.variable_map` (`param_to_var`) when the assembly's mount-edge template library lowers `input_semiss` to this parameter (see couplings/rrtm_lw_column.esm). Standalone, `input_semiss` is lowered to a dumped column by the test's library and this parameter is unused (default 0)."
    },
    "pfrac_flat_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gl"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives `pfrac_flat` from the upstream component through a document-level `coupling.variable_map` (`param_to_var`) when the assembly's mount-edge template library lowers `input_pfrac_flat` to this parameter (see couplings/rrtm_lw_column.esm). Standalone, `input_pfrac_flat` is lowered to a dumped column by the test's library and this parameter is unused (default 0)."
    },
    "itr_flat_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "gl"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives `itr_flat` from the upstream component through a document-level `coupling.variable_map` (`param_to_var`) when the assembly's mount-edge template library lowers `input_itr_flat` to this parameter (see couplings/rrtm_lw_column.esm). Standalone, `input_itr_flat` is lowered to a dumped column by the test's library and this parameter is unused (default 0)."
    },
    "tavel": {
     "type": "unknown",
     "units": "K",
     "shape": [
      "rlay"
     ],
     "description": "RRTM layer temperatures TAVEL (extended column, layer 1 lowest)."
    },
    "tz": {
     "type": "unknown",
     "units": "K",
     "shape": [
      "rlev"
     ],
     "description": "RRTM level temperatures TZ(0:NLAYERS); level 1 is the surface."
    },
    "pz": {
     "type": "unknown",
     "units": "hPa",
     "shape": [
      "rlev"
     ],
     "description": "RRTM level pressures PZ(0:NLAYERS) in hPa."
    },
    "cldfrac": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rlay"
     ],
     "description": "Layer cloud fraction CLDFRAC (0 or 1 with WRF's icloud = 1 overcast forcing)."
    },
    "taucloud": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rlay"
     ],
     "description": "Layer cloud optical depth TAUCLOUD (MM5ATM)."
    },
    "semiss": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "bands"
     ],
     "description": "Surface emissivity per band SEMISS."
    },
    "tbound": {
     "type": "parameter",
     "units": "K",
     "default": 288.0,
     "description": "Surface (skin) temperature TBOUND."
    },
    "pfrac_flat": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gl"
     ],
     "description": "GASABS Planck fractions PFRAC(NGPT, NLAYERS) flattened g-point fastest: element (l-1) NGPT + g is PFRAC(g, l)."
    },
    "itr_flat": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gl"
     ],
     "description": "GASABS table indices ITR(NGPT, NLAYERS) flattened g-point fastest (integers 0..5000 carried as reals)."
    },
    "pfrac": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts",
      "rlay"
     ],
     "description": "Planck fraction of each g-point in each layer (PFRAC)."
    },
    "itr": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts",
      "rlay"
     ],
     "description": "Quantised transition-fraction index of each g-point and layer (ITR)."
    },
    "ngb": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts"
     ],
     "description": "Band of each g-point (RRTM NGB)."
    },
    "delwave": {
     "type": "unknown",
     "units": "1/cm",
     "shape": [
      "bands"
     ],
     "description": "Band widths in wavenumber (RRTM DELWAVE)."
    },
    "totplnk": {
     "type": "unknown",
     "units": "W*cm/m^2",
     "shape": [
      "tnodes",
      "bands"
     ],
     "description": "Band-integrated Planck function per unit wavenumber at T = PLANCK_T0 + i (RRTM TOTPLNK table, in the units that make DELWAVE TOTPLNK x WTNUM FLUXFAC a flux in W/m^2). Spelled as an aggregate over the const table rather than the bare const: the Rust CLI folds a gather from a bare const array at interpreter-build time, before document-level couplings are applied, so with the temperatures coupled in (couplings/rrtm_lw_column.esm) the fold saw T = 0 and failed with E_TREEWALK_CONSTARRAY_OOB (repro esm-repro/assemblies/rrtm/probe_chain_const.esm vs probe_chain_constagg.esm)."
    },
    "tau_gas": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts",
      "rlay"
     ],
     "description": "Diffusivity-weighted gas optical depth as RTRN uses it: the TAU table entry at ITR (ODCLR)."
    },
    "trans_gas": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts",
      "rlay"
     ],
     "description": "Gas transmittance e^-tau (TRANS(ITR))."
    },
    "abss": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts",
      "rlay"
     ],
     "description": "Gas absorptance 1 - TRANS(ITR) (ABSS)."
    },
    "tf": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts",
      "rlay"
     ],
     "description": "Tau-transition function TF(ITR) weighting the layer source between the layer-mean and the level Planck emissions."
    },
    "icld": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rlay"
     ],
     "description": "Cloud indicator ICLDLYR: 1 where CLDFRAC > 0."
    },
    "odcld": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rlay"
     ],
     "description": "Diffusivity-weighted cloud optical depth SECANG TAUCLOUD (ODCLD)."
    },
    "abscld": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rlay"
     ],
     "description": "Cloud absorptance 1 - e^-ODCLD (ABSCLD)."
    },
    "efclfrac": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "rlay"
     ],
     "description": "Effective cloud fraction ABSCLD CLDFRAC (EFCLFRAC)."
    },
    "atot": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts",
      "rlay"
     ],
     "description": "Combined gas + cloud absorptance ABSS + ABSCLD - ABSS ABSCLD (ATOT)."
    },
    "factot": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "gpts",
      "rlay"
     ],
     "description": "Pade transition fraction of the total (gas + cloud) optical depth, ODSM/(BPADE + ODSM) (FACTOT), the source weight used in cloudy layers."
    },
    "plvl": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "bands",
      "rlev"
