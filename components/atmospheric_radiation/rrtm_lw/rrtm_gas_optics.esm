   "expression_templates": {
    "row_lower": {
     "params": [
      "jp",
      "jt",
      "nsp",
      "js"
     ],
     "description": "Row of a lower-atmosphere k-table ABSA at reference pressure JP and temperature JT with mixing point JS: ((JP - 1) 5 + (JT - 1)) NSP + JS (TAUGBn IND0).",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             {
              "op": "-",
              "args": [
               "jp",
               1.0
              ]
             },
             5.0
            ]
           },
           {
            "op": "-",
            "args": [
             "jt",
             1.0
            ]
           }
          ]
         },
         "nsp"
        ]
       },
       "js"
      ]
     }
    },
    "row_lower_next": {
     "params": [
      "jp",
      "jt1",
      "nsp",
      "js"
     ],
     "description": "Row of ABSA at the next reference pressure JP + 1 and temperature JT1: (JP 5 + (JT1 - 1)) NSP + JS (TAUGBn IND1).",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             "jp",
             5.0
            ]
           },
           {
            "op": "-",
            "args": [
             "jt1",
             1.0
            ]
           }
          ]
         },
         "nsp"
        ]
       },
       "js"
      ]
     }
    },
    "row_upper": {
     "params": [
      "jp",
      "jt",
      "nsp",
      "js",
      "jp0"
     ],
     "description": "Row of an upper-atmosphere k-table ABSB, whose first reference pressure is JP0 (13, or 7 for band 8): ((JP - JP0) 5 + (JT - 1)) NSP + JS.",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             {
              "op": "-",
              "args": [
               "jp",
               "jp0"
              ]
             },
             5.0
            ]
           },
           {
            "op": "-",
            "args": [
             "jt",
             1.0
            ]
           }
          ]
         },
         "nsp"
        ]
       },
       "js"
      ]
     }
    },
    "row_upper_next": {
     "params": [
      "jp",
      "jt1",
      "nsp",
      "js",
      "jp0"
     ],
     "description": "Row of ABSB at reference pressure JP + 1: ((JP - JP0 + 1) 5 + (JT1 - 1)) NSP + JS.",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             {
              "op": "+",
              "args": [
               {
                "op": "-",
                "args": [
                 "jp",
                 "jp0"
                ]
               },
               1.0
              ]
             },
             5.0
            ]
           },
           {
            "op": "-",
            "args": [
             "jt1",
             1.0
            ]
           }
          ]
         },
         "nsp"
        ]
       },
       "js"
      ]
     }
    },
    "k_bilinear": {
     "params": [
      "tab",
      "ind0",
      "ind1",
      "f00",
      "f10",
      "f01",
      "f11",
      "g"
     ],
     "description": "Absorption coefficient interpolated in ln p and T between the four k-table nodes (JP, JT), (JP, JT+1), (JP+1, JT1), (JP+1, JT1+1) with the SETCOEF weights: FAC00 k[IND0] + FAC10 k[IND0+1] + FAC01 k[IND1] + FAC11 k[IND1+1] (TAUGBn, single-species bands).",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         "f00",
         {
          "op": "index",
          "args": [
           "tab",
           "ind0",
           "g"
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         "f10",
         {
          "op": "index",
          "args": [
           "tab",
           {
            "op": "+",
            "args": [
             "ind0",
             1.0
            ]
           },
           "g"
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         "f01",
         {
          "op": "index",
          "args": [
           "tab",
           "ind1",
           "g"
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         "f11",
         {
          "op": "index",
          "args": [
           "tab",
           {
            "op": "+",
            "args": [
             "ind1",
             1.0
            ]
           },
           "g"
          ]
         }
        ]
       }
      ]
     }
    },
    "k_trilinear": {
     "params": [
      "tab",
      "ind0",
      "ind1",
      "nsp",
      "fs",
      "f00",
      "f10",
      "f01",
      "f11",
      "g"
     ],
     "description": "Absorption coefficient of a two-species band interpolated in ln p, T and the species parameter: the bilinear form at mixing point JS (rows IND0, IND0+NSP, IND1, IND1+NSP, weight 1 - FS) plus the same at JS + 1 (rows shifted by one, weight FS); TAUGBn's FAC000..FAC111 = (1 - FS or FS) x FAC00..FAC11.",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         {
          "op": "-",
          "args": [
           1.0,
           "fs"
          ]
         },
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             "f00",
             {
              "op": "index",
              "args": [
               "tab",
               "ind0",
               "g"
              ]
             }
            ]
           },
           {
            "op": "*",
            "args": [
             "f10",
             {
              "op": "index",
              "args": [
               "tab",
               {
                "op": "+",
                "args": [
                 "ind0",
                 "nsp"
                ]
               },
               "g"
              ]
             }
            ]
           },
           {
            "op": "*",
            "args": [
             "f01",
             {
              "op": "index",
              "args": [
               "tab",
               "ind1",
               "g"
              ]
             }
            ]
           },
           {
            "op": "*",
            "args": [
             "f11",
             {
              "op": "index",
              "args": [
               "tab",
               {
                "op": "+",
                "args": [
                 "ind1",
                 "nsp"
                ]
               },
               "g"
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         "fs",
         {
          "op": "+",
          "args": [
           {
            "op": "*",
            "args": [
             "f00",
             {
              "op": "index",
              "args": [
               "tab",
               {
                "op": "+",
                "args": [
                 "ind0",
                 1.0
                ]
               },
               "g"
              ]
             }
            ]
           },
           {
            "op": "*",
            "args": [
             "f10",
             {
              "op": "index",
              "args": [
               "tab",
               {
                "op": "+",
                "args": [
                 "ind0",
                 "nsp",
                 1.0
                ]
               },
               "g"
              ]
             }
            ]
           },
           {
            "op": "*",
            "args": [
             "f01",
             {
              "op": "index",
              "args": [
               "tab",
               {
                "op": "+",
                "args": [
                 "ind1",
                 1.0
                ]
               },
               "g"
              ]
             }
            ]
           },
           {
            "op": "*",
            "args": [
             "f11",
             {
              "op": "index",
              "args": [
               "tab",
               {
                "op": "+",
                "args": [
                 "ind1",
                 "nsp",
                 1.0
                ]
               },
               "g"
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "self_continuum": {
     "params": [
      "tab",
      "inds",
      "selffac",
      "selffrac",
      "g"
     ],
     "description": "Water-vapour self-continuum coefficient: SELFFAC (SELFREF[INDSELF] + SELFFRAC (SELFREF[INDSELF+1] - SELFREF[INDSELF])), linear in temperature between the two SELFREF rows (TAUGBn).",
     "body": {
      "op": "*",
      "args": [
       "selffac",
       {
        "op": "+",
        "args": [
         {
          "op": "index",
          "args": [
           "tab",
           "inds",
           "g"
          ]
         },
         {
          "op": "*",
          "args": [
           "selffrac",
           {
            "op": "-",
            "args": [
             {
              "op": "index",
              "args": [
               "tab",
               {
                "op": "+",
                "args": [
                 "inds",
                 1.0
                ]
               },
               "g"
              ]
             },
             {
              "op": "index",
              "args": [
               "tab",
               "inds",
               "g"
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "species_parameter": {
     "params": [
      "ca",
      "cb",
      "strrat",
      "cap"
     ],
     "description": "Mixing parameter of a two-species band, SPECPARM = ca/(ca + STRRAT cb) capped at ONEMINUS (TAUGBn).",
     "body": {
      "op": "min",
      "args": [
       {
        "op": "/",
        "args": [
         "ca",
         {
          "op": "+",
          "args": [
           "ca",
           {
            "op": "*",
            "args": [
             "strrat",
             "cb"
            ]
           }
          ]
         }
        ]
       },
       "cap"
      ]
     }
    },
    "mixing_bin": {
     "params": [
      "specparm",
      "n"
     ],
     "description": "Mixing-dimension bin JS = 1 + INT(n SPECPARM) (the argument is non-negative, so INT = floor).",
     "body": {
      "op": "+",
      "args": [
       1.0,
       {
        "op": "floor",
        "args": [
         {
          "op": "*",
          "args": [
           "n",
           "specparm"
          ]
         }
        ]
       }
      ]
     }
    },
    "mixing_fraction": {
     "params": [
      "specparm",
      "n"
     ],
     "description": "Position within the mixing bin, FS = MOD(n SPECPARM, 1) = n SPECPARM - floor(n SPECPARM).",
     "body": {
      "op": "-",
      "args": [
       {
        "op": "*",
        "args": [
         "n",
         "specparm"
        ]
       },
       {
        "op": "floor",
        "args": [
         {
          "op": "*",
          "args": [
           "n",
           "specparm"
          ]
         }
        ]
       }
      ]
     }
    },
    "planck_fraction": {
     "params": [
      "tab",
      "js",
      "fs",
      "g"
     ],
     "description": "Planck fraction interpolated linearly in the mixing dimension: FRACREF[g, JS] + FS (FRACREF[g, JS+1] - FRACREF[g, JS]).",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "index",
        "args": [
         "tab",
         "g",
         "js"
        ]
       },
       {
        "op": "*",
        "args": [
         "fs",
         {
          "op": "-",
          "args": [
           {
            "op": "index",
            "args": [
             "tab",
             "g",
             {
              "op": "+",
              "args": [
               "js",
               1.0
              ]
             }
            ]
           },
           {
            "op": "index",
            "args": [
             "tab",
             "g",
             "js"
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "reference_ratio": {
     "params": [
      "colref1",
      "colref2",
      "wcomb1",
      "wcomb2",
      "fp"
     ],
     "description": "N2O-to-combined-species ratio of the reference atmosphere interpolated in ln p between reference pressures JP and JP + 1 with FP = FAC01 + FAC11: colref1/wcomb1 + FP (colref2/wcomb2 - colref1/wcomb1) (TAUGB3/8/9 RATIO).",
     "body": {
      "op": "+",
      "args": [
       {
        "op": "/",
        "args": [
         "colref1",
         "wcomb1"
        ]
       },
       {
        "op": "*",
        "args": [
         "fp",
         {
          "op": "-",
          "args": [
           {
            "op": "/",
            "args": [
             "colref2",
             "wcomb2"
            ]
           },
           {
            "op": "/",
            "args": [
             "colref1",
             "wcomb1"
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "corr_sqrt_over": {
     "params": [
      "fp_q"
     ],
     "description": "TAUGB2's CORR1 at the quantised pressure fraction: sqrt(FP)/FP (1 at FP = 0 and FP = 1; RRTMINIT loop 1200).",
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "or",
        "args": [
         {
          "op": "<=",
          "args": [
           "fp_q",
           0.0
          ]
         },
         {
          "op": ">=",
          "args": [
           "fp_q",
           1.0
          ]
         }
        ]
       },
       1.0,
       {
        "op": "/",
        "args": [
         {
          "op": "sqrt",
          "args": [
           {
            "op": "max",
            "args": [
             "fp_q",
             1e-12
            ]
           }
          ]
         },
         {
          "op": "max",
          "args": [
           "fp_q",
           1e-12
          ]
         }
        ]
       }
      ]
     }
    },
    "corr_one_minus_sqrt": {
     "params": [
      "fp_q"
     ],
     "description": "TAUGB2's CORR2 at the quantised pressure fraction: (1 - sqrt(FP))/(1 - FP) (1 at FP = 0 and FP = 1).",
     "body": {
      "op": "ifelse",
      "args": [
       {
        "op": "or",
        "args": [
         {
          "op": "<=",
          "args": [
           "fp_q",
           0.0
          ]
         },
         {
          "op": ">=",
          "args": [
           "fp_q",
           1.0
          ]
         }
        ]
       },
       1.0,
       {
        "op": "/",
        "args": [
         {
          "op": "-",
          "args": [
           1.0,
           {
            "op": "sqrt",
            "args": [
             {
              "op": "max",
              "args": [
               "fp_q",
               1e-12
              ]
             }
            ]
           }
          ]
         },
         {
          "op": "-",
          "args": [
           1.0,
           {
            "op": "min",
            "args": [
             "fp_q",
             0.999999999
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "flat_index_g": {
     "params": [
      "i",
      "ng"
     ],
     "description": "g-point of flat element i of a [g, layer] field flattened g-point fastest: 1 + (i - 1) mod ng.",
     "body": {
      "op": "+",
      "args": [
       1.0,
       {
        "op": "-",
        "args": [
         {
          "op": "-",
          "args": [
           "i",
           1.0
          ]
         },
         {
          "op": "*",
          "args": [
           "ng",
           {
            "op": "floor",
            "args": [
             {
              "op": "/",
              "args": [
               {
                "op": "-",
                "args": [
                 "i",
                 1.0
                ]
               },
               "ng"
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    "flat_index_layer": {
     "params": [
      "i",
      "ng"
     ],
     "description": "Layer of flat element i of a [g, layer] field flattened g-point fastest: 1 + floor((i - 1)/ng).",
     "body": {
      "op": "+",
      "args": [
       1.0,
       {
        "op": "floor",
        "args": [
         {
          "op": "/",
          "args": [
           {
            "op": "-",
            "args": [
             "i",
             1.0
            ]
           },
           "ng"
          ]
         }
        ]
       }
      ]
     }
    }
   },
