     "shape": [
      "g02",
      "rlay"
     ],
     "description": "Gas optical depth TAUG of the 14 g-points of band 2 in each RRTM layer (TAUGB2)."
    },
    "pfrac_b02": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "g02",
      "rlay"
     ],
     "description": "Planck fraction PFRAC of the g-points of band 2 in each layer (TAUGB2)."
    },
