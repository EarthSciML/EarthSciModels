{
  "esm": "1.0.0",
  "metadata": {
    "name": "lacis_hansen_absorptance",
    "description": "Broadband solar absorptance of water vapour as a function of the slant water-vapour path, the Lacis and Hansen (1974, eq. 16) fit A(u) = a u / ((1 + b u)^p + c u) with u in g/cm^2, used by the Dudhia shortwave scheme (SWPARA: TOTABS = 2.9*UGCM/((1.+141.5*UGCM)**0.635+5.925*UGCM)). The coefficients are passed as template parameters so that the scheme's constants table supplies them (lib-style, as in lib/wrf_thermo.esm). The absorptance is cumulative: applied to the vapour path integrated from the top of the atmosphere down to a level it gives the fraction of the beam absorbed above that level, and the layer absorption is the increment of A between the layer's top and bottom.",
    "license": "MIT",
    "tags": ["radiation", "shortwave", "water-vapour", "absorptance", "expression-template"],
    "references": [
      {
        "citation": "Lacis, A. A. and Hansen, J. E. (1974). A parameterization for the absorption of solar radiation in the Earth's atmosphere. J. Atmos. Sci. 31, 118-133.",
        "doi": "10.1175/1520-0469(1974)031<0118:APFTAO>2.0.CO;2"
      }
    ]
  },
  "expression_templates": {
    "lacis_hansen_absorptance": {
      "params": ["u", "a", "b", "p", "c"],
      "description": "A(u) = a u / ((1 + b u)^p + c u); u the slant water-vapour path in units of g/cm^2 (dimensionless after division by the reference path).",
      "body": {
        "op": "/",
        "args": [
          { "op": "*", "args": ["a", "u"] },
          {
            "op": "+",
            "args": [
              { "op": "^", "args": [ { "op": "+", "args": [1.0, { "op": "*", "args": ["b", "u"] }] }, "p" ] },
              { "op": "*", "args": ["c", "u"] }
            ]
          }
        ]
      }
    }
  }
}
