      "expression_templates": {
        "wave_froude": {
          "params": [
            "tp",
            "kz"
          ],
          "description": "Froude number of the wave itself at interface kz + 1/2, given the stress tp it carries there: the displacement amplitude is recovered from the stress as hd = sqrt(tp / tem1), and fro = N hd / U. Reads the consuming model's `brvf`, `tem1_safe` and `velco_safe` by bare name, the keyed-factor convention the EarthSciDiscretizations column rules use for `dz`.",
          "body": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "brvf",
                      "kz"
                    ]
                  },
                  {
                    "op": "sqrt",
                    "args": [
                      {
                        "op": "max",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              "tp",
                              {
                                "op": "index",
                                "args": [
                                  "tem1_safe",
                                  "kz"
                                ]
                              }
                            ]
                          },
                          0.0
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "velco_safe",
                  "kz"
                ]
              }
            ]
          }
        },
        "shutts_min_richardson": {
          "params": [
            "tp",
            "kz"
          ],
          "description": "Shutts's (1985) minimum Richardson number of the flow once the wave of stress tp is superimposed on it: Ri (1 - fro) / (1 + sqrt(Ri) fro)^2. Applied TWICE -- inside the causal sweep, on the stress the sweep has just published for the level below, and afterwards on the finished profile so that the branch record can be asserted level by level. Writing it once is the reason it is a template.",
          "body": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "usqj",
                      "kz"
                    ]
                  },
                  {
                    "op": "-",
                    "args": [
                      1.0,
                      {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "wave_froude",
                        "bindings": {
                          "tp": "tp",
                          "kz": "kz"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "op": "^",
                "args": [
                  {
                    "op": "+",
                    "args": [
                      1.0,
                      {
                        "op": "*",
                        "args": [
                          {
                            "op": "index",
                            "args": [
                              "srj",
                              "kz"
                            ]
                          },
                          {
                            "op": "apply_expression_template",
                            "args": [],
                            "name": "wave_froude",
                            "bindings": {
                              "tp": "tp",
                              "kz": "kz"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  2
                ]
              }
            ]
          }
        }
      }
    }
  }
