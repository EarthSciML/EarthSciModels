        {
          "lhs": "on",
          "rhs": {
            "op": "-",
            "args": [
              1.0,
              "col.ldrag"
            ]
          }
        },
        {
          "lhs": "wdir",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "atan2",
                "args": [
                  "col.ubar",
                  "col.vbar"
                ]
              },
              "wrf.piconst"
            ]
          }
        },
        {
          "lhs": "fdir",
          "rhs": {
            "op": "/",
            "args": [
              "par.mdir",
              {
                "op": "*",
                "args": [
                  2.0,
                  "wrf.piconst"
                ]
              }
            ]
          }
        },
        {
          "lhs": "isec",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": ">=",
                    "args": [
                      {
                        "op": "floor",
                        "args": [
                          {
                            "op": "+",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "fdir",
                                  "wdir"
                                ]
                              },
                              0.5
                            ]
                          }
                        ]
                      },
                      "par.mdir"
                    ]
                  },
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "floor",
                        "args": [
                          {
                            "op": "+",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "fdir",
                                  "wdir"
                                ]
                              },
                              0.5
                            ]
                          }
                        ]
                      },
                      "par.mdir"
                    ]
                  },
                  {
                    "op": "floor",
                    "args": [
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              "fdir",
                              "wdir"
                            ]
                          },
                          0.5
                        ]
                      }
                    ]
                  }
                ]
              },
              1.0
            ]
          }
        },
        {
          "lhs": "nwd",
          "rhs": {
            "op": "index",
            "args": [
              {
                "op": "const",
                "args": [],
                "value": [
                  6,
                  7,
                  5,
                  8,
                  2,
                  3,
                  1,
                  4
                ]
              },
              "isec"
            ]
          }
        },
        {
