            "bindings": {
              "a1": 2,
              "a2": 1,
              "a3": 4,
              "a4": 3,
              "j": "jax"
            }
          }
        },
        {
          "lhs": "sgn",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "<=",
                "args": [
                  "nwd",
                  4
                ]
              },
              1.0,
              -1.0
            ]
          }
        },
        {
          "lhs": "oa",
          "rhs": {
            "op": "*",
            "args": [
              "sgn",
              {
                "op": "apply_expression_template",
                "args": [],
