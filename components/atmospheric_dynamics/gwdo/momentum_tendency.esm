     "lhs": "velco",
     "rhs": "blk.sat.oro.col.velco"
    },
    {
     "lhs": "taud_raw",
     "rhs": {
      "op": "D",
      "args": [
       "taup"
      ],
      "wrt": "lev"
     }
    },
    {
     "lhs": "taud_safe",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": ">=",
        "args": [
         {
          "op": "abs",
          "args": [
           "taud_raw"
          ]
         },
         "par.qmin"
        ]
       },
       "taud_raw",
       "par.qmin"
      ]
     }
    },
    {
     "lhs": "denfac",
     "rhs": {
      "op": "min",
      "args": [
       {
        "op": "/",
        "args": [
         "rho",
         "par.pcutoff_den"
        ]
       },
       1.0
      ]
     }
    },
    {
     "lhs": "dtfac_raw",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "k"
      ],
      "args": [
       "taud_raw",
       "taud_safe",
       "velco",
       "prsl",
       "rho",
       "denfac"
      ],
      "ranges": {
