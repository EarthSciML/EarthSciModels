          {
           "op": "-",
           "args": [
            "kgwdmax",
            1.0
           ]
          }
         ]
        },
        {
         "op": "ifelse",
         "args": [
          {
           "op": ">=",
           "args": [
            {
             "op": "abs",
             "args": [
              {
               "op": "index",
               "args": [
                "taud_raw",
                "k"
               ]
              }
             ]
            },
            "par.qmin"
           ]
          },
          {
           "op": "min",
           "args": [
            1.0,
            {
             "op": "abs",
             "args": [
              {
               "op": "/",
               "args": [
                {
                 "op": "index",
                 "args": [
                  "velco",
                  "k"
                 ]
                },
                {
                 "op": "*",
                 "args": [
                  "deltim",
                  {
                   "op": "index",
                   "args": [
                    "taud_safe",
                    "k"
                   ]
                  }
                 ]
                }
               ]
              }
             ]
            }
           ]
          },
          1.0
         ]
        },
        {
         "op": "ifelse",
         "args": [
          {
           "op": "and",
           "args": [
            {
             "op": "<",
             "args": [
              "k",
              "NLEV"
             ]
            },
            {
             "op": "and",
             "args": [
              {
               "op": ">=",
               "args": [
                {
                 "op": "abs",
                 "args": [
                  {
                   "op": "index",
                   "args": [
                    "taud_raw",
                    "k"
                   ]
                  }
                 ]
                },
                "par.qmin"
               ]
              },
              {
               "op": "<=",
               "args": [
                {
                 "op": "index",
                 "args": [
                  "prsl",
                  "k"
                 ]
                },
                "par.pcutoff"
               ]
              }
             ]
            }
           ]
          },
          {
           "op": "min",
           "args": [
            1.0,
            {
             "op": "*",
             "args": [
              {
               "op": "index",
               "args": [
                "denfac",
                "k"
               ]
              },
              {
               "op": "abs",
               "args": [
                {
                 "op": "/",
                 "args": [
                  {
                   "op": "index",
                   "args": [
                    "velco",
                    "k"
                   ]
                  },
                  {
                   "op": "*",
                   "args": [
                    "deltim",
                    {
                     "op": "index",
                     "args": [
                      "taud_safe",
                      "k"
                     ]
                    }
                   ]
                  }
                 ]
                }
               ]
              }
             ]
            }
           ]
          },
          1.0
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "dtfac",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "k"
      ],
      "args": [
       "dtfac_raw"
      ],
      "ranges": {
       "k": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "ifelse",
       "args": [
        {
         "op": "<",
         "args": [
          "k",
          "NLEV"
         ]
        },
        {
         "op": "index",
         "args": [
          "dtfac_raw",
          "k"
         ]
        },
        {
         "op": "index",
         "args": [
          "dtfac_raw",
          {
           "op": "-",
           "args": [
            "NLEV",
            1
           ]
          }
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "taud",
     "rhs": {
      "op": "*",
      "args": [
       "taud_raw",
       "dtfac"
      ]
     }
    },
    {
     "lhs": "dtaux2d",
     "rhs": {
      "op": "*",
      "args": [
       "taud",
       "xn"
      ]
     }
    },
    {
     "lhs": "dtauy2d",
     "rhs": {
      "op": "*",
      "args": [
       "taud",
       "yn"
      ]
     }
    },
    {
     "lhs": "dusfc",
     "rhs": {
      "op": "-",
      "args": [
       {
        "op": "integral",
        "args": [
         "dtaux2d"
        ],
        "var": "lev",
        "lower": "z_sfc",
        "upper": "z_top"
       }
      ]
     }
    },
    {
     "lhs": "dvsfc",
     "rhs": {
      "op": "-",
      "args": [
       {
        "op": "integral",
        "args": [
         "dtauy2d"
        ],
        "var": "lev",
        "lower": "z_sfc",
        "upper": "z_top"
       }
      ]
     }
    },
    {
     "lhs": "dtaux3d",
     "rhs": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         "dtaux2d",
         "cosa"
        ]
       },
       {
        "op": "*",
        "args": [
         "dtauy2d",
         "sina"
        ]
       }
      ]
     }
    },
    {
     "lhs": "dtauy3d",
     "rhs": {
      "op": "-",
      "args": [
       {
        "op": "*",
        "args": [
         "dtauy2d",
         "cosa"
        ]
       },
       {
        "op": "*",
        "args": [
