       "time": 0.0,
       "reduce": "Linf_error",
       "expected": 0.0,
       "reference": {
        "op": "faq",
        "output_idx": [
         "k"
        ],
        "args": [],
        "ranges": {
         "k": {
          "from": "lev_nodes"
