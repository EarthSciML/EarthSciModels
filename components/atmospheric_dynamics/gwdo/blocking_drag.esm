       "taufb"
      ]
     }
    }
   ],
   "tests": [
    {
     "id": "s2_j61_i39_col30_night_launch_over_the_sangre_de_cristo",
     "description": "Reference run: WRF 4.8 real-terrain simulation of data/eqwefic/notes/gwdo_real_reference_run.md (Last Chance Gulch d01, Colorado Rockies, 8.1 km, 150 x 180 x 50, dt = 45 s, gwd_opt = 1 with ELVMAX supplied by WPS util/compute_gwdo.py -- without it GWDO is silently off everywhere, FORTRAN_BUGS B17). Step 2 = 2012-06-25 12:01Z, global row j = 61 across the Sangre de Cristo range, tile column 30 of the dump that starts at i = 39. Drag is ON (ELVMAX = 1770 m, var = 54 m); wind-rose sector 3 (south-west), aspect ratio od = 1.59, Froude number 0.42, launch stress 0.30 Pa. Above the reference level kref = 5 it has 8 saturating levels, 24 no-wave-breaking levels and a flow-blocking layer, so one column exercises the whole scheme. Reference build: the real64 (kind_phys = real64) replay of the same dumped row through kernels/gwdo_diag_driver of WRF fork branch earthsciml-instrumented-gwdo, with the six scalar constants g, cp, R_d, R_v, eps_1 and pi supplied at binary64 precision instead of WRF's real32 module values (gwdo_real/mkflat64.py). They are subroutine arguments, not internal parameters, so that is what a double-precision kernel reference means for this scheme, and it is exactly what lib/wrf_constants.esm carries; promoting them flips no branch on any of the 140 dumped rows and moves the outputs by a median 2.7e-8 of the row maximum. Every assertion is on an algebraic observed at t = 0 and the document declares no ODE state, so the empty time_span is a single static evaluation.",
     "parameter_overrides": {},
     "expression_template_imports": [
      {
       "ref": "./tests/s2_j61_i39_col30_inputs.esm"
      }
     ],
     "time_span": {
      "start": 0,
      "end": 0
     },
     "tolerance": {
      "rel": 1e-09
     },
     "assertions": [
      {
       "variable": "kblk",
       "time": 0.0,
       "expected": 2.0,
       "tolerance": {
        "abs": 0.0,
        "rel": 0.0
       }
      },
      {
       "variable": "zblk",
       "time": 0.0,
       "expected": 33.147216796875
      },
      {
       "variable": "fbdcd",
       "time": 0.0,
       "expected": 1.3716215945840138
      },
      {
       "variable": "taufb",
       "time": 0.0,
       "reduce": "Linf_error",
       "expected": 0.0,
       "reference": {
        "op": "faq",
        "output_idx": [
         "k"
        ],
        "args": [],
        "ranges": {
         "k": {
          "from": "lev_nodes"
         }
        },
        "expr": {
         "op": "index",
         "args": [
          {
           "op": "const",
           "args": [],
