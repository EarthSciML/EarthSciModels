          "expression_template_imports": [
            {
              "ref": "./tests/s2_j61_i39_col30_inputs.esm"
            }
          ],
          "time_span": {
            "start": 0,
            "end": 0
          },
          "tolerance": {
            "rel": 1e-09
          },
          "assertions": [
