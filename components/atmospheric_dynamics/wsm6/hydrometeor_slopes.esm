{
  "esm": "1.0.0",
  "metadata": {
    "name": "WSM6HydrometeorSlopes",
    "description": "Size-distribution and fall-speed diagnostics of the WRF single-moment 6-class microphysics scheme (WSM6; Hong and Lim 2006), transcribed from slope_wsm6 and the cold-rain preamble of mp_wsm6_run in phys/physics_mmm/mp_wsm6.F90 (WRF 4.8, NCAR/MMM-physics): the temperature-dependent snow intercept factor n0s(T)/n0s (HDC 2004 eq. 6), the inverse slopes lambda^-1 of the exponential rain, snow and graupel distributions and their powers lambda^-b, lambda^-2, lambda^-3 (held at 1/lambda_max below the threshold qcrmin), the diagnosed ice crystal number concentration N_i (HDC eq. 5c), mean ice crystal diameter D_i (HDC eq. 5b) and fall speed V_i (HDC eq. 5a), the mass-weighted fall speeds of rain, snow and graupel V = a Gamma(4+b)/6 lambda^-b (rho0/rho)^(1/2), the ventilation coefficients precs1/2 and precg1/2 of the snow and graupel distributions (mp_wsm6_init products shared by deposition, evaporation and melting), and the combined snow/graupel fall speed WSM6 uses since V3.0. Everything is a pointwise function of the layer state on the layer index `lev` (WRF k, layer 1 at the surface). The process-rate components (warm_rain.esm, cold_accretion.esm, ice_deposition.esm) take the inverse slopes as INPUTS produced by this component, mirroring how the kernel computes them once per sub-step (slope_wsm6) and reuses them in every process; melting_freezing.esm evaluates the same templates at its own, earlier state. Scheme constants come from wsm6_parameters.esm (subsystem `par`) and physical constants from lib/wrf_constants.esm (subsystem `wrf`). Consumer-supplied inputs are the rewrite-target ops `input_<name>` lowered in the inline tests through a per-test template library generated by tools/fill_tests.py from the instrumented WRF dumps.",
    "license": "MIT",
    "tags": ["wrf", "microphysics", "wsm6", "size-distribution", "fall-speed", "column"],
    "references": [
      { "citation": "Hong, S.-Y., and J.-O. J. Lim (2006). The WRF single-moment 6-class microphysics scheme (WSM6). J. Korean Meteor. Soc. 42, 129-151." },
      { "citation": "Hong, S.-Y., J. Dudhia, and S.-H. Chen (2004). A revised approach to ice microphysical processes for the bulk parameterization of clouds and precipitation. Mon. Wea. Rev. 132, 103-120.", "doi": "10.1175/1520-0493(2004)132<0103:ARATIM>2.0.CO;2" },
      { "citation": "Lin, Y.-L., R. D. Farley, and H. D. Orville (1983). Bulk parameterization of the snow field in a cloud model. J. Climate Appl. Meteor. 22, 1065-1092." },
      { "citation": "NCAR/MMM-physics mp_wsm6.F90 at commit 550b5b4 (WRF 4.8 phys/physics_mmm submodule): slope_wsm6 (lines 1653-1730), cold-rain preamble (lines 968-995)." }
    ]
  },
  "metaparameters": { "NLEV": { "type": "integer", "default": 40, "description": "Number of model layers (WRF kte); 40 is the em_quarter_ss supercell reference column." } },
  "index_sets": { "lev": { "kind": "interval", "size": "NLEV" } },
  "models": {
    "WSM6HydrometeorSlopes": {
      "expression_template_imports": [ { "ref": "./microphysics_templates.esm" } ],
      "subsystems": {
        "wrf": { "ref": "../../../lib/wrf_constants.esm" },
        "par": { "ref": "./wsm6_parameters.esm" }
      },
      "variables": {
        "T": { "type": "unknown", "units": "K", "shape": ["lev"], "description": "Absolute temperature." },
        "qi": { "type": "unknown", "units": "kg/kg", "shape": ["lev"], "description": "Cloud-ice mixing ratio." },
        "qr": { "type": "unknown", "units": "kg/kg", "shape": ["lev"], "description": "Rain mixing ratio." },
        "qs": { "type": "unknown", "units": "kg/kg", "shape": ["lev"], "description": "Snow mixing ratio." },
        "qg": { "type": "unknown", "units": "kg/kg", "shape": ["lev"], "description": "Graupel mixing ratio." },
        "rho": { "type": "unknown", "units": "kg/m^3", "shape": ["lev"], "description": "Dry-air density (WSM6 den)." },
        "pidn0r": { "type": "unknown", "units": "kg/m^7", "description": "pi rho_w n0r (WSM6 pidn0r)." },
        "pidn0s": { "type": "unknown", "units": "kg/m^7", "description": "pi rho_s n0s (WSM6 pidn0s)." },
        "pidn0g": { "type": "unknown", "units": "kg/m^7", "description": "pi rho_g n0g (WSM6 pidn0g)." },
        "rslope_r_max": { "type": "unknown", "units": "m", "description": "1/lamdarmax (WSM6 rslopermax)." },
        "rslope_s_max": { "type": "unknown", "units": "m", "description": "1/lamdasmax (WSM6 rslopesmax)." },
        "rslope_g_max": { "type": "unknown", "units": "m", "description": "1/lamdagmax (WSM6 rslopegmax)." },
        "pvtr": { "type": "unknown", "units": "m^(1/5)/s", "description": "Rain fall-speed constant avtr Gamma(4 + bvtr)/6 (WSM6 pvtr)." },
        "precs1": { "type": "unknown", "units": "1/m^4", "description": "Snow deposition/melting coefficient of the non-ventilated term, 4 n0s a_v (WSM6 precs1)." },
        "precs2": { "type": "unknown", "units": "1/(m^(719/200)*s^(1/2))", "description": "Snow deposition/melting coefficient of the ventilated term, 4 n0s b_v sqrt(avts) Gamma(2.5 + bvts/2) (WSM6 precs2); units for bvts = 0.41." },
        "precg1": { "type": "unknown", "units": "1/m^4", "description": "Graupel deposition/melting coefficient of the non-ventilated term, 2 pi n0g a_v (WSM6 precg1)." },
        "precg2": { "type": "unknown", "units": "1/(m^(39/10)*s^(1/2))", "description": "Graupel deposition/melting coefficient of the ventilated term, 2 pi n0g b_v sqrt(avtg) Gamma(2.5 + bvtg/2) (WSM6 precg2); units for bvtg = 0.8." },
        "pvts": { "type": "unknown", "units": "m^(59/100)/s", "description": "Snow fall-speed constant avts Gamma(4 + bvts)/6 (WSM6 pvts)." },
        "pvtg": { "type": "unknown", "units": "m^(1/5)/s", "description": "Graupel fall-speed constant avtg Gamma(4 + bvtg)/6 (WSM6 pvtg)." },
        "denfac": { "type": "unknown", "units": "1", "shape": ["lev"], "description": "Density correction of the fall speed, (rho0/rho)^(1/2) (WSM6 denfac)." },
        "n0sfac": { "type": "unknown", "units": "1", "shape": ["lev"], "description": "Snow intercept temperature factor n0s(T)/n0s (WSM6 n0sfac)." },
        "rslope_r": { "type": "unknown", "units": "m", "shape": ["lev"], "description": "Inverse slope of the raindrop distribution (WSM6 rslope(:,:,1))." },
        "rslopeb_r": { "type": "unknown", "units": "m^(4/5)", "shape": ["lev"], "description": "lambda_r^-bvtr (WSM6 rslopeb(:,:,1))." },
        "rslope2_r": { "type": "unknown", "units": "m^2", "shape": ["lev"], "description": "lambda_r^-2." },
        "rslope3_r": { "type": "unknown", "units": "m^3", "shape": ["lev"], "description": "lambda_r^-3." },
        "rslope_s": { "type": "unknown", "units": "m", "shape": ["lev"], "description": "Inverse slope of the snow distribution with the temperature-dependent intercept (WSM6 rslope(:,:,2))." },
        "rslopeb_s": { "type": "unknown", "units": "m^(41/100)", "shape": ["lev"], "description": "lambda_s^-bvts (WSM6 rslopeb(:,:,2))." },
        "rslope2_s": { "type": "unknown", "units": "m^2", "shape": ["lev"], "description": "lambda_s^-2." },
        "rslope3_s": { "type": "unknown", "units": "m^3", "shape": ["lev"], "description": "lambda_s^-3." },
        "rslope_g": { "type": "unknown", "units": "m", "shape": ["lev"], "description": "Inverse slope of the graupel distribution (WSM6 rslope(:,:,3))." },
        "rslopeb_g": { "type": "unknown", "units": "m^(4/5)", "shape": ["lev"], "description": "lambda_g^-bvtg (WSM6 rslopeb(:,:,3))." },
        "rslope2_g": { "type": "unknown", "units": "m^2", "shape": ["lev"], "description": "lambda_g^-2." },
        "rslope3_g": { "type": "unknown", "units": "m^3", "shape": ["lev"], "description": "lambda_g^-3." },
        "xni": { "type": "unknown", "units": "1/m^3", "shape": ["lev"], "description": "Ice crystal number concentration N_i (WSM6 xni as recomputed in the cold-rain block from the current ice content)." },
        "D_i": { "type": "unknown", "units": "m", "shape": ["lev"], "description": "Mean ice crystal diameter (WSM6 diameter)." },
        "vt_i": { "type": "unknown", "units": "m/s", "shape": ["lev"], "description": "Ice crystal fall speed (WSM6 vt2i)." },
        "vt_r": { "type": "unknown", "units": "m/s", "shape": ["lev"], "description": "Mass-weighted rain fall speed (WSM6 vt2r)." },
        "vt_s": { "type": "unknown", "units": "m/s", "shape": ["lev"], "description": "Mass-weighted snow fall speed (WSM6 vt2s)." },
        "vt_g": { "type": "unknown", "units": "m/s", "shape": ["lev"], "description": "Mass-weighted graupel fall speed (WSM6 vt2g)." },
        "vt_sg": { "type": "unknown", "units": "m/s", "shape": ["lev"], "description": "Mixing-ratio-weighted snow/graupel fall speed (WSM6 vt2ave)." }
      },
      "equations": [
        { "lhs": "T", "rhs": { "op": "input_T", "args": [] } },
        { "lhs": "qi", "rhs": { "op": "input_qi", "args": [] } },
        { "lhs": "qr", "rhs": { "op": "input_qr", "args": [] } },
        { "lhs": "qs", "rhs": { "op": "input_qs", "args": [] } },
        { "lhs": "qg", "rhs": { "op": "input_qg", "args": [] } },
        { "lhs": "rho", "rhs": { "op": "input_rho", "args": [] } },
        { "lhs": "pidn0r", "rhs": { "op": "*", "args": ["wrf.piconst", "wrf.rhowater", "par.n0r"] } },
        { "lhs": "pidn0s", "rhs": { "op": "*", "args": ["wrf.piconst", "par.dens", "par.n0s"] } },
        { "lhs": "pidn0g", "rhs": { "op": "*", "args": ["wrf.piconst", "par.deng", "par.n0g"] } },
        { "lhs": "rslope_r_max", "rhs": { "op": "/", "args": [1, "par.lamdarmax"] } },
        { "lhs": "rslope_s_max", "rhs": { "op": "/", "args": [1, "par.lamdasmax"] } },
        { "lhs": "rslope_g_max", "rhs": { "op": "/", "args": [1, "par.lamdagmax"] } },
        { "lhs": "pvtr", "rhs": { "op": "/", "args": [{ "op": "*", "args": ["par.avtr", "par.g4pbr"] }, 6] } },
        { "lhs": "precs1", "rhs": { "op": "*", "args": [4, "par.n0s", "par.vent_a_snow"] } },
        { "lhs": "precs2", "rhs": { "op": "*", "args": [4, "par.n0s", "par.vent_b_snow", { "op": "sqrt", "args": ["par.avts"] }, "par.g5pbso2"] } },
        { "lhs": "precg1", "rhs": { "op": "*", "args": [2, "wrf.piconst", "par.n0g", "par.vent_a"] } },
        { "lhs": "precg2", "rhs": { "op": "*", "args": [2, "wrf.piconst", "par.n0g", "par.vent_b", { "op": "sqrt", "args": ["par.avtg"] }, "par.g5pbro2"] } },
        { "lhs": "pvts", "rhs": { "op": "/", "args": [{ "op": "*", "args": ["par.avts", "par.g4pbs"] }, 6] } },
        { "lhs": "pvtg", "rhs": { "op": "/", "args": [{ "op": "*", "args": ["par.avtg", "par.g4pbr"] }, 6] } },
        { "lhs": "denfac", "rhs": { "op": "sqrt", "args": [{ "op": "/", "args": ["wrf.rhoair0", "rho"] }] } },
        { "lhs": "n0sfac", "rhs": { "op": "apply_expression_template", "args": [], "name": "snow_intercept_factor", "bindings": { "T": "T", "t0": "wrf.svpt0", "alpha": "par.alpha_n0s", "n0": "par.n0s", "n0max": "par.n0smax" } } },
        { "lhs": "rslope_r", "rhs": { "op": "apply_expression_template", "args": [], "name": "marshall_palmer_inverse_slope", "bindings": { "q": "qr", "rho": "rho", "pidn0": "pidn0r", "q_min": "par.qcrmin", "rslope_max": "rslope_r_max" } } },
        { "lhs": "rslopeb_r", "rhs": { "op": "^", "args": ["rslope_r", "par.bvtr"] } },
        { "lhs": "rslope2_r", "rhs": { "op": "^", "args": ["rslope_r", 2] } },
        { "lhs": "rslope3_r", "rhs": { "op": "^", "args": ["rslope_r", 3] } },
        { "lhs": "rslope_s", "rhs": { "op": "apply_expression_template", "args": [], "name": "marshall_palmer_inverse_slope", "bindings": { "q": "qs", "rho": "rho", "pidn0": { "op": "*", "args": ["pidn0s", "n0sfac"] }, "q_min": "par.qcrmin", "rslope_max": "rslope_s_max" } } },
        { "lhs": "rslopeb_s", "rhs": { "op": "^", "args": ["rslope_s", "par.bvts"] } },
        { "lhs": "rslope2_s", "rhs": { "op": "^", "args": ["rslope_s", 2] } },
        { "lhs": "rslope3_s", "rhs": { "op": "^", "args": ["rslope_s", 3] } },
        { "lhs": "rslope_g", "rhs": { "op": "apply_expression_template", "args": [], "name": "marshall_palmer_inverse_slope", "bindings": { "q": "qg", "rho": "rho", "pidn0": "pidn0g", "q_min": "par.qcrmin", "rslope_max": "rslope_g_max" } } },
        { "lhs": "rslopeb_g", "rhs": { "op": "^", "args": ["rslope_g", "par.bvtg"] } },
        { "lhs": "rslope2_g", "rhs": { "op": "^", "args": ["rslope_g", 2] } },
        { "lhs": "rslope3_g", "rhs": { "op": "^", "args": ["rslope_g", 3] } },
        { "lhs": "xni", "rhs": { "op": "apply_expression_template", "args": [], "name": "ice_crystal_number", "bindings": { "qi": "qi", "rho": "rho", "q_min": "par.qmin", "coef": "par.xni_coef", "n_min": "par.xni_min", "n_max": "par.xni_max" } } },
        { "lhs": "D_i", "rhs": { "op": "apply_expression_template", "args": [], "name": "ice_crystal_diameter", "bindings": { "qi": "qi", "rho": "rho", "xni": "xni", "dicon": "par.dicon", "dimax": "par.dimax" } } },
        { "lhs": "vt_i", "rhs": { "op": "apply_expression_template", "args": [], "name": "ice_crystal_fall_speed", "bindings": { "D": "D_i", "coef": "par.vt_ice_coef", "expn": "par.vt_ice_exp" } } },
        { "lhs": "vt_r", "rhs": { "op": "apply_expression_template", "args": [], "name": "precipitation_fall_speed", "bindings": { "pvt": "pvtr", "rslopeb": "rslopeb_r", "denfac": "denfac" } } },
        { "lhs": "vt_s", "rhs": { "op": "apply_expression_template", "args": [], "name": "precipitation_fall_speed", "bindings": { "pvt": "pvts", "rslopeb": "rslopeb_s", "denfac": "denfac" } } },
        { "lhs": "vt_g", "rhs": { "op": "apply_expression_template", "args": [], "name": "precipitation_fall_speed", "bindings": { "pvt": "pvtg", "rslopeb": "rslopeb_g", "denfac": "denfac" } } },
        { "lhs": "vt_sg", "rhs": { "op": "apply_expression_template", "args": [], "name": "snow_graupel_weighted_mean", "bindings": { "x_s": "vt_s", "q_s": "qs", "x_g": "vt_g", "q_g": "qg", "q_floor": "par.qmin" } } }
      ],
      "tests": [
        {
          "id": "qss_step250_row23_col24_mixed_phase",
          "description": "Reference: WRF 4.8 em_quarter_ss idealized supercell (GNU real32 build, dx = 2 km, dt = 12 s, 40 layers, WSM6 only) dumped by the instrumented ctessum-claude/WRF fork (module_esm_dump with esm_dump_inner hooks inside mp_wsm6_run of the ctessum-claude/MMM-physics fork, commit 52cfbd7) and replayed through the real64 (kind_phys = real64) standalone kernels/wsm6_driver at the WRF step. POINTWISE and step-free: the inputs are the state at which the kernel evaluates its process rates (t_rates, qi/qr/qs/qg_rates: after the sub-step's sedimentation, melting, freezing and the slope update; den: kernel argument), the expected values are the inverse slopes, their powers and n0sfac the kernel dumps for that state and the mp_wsm6_init constants, all from the real64 replay. The rates state is the correct one because slope_wsm6 is called again after melting/freezing ('update the slope parameters for microphysics computation'). Real64 replay vs real32 in-model dump: 3-4e-7 relative in rslope*. Residual esm-vs-real64 mismatch comes from the kernel's default-real literals and real32 WRF constants (pi, bvtr, bvts, avts, dens, n0s, ...; FORTRAN_BUGS.md N2): measured with zero tolerances it is <= 3e-8 relative in the inverse slopes and their powers, 1.5e-8 in the fall-speed constants; tolerances are 1e-6 relative (5-10x the measured residual) on scalars and spot checks and absolute Linf bounds at 1e-6 of each column's maximum. xni, D_i and the fall speeds are not dumped by the kernel at this state (the dumped xni is the stale value from before the ice fallout) and are checked through the accretion and deposition rates they enter (cold_accretion.esm, ice_deposition.esm). Regime: supercell step 250 (t = 50 min), tile row j = 23, column i = 24: rain in layers 1-16 (up to 1.3e-2 kg/kg), snow in layers 6-33 and graupel in layers 1-33 (up to 1e-2), ice in layers 9-39, freezing level at layer 9, temperatures 199-298 K so n0sfac spans 1 to 7.5e3.",
          "parameter_overrides": {},
          "expression_template_imports": [
            {
              "ref": "./tests/qss_step250_row23_col24_mixed_phase_inputs.esm"
            }
          ],
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "pidn0r",
              "time": 0.0,
              "expected": 25132741928.100586,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "pidn0s",
              "time": 0.0,
              "expected": 628318548.2025146,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "pidn0g",
              "time": 0.0,
              "expected": 6283185482.0251465,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "rslope_r_max",
              "time": 0.0,
              "expected": 1.25e-05,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "rslope_s_max",
              "time": 0.0,
              "expected": 1e-05,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "rslope_g_max",
              "time": 0.0,
              "expected": 1.6666666666666667e-05,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "pvtr",
              "time": 0.0,
              "expected": 2500.068237337106,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "pvts",
              "time": 0.0,
              "expected": 20.051785002845385,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "pvtg",
              "time": 0.0,
              "expected": 979.9530756581653,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "precs1",
              "time": 0.0,
              "expected": 5199999.809265137,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "precs2",
              "time": 0.0,
              "expected": 18681871.662510514,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "precg1",
              "time": 0.0,
              "expected": 19603537.984864943,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "precg2",
              "time": 0.0,
              "expected": 258522819.51234746,
              "tolerance": {
                "rel": 1e-06
              }
            },
            {
              "variable": "denfac",
              "time": 0.0,
              "reduce": "Linf_error",
              "expected": 0.0,
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "k"
                ],
                "args": [],
                "ranges": {
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": {
                  "op": "index",
                  "args": [
                    {
                      "op": "const",
                      "args": [],
                      "value": [1.074297648601964, 1.0988758165188706, 1.1288867811848777, 1.1602700614599697, 1.192123954468512, 1.2246820558855798, 1.2582500928449838, 1.292808506687401, 1.3283037231725008, 1.3645763776496205, 1.4020583602973977, 1.4396854385640094, 1.4835556358342181, 1.5248115440101326, 1.5664510609796232, 1.6091176379658874, 1.6525457933489218, 1.6967181474622186, 1.74166539824332, 1.787388938078431, 1.833815931787568, 1.8819464686130778, 1.930171827665902, 1.9789910276164668, 2.0287444851154315, 2.08004478930757, 2.1338844217674344, 2.192584031512916, 2.272919650733487, 2.4071314861423874, 2.517537815782692, 2.628772485136029, 2.7445896462038344, 2.862603538137479, 2.982749200059628, 3.1061754351938746, 3.2347614364631796, 3.3704631345827436, 3.515037802394403, 3.669399516419166]
                    },
                    "k"
                  ]
                }
              },
              "tolerance": {
                "abs": 4e-06
              }
            },
            {
              "variable": "n0sfac",
              "time": 0.0,
              "reduce": "Linf_error",
              "expected": 0.0,
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "k"
                ],
                "args": [],
                "ranges": {
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": {
                  "op": "index",
                  "args": [
                    {
