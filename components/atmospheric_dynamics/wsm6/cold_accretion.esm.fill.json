        { "variable": "praci_lim", "expr": "praci_raw[:40]", "axis": "lev", "reduce": "Linf_error", "tolerance": { "abs": 0 } },
        { "variable": "piacr_lim", "expr": "piacr_raw[:40]", "axis": "lev", "reduce": "Linf_error", "tolerance": { "abs": 0 } },
        { "variable": "psaci_lim", "expr": "psaci_raw[:40]", "axis": "lev", "reduce": "Linf_error", "tolerance": { "abs": 0 } },
