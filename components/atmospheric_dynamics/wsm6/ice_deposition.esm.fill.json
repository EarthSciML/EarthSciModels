        { "variable": "ifsat_i", "expr": "0*pidep_raw", "axis": "lev", "reduce": "Linf_error", "tolerance": { "abs": 0 } },
        { "variable": "ifsat_g", "expr": "0*pidep_raw", "axis": "lev", "reduce": "Linf_error", "tolerance": { "abs": 0 } },
        { "variable": "pidep", "expr": "pidep_raw", "coords": { "lev": [9, 16, 24, 31] }, "tolerance": { "rel": 2e-6 } },
        { "variable": "psdep", "expr": "psdep_raw", "coords": { "lev": [9, 16, 24, 30] }, "tolerance": { "rel": 2e-6 } },
        { "variable": "pgdep", "expr": "pgdep_raw", "coords": { "lev": [9, 16, 24, 32] }, "tolerance": { "rel": 2e-6 } },
        { "variable": "pigen", "expr": "pigen_raw", "coords": { "lev": [9, 14, 20] }, "tolerance": { "rel": 5e-6 } },
        { "variable": "psaut", "expr": "psaut_raw", "coords": { "lev": [21, 22, 23, 24] }, "tolerance": { "rel": 5e-5 } },
        { "variable": "pgaut", "expr": "pgaut_raw", "coords": { "lev": [16, 22, 28] }, "tolerance": { "rel": 2e-6 } },
        { "variable": "pidep", "expr": "0*pidep_raw", "coords": { "lev": [1, 8] }, "tolerance": { "abs": 0 } }
      ]
    },
