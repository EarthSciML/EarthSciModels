                 {
                   "op": "const",
                   "args": [],
                   "value": [0.013846929986437152, 0.01431545246008718, 0.013406498535241767, 0.012247837187339947, 0.011006286044407372, 0.00976554190095171, 0.008616316545074238, 0.0075516864864423406, 0.006558786174679419, 0.005613339946519703, 0.00477437239028923, 0.0039012283979696074, 0.0035489224819867677, 0.0030243853306430287, 0.0024339708277143638, 0.001926357384978141, 0.0014903549403630968, 0.0011230442016815815, 0.0008248739432073163, 0.0005908604296220768, 0.00041115188424143236, 0.0001660910358643979, 0.00011123353671478709, 6.988452865904442e-05, 4.231984800555517e-05, 2.505321183266298e-05, 1.500512737996692e-05, 9.556008285669237e-06, 1.0146409744070776e-05, 3.602801224554805e-05, 4.106390282050772e-05, 4.628168599247572e-05, 5.233629053691403e-05, 5.885793143534648e-05, 6.558828317793539e-05, 7.24658602848649e-05, 7.955444016261026e-05, 8.704032370587811e-05, 9.51660840655677e-05, 0.00010392525291536003]
