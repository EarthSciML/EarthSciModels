     "shape": [
      "lev_nodes"
     ],
     "description": "Entrainment-zone heat diffusivity sqrt(-w_e dz_h exp(-entfac) K_h_fa), bounded by [xkzminh, xkzmax]."
    },
    "K_m_ent": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "lev_nodes"
     ],
     "description": "Entrainment-zone momentum diffusivity sqrt(K_h_ent K_m_fa) (prpbl = 1), bounded by [xkzminm, xkzmax]."
    },
    "K_h": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "lev_nodes"
     ],
     "description": "Heat eddy diffusivity on the interfaces (WRF exch_hx; zero on the two domain faces)."
    },
    "K_m": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "lev_nodes"
     ],
     "description": "Momentum eddy diffusivity on the interfaces (WRF exch_mx)."
    },
    "K_q": {
     "type": "unknown",
     "units": "m^2/s",
     "shape": [
      "lev_nodes"
     ],
     "description": "Water (vapor, cloud, ice) eddy diffusivity on the interfaces (WRF xkzq; equals K_h above the boundary layer)."
    },
    "rhoK_h": {
     "type": "unknown",
     "units": "kg/(m*s)",
     "shape": [
      "lev_nodes"
     ],
     "description": "rho_n K_h, the interface coefficient handed to the flux-form diffusion rule."
    },
    "rhoK_m": {
     "type": "unknown",
     "units": "kg/(m*s)",
     "shape": [
      "lev_nodes"
     ],
