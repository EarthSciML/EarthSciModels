    },
    "phi_theta": {
     "type": "unknown",
     "units": "K*kg/(m^2*s)",
     "shape": [
      "lev_nodes"
     ],
     "description": "Prescribed (non-gradient) part of rho times the theta flux, in the rule's rho K dc/dz sign convention: -hfx/cp on the surface, rho_n (-K_h gamma_h - hfxpbl zfacent) inside the boundary layer when pblflg, 0 elsewhere and on the top."
    },
    "phi_u": {
     "type": "unknown",
     "units": "kg/(m*s^2)",
     "shape": [
      "lev_nodes"
     ],
     "description": "Prescribed part of rho times the u flux: rho_s u_*^2 |U_1| u_1/|U|^2 on the surface (the WRF surface drag), rho_n (-K_m gamma_u - ufxpbl zfacent) inside the boundary layer."
    },
    "phi_v": {
     "type": "unknown",
     "units": "kg/(m*s^2)",
