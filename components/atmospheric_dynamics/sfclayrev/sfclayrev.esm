         "hfx_in": 0.0,
         "qfx_in": 0.0,
         "ustm_in": 0.0,
         "chs_in": 0.0,
         "chs2_in": 0.0,
         "cqs2_in": 4.742500840163872e+30,
         "isfflx": 1.0,
         "shalwater_z0": 0.0,
         "scm_force_flux": 0.0,
         "isftcflx": 0.0,
         "iz0tlnd": 0.0
       },
