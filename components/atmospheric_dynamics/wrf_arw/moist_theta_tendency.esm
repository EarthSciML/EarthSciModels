      "args": []
     }
    },
    {
     "lhs": "dqv_dt_phys",
     "rhs": {
      "op": "input_dqv_dt_phys",
      "args": []
     }
    },
    {
     "lhs": "theta",
     "rhs": {
      "op": "/",
      "args": [
       "theta_m",
       {
        "op": "+",
        "args": [
