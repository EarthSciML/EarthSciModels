{
 "esm": "1.2.0",
 "metadata": {
  "name": "WRFMoistThetaTendency",
  "description": "WRF-ARW's conversion of the physics temperature tendency into a tendency of the moist potential temperature when the dynamics carries theta_m (use_theta_m = 1, the WRF 4 default): SUBROUTINE conv_t_tendf_to_moist of dyn_em/module_big_step_utilities_em.F:6674-6707, called once per step from dyn_em/module_first_rk_step_part2.F after update_phy_ten has summed the physics tendencies. The physics schemes compute tendencies of the DRY potential temperature theta and of q_v; the dynamics prognoses theta_m = theta (1 + (R_v/R_d) q_v), so the tendency it needs is the product-rule derivative (1 + (R_v/R_d) q_v) dtheta/dt + (R_v/R_d) theta dq_v/dt, with theta recovered from the step's theta_m and q_v as theta_m / (1 + (R_v/R_d) q_v) (the Fortran's (t_1 + T0)/(1 + R_v/R_d moist_old)). Written as instantaneous decoupled rates of a single column on the EarthSciDiscretizations column_nonuniform_1d layer index `lev`: WRF applies the conversion to the mass-coupled t_tendf and moist_tend, but the conversion is linear and both carry the same column mass, so it holds unchanged for the decoupled rates. Consumer-supplied column fields are rewrite-target ops input_<name>.",
  "license": "MIT",
  "tags": [
   "wrf",
   "dynamics",
   "moist-theta",
   "physics-coupling",
   "column"
  ],
  "references": [
   {
    "citation": "Skamarock, W. C., et al. (2021). A Description of the Advanced Research WRF Model Version 4.3. NCAR/TN-556+STR, section 2.2 (moist potential temperature theta_m).",
    "doi": "10.5065/1dfh-6p97"
   },
   {
    "citation": "WRF v4.8.0 dyn_em/module_big_step_utilities_em.F:6674-6707 (conv_t_tendf_to_moist), called from dyn_em/module_first_rk_step_part2.F:1005-1017."
   }
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 59,
   "description": "Number of model layers (WRF kde - 1). Bound into the column grid at the import edge; 59 is the em_scm_xy reference column."
  }
 },
 "models": {
  "WRFMoistThetaTendency": {
   "expression_template_imports": [
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/grid.esm",
     "bindings": {
      "NLEV": "NLEV"
     }
    }
   ],
   "subsystems": {
    "wrf": {
     "ref": "../../../lib/wrf_constants.esm"
    }
   },
   "variables": {
    "theta_m": {
     "type": "unknown",
     "units": "K",
     "description": "Moist potential temperature theta (1 + (R_v/R_d) q_v) on the layers at the start of the step (WRF t_1 + t0 with use_theta_m = 1), consumer-supplied through `input_theta_m`.",
     "shape": [
      "lev"
     ]
    },
    "qv": {
     "type": "unknown",
     "units": "kg/kg",
     "description": "Water-vapour mixing ratio at the start of the step (WRF moist_old(P_qv), the value theta_m was formed with), consumer-supplied through `input_qv`.",
     "shape": [
      "lev"
     ]
    },
    "dtheta_dt_phys": {
     "type": "unknown",
     "units": "K/s",
     "description": "Physics tendency of the DRY potential temperature, the sum the schemes deliver (radiation, PBL, cumulus; WRF t_tendf after update_phy_ten, decoupled), consumer-supplied through `input_dtheta_dt_phys`.",
     "shape": [
      "lev"
     ]
    },
    "dqv_dt_phys": {
     "type": "unknown",
     "units": "1/s",
     "description": "Physics tendency of the water-vapour mixing ratio (WRF moist_tend(P_qv) after update_phy_ten, decoupled), consumer-supplied through `input_dqv_dt_phys`.",
     "shape": [
      "lev"
     ]
    },
    "theta": {
     "type": "unknown",
     "units": "K",
     "description": "Dry potential temperature recovered from theta_m, theta_m / (1 + (R_v/R_d) q_v).",
     "shape": [
      "lev"
     ]
    },
    "dtheta_m_dt_phys": {
     "type": "unknown",
     "units": "K/s",
     "description": "Physics tendency of the moist potential temperature: the time derivative of theta_m = theta (1 + (R_v/R_d) q_v) by the product rule, (1 + (R_v/R_d) q_v) dtheta/dt + (R_v/R_d) theta dq_v/dt.",
     "shape": [
      "lev"
     ]
    },
    "theta_m_in": {
     "type": "parameter",
     "units": "K",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives the layer theta_m from the SCM state document's moist potential temperature through a document-level `coupling.variable_map` (`param_to_var`) when an assembly's mount-edge template library lowers `input_theta_m` to this parameter. Unused in the component's own inline tests, which lower `input_theta_m` to a dumped profile."
    },
    "qv_in": {
     "type": "parameter",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives the layer q_v from the SCM state document's water-vapour mixing ratio through a document-level `coupling.variable_map` (`param_to_var`) when an assembly's mount-edge template library lowers `input_qv` to this parameter. Unused in the component's own inline tests, which lower `input_qv` to a dumped profile."
    },
    "dtheta_dt_phys_in": {
     "type": "parameter",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives the physics theta tendency from the physics suite's summed dry-theta tendency (rth_phys_sum) through a document-level `coupling.variable_map` (`param_to_var`) when an assembly's mount-edge template library lowers `input_dtheta_dt_phys` to this parameter. Unused in the component's own inline tests, which lower `input_dtheta_dt_phys` to a dumped profile."
    },
    "dqv_dt_phys_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives the physics q_v tendency from the physics suite's summed vapour tendency through a document-level `coupling.variable_map` (`param_to_var`) when an assembly's mount-edge template library lowers `input_dqv_dt_phys` to this parameter. Unused in the component's own inline tests, which lower `input_dqv_dt_phys` to a dumped profile."
    }
   },
   "equations": [
    {
     "lhs": "theta_m",
     "rhs": {
      "op": "input_theta_m",
      "args": []
     }
    },
    {
     "lhs": "qv",
     "rhs": {
      "op": "input_qv",
      "args": []
     }
    },
    {
