         {
          "op": "*",
          "args": [
           "wrf.rvovrd",
           "qv"
          ]
         }
        ]
       }
      ]
     }
    },
    {
     "lhs": "dtheta_m_dt_phys",
     "rhs": {
      "op": "+",
      "args": [
       {
        "op": "*",
        "args": [
         {
          "op": "+",
          "args": [
           1,
           {
            "op": "*",
            "args": [
             "wrf.rvovrd",
             "qv"
            ]
           }
          ]
         },
         "dtheta_dt_phys"
        ]
       },
       {
        "op": "*",
        "args": [
