    }
   },
   "variables": {
    "phi_p_in": {
     "type": "parameter",
     "units": "m^2/s^2",
     "shape": [
      "lev_nodes"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives the interface perturbation geopotential phi' from the EqWeather-SCM state document's ODE state (couplings/eqweather_scm_dynamics.esm) through a document-level `coupling.variable_map` (`param_to_var`), when that document's mount-edge library couplings/tests/scmstate_couple_geo_inputs.esm lowers `input_phi_p` to it. Unused in the component's own inline tests, which lower `input_phi_p` to a dumped profile instead."
    },
    "theta_m_in": {
     "type": "parameter",
     "units": "K",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives the layer moist potential temperature theta_m from the EqWeather-SCM state document's ODE state (couplings/eqweather_scm_dynamics.esm) through a document-level `coupling.variable_map` (`param_to_var`), when that document's mount-edge library couplings/tests/scmstate_couple_geo_inputs.esm lowers `input_theta_m` to it. Unused in the component's own inline tests, which lower `input_theta_m` to a dumped profile instead."
    },
    "qv_in": {
     "type": "parameter",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives the layer water-vapour mixing ratio q_v from the EqWeather-SCM state document's ODE state (couplings/eqweather_scm_dynamics.esm) through a document-level `coupling.variable_map` (`param_to_var`), when that document's mount-edge library couplings/tests/scmstate_couple_geo_inputs.esm lowers `input_qv` to it. Unused in the component's own inline tests, which lower `input_qv` to a dumped profile instead."
    },
    "q_t_in": {
     "type": "parameter",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target (assembly input path): a shaped parameter that receives the total water mixing ratio q_t = q_v + q_c + q_r + q_i + q_s + q_g from the EqWeather-SCM state document (couplings/eqweather_scm.esm), summed there over the six moisture ODE states, through a document-level `coupling.variable_map` (`param_to_var`) when that document's mount-edge library lowers `input_q_t` to it. Unused in the component's own inline tests, which lower `input_q_t` to a dumped profile instead."
    },
    "mu_p": {
     "type": "parameter",
     "units": "Pa",
     "default": 0.0,
     "description": "Perturbation dry column mass mu' (WRF mu)."
    },
    "mu_b": {
     "type": "parameter",
     "units": "Pa",
     "default": 79438.7,
     "description": "Base-state dry column mass (WRF mub)."
    },
    "p_top": {
     "type": "parameter",
     "units": "Pa",
     "default": 17761.31,
     "description": "Pressure at the model lid (WRF p_top)."
    },
    "eta_w": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev_nodes"
     ],
     "description": "Eta value of each interface, 1 at the surface, 0 at the top (WRF znw), through `input_eta_w`."
    },
    "phi_p": {
     "type": "unknown",
     "units": "m^2/s^2",
     "shape": [
      "lev_nodes"
     ],
     "description": "Perturbation geopotential on the interfaces (WRF ph), through `input_phi_p`."
    },
    "phi_b": {
     "type": "unknown",
     "units": "m^2/s^2",
     "shape": [
      "lev_nodes"
     ],
     "description": "Base-state geopotential on the interfaces (WRF phb), through `input_phi_b`."
    },
    "theta_m": {
     "type": "unknown",
     "units": "K",
     "shape": [
      "lev"
     ],
