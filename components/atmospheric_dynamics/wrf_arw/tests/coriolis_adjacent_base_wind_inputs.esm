{
 "esm": "1.1.0",
 "metadata": {
  "name": "coriolis_adjacent_base_wind_inputs",
  "description": "Synthetic inputs for the adjacent-level Coriolis test. The current grid is compressed relative to the base grid, displacing layers upward at low levels and downward at high levels. The base winds vary with level. Current winds are zero and interface weights are equal.",
  "license": "MIT",
  "tags": ["test-inputs", "wrf", "coriolis"]
 },
 "expression_templates": {
  "input_ze": {
   "params": [],
   "match": {"op": "input_ze", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev_nodes"}},
    "expr": {"op": "+", "args": [215, {"op": "*", "args": [90, "k"]}]}}
  },
  "input_z_base": {
   "params": [],
   "match": {"op": "input_z_base", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev"}},
    "expr": {"op": "*", "args": [100, "k"]}}
  },
  "input_u_base": {
   "params": [],
   "match": {"op": "input_u_base", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev"}},
    "expr": {"op": "*", "args": [2, "k"]}}
  },
  "input_v_base": {
   "params": [],
   "match": {"op": "input_v_base", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev"}},
    "expr": {"op": "-", "args": ["k"]}}
  },
  "input_u": {
   "params": [],
   "match": {"op": "input_u", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev"}},
    "expr": 0.0}
  },
  "input_v": {
   "params": [],
   "match": {"op": "input_v", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev"}},
    "expr": 0.0}
  },
  "input_w": {
   "params": [],
   "match": {"op": "input_w", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev_nodes"}},
    "expr": 0.0}
  },
  "input_w_above": {
   "params": [],
   "match": {"op": "input_w_above", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev_nodes"}},
    "expr": 0.5}
  },
  "input_w_below": {
   "params": [],
   "match": {"op": "input_w_below", "args": []},
   "body": {"op": "faq", "output_idx": ["k"], "args": [], "ranges": {"k": {"from": "lev_nodes"}},
    "expr": 0.5}
  }
 }
}
